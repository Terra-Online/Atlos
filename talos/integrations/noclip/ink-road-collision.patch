+++ b/packages/extractor/src/game/dynamic/ink-road-collision.test.ts
@@ -0,0 +1,62 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import type { DynamicResourceEntity } from '@endfield-noclip/formats/endfield/dynamic-resources';
+
+import { isInkRoadCollider, visibleInkRoadGroup } from './ink-road-collision.ts';
+
+const owner = (): DynamicResourceEntity => ({
+	entity: {
+		grid: 1,
+		uid: 123n,
+		entityType: 0,
+		components: [],
+		controllers: [],
+		gates: [],
+		variables: [],
+		viewState: null,
+		resourceGroups: [
+			{
+				resources: { type: 7, grid: 1, index: 0, count: 1 },
+				sceneState: 0,
+				logicState: 0,
+				levelNum: 1,
+				factoryIndex: -1,
+			},
+		],
+		extraScene: null,
+		erosionCore: null,
+		sludgeCore: null,
+	},
+	states: [3],
+	groupStates: [[4]],
+	areas: [0],
+	groupAreas: [[7]],
+	scriptDefaultLoad: false,
+});
+
+test('completed script roads still require the owner and group scene states and area', () => {
+	const road = owner();
+	const enabled = new Set([3, 4]);
+	assert.equal(visibleInkRoadGroup(road, 0, enabled, 7), true);
+	assert.equal(visibleInkRoadGroup(road, 0, new Set([3]), 7), false);
+	assert.equal(visibleInkRoadGroup(road, 0, enabled, 0), false);
+	road.scriptDefaultLoad = null;
+	assert.equal(visibleInkRoadGroup(road, 0, enabled, 7), false);
+});
+
+test('requires an ECS collision group with a resolved logic pose and the source ink-road mesh family', () => {
+	const road = owner();
+	const group = road.entity.resourceGroups[0];
+	group.logicState = 2;
+	assert.equal(visibleInkRoadGroup(road, 0, new Set([3, 4]), 7), false);
+	group.logicState = 0;
+	group.resources.type = 6;
+	assert.equal(visibleInkRoadGroup(road, 0, new Set([3, 4]), 7), false);
+	assert.equal(
+		isInkRoadCollider('Assets/Beyond/Arts/Gameplay/PCG/InkBridge/Road/Models/road_COL1.fbx##mesh_000'),
+		true,
+	);
+	assert.equal(isInkRoadCollider('Assets/Beyond/Arts/Effects/Map/Prefab/inkbridge_floor.prefab'), false);
+	assert.equal(isInkRoadCollider(undefined), false);
+});
diff --git a/packages/extractor/src/game/dynamic/ink-road-collision.ts b/packages/extractor/src/game/dynamic/ink-road-collision.ts
new file mode 100644
index 0000000..ce7de35
--- /dev/null
+++ b/packages/extractor/src/game/dynamic/ink-road-collision.ts
@@ -0,0 +1,140 @@
+import {
+	dynamicResourceSlice,
+	type DynamicResourceEntity,
+} from '@endfield-noclip/formats/endfield/dynamic-resources';
+import { parseDynamicChunk } from '@endfield-noclip/formats/endfield/init-chunk-data';
+import { parseStreamingChunk } from '@endfield-noclip/formats/endfield/streaming-chunk-data';
+import type { Rect } from '@endfield-noclip/package-format/values';
+
+import type { Context } from '../../context.ts';
+import type { CollisionInputs } from '../collision-ground.ts';
+import { decodeCollisionRecords } from '../collision-inputs.ts';
+import { GameState, gateCondition } from '../state/game-state.ts';
+import { loadMapVariables } from '../state/scene-conditions.ts';
+
+import { gridIdReach } from './dynamic-grids.ts';
+import { DynamicFiles } from './dynamic-structures.ts';
+
+/** Restrict this completed-facility assumption to the authored solid ink road family. */
+export const isInkRoadCollider = (path: string | undefined): boolean =>
+	path?.toLowerCase().startsWith('assets/beyond/arts/gameplay/pcg/inkbridge/road/models/') ?? false;
+
+export function visibleInkRoadGroup(
+	owner: DynamicResourceEntity,
+	index: number,
+	states: ReadonlySet<number>,
+	area: number,
+): boolean {
+	// The completed passage view admits the road even when its script starts with it hidden.
+	// Other entity gates and unresolved logic poses still constrain the geometry.
+	return (
+		owner.scriptDefaultLoad !== null &&
+		owner.entity.resourceGroups[index].resources.type === 7 &&
+		owner.entity.resourceGroups[index].logicState === 0 &&
+		[owner.states, owner.groupStates[index]].every(
+			(row) => !row.length || row.some((state) => states.has(state)),
+		) &&
+		[owner.areas, owner.groupAreas[index]].every(
+			(row) => !row.length || row.includes(0) || row.includes(area),
+		)
+	);
+}
+
+const intersects = (a: Rect, b: Rect): boolean =>
+	a.minX <= b.maxX && a.maxX >= b.minX && a.minZ <= b.maxZ && a.maxZ >= b.minZ;
+
+/** Type-7 resource groups bind collision to streamed ECS actors, not the paired VFX prefabs. */
+export async function collectInkRoadCollision(
+	ctx: Context,
+	scene: string,
+	bounds: Rect,
+	selection: CollisionInputs['selection'] & { solidsOnly: true },
+): Promise<CollisionInputs | null> {
+	const dynamic = new DynamicFiles(ctx.vfs, scene);
+	const { grids, owners } = await dynamic.readOwners();
+	const states = new Set(
+		(selection.sceneStates ?? [selection.sceneState]).filter((s) => s > 0).map((s) => s - 1),
+	);
+	const selected = owners.flatMap((owner) => {
+		const entries = owner.entity.resourceGroups.filter(
+			({ resources }, index) =>
+				resources.count > 0 &&
+				visibleInkRoadGroup(owner, index, states, selection.area) &&
+				intersects(gridIdReach(resources.grid), bounds),
+		);
+		return entries.length ? [{ gates: owner.entity.gates.map(gateCondition), entries }] : [];
+	});
+	if (!selected.length) return null;
+	const game = new GameState({ variables: await loadMapVariables(ctx.world, scene) });
+	game.note(selected.flatMap((owner) => owner.gates));
+	const groups = new Map<string, Set<number>>();
+	for (const owner of selected) {
+		if (!owner.gates.every((gate) => game.evaluate(gate))) continue;
+		for (const { resources } of owner.entries) {
+			const grid = grids.get(resources.grid);
+			if (!grid) throw new Error(`missing dynamic collision grid ${resources.grid}`);
+			for (const row of dynamicResourceSlice(grid.ecs, resources)) {
+				const key = `${row.sceneIndex.toString().padStart(2, '0')}_${row.chunk.toString().padStart(8, '0')}`;
+				groups.getOrInsertComputed(key, () => new Set()).add(row.index);
+			}
+		}
+	}
+	const paths = await ctx.world.pathLookup();
+	const sourceFiles: string[] = [];
+	const records = async function* () {
+		for (const [key, indices] of groups) {
+			const { init, stream } = await dynamic.readEcsChunk(key);
+			const chunk = parseDynamicChunk(init, stream);
+			const ids = new Set<number>();
+			for (const index of indices) {
+				const group = chunk.groups[index];
+				if (!group) throw new Error(`missing dynamic collision group ${key}/${index}`);
+				if (group.bounds) {
+					const { center, extents } = group.bounds;
+					if (
+						!intersects(bounds, {
+							minX: center[0] - extents[0],
+							maxX: center[0] + extents[0],
+							minZ: center[2] - extents[2],
+							maxZ: center[2] + extents[2],
+						})
+					)
+						continue;
+				}
+				for (const id of group.ids) ids.add(id);
+			}
+			if (!ids.size) continue;
+			const selectedRows = parseStreamingChunk(stream).records.filter(
+				(row) =>
+					ids.has(row.id) &&
+					row.properties.some(({ value }) => value.type === 'asset' && isInkRoadCollider(paths(value.hash))),
+			);
+			if (!selectedRows.length) continue;
+			const name = `Data/DynamicStreaming/PC/Scene/${scene}/fb_streaming_${key}.bytes`;
+			sourceFiles.push(name);
+			yield { name, records: selectedRows };
+		}
+	};
+	const decoded = await decodeCollisionRecords(
+		ctx,
+		selection,
+		records(),
+		(assets) => assets.length > 0 && assets.every((asset) => isInkRoadCollider(paths(BigInt(asset)))),
+	);
+	if (!decoded.actors.length) return null;
+	const build = await ctx.world.manifest();
+	return {
+		version: 1,
+		scene,
+		cell: 'global',
+		selection,
+		source: { buildGuid: build.guid, contentHash: build.contentHash },
+		coverage: {
+			complete: false,
+			remaining: [],
+			scope: 'scripted-ink-road-ecs',
+			files: sourceFiles,
+		},
+		...decoded,
+	};
+}
