+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import type { DynamicEntity } from '@endfield-noclip/formats/endfield/dynamic-scene';
+
+import { isInkRoadCollider, visibleInkRoadGroup } from './ink-road-collision.ts';
+
+const owner = (): DynamicEntity => ({
+	grid: 1,
+	uid: 123n,
+	entityType: 0,
+	components: [],
+	controllers: [],
+	gates: [],
+	variables: [],
+	viewState: null,
+	resourceGroups: [
+		{
+			resources: { type: 7, grid: 1, index: 0, count: 1 },
+			lod: null,
+			sceneState: 0,
+			logicState: 0,
+			levelNum: 1,
+			factoryIndex: -1,
+			states: [4],
+			areas: [7],
+		},
+	],
+	extraScene: null,
+	erosionCore: null,
+	sludgeCore: null,
+	waterPipe: null,
+	states: [3],
+	areas: [0],
+	scriptDefaultLoad: false,
+});
+
+test('completed script roads still require the owner and group scene states and area', () => {
+	const road = owner();
+	const enabled = new Set([3, 4]);
+	assert.equal(visibleInkRoadGroup(road, 0, enabled, 7), true);
+	assert.equal(visibleInkRoadGroup(road, 0, new Set([3]), 7), false);
+	assert.equal(visibleInkRoadGroup(road, 0, enabled, 0), false);
+	road.scriptDefaultLoad = null;
+	assert.equal(visibleInkRoadGroup(road, 0, enabled, 7), false);
+});
+
+test('requires an ECS collision group with a resolved logic pose and the source ink-road mesh family', () => {
+	const road = owner();
+	const group = road.resourceGroups[0];
+	group.logicState = 2;
+	assert.equal(visibleInkRoadGroup(road, 0, new Set([3, 4]), 7), false);
+	group.logicState = 0;
+	group.resources.type = 6;
+	assert.equal(visibleInkRoadGroup(road, 0, new Set([3, 4]), 7), false);
+	assert.equal(
+		isInkRoadCollider('Assets/Beyond/Arts/Gameplay/PCG/InkBridge/Road/Models/road_COL1.fbx##mesh_000'),
+		true,
+	);
+	assert.equal(isInkRoadCollider('Assets/Beyond/Arts/Effects/Map/Prefab/inkbridge_floor.prefab'), false);
+	assert.equal(isInkRoadCollider(undefined), false);
+});
