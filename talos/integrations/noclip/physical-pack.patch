+import { lstat, mkdir, mkdtemp, rename, rm } from 'node:fs/promises';
+import { dirname, join, resolve } from 'node:path';
+import { isDeepStrictEqual, parseArgs } from 'node:util';
+
+import { physicalTileSpan } from '@opendfieldmap/ganglia/solver/host';
+import { gridTiles, tileKey, writeScenePack } from '@opendfieldmap/ganglia/scene-pack';
+
+import { buildPlayerGround } from './player-ground.ts';
+
+export const summary = 'export one range-readable physical pack for solver windows';
+export const usage = 'usage: endfield-extract player-scene <scene> --bounds <minX,minZ,maxX,maxZ> --movement-settings <file> --static-supports <file> --output <new-directory> --config <file>';
+
+export async function run(args: string[]) {
+	const { positionals, values } = parseArgs({ args, allowPositionals: true, options: {
+		bounds: { type: 'string' }, output: { type: 'string' }, config: { type: 'string' },
+		'movement-settings': { type: 'string' }, 'static-supports': { type: 'string' },
+	} });
+	if (positionals.length !== 1 || !values.bounds || !values.output || !values.config ||
+		!values['movement-settings'] || !values['static-supports']) throw new Error(usage);
+	const [scene] = positionals;
+	const box = values.bounds.split(',').map(Number);
+	if (box.length !== 4 || !box.every(Number.isFinite) || box[0] >= box[2] || box[1] >= box[3])
+		throw new Error('Invalid physical pack bounds');
+	const span = physicalTileSpan;
+	const tiles = gridTiles({ min: [box[0], box[1]], max: [box[2], box[3]] }, span);
+	const groups = new Map<string, typeof tiles>();
+	for (const tile of tiles) {
+		const key = tileKey({ x: Math.floor(tile.x / 4), z: Math.floor(tile.z / 4) });
+		const group = groups.get(key) ?? [];
+		group.push(tile);
+		groups.set(key, group);
+	}
+	const output = resolve(values.output);
+	await lstat(output).then(
+		() => { throw new Error(`Physical pack destination already exists: ${output}`); },
+		(error: NodeJS.ErrnoException) => { if (error.code !== 'ENOENT') throw error; },
+	);
+	await mkdir(dirname(output), { recursive: true });
+	const staging = await mkdtemp(join(dirname(output), '.physical-pack-'));
+	const bundle = join(staging, 'pack');
+	await mkdir(bundle);
+	const common = [
+		scene, '--terminal-scene', '--scene-state', '0', '--area', '0',
+		'--config', values.config, '--movement-settings', values['movement-settings'],
+		'--static-supports', values['static-supports'], '--input-cache', join(staging, 'input-cache'),
+	];
+	const build = (group: typeof tiles, publish: NonNullable<Parameters<typeof buildPlayerGround>[1]>) => {
+		const xs = group.map(({ x }) => x), zs = group.map(({ z }) => z);
+		const bounds = [Math.min(...xs) * span, Math.min(...zs) * span, (Math.max(...xs) + 1) * span, (Math.max(...zs) + 1) * span];
+		return buildPlayerGround([
+			...common, '--bounds=' + bounds.join(','),
+			'--tiles=' + group.map(({ x, z }) => `${x},${z}`).join(';'),
+		], publish);
+	};
+	try {
+		const [first, ...rest] = groups.values();
+		const outputTiles = (ground: Parameters<NonNullable<Parameters<typeof buildPlayerGround>[1]>>[2]) => {
+			const byTile = new Map(ground.tiles.map(({ x, z }) => [tileKey({ x, z }), { x, z, surfaces: [] as typeof ground.surfaces }]));
+			for (const surface of ground.surfaces)
+				byTile.get(surface.id.slice(0, surface.id.indexOf('/')))!.surfaces.push(surface);
+			return [...byTile.values()];
+		};
+		await build(first, (header, geometry, ground) =>
+			writeScenePack(bundle, header, async (append) => {
+				await append(geometry, outputTiles(ground));
+				for (const group of rest)
+					await build(group, (binding, geometry, ground) => {
+						if (!isDeepStrictEqual(binding, header)) throw new Error('Physical pack source changed');
+						return append(geometry, outputTiles(ground));
+					});
+			}),
+		);
+		await rename(bundle, output);
+	} finally {
+		await rm(staging, { recursive: true, force: true });
+	}
+}
