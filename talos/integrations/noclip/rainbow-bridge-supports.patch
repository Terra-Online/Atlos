+import { UnityClass } from '@endfield-noclip/formats/unity/serialized-file';
+import { transformPoint } from '@endfield-noclip/formats/unity/transform';
+
+import type { Vec3 } from '@opendfieldmap/ganglia';
+
+import type { Context } from '../context.ts';
+
+import { loadMesh } from './assets/asset-decode.ts';
+import { readPrefabRenderers } from './prefabs/prefab.ts';
+
+const effectRoot = 'Assets/Beyond/DynamicAssets/Gameplay/Effects/Prefabs';
+const effectMesh = 's_fx_ch_qiao_03';
+
+const spanFor = (template: string): 15 | 25 | 35 | null => {
+	switch (template) {
+		case 'int_rainbow_mushroom':
+			return 15;
+		case 'int_rainbow_mushroom_25m':
+			return 25;
+		case 'int_rainbow_mushroom_35m':
+			return 35;
+		default:
+			return null;
+	}
+};
+
+/**
+ * Models the passable completed-state ribbon between the effect mesh's two upper rails. The game generates
+ * its collision at runtime. The authored effect supplies width, height and orientation for this phase-free
+ * route model. Ordinary body/obstacle sweeps still apply.
+ */
+export const rainbowBridgeRibbon = (vertices: readonly Vec3[]) => {
+	const sections = new Map<number, { x: number; y: number; low: number; high: number }>();
+	for (const [x, y, z] of vertices) {
+		const key = Math.round(x * 4);
+		const previous = sections.get(key);
+		if (previous) {
+			previous.y = Math.max(previous.y, y);
+			previous.low = Math.min(previous.low, z);
+			previous.high = Math.max(previous.high, z);
+		} else {
+			sections.set(key, { x, y, low: z, high: z });
+		}
+	}
+	const pairs = [...sections.values()]
+		.filter(({ low, high }) => high - low > 1)
+		.toSorted((a, b) => a.x - b.x);
+	if (pairs.length < 5) {
+		throw new Error('rainbow bridge effect has no paired deck rails');
+	}
+	const start = pairs[0],
+		end = pairs.at(-1)!;
+	const rise = Math.max(...pairs.map((pair) => pair.y)) - (start.y + end.y) / 2;
+	const positions: Vec3[] = [];
+	const indices: number[] = [];
+	for (const { x, low, high } of pairs) {
+		const t = (x - start.x) / (end.x - start.x);
+		const y = start.y + (end.y - start.y) * t + 4 * rise * t * (1 - t);
+		const next = positions.length;
+		positions.push([x, y, low], [x, y, high]);
+		if (next > 0) indices.push(next - 2, next - 1, next + 1, next - 2, next + 1, next);
+	}
+	return { positions, indices };
+};
+
+const load = async (context: Context, length: 15 | 25 | 35) => {
+	const path = `${effectRoot}/P_fxint_l_map02_lv011_rainbowbridge_${length}m_801.prefab`;
+	const [hash] = await context.world.hashesOf(path);
+	if (hash === undefined) {
+		throw new Error(`missing Old Dam rainbow bridge effect: ${path}`);
+	}
+	const resolver = await context.resolver();
+	const root = await resolver.findUnique({ hash, path }, UnityClass.GameObject);
+	const draws = await readPrefabRenderers(resolver, root, {
+		viewPose: null,
+		particleQuad: null,
+		decalCube: null,
+		locked: false,
+		effectLod: 'camera',
+	});
+	for (const draw of draws) {
+		if ((await draw.mesh.file.peekName(draw.mesh.info)) !== effectMesh) continue;
+		const mesh = await loadMesh(resolver, draw.mesh);
+		const vertices = Array.from(
+			{ length: mesh.positions.length / 3 },
+			(_, i) =>
+				transformPoint(draw.matrix, [
+					mesh.positions[3 * i],
+					mesh.positions[3 * i + 1],
+					mesh.positions[3 * i + 2],
+				]) as Vec3,
+		);
+		return { path, hash: String(hash), ...rainbowBridgeRibbon(vertices) };
+	}
+	throw new Error(`missing authored rainbow bridge rails: ${path}`);
+};
+
+/** @param context source game build @returns a cache of the three supported Old Dam bridge effect meshes */
+export const rainbowBridgeDecks = (context: Context) => {
+	const models = new Map<number, ReturnType<typeof load>>();
+	return (template: string) => {
+		const span = spanFor(template);
+		return span === null ? null : models.getOrInsertComputed(span, () => load(context, span));
+	};
+};
