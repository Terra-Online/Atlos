+		if (level !== 'map02_lv011' || !row.template.startsWith('int_rainbow_mushroom')) continue;
+		const id = `rainbow-bridge/${owner}`;
+		try {
+			const deck = await bridgeDeck(row.template);
+			if (!deck) continue;
+			const scale = row.scale.map((value) => value * (row.modelScale > 0 ? row.modelScale : 1));
+			const transform = trsMatrix(row.position, unityEulerQuaternion(row.rotation), scale);
+			const pose = 'connected-effect-deck';
+			supports.set(id, {
+				sourceId: owner,
+				id,
+				level,
+				template: row.template,
+				source,
+				model: deck.path,
+				pose,
+				positions: deck.positions.flatMap((point) => transformPoint(transform, point)),
+				indices: deck.indices,
+				parts: [
+					{
+						model: { pathHash: deck.hash, position: row.position, rotation: row.rotation, scale },
+						path: deck.path,
+						pose,
+						source,
+						motion: [],
+					},
+				],
+				motion: 'fixed-terminal-pose',
+			});
+			objects.push({
+				id,
+				level,
+				template: row.template,
+				source,
+				owners: [owner],
+				category: 'bridge-deck',
+				status: 'exported',
+			});
+		} catch (error) {
+			unsupported.push({
