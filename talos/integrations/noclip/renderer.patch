@@ -0,0 +1,66 @@
+import assert from 'node:assert/strict';
+import { it } from 'node:test';
+
+import { BlobCodec } from '@endfield-noclip/package-format/blobs';
+import { encodeInstanceBlock } from '@endfield-noclip/package-format/instances';
+
+import { RowKind } from '../content/instance-rows.ts';
+
+import { decodeData } from './decode-data.ts';
+
+it('CPU decoding respects the blob range inside a shared read', async () => {
+	const bytes = Uint8Array.from([99, 1, 2, 3, 99]);
+	const decoded = await decodeData(
+		{
+			id: 1,
+			kind: 'layer',
+			buffer: 0,
+			offset: 1,
+			length: 3,
+			last: true,
+			codec: BlobCodec.None,
+			rawLength: 3,
+		},
+		bytes.buffer,
+	);
+	assert.equal(decoded.response.kind, 'layer');
+	if (decoded.response.kind === 'layer') {
+		assert.deepEqual([...new Uint8Array(decoded.response.data)], [1, 2, 3]);
+	}
+	assert.deepEqual([...bytes], [99, 1, 2, 3, 99]);
+});
+
+it('CPU instance decoding reads the current package layout for point framing', async () => {
+	const encoded = encodeInstanceBlock({
+		origin: [12, 3, 45],
+		chains: new Uint32Array([0]),
+		transforms: new Float32Array([1, 0, 0, 2, 0, 1, 0, 4, 0, 0, 1, 6]),
+		bounds: new Float32Array([2, 4, 6, 1, 1, 1]),
+		decals: { rows: new Uint32Array(), values: new Float32Array() },
+		spins: { rows: new Uint32Array(), values: new Float32Array() },
+		floaters: { rows: new Uint32Array(), values: new Uint32Array() },
+		rides: { rows: new Uint32Array([0]), values: new Uint32Array([0]) },
+		paths: [{ frameRate: 1, offsets: new Float32Array([0, 0, 0, 2, 0, 0]) }],
+	});
+	const decoded = await decodeData(
+		{
+			id: 2,
+			kind: 'instances',
+			buffer: 0,
+			offset: 0,
+			length: encoded.byteLength,
+			last: true,
+			codec: BlobCodec.None,
+			rawLength: encoded.byteLength,
+			rowKinds: RowKind.Detail,
+		},
+		encoded.slice().buffer,
+	);
+	assert.equal(decoded.response.kind, 'instances');
+	if (decoded.response.kind === 'instances') {
+		assert.deepEqual(decoded.response.origin, [12, 3, 45]);
+		assert.deepEqual([...decoded.response.runs], [0, 0, 1]);
+		assert.deepEqual([...decoded.response.rides!.pathOf], [0]);
+		assert.ok(decoded.transfer.includes(decoded.response.rides!.paths[0].offsets.buffer));
+	}
+});
