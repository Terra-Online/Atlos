@@ -0,0 +1,55 @@
+import assert from 'node:assert/strict';
+import { it } from 'node:test';
+
+import { pointViewKey, readPointView, writePointView } from './point-view-cache.ts';
+
+it('invalidates saved views when geometry, point, level or effective visibility changes', async () => {
+	const key = await pointViewKey('gen', 'a', [0, 0, 0], [true, false]);
+	assert.ok(key.startsWith('noclip-point-view-v7:'));
+	assert.equal(await pointViewKey('gen', 'a', [0, 0, 0], [true, false]), key);
+	for (const changed of [
+		pointViewKey('new', 'a', [0, 0, 0], [true, false]),
+		pointViewKey('gen', 'b', [0, 0, 0], [true, false]),
+		pointViewKey('gen', 'a', [1, 0, 0], [true, false]),
+		pointViewKey('gen', 'a', [0, 0, 0], [true, true]),
+	]) {
+		assert.notEqual(await changed, key);
+	}
+});
+it('restores valid views across reads and rejects malformed or blocked storage', () => {
+	const descriptor = Object.getOwnPropertyDescriptor(globalThis, 'localStorage');
+	const items: Record<string, string> = {};
+	const storage = {
+		getItem: (key: string) => items[key] ?? null,
+		setItem: (key: string, value: string) => {
+			items[key] = value;
+		},
+		removeItem: (key: string) => {
+			delete items[key];
+		},
+	};
+	Object.defineProperty(globalThis, 'localStorage', { configurable: true, value: storage });
+	try {
+		const pose = { position: [1, 2, 3] as [number, number, number], yaw: 1, pitch: -0.3 };
+		writePointView('test', pose);
+		assert.deepEqual(readPointView('test'), pose);
+		items.test = '{"position":[0],"yaw":0,"pitch":0}';
+		assert.equal(readPointView('test'), null);
+		items.test = JSON.stringify({ ...pose, pitch: Math.PI });
+		assert.equal(readPointView('test'), null);
+		storage.getItem = () => {
+			throw new Error('blocked');
+		};
+		storage.setItem = () => {
+			throw new Error('quota');
+		};
+		assert.equal(readPointView('test'), null);
+		assert.doesNotThrow(() => writePointView('test', pose));
+	} finally {
+		if (descriptor) {
+			Object.defineProperty(globalThis, 'localStorage', descriptor);
+		} else {
+			Reflect.deleteProperty(globalThis, 'localStorage');
+		}
+	}
+});
diff --git a/packages/viewer/src/scene/point-view-cache.ts b/packages/viewer/src/scene/point-view-cache.ts
new file mode 100644
index 00000000..c158853b
--- /dev/null
+++ b/packages/viewer/src/scene/point-view-cache.ts
@@ -0,0 +1,83 @@
+import { isPointView, type PointView } from '@endfield-noclip/package-format/oem';
+import type { Vec3 } from '@endfield-noclip/package-format/values';
+
+import type { CameraPose } from './noclip-controls.ts';
+
+const PREFIX = 'noclip-point-view-v7:';
+const LIMIT = 512;
+
+/**
+ * @param generation immutable scene generation
+ * @param level shown level
+ * @param target authored coordinates
+ * @param shown effective progression and area visibility
+ * @returns compact key invalidated by geometry, conditions or framing algorithm changes
+ */
+export const pointViewKey = async (
+	generation: string,
+	level: string | null,
+	target: Vec3,
+	shown: readonly boolean[],
+): Promise<string> => {
+	const bytes = new TextEncoder().encode(JSON.stringify([generation, level, target, shown]));
+	const hash = await crypto.subtle.digest('SHA-256', bytes);
+	return PREFIX + Array.from(new Uint8Array(hash), (v) => v.toString(16).padStart(2, '0')).join('');
+};
+
+/**
+ * @param key versioned point-view key
+ * @returns validated local pose, or null when unavailable; blocked storage never prevents preview
+ */
+export const readPointView = (
+	key: string,
+): (CameraPose & Partial<Pick<PointView, 'clear' | 'interactions'>>) | null => {
+	try {
+		const value: unknown = JSON.parse(localStorage.getItem(key) ?? 'null');
+		if (
+			!value ||
+			typeof value !== 'object' ||
+			!('position' in value) ||
+			!Array.isArray(value.position) ||
+			value.position.length !== 3 ||
+			!value.position.every((v) => typeof v === 'number' && Number.isFinite(v)) ||
+			!('yaw' in value) ||
+			typeof value.yaw !== 'number' ||
+			!Number.isFinite(value.yaw) ||
+			!('pitch' in value) ||
+			typeof value.pitch !== 'number' ||
+			!Number.isFinite(value.pitch) ||
+			Math.abs(value.pitch) > Math.PI / 2
+		) {
+			return null;
+		}
+		if ('interactions' in value && !isPointView({ ...value, key })) {
+			return null;
+		}
+		const candidate = { ...value, key };
+		const metadata = isPointView(candidate) ? candidate : null;
+		return {
+			...(metadata ? { clear: metadata.clear, interactions: metadata.interactions } : {}),
+			position: [value.position[0], value.position[1], value.position[2]],
+			yaw: value.yaw,
+			pitch: value.pitch,
+		};
+	} catch {
+		return null;
+	}
+};
+
+/**
+ * @param key versioned point-view key
+ * @param pose checked view to retain across reloads and preview windows
+ */
+export const writePointView = (key: string, pose: CameraPose): void => {
+	try {
+		const keys = Object.keys(localStorage).filter((k) => k.startsWith(PREFIX));
+		for (const old of keys.slice(0, Math.max(0, keys.length - LIMIT + 1))) {
+			localStorage.removeItem(old);
+		}
+		localStorage.setItem(key, JSON.stringify(pose));
+	} catch {
+		/* storage is optional, including in private or quota-limited sessions */
+	}
+};
diff --git a/packages/viewer/src/scene/point-view.test.ts b/packages/viewer/src/scene/point-view.test.ts
