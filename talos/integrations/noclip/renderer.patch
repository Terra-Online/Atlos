--- /dev/null
+++ b/packages/viewer/src/render/post/depth-of-field-optics.ts
@@ -0,0 +1,47 @@
+/** physical lens inputs; all distances are metres except the lens and sensor, which use millimetres */
+export interface FocusLens {
+	focalLength: number;
+	aperture: number;
+	focusDistance: number;
+	sensorSpan: number;
+	/** pixels along the sensor's fitted axis */
+	pixels: number;
+	near: number;
+	far: number;
+}
+
+/** signed circle-of-confusion coefficients for a reversed depth buffer */
+export interface FocusCoefficients {
+	offset: number;
+	scale: number;
+}
+
+/**
+ * converts the physical lens into a signed blur radius in pixels. negative radii are foreground; positive
+ * radii are background. keeping the finite-far expression also allows checking the viewer's infinite
+ * projection against cameras with a finite far clip.
+ *
+ * @param lens physical lens and clipping planes; all finite inputs must be positive, far > near
+ * @returns coefficients for `offset - scale * reversedDepth`
+ * @throws RangeError if the lens or clipping planes cannot represent a physical camera
+ */
+export const focusCoefficients = (lens: FocusLens): FocusCoefficients => {
+	const { focalLength, aperture, focusDistance, sensorSpan, pixels, near, far } = lens;
+	for (const value of [focalLength, aperture, focusDistance, sensorSpan, pixels, near]) {
+		if (!Number.isFinite(value) || value <= 0) {
+			throw new RangeError('focus lens values must be finite and positive');
+		}
+	}
+	if (!(far > near)) {
+		throw new RangeError('far clip must be greater than near clip');
+	}
+	const focalMetres = focalLength / 1000;
+	const radius =
+		(focalMetres * focalLength * pixels) /
+		(2 * aperture * sensorSpan * Math.max(focusDistance - focalMetres, 1e-6));
+	const inverseFar = 1 / far;
+	return {
+		offset: radius * (1 - focusDistance * inverseFar),
+		scale: radius * focusDistance * (1 / near - inverseFar),
+	};
+};
diff --git a/packages/viewer/src/render/post/depth-of-field.ts b/packages/viewer/src/render/post/depth-of-field.ts
new file mode 100644
index 00000000..1d146180
--- /dev/null
+++ b/packages/viewer/src/render/post/depth-of-field.ts
@@ -0,0 +1,310 @@
+import type { Vec3 } from '@endfield-noclip/package-format/values';
+
+import type { Camera } from '../../scene/camera.ts';
+import { HDR_FORMAT } from '../frame/render-targets.ts';
+
+import { focusCoefficients } from './depth-of-field-optics.ts';
+import depthOfFieldWgsl from './depth-of-field.wgsl?raw';
+
+/** camera-local photography settings; changing them does not modify an environment profile */
+export interface FocusSettings {
+	aperture: number;
+	focusDistance: number;
+	/** maximum foreground/background radii at a 1440-pixel render height */
+	nearRadius: number;
+	farRadius: number;
+	temporalFactor: number;
+}
+
+const UNIFORM_BYTES = 224;
+const BINDINGS = {
+	coc: [0, 7, 8, 9],
+	downsample: [0, 1, 2, 3, 4, 5, 7, 8, 9, 10],
+	tile: [0, 1, 2, 9],
+	tile_blur: [0, 1, 2, 9],
+	near_x: [0, 1, 2, 3, 4, 9, 10],
+	near_y: [0, 1, 2, 3, 4, 9],
+	alpha_x: [0, 1, 2, 9],
+	alpha_y: [0, 1, 2, 3, 9],
+	far_y: [0, 1, 2, 3, 9, 10, 11],
+	far_x: [0, 1, 2, 3, 4, 5, 6, 9],
+	composite: [0, 1, 2, 3, 4, 5, 9],
+} as const;
+type Stage = keyof typeof BINDINGS;
+interface Pass {
+	stage: Stage;
+	group: GPUBindGroup;
+	width: number;
+	height: number;
+}
+interface Sized {
+	width: number;
+	height: number;
+	lowWidth: number;
+	lowHeight: number;
+	tileWidth: number;
+	tileHeight: number;
+	scene: GPUTexture;
+	depth: GPUTextureView;
+	waterDepth: GPUTextureView;
+	textures: GPUTexture[];
+	output: GPUTexture;
+	passes: [Pass[], Pass[]];
+}
+
+/** owns the high-quality circular depth-of-field passes and their private temporal history */
+export class DepthOfField {
+	#device: GPUDevice;
+	#uniforms: GPUBuffer;
+	#data = new Float32Array(UNIFORM_BYTES / 4);
+	#sampler: GPUSampler;
+	#pipelines = new Map<string, GPUComputePipeline>();
+	#sized: Sized | null = null;
+	#index = 0;
+	#valid = false;
+	#previousViewProj = new Float32Array(16);
+	#previousEye: Vec3 = [0, 0, 0];
+	#previousLens = '';
+
+	/** @param device the viewer's GPU device */
+	constructor(device: GPUDevice) {
+		this.#device = device;
+		this.#uniforms = device.createBuffer({
+			label: 'depth of field uniforms',
+			size: UNIFORM_BYTES,
+			usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST,
+		});
+		this.#sampler = device.createSampler({
+			label: 'depth of field bilinear',
+			magFilter: 'linear',
+			minFilter: 'linear',
+			addressModeU: 'clamp-to-edge',
+			addressModeV: 'clamp-to-edge',
+		});
+		const module = device.createShaderModule({ label: 'depth of field', code: depthOfFieldWgsl });
+		for (const stage of Object.keys(BINDINGS)) {
+			this.#pipelines.set(
+				stage,
+				device.createComputePipeline({
+					label: `depth of field ${stage}`,
+					layout: 'auto',
+					compute: { module, entryPoint: `cs_${stage}` },
+				}),
+			);
+		}
+	}
+
+	/** @returns memory occupied by the effect's render targets */
+	get bytes(): number {
+		return this.#sized?.textures.reduce((sum, texture) => sum + texture.width * texture.height * 8, 0) ?? 0;
+	}
+
+	/** discards temporal samples after a camera cut, scene switch or an interval with the effect disabled */
+	reset(): void {
+		this.#valid = false;
+	}
+
+	/** releases targets while photography is disabled */
+	release(): void {
+		for (const texture of this.#sized?.textures ?? []) {
+			texture.destroy();
+		}
+		this.#sized = null;
+		this.reset();
+	}
+
+	#resize(scene: GPUTexture, depth: GPUTextureView, waterDepth: GPUTextureView): Sized {
+		const old = this.#sized;
+		if (old !== null && old.scene === scene && old.depth === depth && old.waterDepth === waterDepth) {
+			return old;
+		}
+		this.release();
+		const device = this.#device;
+		const { width, height } = scene;
+		const lowWidth = width;
+		const lowHeight = height;
+		const tileWidth = Math.max(1, Math.ceil(width / 8));
+		const tileHeight = Math.max(1, Math.ceil(height / 8));
+		const textures: GPUTexture[] = [];
+		const texture = (label: string, w = lowWidth, h = lowHeight): GPUTexture => {
+			const result = device.createTexture({
+				label: `depth of field ${label}`,
+				size: [w, h],
+				format: HDR_FORMAT,
+				usage: GPUTextureUsage.TEXTURE_BINDING | GPUTextureUsage.STORAGE_BINDING | GPUTextureUsage.COPY_SRC,
+			});
+			textures.push(result);
+			return result;
+		};
+		const coc = texture('signed radius', width, height);
+		const colors = [texture('colour 0'), texture('colour 1')];
+		const radii = [texture('radius 0'), texture('radius 1')];
+		const tile = texture('tiles', tileWidth, tileHeight);
+		const tileBlur = texture('smooth tiles', tileWidth, tileHeight);
+		const nearReal = texture('near real');
+		const nearImaginary = texture('near imaginary');
+		const nearRaw = texture('near unfiltered coverage');
+		const alpha = texture('near coverage');
+		const near = texture('near');
+		const farRed = texture('far red');
+		const farGreen = texture('far green');
+		const farBlue = texture('far blue');
+		const far = texture('far');
+		const output = texture('composite', width, height);
+		const views = new Map<GPUTexture, GPUTextureView>();
+		for (const value of [scene, ...textures]) {
+			views.set(value, value.createView());
+		}
+		const pass = (stage: Stage, sources: GPUTexture[], outputs: GPUTexture[]): Pass => {
+			const resources = new Map<number, GPUBindingResource>([
+				[0, { buffer: this.#uniforms }],
+				[1, this.#sampler],
+				[7, depth],
+				[8, waterDepth],
+			]);
+			sources.forEach((value, i) => resources.set(i + 2, views.get(value)!));
+			outputs.forEach((value, i) => resources.set(i + 9, views.get(value)!));
+			return {
+				stage,
+				width: outputs[0].width,
+				height: outputs[0].height,
+				group: device.createBindGroup({
+					label: `depth of field ${stage}`,
+					layout: this.#pipelines.get(stage)!.getBindGroupLayout(0),
+					entries: BINDINGS[stage].map((binding) => ({ binding, resource: resources.get(binding)! })),
+				}),
+			};
+		};
+		const passes = (i: number): Pass[] => [
+			pass('coc', [], [coc]),
+			pass('downsample', [coc, scene, colors[1 - i], radii[1 - i]], [radii[i], colors[i]]),
+			pass('tile', [radii[i]], [tile]),
+			pass('tile_blur', [tile], [tileBlur]),
+			pass('near_x', [tileBlur, colors[i], radii[i]], [nearReal, nearImaginary]),
+			pass('near_y', [tileBlur, nearReal, nearImaginary], [nearRaw]),
+			pass('alpha_x', [nearRaw], [alpha]),
+			pass('alpha_y', [alpha, nearRaw], [near]),
+			pass('far_y', [radii[i], colors[i]], [farRed, farGreen, farBlue]),
+			pass('far_x', [radii[i], colors[i], farRed, farGreen, farBlue], [far]),
+			pass('composite', [scene, coc, near, far], [output]),
+		];
+		this.#sized = {
+			width,
+			height,
+			lowWidth,
+			lowHeight,
+			tileWidth,
+			tileHeight,
+			scene,
+			depth,
+			waterDepth,
+			textures,
+			output,
+			passes: [passes(0), passes(1)],
+		};
+		return this.#sized;
+	}
+
+	/**
+	 * writes the focused HDR scene back into `scene`. it must allow copying into it. the two depth views use
+	 * the same render size and reversed infinite projection; water must be zero where absent.
+	 *
+	 * @param encoder this frame's encoder
+	 * @param input camera, validated photography settings and this frame's render targets
+	 */
+	encode(
+		encoder: GPUCommandEncoder,
+		input: {
+			camera: Camera;
+			jitter: readonly [number, number];
+			settings: FocusSettings;
+			scene: GPUTexture;
+			depth: GPUTextureView;
+			waterDepth: GPUTextureView;
+		},
+	): void {
+		const { camera, jitter, settings, scene, depth, waterDepth } = input;
+		const sized = this.#resize(scene, depth, waterDepth);
+		const { width, height, lowWidth, lowHeight, tileWidth, tileHeight } = sized;
+		// the viewer's focal-length readout fixes the sensor height at 24 mm. fitting that same sensor
+		// vertically preserves framing on any aspect ratio, instead of changing FOV when enabling DoF.
+		const coefficients = focusCoefficients({
+			focalLength: camera.focalLength,
+			aperture: settings.aperture,
+			focusDistance: settings.focusDistance,
+			sensorSpan: 24,
+			pixels: height,
+			near: camera.near,
+			far: Infinity,
+		});
+		const lens = `${camera.fovY}/${settings.aperture}/${settings.focusDistance}/${settings.nearRadius}/${settings.farRadius}/${settings.temporalFactor}`;
+		if (lens !== this.#previousLens) {
+			this.reset();
+		}
+		const data = this.#data;
+		data.set([width, height, 1 / width, 1 / height], 0);
+		data.set([lowWidth, lowHeight, 1 / lowWidth, 1 / lowHeight], 4);
+		data.set([tileWidth, tileHeight, 1 / tileWidth, 1 / tileHeight], 8);
+		data.set(
+			[
+				coefficients.offset,
+				coefficients.scale,
+				(settings.nearRadius * height) / 1440,
+				(settings.farRadius * height) / 1440,
+			],
+			12,
+		);
+		data.set(
+			[
+				Number(this.#valid),
+				// the effect uses this rounded exponent, rather than Euler's constant.
+				// oxlint-disable-next-line approx-constant
+				(2 * Math.min(1, Math.max(0.1, settings.temporalFactor))) ** 2.718,
+				camera.near,
+				0,
+			],
+			16,
+		);
+		data.set(camera.forward(), 20);
+		const tangent = Math.tan(camera.fovY / 2);
+		data.set(
+			camera.right().map((v) => (v * tangent * width) / height),
+			24,
+		);
+		data.set(
+			camera.up().map((v) => v * tangent),
+			28,
+		);
+		data.set(
+			camera.position.map((v, i) => v - this.#previousEye[i]),
+			32,
+		);
+		data.set(this.#previousViewProj, 36);
+		data.set(jitter, 52);
+		this.#device.queue.writeBuffer(this.#uniforms, 0, data);
+		for (const pass of sized.passes[this.#index]) {
+			const compute = encoder.beginComputePass({ label: `depth of field ${pass.stage}` });
+			compute.setPipeline(this.#pipelines.get(pass.stage)!);
+			compute.setBindGroup(0, pass.group);
+			compute.dispatchWorkgroups(Math.ceil(pass.width / 8), Math.ceil(pass.height / 8));
+			compute.end();
+		}
+		encoder.copyTextureToTexture({ texture: sized.output }, { texture: scene }, [width, height]);
+		camera.writeViewProjection(width / height, this.#previousViewProj);
+		for (let column = 0; column < 4; column++) {
+			const w = this.#previousViewProj[column * 4 + 3];
+			this.#previousViewProj[column * 4] += jitter[0] * w;
+			this.#previousViewProj[column * 4 + 1] += jitter[1] * w;
+		}
+		this.#previousEye = [...camera.position];
+		this.#previousLens = lens;
+		this.#valid = true;
+		this.#index = 1 - this.#index;
+	}
+
+	/** frees all resources owned by the effect */
+	destroy(): void {
+		this.release();
+		this.#uniforms.destroy();
+	}
+}
diff --git a/packages/viewer/src/render/post/depth-of-field.wgsl b/packages/viewer/src/render/post/depth-of-field.wgsl
new file mode 100644
index 00000000..f2f75f17
--- /dev/null
+++ b/packages/viewer/src/render/post/depth-of-field.wgsl
@@ -0,0 +1,281 @@
+// signed circle of confusion, temporal downsample and separable circular bokeh.
+// each dispatch has its own bind group; sampled and writable textures never alias.
+struct Focus {
+	full: vec4f,
+	low: vec4f,
+	tile: vec4f,
+	// depth offset, depth scale, foreground cap, background cap (pixels)
+	coc: vec4f,
+	// history valid, temporal shaping, near clip, unused
+	history: vec4f,
+	forward: vec4f,
+	right: vec4f,
+	up: vec4f,
+	eye_delta: vec4f,
+	previous_view_proj: mat4x4f,
+	jitter: vec4f,
+}
+@group(0) @binding(0) var<uniform> focus: Focus;
+@group(0) @binding(1) var linear_sampler: sampler;
+@group(0) @binding(2) var source0: texture_2d<f32>;
+@group(0) @binding(3) var source1: texture_2d<f32>;
+@group(0) @binding(4) var source2: texture_2d<f32>;
+@group(0) @binding(5) var source3: texture_2d<f32>;
+@group(0) @binding(6) var source4: texture_2d<f32>;
+@group(0) @binding(7) var scene_depth: texture_depth_2d;
+@group(0) @binding(8) var water_depth: texture_depth_2d;
+@group(0) @binding(9) var output0: texture_storage_2d<rgba16float, write>;
+@group(0) @binding(10) var output1: texture_storage_2d<rgba16float, write>;
+@group(0) @binding(11) var output2: texture_storage_2d<rgba16float, write>;
+
+fn sample_at(tex: texture_2d<f32>, uv: vec2f) -> vec4f {
+	return textureSampleLevel(tex, linear_sampler, clamp(uv, vec2f(0.0001), vec2f(0.9999)), 0.0);
+}
+fn complex_product(a: vec2f, b: vec2f) -> vec2f {
+	return vec2f(a.x * b.x - a.y * b.y, a.x * b.y + a.y * b.x);
+}
+// symmetric complex Gaussian coefficients, stored from the outside tap to the centre.
+const NEAR_KERNEL = array<vec2f, 9>(
+	vec2f(-0.001442, 0.026656), vec2f(0.010488, 0.030945),
+	vec2f(0.023771, 0.030830), vec2f(0.036356, 0.026770),
+	vec2f(0.046822, 0.020140), vec2f(0.054555, 0.012687),
+	vec2f(0.059606, 0.006074), vec2f(0.062366, 0.001584), vec2f(0.063232, 0.0));
+const FAR_KERNEL_A = array<vec2f, 7>(
+	vec2f(0.018671, -0.030012), vec2f(-0.040278, -0.022921),
+	vec2f(-0.040304, 0.041487), vec2f(0.017240, 0.066525),
+	vec2f(0.064784, 0.042949), vec2f(0.082792, 0.012205), vec2f(0.085774, 0.0));
+const FAR_KERNEL_B = array<vec2f, 7>(
+	vec2f(0.000152, 0.012075), vec2f(0.010320, 0.019409),
+	vec2f(0.027619, 0.022913), vec2f(0.048604, 0.019954),
+	vec2f(0.067953, 0.011884), vec2f(0.081151, 0.003515), vec2f(0.085774, 0.0));
+
+@compute @workgroup_size(8, 8)
+fn cs_coc(@builtin(global_invocation_id) id: vec3u) {
+	if (any(id.xy >= vec2u(focus.full.xy))) { return; }
+	let p = vec2i(id.xy);
+	let depth = max(textureLoad(scene_depth, p, 0), textureLoad(water_depth, p, 0));
+	let radius = clamp(focus.coc.x - focus.coc.y * depth, -focus.coc.z, focus.coc.w);
+	textureStore(output0, p, vec4f(radius));
+}
+
+fn compress_color(color: vec3f) -> vec3f {
+	return color / (1.0 + dot(color, vec3f(0.2126729, 0.7151522, 0.0721750)));
+}
+fn expand_color(color: vec3f) -> vec3f {
+	let positive = max(color, vec3f(0.0));
+	return positive / max(0.0001, 1.0 - dot(positive, vec3f(0.2126729, 0.7151522, 0.0721750)));
+}
+
+// source0: full CoC, source1: colour, source2/3: previous downsampled colour/CoC.
+@compute @workgroup_size(8, 8)
+fn cs_downsample(@builtin(global_invocation_id) id: vec3u) {
+	if (any(id.xy >= vec2u(focus.low.xy))) { return; }
+	let uv = (vec2f(id.xy) + 0.5) * focus.low.zw;
+	var near_sum = 0.0;
+	var far_sum = 0.0;
+	for (var y = 0; y < 2; y++) {
+		for (var x = 0; x < 2; x++) {
+			let c = sample_at(source0, uv + (vec2f(f32(x), f32(y)) - 0.5) * focus.full.zw).r;
+			near_sum += min(c, 0.0);
+			far_sum += max(c, 0.0);
+		}
+	}
+	let coc = select(far_sum, near_sum, -near_sum > far_sum) * 0.25;
+	var sum = vec3f(0.0);
+	var squares = vec3f(0.0);
+	var cross_min = vec3f(1e20);
+	var cross_max = vec3f(-1e20);
+	var all_min = vec3f(1e20);
+	var all_max = vec3f(-1e20);
+	var current = vec3f(0.0);
+	for (var y = -1; y <= 1; y++) {
+		for (var x = -1; x <= 1; x++) {
+			let color = compress_color(sample_at(source1, uv + vec2f(f32(x), f32(y)) * focus.low.zw).rgb);
+			sum += color;
+			squares += color * color;
+			all_min = min(all_min, color);
+			all_max = max(all_max, color);
+			if (x == 0 || y == 0) {
+				cross_min = min(cross_min, color);
+				cross_max = max(cross_max, color);
+			}
+			if (x == 0 && y == 0) { current = color; }
+		}
+	}
+	let mean = sum / 9.0;
+	let sigma = sqrt(max(squares / 9.0 - mean * mean, vec3f(0.0))) * 1.25;
+	let lo = min((cross_min + all_min) * 0.5, mean - sigma);
+	let hi = max((cross_max + all_max) * 0.5, mean + sigma);
+	let depth_pixel = clamp(vec2i(uv * focus.full.xy), vec2i(0), vec2i(focus.full.xy) - 1);
+	let depth = max(textureLoad(scene_depth, depth_pixel, 0), textureLoad(water_depth, depth_pixel, 0));
+	let ndc = uv * vec2f(2.0, -2.0) + vec2f(-1.0, 1.0) - focus.jitter.xy;
+	let ray = focus.forward.xyz + ndc.x * focus.right.xyz + ndc.y * focus.up.xyz;
+	let relative = ray * focus.history.z / max(depth, 1e-8) + focus.eye_delta.xyz;
+	let previous_clip = focus.previous_view_proj * vec4f(relative, 1.0);
+	let previous_uv = previous_clip.xy / max(previous_clip.w, 1e-8) * vec2f(0.5, -0.5) + 0.5;
+	var result = current;
+	if (focus.history.x > 0.5 && previous_clip.w > 0.0 && all(previous_uv >= vec2f(0.0)) && all(previous_uv <= vec2f(1.0))) {
+		let previous = compress_color(sample_at(source2, previous_uv).rgb);
+		let previous_coc = sample_at(source3, previous_uv).r;
+		let center = (lo + hi) * 0.5;
+		let extent = max((hi - lo) * 0.5, vec3f(0.0001));
+		let displacement = previous - center;
+		let units = abs(displacement / extent);
+		let reach = max(units.x, max(units.y, units.z));
+		let clipped = select(previous, center + displacement / max(reach, 0.0001), reach > 1.0);
+		let cap = select(focus.coc.w, focus.coc.z, coc < 0.0);
+		let stability = exp(-10.0 * abs(coc - previous_coc)) * (1.0 - exp(-abs(coc) * cap * focus.history.y));
+		let weight = select(0.0, 0.95 * stability, coc * previous_coc > 0.0);
+		result = mix(current, clipped, weight);
+	}
+	// full-resolution photography keeps the unfiltered CoC for spatial passes and history.
+	textureStore(output0, vec2i(id.xy), vec4f(textureLoad(source0, vec2i(id.xy), 0).r));
+	textureStore(output1, vec2i(id.xy), vec4f(expand_color(result), 1.0));
+}
+
+@compute @workgroup_size(8, 8)
+fn cs_tile(@builtin(global_invocation_id) id: vec3u) {
+	if (any(id.xy >= vec2u(focus.tile.xy))) { return; }
+	let uv = (vec2f(id.xy) + 0.5) * focus.tile.zw;
+	var radius = vec4f(0.0);
+	for (var y = -16.0; y <= 17.0; y += 7.9200006) {
+		for (var x = -16.0; x <= 17.0; x += 7.9200006) {
+			radius = max(radius, -textureGather(0, source0, linear_sampler, uv + vec2f(x, y) * focus.low.zw));
+		}
+	}
+	textureStore(output0, vec2i(id.xy), vec4f(max(max(radius.x, radius.y), max(radius.z, radius.w))));
+}
+@compute @workgroup_size(8, 8)
+fn cs_tile_blur(@builtin(global_invocation_id) id: vec3u) {
+	if (any(id.xy >= vec2u(focus.tile.xy))) { return; }
+	var sum = 0.0;
+	for (var y = -1; y <= 1; y++) {
+		for (var x = -1; x <= 1; x++) {
+			sum += sample_at(source0, (vec2f(id.xy) + 0.5 + vec2f(f32(x), f32(y))) * focus.tile.zw).r;
+		}
+	}
+	textureStore(output0, vec2i(id.xy), vec4f(sum / 9.0));
+}
+
+// source0: tile radii, source1: colour, source2: signed CoC.
+@compute @workgroup_size(8, 8)
+fn cs_near_x(@builtin(global_invocation_id) id: vec3u) {
+	if (any(id.xy >= vec2u(focus.low.xy))) { return; }
+	let uv = (vec2f(id.xy) + 0.5) * focus.low.zw;
+	let step = sample_at(source0, uv).r * focus.low.z / 8.0;
+	var real = vec3f(0.0);
+	var imaginary = vec3f(0.0);
+	var coverage = 0.0;
+	for (var i = -8; i <= 8; i++) {
+		let at = uv + vec2f(f32(i) * step, 0.0);
+		let color = sample_at(source1, at).rgb;
+		let weight = NEAR_KERNEL[8 - abs(i)];
+		real += color * weight.x;
+		imaginary += color * weight.y;
+		coverage += select(0.0, 1.0, sample_at(source2, at).r < 0.0);
+	}
+	textureStore(output0, vec2i(id.xy), vec4f(real, coverage));
+	textureStore(output1, vec2i(id.xy), vec4f(imaginary, 0.0));
+}
+@compute @workgroup_size(8, 8)
+fn cs_near_y(@builtin(global_invocation_id) id: vec3u) {
+	if (any(id.xy >= vec2u(focus.low.xy))) { return; }
+	let uv = (vec2f(id.xy) + 0.5) * focus.low.zw;
+	let step = sample_at(source0, uv).r * focus.low.w / 8.0;
+	var real = vec3f(0.0);
+	var imaginary = vec3f(0.0);
+	var coverage = 0.0;
+	for (var i = -8; i <= 8; i++) {
+		let at = uv + vec2f(0.0, f32(i) * step);
+		let a = sample_at(source1, at);
+		let b = sample_at(source2, at).rgb;
+		let weight = NEAR_KERNEL[8 - abs(i)];
+		real += a.rgb * weight.x - b * weight.y;
+		imaginary += a.rgb * weight.y + b * weight.x;
+		coverage += a.a;
+	}
+	textureStore(output0, vec2i(id.xy), vec4f(real * 0.767583 + imaginary * 1.862321, clamp(coverage * 0.0415224917, 0.0, 1.0)));
+}
+@compute @workgroup_size(8, 8)
+fn cs_alpha_x(@builtin(global_invocation_id) id: vec3u) {
+	if (any(id.xy >= vec2u(focus.low.xy))) { return; }
+	let uv = (vec2f(id.xy) + 0.5) * focus.low.zw;
+	var sum = 0.0;
+	for (var i = -4; i <= 4; i++) { sum += sample_at(source0, uv + vec2f(f32(i) * focus.low.z, 0.0)).a; }
+	textureStore(output0, vec2i(id.xy), vec4f(sum / 9.0));
+}
+@compute @workgroup_size(8, 8)
+fn cs_alpha_y(@builtin(global_invocation_id) id: vec3u) {
+	if (any(id.xy >= vec2u(focus.low.xy))) { return; }
+	let uv = (vec2f(id.xy) + 0.5) * focus.low.zw;
+	var sum = 0.0;
+	for (var i = -4; i <= 4; i++) { sum += sample_at(source0, uv + vec2f(0.0, f32(i) * focus.low.w)).r; }
+	textureStore(output0, vec2i(id.xy), vec4f(sample_at(source1, uv).rgb, sum / 9.0));
+}
+
+// background CoC limits the support: in-focus neighbours must not bleed across a silhouette.
+fn far_uv(uv: vec2f, at: vec2f, tap: i32) -> vec2f {
+	let coverage = clamp(sample_at(source0, at).r, 0.0, 1.0);
+	return select(at, uv, coverage == 0.0 || coverage * 6.0 < f32(abs(tap)));
+}
+@compute @workgroup_size(8, 8)
+fn cs_far_y(@builtin(global_invocation_id) id: vec3u) {
+	if (any(id.xy >= vec2u(focus.low.xy))) { return; }
+	let uv = (vec2f(id.xy) + 0.5) * focus.low.zw;
+	let radius = max(sample_at(source0, uv).r, 0.0);
+	var red = vec4f(0.0);
+	var green = vec4f(0.0);
+	var blue = vec4f(0.0);
+	if (radius > 0.0) {
+		for (var i = -6; i <= 6; i++) {
+			let at = far_uv(uv, uv + vec2f(0.0, f32(i) * radius * focus.low.w / 6.0), i);
+			let color = sample_at(source1, at).rgb;
+			let weight = vec4f(FAR_KERNEL_A[6 - abs(i)], FAR_KERNEL_B[6 - abs(i)]);
+			red += weight * color.r;
+			green += weight * color.g;
+			blue += weight * color.b;
+		}
+	}
+	textureStore(output0, vec2i(id.xy), red);
+	textureStore(output1, vec2i(id.xy), green);
+	textureStore(output2, vec2i(id.xy), blue);
+}
+fn far_convolve(value: vec4f, a: vec2f, b: vec2f) -> vec4f {
+	return vec4f(complex_product(value.xy, a), complex_product(value.zw, b));
+}
+fn far_combine(value: vec4f) -> f32 {
+	return dot(value, vec4f(0.411259, -0.548794, 0.513282, 4.561110));
+}
+@compute @workgroup_size(8, 8)
+fn cs_far_x(@builtin(global_invocation_id) id: vec3u) {
+	if (any(id.xy >= vec2u(focus.low.xy))) { return; }
+	let uv = (vec2f(id.xy) + 0.5) * focus.low.zw;
+	let radius = max(sample_at(source0, uv).r, 0.0);
+	var color = sample_at(source1, uv).rgb;
+	if (radius > 0.0) {
+		var red = vec4f(0.0);
+		var green = vec4f(0.0);
+		var blue = vec4f(0.0);
+		for (var i = -6; i <= 6; i++) {
+			let at = far_uv(uv, uv + vec2f(f32(i) * radius * focus.low.z / 6.0, 0.0), i);
+			let a = FAR_KERNEL_A[6 - abs(i)];
+			let b = FAR_KERNEL_B[6 - abs(i)];
+			red += far_convolve(sample_at(source2, at), a, b);
+			green += far_convolve(sample_at(source3, at), a, b);
+			blue += far_convolve(sample_at(source4, at), a, b);
+		}
+		color = vec3f(far_combine(red), far_combine(green), far_combine(blue));
+	}
+	textureStore(output0, vec2i(id.xy), vec4f(color, 1.0));
+}
+@compute @workgroup_size(8, 8)
+fn cs_composite(@builtin(global_invocation_id) id: vec3u) {
+	if (any(id.xy >= vec2u(focus.full.xy))) { return; }
+	let uv = (vec2f(id.xy) + 0.5) * focus.full.zw;
+	let sharp = sample_at(source0, uv);
+	let coc = sample_at(source1, uv).r;
+	let near = sample_at(source2, uv);
+	let far = sample_at(source3, uv).rgb;
+	let background = mix(sharp.rgb, far, smoothstep(0.5, 1.5, max(coc, 0.0)));
+	textureStore(output0, vec2i(id.xy), vec4f(mix(background, near.rgb, near.a), sharp.a));
+}
