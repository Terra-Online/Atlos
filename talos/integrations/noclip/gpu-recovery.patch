diff --git a/packages/viewer/src/viewer/frame-queue.ts b/packages/viewer/src/viewer/frame-queue.ts
new file mode 100644
--- /dev/null
+++ b/packages/viewer/src/viewer/frame-queue.ts
@@ -0,0 +1,10 @@
+/** Bound CPU submission when animation outpaces the GPU. */
+export class FrameQueue {
+    #pending = 0;
+    get full(): boolean { return this.#pending >= 2; }
+    submitted(queue: Pick<GPUQueue, 'onSubmittedWorkDone'>): void {
+        this.#pending++;
+        const release = () => { this.#pending--; };
+        queue.onSubmittedWorkDone().then(release, release);
+    }
+}
