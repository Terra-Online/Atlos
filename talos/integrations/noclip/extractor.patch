+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { planGroundRoute } from '@opendfieldmap/ganglia';
+
+import { groundData } from './ground-data.ts';
+
+const source = { buildGuid: 'build', contentHash: 'content' };
+const navigation = {
+	version: 1,
+	source,
+	scene: 'scene',
+	assets: [
+		{
+			asset: 'base',
+			position: [0, 0, 0],
+			rotation: { x: 0, y: 0, z: 0, w: 1 },
+			settings: { agentRadius: 0.41, agentHeight: 2.1 },
+			tiles: [
+				{
+					vertices: [
+						[0, 0, 0],
+						[2, 0, 0],
+						[0, 0, 2],
+					],
+					polygons: [
+						{ vertices: [0, 1, 2], area: 0, type: 0, neighbours: [0, 0, 0] },
+						{ vertices: [0, 1, 2], area: 3, type: 0, neighbours: [0, 0, 0] },
+					],
+				},
+			],
+		},
+	],
+};
+const walls = { version: 2, source, scene: 'scene', walls: [], hazards: [] };
+const request = {
+	release: 'release',
+	state: 'explicit-state',
+	assets: ['base'],
+	areas: [0],
+	profile: { radius: 0.4, height: 2 },
+	speed: 3,
+	maxVertical: 0.3,
+	arrivals: [{ id: 'player', position: [0.2, 0, 0.2], state: 'available', cost: 0 }],
+	targets: [{ id: 'target', position: [0.4, 0, 0.4] }],
+};
+test('excludes reset volumes even when the navmesh contains a continuous walkable face', () => {
+	const clear = groundData(navigation, walls, request);
+	assert.equal(
+		planGroundRoute(clear.surfaces, clear.arrivals, clear.targets[0].position, clear.options).status,
+		'complete',
+	);
+	const blocked = groundData(
+		navigation,
+		{
+			...walls,
+			hazards: [
+				{
+					kind: 'repatriation',
+					state: 'unknown',
+					min: [0.3, -0.1, 0.3],
+					max: [0.5, 0.1, 0.5],
+				},
+			],
+		},
+		request,
+	);
+	assert.equal(
+		planGroundRoute(blocked.surfaces, blocked.arrivals, blocked.targets[0].position, blocked.options).status,
+		'no-verified-route',
+	);
+	assert.throws(() => groundData(navigation, { ...walls, version: 1 }, request), /share/);
+});
+
+test('fully-enabled progression retains continuous and lifecycle-unresolved steam exclusions', () => {
+	for (const state of ['active', 'unknown']) {
+		const result = groundData(
+			navigation,
+			{
+				...walls,
+				hazards: [
+					{
+						kind: 'steam',
+						state,
+						min: [0.3, -0.1, 0.3],
+						max: [0.5, 0.1, 0.5],
+						shape: { defaultOff: true, hasCondition: true },
+						conditions: [{ controlled: true }],
+					},
+				],
+			},
+			{ ...request, progression: 'fully-enabled' },
+		);
+		assert.equal(result.options.walls[0].state, state);
+		assert.equal(
+			planGroundRoute(result.surfaces, result.arrivals, result.targets[0].position, result.options).status,
+			'no-verified-route',
+		);
+	}
+});
+test('imports only explicitly selected areas with matching build and clearance', () => {
+	assert.equal(groundData(navigation, walls, request).surfaces.length, 1);
+	assert.throws(
+		() => groundData({ ...navigation, source: {} }, { ...walls, source: {} }, request),
+		/identifier/,
+	);
+	assert.throws(
+		() => groundData(navigation, { ...walls, source: { ...source, contentHash: 'other' } }, request),
+		/share/,
+	);
+	assert.throws(() => groundData(navigation, walls, { ...request, assets: ['missing'] }), /missing/);
+	assert.throws(
+		() => groundData(navigation, walls, { ...request, profile: { radius: 1, height: 2 } }),
+		/clearance/,
+	);
+});
+
+test('resolves travel landing IDs only within the selected build and scene', () => {
+	const travel = { version: 1, source, points: [{ id: 'tp', scene: 'scene', position: [0.2, 0, 0.2] }] };
+	const query = { ...request, arrivals: [{ id: 'tp', state: 'available', cost: 5 }] };
+	assert.deepEqual(groundData(navigation, walls, query, { travel }).arrivals[0].position, [0.2, 0, 0.2]);
+	assert.throws(
+		() =>
+			groundData(navigation, walls, query, {
+				travel: { ...travel, source: { ...source, buildGuid: 'other' } },
+			}),
+		/build/,
+	);
+	assert.throws(
+		() =>
+			groundData(navigation, walls, query, {
+				travel: {
+					...travel,
+					points: [{ id: 'tp', scene: 'another', position: [0, 0, 0] }],
+				},
+			}),
+		/array/,
+	);
+});
+
+test('uses a build-bound default capsule and preserves explicit profile overrides', () => {
+	const movement = { version: 1, source, defaultProfile: { radius: 0.35, height: 1.66 } };
+	const query = { ...request, profile: undefined };
+	const data = groundData(navigation, walls, query, { movement });
+	assert.deepEqual(data.options.profile, movement.defaultProfile);
+	assert.equal(data.profileSource, 'most-common-character');
+	assert.deepEqual(groundData(navigation, walls, request, { movement }).options.profile, request.profile);
+	assert.throws(() => groundData(navigation, walls, query), /provide a profile/);
+	assert.throws(
+		() =>
+			groundData(navigation, walls, query, {
+				movement: { ...movement, source: { ...source, buildGuid: 'other' } },
+			}),
+		/share/,
+	);
+});
+
+test('passes filled reset footprints to the planner instead of blocking their empty corners', () => {
+	const polygon = [
+		[-10, -10],
+		[10, -10],
+		[10, -9],
+		[-9, -9],
+		[-9, 10],
+		[-10, 10],
+	];
+	const hazard = { kind: 'repatriation', state: 'unknown', min: [-10, -1, -10], max: [10, 1, 10], polygon };
+	const data = groundData(navigation, { ...walls, hazards: [hazard] }, request);
+	assert.deepEqual(data.options.walls[0].polygon, polygon);
+	assert.equal(
+		planGroundRoute(data.surfaces, data.arrivals, data.targets[0].position, data.options).status,
+		'complete',
+	);
+	const boundsOnly = groundData(
+		navigation,
+		{ ...walls, hazards: [{ ...hazard, polygon: undefined }] },
+		request,
+	);
+	assert.equal(
+		planGroundRoute(
+			boundsOnly.surfaces,
+			boundsOnly.arrivals,
+			boundsOnly.targets[0].position,
+			boundsOnly.options,
+		).status,
+		'no-verified-route',
+	);
+});
+
+test('imports sustained sprint from matching movement data and retains explicit resource policy', () => {
+	const movement = {
+		version: 1,
+		source,
+		defaultProfile: request.profile,
+		sustainedSprint: { speed: 5, sprintSpeed: 7, sprintAcceleration: 60 },
+		assets: [
+			{
+				path: 'Gameplay/MovementSetting_Default.asset',
+				settings: {
+					_runSpeed: 5,
+					_sprintSpeed: 7,
+					_sprintAcceleration: 60,
+					_stepOffset: 0.4,
+					_stepDownOffset: 0.6,
+				},
+			},
+		],
+	};
+	const data = groundData(navigation, walls, request, { movement });
+	assert.deepEqual(data.options.locomotion, { speed: 5, sprintSpeed: 7, sprintAcceleration: 60 });
+	const route = planGroundRoute(data.surfaces, data.arrivals, data.targets[0].position, data.options);
+	assert.equal(route.status, 'complete');
+	if (route.status !== 'complete') {
+		throw new Error('expected sprint route');
+	}
+	assert.equal(route.segments[0].gait, 'sprint');
+	const locomotion = {
+		speed: 3,
+		sprintSpeed: 6,
+		sprintAcceleration: 20,
+		stamina: { capacity: 10, initial: 5, sprintDrain: 2, recoveryRate: 1, recoveryDelay: 1, reserve: 1 },
+	};
+	const imported = groundData(navigation, walls, { ...request, locomotion }, { movement }).options.locomotion;
+	assert.equal(imported?.stamina?.initial, 5);
+	assert.equal(imported?.stamina?.activationCost, 0);
+	assert.equal(imported?.stamina?.sprintDrain, 2);
+});
+
+test('resolves only explicit completed mission gates and retains reset exclusions', () => {
+	const wall = {
+		min: [0.3, -0.1, 0.3],
+		max: [0.5, 2, 0.5],
+		state: 'unknown',
+		padding: 0,
+		points: [
+			[0.3, 0.3],
+			[0.5, 0.5],
+		],
+		scriptId: '0',
+		defaultOn: true,
+		condition: {
+			checkType: 1,
+			missionData: {
+				isRiseAny: false,
+				isDownAny: false,
+				riseReason: [{ id: 'mission', isQuest: false, detailState: 2, isSame: true }],
+				downReason: [{ id: 'mission', isQuest: false, detailState: 2, isSame: false }],
+			},
+		},
+	};
+	const exclusions = {
+		...walls,
+		walls: [wall],
+		hazards: [
+			{
+				kind: 'repatriation',
+				state: 'active',
+				min: [1, -1, 1],
+				max: [2, 2, 2],
+			},
+		],
+	};
+	assert.equal(groundData(navigation, exclusions, request).options.walls[0].state, 'unknown');
+	const resolved = groundData(navigation, exclusions, { ...request, progression: 'completed' });
+	assert.equal(resolved.progression, 'completed');
+	assert.deepEqual(
+		resolved.options.walls.map((value) => value.state),
+		['inactive', 'active'],
+	);
+	const enabled = groundData(navigation, exclusions, { ...request, progression: 'fully-enabled' });
+	assert.equal(enabled.progression, 'fully-enabled');
+	const withControlledReset = groundData(
+		navigation,
+		{
+			...exclusions,
+			hazards: [
+				...exclusions.hazards,
+				{ ...exclusions.hazards[0], state: 'unknown', shape: { defaultOff: true } },
+			],
+		},
+		{ ...request, progression: 'fully-enabled' },
+	);
+	assert.deepEqual(
+		withControlledReset.options.walls.map((value) => value.state),
+		['inactive', 'active', 'inactive'],
+	);
+
+	assert.deepEqual(
+		enabled.options.walls.map((value) => value.state),
+		['inactive', 'active'],
+	);
+	assert.throws(
+		() => groundData(navigation, exclusions, { ...request, progression: 'arbitrary' }),
+		/snapshot/,
+	);
+});
diff --git a/packages/extractor/src/game/ground-data.ts b/packages/extractor/src/game/ground-data.ts
new file mode 100644
index 00000000..d9562ef2
--- /dev/null
+++ b/packages/extractor/src/game/ground-data.ts
@@ -0,0 +1,362 @@
+import { isObject } from '@endfield-noclip/formats/unity/values';
+
+import type { GroundArrival, GroundOptions, LocomotionOptions, Surface, Vec3, Wall } from '@opendfieldmap/ganglia';
+
+import { completedWallState, enabledWallState } from './air-wall-state.ts';
+import { navigationPortals } from './navigation-portals.ts';
+
+const object = (value: unknown): Record<string, unknown> => {
+	if (!isObject(value)) {
+		throw new Error('expected routing object');
+	}
+	return value;
+};
+const list = (value: unknown): unknown[] => {
+	if (!Array.isArray(value)) {
+		throw new Error('expected routing array');
+	}
+	return value;
+};
+const number = (value: unknown): number => {
+	if (typeof value !== 'number' || !Number.isFinite(value)) {
+		throw new Error('expected finite routing number');
+	}
+	return value;
+};
+const string = (value: unknown): string => {
+	if (typeof value !== 'string' || !value.length) {
+		throw new Error('expected routing identifier');
+	}
+	return value;
+};
+const vector = (value: unknown): Vec3 => {
+	const p = list(value);
+	if (p.length !== 3) {
+		throw new Error('expected routing position');
+	}
+	return [number(p[0]), number(p[1]), number(p[2])];
+};
+
+const optionalFlag = (value: unknown) => {
+	if (value !== undefined && typeof value !== 'boolean') {
+		throw new Error('invalid stamina recovery flag');
+	}
+	return value;
+};
+
+/**
+ * @param navigation current navmesh export
+ * @param exclusions current air-wall export
+ * @param request explicit asset/area selection, state identifier, ground endpoints and profile
+ * @returns source-bound surfaces and queries; unknown walls remain blocked
+ * @throws for mismatched builds, missing assets, unsupported transforms or invalid selections
+ */
+export const groundData = (
+	navigation: unknown,
+	exclusions: unknown,
+	request: unknown,
+	inputs: { travel?: unknown; movement?: unknown } = {},
+) => {
+	const { travel, movement } = inputs;
+	const nav = object(navigation),
+		walls = object(exclusions),
+		query = object(request);
+	const source = object(nav.source),
+		wallSource = object(walls.source);
+	if (
+		nav.version !== 1 ||
+		walls.version !== 2 ||
+		nav.scene !== walls.scene ||
+		string(source.buildGuid) !== wallSource.buildGuid ||
+		string(source.contentHash) !== wallSource.contentHash
+	) {
+		throw new Error('navigation and walls must share a scene and build');
+	}
+	const release = string(query.release),
+		state = string(query.state);
+	if (
+		query.progression !== undefined &&
+		query.progression !== 'completed' &&
+		query.progression !== 'fully-enabled'
+	) {
+		throw new Error('unsupported route progression snapshot');
+	}
+	const selected = new Set(list(query.assets).map(string));
+	const areas = new Set(list(query.areas).map(number));
+	if (!selected.size || !areas.size || [...areas].some((a) => !Number.isInteger(a) || a < 0 || a > 31)) {
+		throw new Error('explicit assets and area whitelist required');
+	}
+	let defaultProfile: unknown;
+	let defaultLocomotion: unknown;
+	let steps = { up: 0, down: 0 };
+	if (movement !== undefined) {
+		const settings = object(movement),
+			movementSource = object(settings.source);
+		if (
+			settings.version !== 1 ||
+			source.buildGuid !== movementSource.buildGuid ||
+			source.contentHash !== movementSource.contentHash
+		) {
+			throw new Error('movement settings must share the navigation build');
+		}
+		defaultProfile = settings.defaultProfile;
+		defaultLocomotion = settings.sustainedSprint;
+		const defaults = list(settings.assets ?? [])
+			.map(object)
+			.find(
+				(asset) => typeof asset.path === 'string' && asset.path.endsWith('/MovementSetting_Default.asset'),
+			);
+		if (defaults) {
+			const values = object(defaults.settings);
+			steps = { up: number(values['_stepOffset']), down: number(values['_stepDownOffset']) };
+		}
+	}
+	if (query.profile === undefined && defaultProfile === undefined) {
+		throw new Error('provide a profile or build-bound movement settings');
+	}
+	const profile = object(query.profile ?? defaultProfile);
+	const radius = number(profile.radius),
+		height = number(profile.height);
+	const speed = number(query.speed),
+		maxVertical = number(query.maxVertical);
+	if (radius < 0 || height <= 0 || speed <= 0 || maxVertical < 0) {
+		throw new Error('invalid walking profile');
+	}
+	const surfaces: Surface[] = [];
+	const boundaries: Parameters<typeof navigationPortals>[0] = [];
+	const found = new Set<string>();
+	for (const value of list(nav.assets)) {
+		const asset = object(value),
+			name = string(asset.asset);
+		if (!selected.has(name)) {
+			continue;
+		}
+		if (found.has(name)) {
+			throw new Error('duplicate navigation asset');
+		}
+		found.add(name);
+		const position = vector(asset.position),
+			rotation = object(asset.rotation),
+			settings = object(asset.settings);
+		if (rotation.x !== 0 || rotation.y !== 0 || rotation.z !== 0 || rotation.w !== 1) {
+			throw new Error('rotated navigation assets are not supported');
+		}
+		if (radius > number(settings.agentRadius) || height > number(settings.agentHeight)) {
+			throw new Error('player exceeds baked agent clearance');
+		}
+		for (const [ti, tileValue] of list(asset.tiles).entries()) {
+			const tile = object(tileValue),
+				vertices = list(tile.vertices).map(vector);
+			for (const [pi, polygonValue] of list(tile.polygons).entries()) {
+				const polygon = object(polygonValue);
+				if (!areas.has(number(polygon.area))) {
+					continue;
+				}
+				if (polygon.type !== 0) {
+					throw new Error('unsupported navigation polygon type');
+				}
+				const points = list(polygon.vertices).map((indexValue) => {
+					const i = number(indexValue);
+					if (!Number.isInteger(i) || !vertices[i]) {
+						throw new Error('invalid navigation index');
+					}
+					const v = vertices[i];
+					return [v[0] + position[0], v[1] + position[1], v[2] + position[2]] satisfies Vec3;
+				});
+				const origin = points[0];
+				const area = points.reduce((sum, p, i) => {
+					const q = points[(i + 1) % points.length];
+					return sum + (p[0] - origin[0]) * (q[2] - origin[2]) - (q[0] - origin[0]) * (p[2] - origin[2]);
+				}, 0);
+				if (Math.abs(area) <= 1e-8) {
+					continue;
+				}
+				const neighbours = list(polygon.neighbours).map(number);
+				if (
+					neighbours.length !== points.length ||
+					neighbours.some((n) => !Number.isInteger(n) || n < 0 || n > 65535)
+				) {
+					throw new Error('invalid navigation neighbours');
+				}
+				const id = `${name}/${ti}/${pi}`;
+				for (const [edge, neighbour] of neighbours.entries()) {
+					if (neighbour & 0x8000) {
+						boundaries.push({
+							id,
+							side: neighbour & 0xff,
+							climb: number(settings.agentClimb),
+							a: points[edge],
+							b: points[(edge + 1) % points.length],
+						});
+					}
+				}
+				surfaces.push({
+					id,
+					vertices: points,
+					portals: neighbours.flatMap((neighbour, index) => (neighbour === 0 ? [] : [index])),
+				});
+			}
+		}
+	}
+	if (found.size !== selected.size || !surfaces.length) {
+		throw new Error('selected navigation assets are missing or empty');
+	}
+	const exclusionsList: Wall[] = list(walls.walls).map((value) => {
+		const wall = object(value);
+		// resolve only the explicitly selected completed-progression snapshot.
+		// Unsupported conditions and unresolved script-stage analyses remain blocked.
+		if (wall.state !== 'unknown') {
+			throw new Error('expected unresolved exported wall state');
+		}
+		return {
+			min: vector(wall.min),
+			max: vector(wall.max),
+			state:
+				query.progression === 'fully-enabled'
+					? enabledWallState(wall)
+					: query.progression === 'completed'
+						? completedWallState(wall)
+						: 'unknown',
+			padding: number(wall.padding),
+			points: list(wall.points).map((pointValue) => {
+				const p = list(pointValue);
+				if (p.length !== 2) {
+					throw new Error('invalid wall polyline');
+				}
+				return [number(p[0]), number(p[1])];
+			}),
+		};
+	});
+	for (const value of list(walls.hazards)) {
+		const hazard = object(value);
+		const hazardState = hazard.state;
+		if (
+			!['repatriation', 'steam'].includes(String(hazard.kind)) ||
+			(hazardState !== 'unknown' && hazardState !== 'active')
+		) {
+			throw new Error('unsupported route hazard');
+		}
+		const polygon =
+			hazard.polygon === undefined
+				? undefined
+				: list(hazard.polygon).map((p): [number, number] => {
+						const point = list(p);
+						if (point.length !== 2) {
+							throw new Error('invalid hazard polygon');
+						}
+						return [number(point[0]), number(point[1])];
+					});
+		if (polygon && polygon.length < 3) {
+			throw new Error('invalid hazard polygon');
+		}
+		const controlled =
+			(isObject(hazard.shape) && (hazard.shape.defaultOff === true || hazard.shape.hasCondition === true)) ||
+			(Array.isArray(hazard.conditions) && hazard.conditions.length > 0);
+		const resolvedState =
+			hazard.kind === 'repatriation' &&
+			query.progression === 'fully-enabled' &&
+			hazardState === 'unknown' &&
+			controlled
+				? 'inactive'
+				: hazardState;
+		exclusionsList.push({ min: vector(hazard.min), max: vector(hazard.max), state: resolvedState, polygon });
+	}
+	const landings = new Map<string, Vec3>();
+	if (travel !== undefined) {
+		const table = object(travel),
+			travelSource = object(table.source);
+		if (
+			table.version !== 1 ||
+			source.buildGuid !== travelSource.buildGuid ||
+			source.contentHash !== travelSource.contentHash
+		) {
+			throw new Error('teleports must share the navigation build');
+		}
+		for (const value of list(table.points)) {
+			const point = object(value);
+			if (point.scene === nav.scene) {
+				const id = string(point.id);
+				if (landings.has(id)) {
+					throw new Error('duplicate travel point');
+				}
+				landings.set(id, vector(point.position));
+			}
+		}
+	}
+	const arrivals: GroundArrival[] = list(query.arrivals).map((value) => {
+		const arrival = object(value);
+		if (arrival.state !== 'available' && arrival.state !== 'locked' && arrival.state !== 'unknown') {
+			throw new Error('invalid arrival availability');
+		}
+		return {
+			id: string(arrival.id),
+			position:
+				arrival.position === undefined ? vector(landings.get(string(arrival.id))) : vector(arrival.position),
+			cost: number(arrival.cost),
+			state: arrival.state,
+		};
+	});
+	const targets = list(query.targets).map((value) => {
+		const target = object(value);
+		return { id: string(target.id), position: vector(target.position) };
+	});
+	if (new Set(targets.map((t) => t.id)).size !== targets.length) {
+		throw new Error('duplicate routing target');
+	}
+	let locomotion: LocomotionOptions | undefined;
+	const selectedLocomotion = query.locomotion ?? defaultLocomotion;
+	if (selectedLocomotion !== undefined) {
+		const policy = object(selectedLocomotion);
+		locomotion = {
+			speed: number(policy.speed),
+			sprintSpeed: number(policy.sprintSpeed),
+			sprintAcceleration: number(policy.sprintAcceleration),
+		};
+		if (policy.sprintThrough !== undefined) {
+			locomotion.sprintThrough = list(policy.sprintThrough).map((mode) => {
+				if (mode !== 'jump' && mode !== 'drop' && mode !== 'rope' && mode !== 'launch') {
+					throw new Error('invalid sprint continuation mode');
+				}
+				return mode;
+			});
+		}
+		if (policy.stamina !== undefined) {
+			const resource = object(policy.stamina);
+
+			locomotion.stamina = {
+				capacity: number(resource.capacity),
+				initial: number(resource.initial ?? resource.capacity),
+				activationCost: number(resource.activationCost ?? 0),
+				sprintDrain: number(resource.sprintDrain ?? 0),
+				recoveryRate: number(resource.recoveryRate),
+				recoveryDelay: number(resource.recoveryDelay),
+				reserve: number(resource.reserve),
+				recoveryDuringSprint: optionalFlag(resource.recoveryDuringSprint),
+				recoveryDuringNonWalk: optionalFlag(resource.recoveryDuringNonWalk),
+			};
+		}
+	}
+
+	const options: GroundOptions = {
+		speed,
+		maxVertical,
+		profile: { radius, height },
+		walls: exclusionsList,
+		locomotion,
+		portals: navigationPortals(boundaries, steps),
+	};
+	return {
+		release,
+		source,
+		scene: string(nav.scene),
+		state,
+		...(query.progression !== undefined ? { progression: query.progression } : {}),
+		assets: [...selected],
+		areas: [...areas],
+		profileSource: query.profile === undefined ? 'most-common-character' : 'explicit',
+		surfaces,
+		options,
+		arrivals,
+		targets,
+	};
+};
diff --git a/packages/extractor/src/game/ground-refinement.test.ts b/packages/extractor/src/game/ground-refinement.test.ts
