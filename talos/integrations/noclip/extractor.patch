+++ b/packages/extractor/src/game/route-hazards.test.ts
@@ -0,0 +1,150 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import type { TypeTreeObject } from '@endfield-noclip/formats/unity/type-tree';
+
+import { routeHazards } from './route-hazards.ts';
+
+const payload = {
+	$type: 'Beyond_Gameplay_LevelFunctionAreaData_RepatriateZoneDataForMemoryPack',
+	lifeRatio: 1,
+};
+test('maps payload indices independently of slots and never treats defaultOff as verified inactive', () => {
+	const data: { functionArea: TypeTreeObject } = {
+		functionArea: {
+			baseData: [
+				{ functionType: 2, index: 1 },
+				{ functionType: 1, index: 0, defaultOff: true },
+			],
+			ranges: [
+				{ m_center: [0, 0, 0], m_size: [1, 1, 1] },
+				{ m_center: [10, 2, 20], m_size: [4, 2, 8] },
+			],
+			specificDatas: [payload, { $type: 'other' }],
+			functionAreaConditions: [],
+		},
+	};
+	const zones = routeHazards(data);
+	assert.equal(zones.length, 1);
+	assert.equal(zones[0].slot, 1);
+	assert.equal(zones[0].state, 'unknown');
+	assert.deepEqual(zones[0].min, [8, 1, 16]);
+	assert.deepEqual(zones[0].max, [12, 3, 24]);
+	assert.throws(() => routeHazards({ functionArea: { ...data.functionArea, specificDatas: [] } }), /payload/);
+	assert.throws(() => routeHazards({ functionArea: { ...data.functionArea, ranges: [] } }), /range/);
+});
+
+test('retains payload-free temporary reset zones', () => {
+	const zones = routeHazards({
+		functionArea: {
+			baseData: [{ functionType: 15, index: -1 }],
+			ranges: [{ m_center: [0, 0, 0], m_size: [2, 2, 2] }],
+			specificDatas: [],
+			functionAreaConditions: [],
+		},
+	});
+	assert.equal(zones.length, 1);
+	assert.equal(zones[0].payload, null);
+	assert.equal(zones[0].state, 'unknown');
+});
+
+test('unaddressed reset zones follow the direct client enable branch regardless of defaultOff', () => {
+	for (const defaultOff of [false, true]) {
+		const shape = { functionType: 1, index: 0, uniqueId: 0n, hasCondition: false, defaultOff };
+		const area = {
+			baseData: [shape],
+			ranges: [{ m_center: [0, 0, 0], m_size: [2, 2, 2] }],
+			specificDatas: [payload],
+			functionAreaConditions: [],
+		};
+		assert.equal(routeHazards({ functionArea: area })[0].state, 'active');
+		assert.equal(
+			routeHazards({ functionArea: { ...area, baseData: [{ ...shape, uniqueId: 1n }] } })[0].state,
+			'unknown',
+		);
+		assert.equal(
+			routeHazards({ functionArea: { ...area, baseData: [{ ...shape, hasCondition: true }] } })[0].state,
+			'unknown',
+		);
+	}
+});
+
+test('exports an upright rotated hazard footprint while retaining unknown activation', () => {
+	const shape = {
+		functionType: 1,
+		index: 0,
+		shapeType: 3,
+		defaultOff: true,
+		postion: [10, 2, 20],
+		euler: [0, 90, 0],
+		offset: [0, 0, 0],
+		bufferDistance: 0,
+		posList: [
+			[0, 0],
+			[4, 0],
+			[4, 1],
+			[1, 1],
+			[1, 4],
+			[0, 4],
+		],
+	};
+	const area = {
+		baseData: [shape],
+		ranges: [{ m_center: [12, 3.5, 18], m_size: [4, 3, 4] }],
+		specificDatas: [payload],
+		functionAreaConditions: [],
+	};
+	const [zone] = routeHazards({ functionArea: area });
+	assert.equal(zone.state, 'unknown');
+	assert.equal(zone.polygon?.length, 6);
+	for (const [i, p] of [
+		[10, 20],
+		[10, 16],
+		[11, 16],
+		[11, 19],
+		[14, 19],
+		[14, 20],
+	].entries()) {
+		assert.ok(zone.polygon && Math.hypot(zone.polygon[i][0] - p[0], zone.polygon[i][1] - p[1]) < 1e-5);
+	}
+	const [tilted] = routeHazards({ functionArea: { ...area, baseData: [{ ...shape, euler: [10, 90, 0] }] } });
+	assert.equal(tilted.polygon, undefined);
+	assert.deepEqual(tilted.min, zone.min);
+	assert.throws(
+		() => routeHazards({ functionArea: { ...area, ranges: [{ m_center: [0, 0, 0], m_size: [1, 1, 1] }] } }),
+		/disagrees/,
+	);
+});
+
+test('keeps the rotated footprint of an upright box reset zone', () => {
+	const shape = {
+		functionType: 1,
+		index: 0,
+		shapeType: 1,
+		uniqueId: 0n,
+		hasCondition: false,
+		postion: [10, 2, 20],
+		euler: [0, 45, 0],
+		offset: [0, 0, 0],
+		bufferDistance: 0,
+		size: [8, 5, 4],
+	};
+	const center = shape.postion;
+	const horizontalSize = 12 / Math.sqrt(2);
+	const area = {
+		baseData: [shape],
+		ranges: [{ m_center: center, m_size: [horizontalSize, 5, horizontalSize] }],
+		specificDatas: [payload],
+		functionAreaConditions: [],
+	};
+	const [zone] = routeHazards({ functionArea: area });
+	assert.equal(zone.state, 'active');
+	assert.equal(zone.polygon?.length, 4);
+	const [corner] = zone.polygon!;
+	assert.ok(Math.abs(corner[0] - (10 - 6 / Math.sqrt(2))) < 1e-5);
+	assert.ok(Math.abs(corner[1] - (20 + 2 / Math.sqrt(2))) < 1e-5);
+	const [differentHeight] = routeHazards({
+		functionArea: { ...area, ranges: [{ m_center: center, m_size: [horizontalSize, 6, horizontalSize] }] },
+	});
+	assert.equal(differentHeight.polygon, undefined);
+});
diff --git a/packages/extractor/src/game/route-hazards.ts b/packages/extractor/src/game/route-hazards.ts
new file mode 100644
index 00000000..dff6417e
--- /dev/null
+++ b/packages/extractor/src/game/route-hazards.ts
@@ -0,0 +1,141 @@
+import { FormatError } from '@endfield-noclip/formats/binary/binary-reader';
+import { trsMatrix, transformPoint, unityEulerQuaternion } from '@endfield-noclip/formats/unity/transform';
+import type { TypeTreeObject } from '@endfield-noclip/formats/unity/type-tree';
+import { arrayField, isObject, objectField, numberField } from '@endfield-noclip/formats/unity/values';
+
+const vector = (value: unknown): [number, number, number] => {
+	if (
+		!Array.isArray(value) ||
+		value.length !== 3 ||
+		!value.every((v) => typeof v === 'number' && Number.isFinite(v))
+	) {
+		throw new FormatError('invalid route hazard vector');
+	}
+	return [Number(value[0]), Number(value[1]), Number(value[2])];
+};
+
+const polygonOf = (shape: TypeTreeObject, min: number[], max: number[]) => {
+	const box = shape.shapeType === 1;
+	if (!box && shape.shapeType !== 3) {
+		return undefined;
+	}
+	const rotation = vector(shape.euler),
+		offset = vector(shape.offset);
+	// Tilted and offset volumes need their full 3D semantics.
+	if (rotation[0] !== 0 || rotation[2] !== 0 || offset.some((v) => v !== 0) || shape.bufferDistance !== 0) {
+		return undefined;
+	}
+	const origin = vector(shape.postion);
+	let footprint: [number, number][];
+	if (box) {
+		const [x, y, z] = vector(shape.size);
+		if (
+			rotation[1] % 90 === 0 ||
+			Math.min(x, y, z) <= 0 ||
+			Math.abs(origin[1] - y / 2 - min[1]) > 0.001 ||
+			Math.abs(origin[1] + y / 2 - max[1]) > 0.001
+		) {
+			return undefined;
+		}
+		// Keep the authored box footprint. Its broad-phase AABB can cover
+		// otherwise usable ground and devices near the rotated corners.
+		footprint = [
+			[-x / 2, -z / 2],
+			[x / 2, -z / 2],
+			[x / 2, z / 2],
+			[-x / 2, z / 2],
+		];
+	} else {
+		footprint = arrayField(shape, 'posList').map((p) => {
+			if (
+				!Array.isArray(p) ||
+				p.length !== 2 ||
+				!p.every((v) => typeof v === 'number' && Number.isFinite(v))
+			) {
+				throw new FormatError('invalid hazard polygon');
+			}
+			return [Number(p[0]), Number(p[1])];
+		});
+	}
+	const matrix = trsMatrix(origin, unityEulerQuaternion(rotation), [1, 1, 1]);
+	const polygon = footprint.map(([x, z]): [number, number] => {
+		const world = transformPoint(matrix, [x, 0, z]);
+		return [world[0], world[2]];
+	});
+	if (
+		polygon.length < 3 ||
+		[0, 1].some(
+			(i) =>
+				Math.abs(Math.min(...polygon.map((p) => p[i])) - min[i * 2]) > 0.001 ||
+				Math.abs(Math.max(...polygon.map((p) => p[i])) - max[i * 2]) > 0.001,
+		)
+	) {
+		if (box) return undefined;
+		throw new FormatError('hazard polygon disagrees with exported bounds');
+	}
+	return polygon;
+};
+
+/**
+ * @param data current metadata-decoded level data
+ * @returns authored repatriation volumes with conservative world bounds and source-resolved activation
+ * @throws {FormatError} if a hazard cannot be mapped to its bounds or specific payload
+ */
+export const routeHazards = (data: TypeTreeObject) => {
+	const area = objectField(data, 'functionArea');
+	const bases = arrayField(area, 'baseData'),
+		ranges = arrayField(area, 'ranges'),
+		specifics = arrayField(area, 'specificDatas');
+	if (bases.length !== ranges.length) {
+		throw new FormatError('route hazard range count mismatch');
+	}
+	return bases.flatMap((value, slot) => {
+		if (!isObject(value)) {
+			throw new FormatError('invalid function area');
+		}
+		const index = numberField(value, 'index');
+		if (!Number.isInteger(index)) {
+			throw new FormatError('invalid function area payload index');
+		}
+		const specific = specifics[index];
+		const repatriates =
+			isObject(specific) &&
+			specific.$type === 'Beyond_Gameplay_LevelFunctionAreaData_RepatriateZoneDataForMemoryPack';
+		const temporary = numberField(value, 'functionType') === 15 && index === -1;
+		// temporary reset zones carry only their base shape; ordinary reset zones require a payload.
+		if ([1, 15].includes(numberField(value, 'functionType')) && !repatriates && !temporary) {
+			throw new FormatError('missing repatriation payload');
+		}
+		if (!repatriates && !temporary) {
+			return [];
+		}
+		const range = ranges[slot];
+		if (!isObject(range)) {
+			throw new FormatError('missing route hazard bounds');
+		}
+		const center = vector(range.m_center),
+			size = vector(range.m_size);
+		if (size.some((v) => v < 0)) {
+			throw new FormatError('negative route hazard bounds');
+		}
+		const min = center.map((v, i) => v - size[i] / 2),
+			max = center.map((v, i) => v + size[i] / 2);
+		// the client enables unaddressed areas directly. their defaultOff field
+		// belongs to the addressed-area branch and cannot disable these reset zones.
+		const state = value.uniqueId === 0n && value.hasCondition === false ? 'active' : 'unknown';
+		return [
+			{
+				kind: 'repatriation',
+				slot,
+				state,
+				min,
+				max,
+				polygon: polygonOf(value, min, max),
+				// unsupported shapes retain conservative bounds and all inputs for a later resolver.
+				shape: value,
+				payload: specific ?? null,
+				conditions: arrayField(area, 'functionAreaConditions'),
+			},
+		];
+	});
+};
diff --git a/packages/extractor/src/game/script-snapshot.ts b/packages/extractor/src/game/script-snapshot.ts
new file mode 100644
index 00000000..c5607073
--- /dev/null
+++ b/packages/extractor/src/game/script-snapshot.ts
@@ -0,0 +1,212 @@
+import { isObject } from '@endfield-noclip/formats/unity/values';
+
+import type { Script } from './script-drivers.ts';
+
+/** @param value an authored parameter @returns its literal constant, or undefined */
+export const literal = (value: unknown): unknown =>
+	isObject(value) && value.paramSource === 0 ? value.constValue : undefined;
+/** @param node a decoded node @returns its unqualified schema type */
+export const typeOf = (node: unknown): string =>
+	(isObject(node) && typeof node.$type === 'string' ? node.$type : '')
+		.replace(/^Beyond_Gameplay_(Actions_)?/, '')
+		.replace(/ForMemoryPack$/, '');
+// only values established by the selected completed snapshot are evaluated.
+// dynamic properties and event outputs retain unknown values, including on cycles.
+const snapshotValue = (script: Script, value: unknown, stage: number | null, depth = 0): unknown => {
+	if (!isObject(value) || depth > 16) {
+		return undefined;
+	}
+	if (value.paramSource === 0) {
+		return value.constValue;
+	}
+	const path = typeof value.path === 'string' ? /^\$(\d+)@/.exec(value.path) : null;
+	const getter = script.getters.get(path ? Number(path[1]) : Number(value.idRef));
+	if (!getter) {
+		return undefined;
+	}
+	const read = (input: unknown) => snapshotValue(script, input, stage, depth + 1);
+	const type = typeOf(getter);
+	switch (type) {
+		case 'GetterBool':
+		case 'GetterInt': {
+			return read(getter.value);
+		}
+		case 'GetLevelScriptStage': {
+			return isObject(getter.scriptPtr) && getter.scriptPtr.paramSource === 1002
+				? (stage ?? undefined)
+				: undefined;
+		}
+		case 'GetMissionState':
+		case 'GetQuestState': {
+			return typeof read(getter.missionId ?? getter.questId) === 'string' &&
+				read(getter.missionId ?? getter.questId) !== ''
+				? 3
+				: undefined;
+		}
+		case 'CheckMissionOrQuestIsComplete':
+		case 'CheckMissionOrQuestIsProcessing': {
+			return typeof read(getter.missionId) === 'string' &&
+				read(getter.missionId) !== '' &&
+				typeof read(getter.isQuest) === 'boolean'
+				? type === 'CheckMissionOrQuestIsComplete'
+				: undefined;
+		}
+		case 'BoolGetterInvert': {
+			const inverted = read(getter.value);
+			return typeof inverted === 'boolean' ? !inverted : undefined;
+		}
+		case 'BoolGetterAnd':
+		case 'BoolGetterOr': {
+			const a = read(getter.valueA),
+				b = read(getter.valueB);
+			if (type === 'BoolGetterAnd' && (a === false || b === false)) {
+				return false;
+			}
+			if (type === 'BoolGetterOr' && (a === true || b === true)) {
+				return true;
+			}
+			return typeof a === 'boolean' && typeof b === 'boolean' ? a : undefined;
+		}
+		case 'IntEqual':
+		case 'IntCompare':
+		case 'BooleanCompare':
+		case 'CompareQuestState':
+		case 'CompareMissionState':
+		case 'CheckLevelScriptStage': {
+			const ownStage =
+				isObject(getter.scriptPtr) && getter.scriptPtr.paramSource === 1002
+					? (stage ?? undefined)
+					: undefined;
+			const a = type === 'CheckLevelScriptStage' ? ownStage : read(getter.valueA),
+				b = type === 'CheckLevelScriptStage' ? read(getter.value) : read(getter.valueB),
+				comparer = type === 'IntEqual' ? 0 : read(getter.comparer);
+			if (
+				a === undefined ||
+				b === undefined ||
+				typeof a !== typeof b ||
+				(typeof a !== 'boolean' && typeof a !== 'number')
+			) {
+				return undefined;
+			}
+			switch (comparer) {
+				case 0: {
+					return a === b;
+				}
+				case 1: {
+					return a !== b;
+				}
+				case 2: {
+					return typeof a === 'number' && typeof b === 'number' ? a > b : undefined;
+				}
+				case 3: {
+					return typeof a === 'number' && typeof b === 'number' ? a >= b : undefined;
+				}
+				case 4: {
+					return typeof a === 'number' && typeof b === 'number' ? a < b : undefined;
+				}
+				case 5: {
+					return typeof a === 'number' && typeof b === 'number' ? a <= b : undefined;
+				}
+			}
+		}
+	}
+	return undefined;
+};
+
+/**
+ * @param script a decoded script
+ * @param stage the selected completed stage, when resolved
+ * @param header the event being evaluated
+ * @returns reachable nodes and whether their path has fully resolved guards
+ */
+export function* reachableNodes(script: Script, stage: number | null, header: Script['data']) {
+	if (snapshotValue(script, header.validate, stage) === false) {
+		return;
+	}
+	const kind = typeOf(header);
+	const filteredStage = kind.includes('OnScriptStageChanged') && header.filterMode === true;
+	const stageFilter = filteredStage ? snapshotValue(script, header.newStageFilter, stage) : undefined;
+	if (filteredStage && stage !== null && typeof stageFilter === 'number' && stageFilter !== stage) {
+		return;
+	}
+	const valid = snapshotValue(script, header.validate, stage);
+	const pending = [
+			{
+				id: Number(header.ID),
+				guaranteed:
+					(header.validate === undefined || valid === true) &&
+					(!filteredStage || (stage !== null && typeof stageFilter === 'number')),
+			},
+		],
+		visited = new Set<string>();
+	while (pending.length) {
+		const entry = pending.pop()!;
+		const id = entry.id,
+			visitKey = `${id}/${entry.guaranteed}`;
+		let guaranteed = entry.guaranteed;
+		if (visited.has(visitKey)) {
+			continue;
+		}
+		visited.add(visitKey);
+		const node = script.nodes.get(id);
+		if (!node) {
+			continue;
+		}
+		const type = typeOf(node);
+		if (
+			(type === 'CheckBoolIfTrue' && snapshotValue(script, node.value, stage) === false) ||
+			(type === 'CheckBoolIfFalse' && snapshotValue(script, node.value, stage) === true)
+		) {
+			continue;
+		}
+		if (
+			(type === 'CheckBoolIfTrue' || type === 'CheckBoolIfFalse') &&
+			typeof snapshotValue(script, node.value, stage) !== 'boolean'
+		) {
+			guaranteed = false;
+		}
+		if (type === 'IfElseAction') {
+			const condition = snapshotValue(script, node.condition, stage);
+			if (typeof condition === 'boolean') {
+				const branch = condition ? node.onTrueID : node.onFalseID;
+				if (Number.isInteger(branch) && Number(branch) >= 0) {
+					pending.push({ id: Number(branch), guaranteed });
+				}
+				if (Number.isInteger(node.nextID) && Number(node.nextID) >= 0) {
+					pending.push({ id: Number(node.nextID), guaranteed });
+				}
+				continue;
+			}
+			guaranteed = false;
+		}
+		yield { node, guaranteed };
+		if (type === 'SwitchInt' && Array.isArray(node.caseValueList) && Array.isArray(node.caseIDList)) {
+			const value = snapshotValue(script, node.value, stage);
+			if (typeof value === 'number') {
+				const index = node.caseValueList.indexOf(value);
+				const next = index < 0 ? node.defaultID : node.caseIDList[index];
+				if (Number.isInteger(next) && Number(next) >= 0) {
+					pending.push({ id: Number(next), guaranteed });
+				}
+				if (Number.isInteger(node.nextID) && Number(node.nextID) >= 0) {
+					pending.push({ id: Number(node.nextID), guaranteed });
+				}
+				continue;
+			}
+			guaranteed = false;
+		}
+
+		for (const [key, value] of Object.entries(node)) {
+			if (key !== 'ID' && key.endsWith('ID') && Number.isInteger(value) && Number(value) >= 0) {
+				pending.push({ id: Number(value), guaranteed });
+			}
+			if ((key === 'idList' || key === 'caseIDList') && Array.isArray(value)) {
+				pending.push(
+					...value
+						.filter((next) => Number.isInteger(next) && Number(next) >= 0)
+						.map((next) => ({ id: Number(next), guaranteed })),
+				);
+			}
+		}
+	}
+}
diff --git a/packages/extractor/src/game/seesaw-supports.test.ts b/packages/extractor/src/game/seesaw-supports.test.ts
