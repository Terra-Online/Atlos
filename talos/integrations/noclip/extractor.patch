+	trsMatrix,
+	unityEulerQuaternion,
+} from '@endfield-noclip/formats/unity/transform';
+import { objectField, stringField, numberField } from '@endfield-noclip/formats/unity/values';
+
+import type { Vec3 } from '@opendfieldmap/ganglia';
+
+import type { Context } from '../context.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+import { followingSupport, isFollowingBox, type FollowingSupport } from './following-supports.ts';
+import { forkliftOf, forkliftSupports } from './forklift-supports.ts';
+import { componentOf, componentParams } from './interactives/component-params.ts';
+import { curveMoveOf } from './interactives/curve-move.ts';
+import { readPrefabSupport } from './prefab-support.ts';
+import { seesawSupports } from './seesaw-supports.ts';
+import { supportEndpoints, sweepSupports, type SweptSupport } from './swept-supports.ts';
+import { readWaterVolumes } from './water/water-volumes.ts';
+
+const isRecord = (value: MemoryPackValue | undefined): value is { [key: string]: MemoryPackValue } =>
+	value !== null && value !== undefined && typeof value === 'object' && !Array.isArray(value);
+
+const float = (bits: bigint) => {
+	const data = new DataView(new ArrayBuffer(4));
+	data.setUint32(0, Number(BigInt.asUintN(32, bits)), true);
+	return data.getFloat32(0, true);
+};
+const scalar = (param: InteractiveParam | undefined) =>
+	param?.type === 5 && param.values.length === 1 ? float(param.values[0].bits) : null;
+const vectors = (param: InteractiveParam | undefined): Vec3[] => {
+	if (!param || param.type !== 12 || param.values.length % 3) {
+		return [];
+	}
+	const values = param.values.map((atom) => float(atom.bits));
+	return Array.from({ length: values.length / 3 }, (_, i) => [
+		values[i * 3],
+		values[i * 3 + 1],
+		values[i * 3 + 2],
+	]);
+};
+const parameters = (template: MemoryPackValue, row: LevelInteractive) => {
+	const result = new Map<string, InteractiveParam>();
+	if (!isRecord(template)) {
+		return result;
+	}
+	const add = (values: MemoryPackValue | undefined) => {
+		for (const value of Array.isArray(values) ? values : []) {
+			const param = interactiveParamFromValue(value);
+			result.set(param.key, param);
+		}
+	};
+	add(template.configProperties);
+	add(template.saveProperties);
+	for (const pair of Array.isArray(template.templateVariant) ? template.templateVariant : []) {
+		if (Array.isArray(pair) && pair[0] === row.template && isRecord(pair[1])) {
+			add(pair[1].diffProperties);
+		}
+	}
+	for (const param of row.properties) {
+		result.set(param.key, param);
+	}
+	return result;
+};
+
+// geometric subdivision is independent of playback speed, waits and initial phase.
+const sampleCurve = (curve: BezierCurve): Vec3[] => {
+	const points: Vec3[] = [bezierPoint(curve, 0)];
+	const visit = (low: number, high: number, depth: number) => {
+		const a = bezierPoint(curve, low),
+			b = bezierPoint(curve, high);
+		const error = Math.max(
+			...[0.25, 0.5, 0.75].map((t) => {
+				const p = bezierPoint(curve, low + (high - low) * t);
+				return Math.hypot(...p.map((v, axis) => v - a[axis] - (b[axis] - a[axis]) * t));
+			}),
+		);
+		if (error > 0.05 && depth < 16) {
+			visit(low, (low + high) / 2, depth + 1);
+			visit((low + high) / 2, high, depth + 1);
+		} else {
+			points.push(b);
+		}
+	};
+	visit(0, 1, 0);
+	return points;
+};
+const splinePath = (spline: LevelSpline, move: NonNullable<ReturnType<typeof curveMoveOf>>) => {
+	const loop = move.startIndex === move.targetIndex;
+	const curves = splineCurves(spline, spline.closed || loop);
+	if (
+		move.startIndex < 0 ||
+		move.targetIndex < 0 ||
+		Math.max(move.startIndex, move.targetIndex) > curves.length
+	) {
+		throw new Error('moving support has invalid spline interval');
+	}
+	const selected = loop
+		? curves
+		: curves.slice(Math.min(move.startIndex, move.targetIndex), Math.max(move.startIndex, move.targetIndex));
+	const points = selected.flatMap((curve, i) => sampleCurve(curve).slice(i ? 1 : 0));
+	return move.startIndex > move.targetIndex ? points.toReversed() : points;
+};
+
+const conveyorPath = (paths: ConveyorPath[], offset: number): Vec3[] =>
+	paths.flatMap((path) => {
+		if (path.type === 0) {
+			const dx = path.end[0] - path.start[0],
+				dz = path.end[2] - path.start[2],
+				length = Math.hypot(dx, dz);
+			if (!length) {
+				return [];
+			}
+			return [path.start, path.end].map((p) => [
+				p[0] - (dz / length) * offset,
+				p[1],
+				p[2] + (dx / length) * offset,
+			]);
+		}
+		if (path.type !== 1 || path.radius <= 0) {
+			throw new Error('unsupported conveyor path segment');
+		}
+		const start = Math.atan2(path.start[2] - path.center[2], path.start[0] - path.center[0]);
+		const end = Math.atan2(path.end[2] - path.center[2], path.end[0] - path.center[0]);
+		const direction = path.clockwise ? -1 : 1;
+		const span = direction * ((((direction * (end - start)) % (2 * Math.PI)) + 2 * Math.PI) % (2 * Math.PI));
+		const radius = path.radius - direction * offset;
+		const count = Math.max(
+			1,
+			Math.ceil(
+				Math.abs(span) / (2 * Math.acos(Math.max(-1, 1 - 0.05 / Math.max(path.radius, Math.abs(radius))))),
+			),
+		);
+		return Array.from({ length: count + 1 }, (_, i): Vec3 => {
+			const angle = start + (span * i) / count;
+			return [
+				path.center[0] + radius * Math.cos(angle),
+				path.start[1] + ((path.end[1] - path.start[1]) * i) / count,
+				path.center[2] + radius * Math.sin(angle),
+			];
+		});
+	});
+
+/**
+ * @param ctx open local installation readers
+ * @param scene streaming scene
+ * @returns reusable phase-free collision-support envelopes and explicit unresolved source records
+ */
+export const collectMovingSupports = async (ctx: Context, scene: string) => {
+	const supports: SweptSupport[] = [];
+	const following: FollowingSupport[] = [];
+	const unsupported: { id: string; template: string; reason: string }[] = [];
+	const pool = await ctx.world.stringPool(),
+		reader = await ctx.memoryPack();
+	const read = async (path: string, group: string = VfsGroup.JsonData) => {
+		const file = await ctx.vfs.find(group, path);
+		if (!file) {
+			throw new Error(`missing moving support input ${path}`);
+		}
+		return ctx.vfs.readVerified(file);
+	};
+	const table = readInteractiveTable(await read('Data/Json/Interactive/InteractiveTable.json'), (id) =>
+		pool.get(id),
+	);
+	const models = objectField(
+		JSON.parse(new TextDecoder().decode(await read('Data/Json/GameplayConfig/ModelTable.json'))),
+		'data',
+	);
+	const templates = new Map<string, MemoryPackValue>();
+	const prefabs = new Map<string, Promise<Awaited<ReturnType<typeof readPrefabSupport>>>>();
+	const resolver = await ctx.resolver();
+	const bodyOf = async (path: string) => {
+		return prefabs.getOrInsertComputed(path, async () => {
+			const hashes = await ctx.world.hashesOf(path);
+			if (hashes.length !== 1) {
+				throw new Error('ambiguous moving support prefab');
+			}
+			return readPrefabSupport(
+				resolver,
+				await resolver.findUnique({ hash: hashes[0], path }, UnityClass.GameObject),
+			);
+		});
+	};
+	const paths = await ctx.world.pathLookup();
+	const water = await readWaterVolumes(ctx, scene, null, await ctx.world.partition(scene));
+	const waterById = new Map(water.volumes.map((v) => [v.id, v]));
+	const floaters = new Map(water.floaters.map((f) => [f.id, f.volume]));
+	const levels = [...(await ctx.world.levelConfigs()).values()].filter((level) => level.mapId === scene);
+	const levelIds = new Map(levels.map((level) => [level.idNum, level.id]));
+	const seen = new Set<string>();
+	for (const level of levels) {
+		const rows: MemoryPackValue[] = [],
+			splines = new Map<number, LevelSpline>();
+		for (const hash of level.levelDataPathHashes ?? []) {
+			const path = paths(hash);
+			if (!path) {
+				throw new Error('missing moving support level path');
+			}
+			const data = reader.decode(await read(path), 'Beyond_Gameplay_LevelDataForMemoryPack');
+			if (!isRecord(data) || !Array.isArray(data.interactives)) {
+				throw new Error('invalid moving support level data');
+			}
+			rows.push(...data.interactives);
+			for (const spline of readLevelSplines(data)) {
+				splines.set(spline.id, spline);
+			}
+		}
+		for (const raw of rows) {
+			if (!isRecord(raw) || typeof raw.entityDataIdKey !== 'string') {
+				continue;
+			}
+			const existing =
+				/^int_(platform_|movingplat|lifter|seesaw|water_volume_floater)/.test(raw.entityDataIdKey) &&
+				!raw.entityDataIdKey.startsWith('int_lifter_button');
+			if (typeof raw.levelLogicId !== 'string' || !/^[1-9]\d*$/.test(raw.levelLogicId)) {
+				throw new Error('invalid moving support identity');
+			}
+			const row = levelInteractiveFromValue(raw, BigInt(raw.levelLogicId));
+			const id = String(row.id);
+			if (seen.has(id)) {
+				continue;
+			}
+			seen.add(id);
+			try {
+				const templateId = table.templates.get(row.template);
+				const path = templateId === undefined ? undefined : table.templatePaths.get(templateId);
+				if (!path) {
+					if (!existing) {
+						continue;
+					}
+					throw new Error('missing moving support template');
+				}
+				let template = templates.get(path);
+				if (!template) {
+					template = reader.decode(await read(path), 'Beyond_Gameplay_InteractiveTemplateDataForMemoryPack');
+					templates.set(path, template);
+				}
+				const forklift = forkliftOf(template, row);
+				const follows = isFollowingBox(template, row);
+				if (!existing && !forklift && !follows) {
+					continue;
+				}
+				const move = curveMoveOf(template, row);
+				const params = parameters(template, row);
+				const lifter = componentOf(template, '_LifterCoreComponentDataForMemoryPack');
+				const moving = componentOf(template, '_InteractiveMovingPlatformComponentDataForMemoryPack');
+				const logic = componentParams(template, row, {
+					suffix: '_InteractiveLogicControllerComponentDataForMemoryPack',
+					diffKey: 'Comp_InteractiveLogicController',
+					type: 29,
+				});
+				const seesaw = logic?.get('logic_type')?.values[0]?.bits === 9n;
+				const volume = waterById.get(floaters.get(id) ?? '');
+				let positions: Vec3[],
+					speed: number | null,
+					family: SweptSupport['family'] = 'platform';
+				if (follows) {
+					positions = [row.position];
+					speed = null;
+				} else if (forklift) {
+					positions = [forklift.start, forklift.end];
+					speed = forklift.speed;
+					family = 'forklift';
+				} else if (move) {
+					const spline = splines.get(move.splineId);
+					if (!spline || move.followsTangent) {
+						throw new Error('moving support spline or tangent rotation unresolved');
+					}
+					positions = splinePath(spline, move);
+					speed = move.speed > 0 ? move.speed : null;
+				} else if (lifter || moving) {
+					// floor positions are local offsets, unlike world-space spline knots.
+					const placement = trsMatrix(row.position, unityEulerQuaternion(row.rotation), row.scale);
+					positions = vectors(params.get('position_list')).map((p) => transformPoint(placement, p));
+					const suffix = lifter
+						? '_LifterCoreComponentDataForMemoryPack'
+						: '_InteractiveMovingPlatformComponentDataForMemoryPack';
+					const p = componentParams(template, row, {
+						suffix,
+						diffKey: lifter ? 'Comp_Lifter' : 'Comp_MovingPlatform',
+						type: lifter ? 154 : 178,
+					});
+					speed = scalar(p?.get('speed')) ?? scalar(params.get('speed'));
+				} else if (volume) {
+					const current = volume.pivot[1] + volume.heightMax * volume.fraction;
+					positions = [volume.pivot[1], volume.pivot[1] + volume.heightMax].map((y) => [
+						row.position[0],
+						row.position[1] + y - current,
+						row.position[2],
+					]);
+					speed = volume.fillSpeed > 0 ? volume.fillSpeed : null;
+					family = 'water-floater';
+				} else if (seesaw) {
+					positions = [row.position];
+					speed = null;
+					family = 'seesaw';
+				} else {
+					throw new Error('no authored moving support path');
+				}
+				if (!seesaw && !follows && positions.length < 2) {
+					throw new Error('moving support path has fewer than two poses');
+				}
+				const base = componentOf(template, '_InteractiveModelComponentDataForMemoryPack');
+				const variants =
+					isRecord(template) && Array.isArray(template.templateVariant) ? template.templateVariant : [];
+				const variant = variants.find((pair) => Array.isArray(pair) && pair[0] === row.template);
+				const override =
+					Array.isArray(variant) && isRecord(variant[1]) && isRecord(variant[1].modelId)
+						? variant[1].modelId
+						: null;
+				const modelId = override?.enabled === true ? override.value : base?.modelId;
+				if (typeof modelId !== 'string' || !modelId) {
+					throw new Error('moving support has no model');
+				}
+				const model = objectField(models, modelId);
+				const prefab = stringField(model, 'path').toLowerCase();
+				const body = await bodyOf(prefab);
+				if ((lifter || moving) && !body.movingPart) {
+					throw new Error('platform moving subtree unresolved');
+				}
+				const scale =
+					(row.modelScale > 0 ? row.modelScale : typeof base?.modelScale === 'number' ? base.modelScale : 1) *
+					numberField(model, 'scaleFactor');
+				if (follows) {
+					if (body.bodyKinds.some((kind) => kind === 'triangle')) {
+						throw new Error('following box requires solid convex collider provenance');
+					}
+					const placement = trsMatrix(
+						row.position,
+						unityEulerQuaternion(row.rotation),
+						row.scale.map((v) => v * scale),
+					);
+					following.push(
+						followingSupport(
+							id,
+							level.id,
+							prefab,
+							template,
+							row,
+							body.bodies.map((vertices) => vertices.map((p) => transformPoint(placement, p))),
+							body.bodyKinds.every((kind) => kind === 'box') ? 'box' : 'convex',
+						),
+					);
+					continue;
+				}
+				let geometry: Pick<SweptSupport, 'surfaces' | 'transfers' | 'poses' | 'surfacePoses'>;
+				let endpoints: NonNullable<SweptSupport['endpoints']>;
+				if (forklift) {
+					const placement = trsMatrix(
+						row.position,
+						unityEulerQuaternion(row.rotation),
+						row.scale.map((v) => v * scale),
+					);
+					const support = forkliftSupports(id, body, placement, forklift);
+					geometry = support;
+					endpoints = support.endpoints;
+				} else if (seesaw) {
+					const angle = scalar(params.get('max_rotation'));
+					const pivot = body.pivot;
+					if (!pivot || angle === null) {
+						throw new Error('seesaw pivot or tilt limit unresolved');
+					}
+					const placement = trsMatrix(
+						row.position,
+						unityEulerQuaternion(row.rotation),
+						row.scale.map((v) => v * scale),
+					);
+					geometry = seesawSupports(id, body.bodies, pivot, placement, angle);
+					const tilted = multiplyMatrices(
+						multiplyMatrices(placement, pivot),
+						trsMatrix([0, 0, 0], unityEulerQuaternion([angle, 0, 0]), [1, 1, 1]),
+					);
+					// the positive tilt limit is a representative endpoint, independent of timing or phase.
+					endpoints = supportEndpoints([
+						body.bodies.map((vertices) => vertices.map((p) => transformPoint(placement, p))),
+						body.bodies.map((vertices) =>
+							vertices.map((p) => transformPoint(tilted, inverseTransformPoint(pivot, p))),
+						),
+					]);
+				} else {
+					const poses = positions.map((position) => {
+						const matrix = trsMatrix(
+							position,
+							unityEulerQuaternion(row.rotation),
+							row.scale.map((v) => v * scale),
+						);
+						return body.bodies.map((vertices) => vertices.map((p) => transformPoint(matrix, p)));
+					});
+					geometry = sweepSupports(id, poses, speed && speed > 0 ? speed : null);
+					endpoints = supportEndpoints(poses);
+				}
+				supports.push({
+					id,
+					family,
+					level: level.id,
+					model: prefab,
+					...(forklift ? { control: forklift } : {}),
+					endpoints,
+					...geometry,
+					assumption: 'phase-free-swept-support',
+				});
+			} catch (error) {
+				unsupported.push({
+					id,
+					template: row.template,
+					reason: error instanceof Error ? error.message : String(error),
+				});
+			}
+		}
+	}
+	// conveyor boxes are dynamic resource placements, not LevelData interactives.
+	const grids = new Map<number, ReturnType<typeof readDynamicResources>['grids'][number]>();
+	const entities: ReturnType<typeof readDynamicResources>['entities'] = [];
+	const prefix = 'Data/DynamicStreaming/PC/Scene/' + scene + '/fb_main_';
+	for (const name of [...(await ctx.vfs.group(VfsGroup.DynamicStreaming)).files.keys()]
+		.filter((candidate) => candidate.startsWith(prefix))
+		.toSorted()) {
+		const data = readDynamicResources(await read(name, VfsGroup.DynamicStreaming));
+		for (const grid of data.grids) {
+			grids.set(grid.id, grid);
+		}
+		entities.push(...data.entities);
+	}
+	const groups = new Map(
+		entities.flatMap(({ entity }) =>
+			entity.conveyor?.kind === 'group' ? [[String(entity.uid), entity.conveyor] as const] : [],
+		),
+	);
+	for (const { entity } of entities) {
+		if (entity.conveyor?.kind !== 'box') {
+			continue;
+		}
+		const id = String(entity.uid),
+			group = groups.get(String(entity.conveyor.group));
+		try {
+			if (!group) {
+				throw new Error('missing conveyor group');
+			}
+			const positions = conveyorPath(group.paths, entity.conveyor.lateralOffset);
+			if (positions.length < 2) {
+				throw new Error('empty conveyor path');
+			}
+			for (const resource of entity.resourceGroups) {
+				if (resource.resources.type !== 5) {
+					throw new Error('conveyor box resource is not a model');
+				}
+				const grid = grids.get(resource.resources.grid);
+				if (!grid) {
+					throw new Error('missing conveyor resource grid');
+				}
+				const placements: DynamicModel[] = dynamicResourceSlice(grid.models, resource.resources);
+				for (const [index, model] of placements.entries()) {
+					const path = paths(model.pathHash);
+					if (!path) {
+						throw new Error('missing conveyor model path');
+					}
+					const body = await bodyOf(path);
+					const shape = trsMatrix([0, 0, 0], unityEulerQuaternion(model.rotation), model.scale);
+					const poses = positions.map((position) =>
+						body.bodies.map((vertices) =>
+							vertices.map((p): Vec3 => {
+								const q = transformPoint(shape, p);
+								return [q[0] + position[0], q[1] + position[1], q[2] + position[2]];
+							}),
+						),
+					);
+					const key =
+						'conveyor/' +
+						entity.conveyor.group +
+						'/' +
+						resource.resources.grid +
+						'/' +
+						(resource.resources.index + index);
+					supports.push({
+						id: key,
+						family: 'conveyor',
+						level: levelIds.get(group.level) ?? scene + '/level/' + group.level,
+						model: path,
+						endpoints: supportEndpoints(poses),
+						...sweepSupports(key, poses, Math.abs(group.speed) || null),
+						assumption: 'phase-free-swept-support',
+					});
+				}
+			}
+		} catch (error) {
+			unsupported.push({
+				id,
+				template: 'conveyor-box',
+				reason: error instanceof Error ? error.message : String(error),
+			});
+		}
+	}
+	if (new Set(supports.map((support) => support.id)).size !== supports.length) {
+		throw new Error('duplicate moving support source identity');
+	}
+	return { supports, following, unsupported };
+};
