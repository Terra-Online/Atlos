+++ b/packages/extractor/src/route-cache.test.ts
@@ -0,0 +1,72 @@
+import assert from 'node:assert/strict';
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { test } from 'node:test';
+
+import { createRouteCache } from './route-cache.ts';
+
+const inputs = async (directory: string, suffix = '') => {
+	const files = {
+		ground: join(directory, 'ground' + suffix),
+		collision: join(directory, 'collision' + suffix),
+		movement: join(directory, 'movement' + suffix),
+	};
+	await Promise.all(Object.values(files).map((path) => writeFile(path, JSON.stringify({ value: path }))));
+	return files;
+};
+
+test('input changes invalidate prepared regions and races cannot reuse an older preparation', async () => {
+	const directory = await mkdtemp(join(tmpdir(), 'route-cache-'));
+	try {
+		const files = await inputs(directory);
+		const other = await inputs(directory, '-other');
+		const cache = createRouteCache();
+		const generation = await cache.begin(files);
+		const value = await cache.read('ground', files.ground);
+		assert.equal(await cache.read('ground', files.ground), value);
+		assert.equal((await cache.memo('ground', generation, () => 1)).reused, false);
+		assert.deepEqual(await cache.memo('ground', generation, () => 2), { value: 1, reused: true });
+		await writeFile(files.ground, '{"value":"changed"}');
+		await assert.rejects(cache.read('ground', files.ground), /changed after preparation/);
+		const next = await cache.begin(files);
+		assert.notEqual(next, generation);
+		assert.deepEqual(await cache.read('ground', files.ground), { value: 'changed' });
+		assert.equal((await cache.memo('ground', next, () => 2)).value, 2);
+		const switched = await cache.begin(other);
+		assert.equal((await cache.memo('ground', switched, () => 3)).reused, false);
+		await cache.begin(files);
+		assert.equal((await cache.memo('ground', next, () => 4)).reused, false);
+	} finally {
+		await rm(directory, { recursive: true, force: true });
+	}
+});
+
+test('oversized regions and rejected preparations are never retained', async () => {
+	const directory = await mkdtemp(join(tmpdir(), 'route-cache-budget-'));
+	try {
+		const files = await inputs(directory);
+		const disabled = createRouteCache(0);
+		await disabled.begin(files);
+		assert.notEqual(await disabled.read('ground', files.ground), await disabled.read('ground', files.ground));
+		assert.equal((await disabled.memo('ground', 'key', () => 1)).reused, false);
+		assert.equal((await disabled.memo('ground', 'key', () => 2)).value, 2);
+		const cache = createRouteCache();
+		await cache.begin(files);
+		await assert.rejects(
+			cache.memo('refinement', 'key', () => Promise.reject(new Error('failed'))),
+			/failed/,
+		);
+		assert.deepEqual(await cache.memo('refinement', 'key', () => 3), { value: 3, reused: false });
+		await cache.memo('ground', 'old-walls', () => 1);
+		await cache.memo('refinement', 'same-goal', () => 2);
+		await cache.memo('ground', 'new-walls', () => 3);
+		assert.equal((await cache.memo('refinement', 'same-goal', () => 4)).reused, false);
+		await cache.memo('moving', 'first-device-input', () => 5);
+		await cache.memo('refinement', 'same-goal', () => 6);
+		await cache.memo('moving', 'different-device-input-same-face-count', () => 7);
+		assert.deepEqual(await cache.memo('refinement', 'same-goal', () => 8), { value: 8, reused: false });
+	} finally {
+		await rm(directory, { recursive: true, force: true });
+	}
+});
diff --git a/packages/extractor/src/route-cache.ts b/packages/extractor/src/route-cache.ts
new file mode 100644
index 00000000..01326af5
--- /dev/null
+++ b/packages/extractor/src/route-cache.ts
@@ -0,0 +1,110 @@
+import { readFile, stat } from 'node:fs/promises';
+import { resolve } from 'node:path';
+
+type Entry = { key: string; value: unknown };
+type Files = { ground: string; collision: string; movement: string };
+
+const fileIdentity = async (path: string) => {
+	const absolute = resolve(path);
+	const info = await stat(absolute, { bigint: true });
+	return {
+		path: absolute,
+		bytes: Number(info.size),
+		key: JSON.stringify([absolute, info.dev, info.ino, info.size, info.mtimeNs, info.ctimeNs].map(String)),
+	};
+};
+
+/**
+ * @param maxInputBytes maximum serialized bytes retained for one physical input region
+ * @returns a single-region preparation cache; failed work and oversized regions are never retained
+ * @throws for a negative or non-integer input byte limit
+ */
+export const createRouteCache = (maxInputBytes = 512 * 1024 * 1024) => {
+	if (!Number.isSafeInteger(maxInputBytes) || maxInputBytes < 0) {
+		throw new Error('invalid route input cache limit');
+	}
+	let generation = '';
+	let enabled = false;
+	let inputBytes = 0;
+	let expected = new Map<string, string>();
+	const inputs = new Map<string, Entry>();
+	const prepared = new Map<string, Entry>();
+	const clear = () => {
+		generation = '';
+		enabled = false;
+		inputs.clear();
+		prepared.clear();
+		expected.clear();
+	};
+	return {
+		clear,
+		release(slot: 'ground' | 'moving') {
+			prepared.delete(slot);
+		},
+		async begin(files: Files) {
+			const identities = await Promise.all(Object.values(files).map(fileIdentity));
+			const key = JSON.stringify(identities.map((entry) => entry.key));
+			if (key !== generation) {
+				// Release the preceding region before decoding its replacement.
+				clear();
+				generation = key;
+			}
+			inputBytes = identities.reduce((sum, entry) => sum + entry.bytes, 0);
+			enabled = inputBytes <= maxInputBytes;
+			expected = new Map(identities.map((entry) => [entry.path, entry.key]));
+			return key;
+		},
+		async read<T>(slot: 'ground' | 'collision' | 'movement' | 'devices', path: string): Promise<T> {
+			const identity = await fileIdentity(path);
+			if (slot !== 'devices' && expected.get(identity.path) !== identity.key) {
+				clear();
+				throw new Error('route input changed after preparation began');
+			}
+			if (slot === 'devices' && inputBytes + identity.bytes > maxInputBytes) {
+				enabled = false;
+				inputs.clear();
+				prepared.clear();
+			}
+			const existing = inputs.get(slot);
+			if (enabled && existing?.key === identity.key) {
+				return existing.value as T;
+			}
+			const value: unknown = JSON.parse(await readFile(identity.path, 'utf8'));
+			const after = await fileIdentity(identity.path);
+			if (after.key !== identity.key) {
+				clear();
+				throw new Error('route input changed while reading');
+			}
+			if (enabled && identity.bytes <= maxInputBytes) {
+				inputs.set(slot, { key: identity.key, value });
+			}
+			return value as T;
+		},
+		async memo<T>(
+			slot: 'ground' | 'collision' | 'devices' | 'moving' | 'refinement',
+			key: string,
+			create: () => T | Promise<T>,
+		) {
+			const existing = prepared.get(slot);
+			if (enabled && existing?.key === key) {
+				return { value: existing.value as T, reused: true };
+			}
+			prepared.delete(slot);
+			if (slot === 'moving') {
+				prepared.delete('refinement');
+			}
+			if (slot === 'ground') {
+				prepared.delete('refinement');
+				prepared.delete('devices');
+				prepared.delete('moving');
+			}
+			const value = await create();
+			if (enabled) {
+				prepared.set(slot, { key, value });
+			}
+			return { value, reused: false };
+		},
+	};
+};
+
+export type RouteCache = ReturnType<typeof createRouteCache>;
diff --git a/packages/extractor/src/route-worker.ts b/packages/extractor/src/route-worker.ts
new file mode 100644
index 00000000..4ca43fc5
--- /dev/null
+++ b/packages/extractor/src/route-worker.ts
@@ -0,0 +1,50 @@
+import { run } from './commands/player-route.ts';
+import { createRouteCache } from './route-cache.ts';
+
+type Request = { id: string; args: string[] };
+const cache = createRouteCache();
+let running = false;
+const send = (message: object) => {
+	if (process.connected) {
+		process.send?.(message);
+	}
+};
+
+process.on('message', (value: unknown) => {
+	if (!value || typeof value !== 'object' || !('id' in value) || typeof value.id !== 'string' || !value.id) {
+		return;
+	}
+	const id = value.id;
+	if (
+		!('args' in value) ||
+		!Array.isArray(value.args) ||
+		!value.args.every((argument) => typeof argument === 'string')
+	) {
+		send({ type: 'error', id, error: 'invalid route worker request' });
+		return;
+	}
+	if (running) {
+		send({ type: 'error', id, error: 'route worker is already running' });
+		return;
+	}
+	const request: Request = { id, args: value.args };
+	running = true;
+	void run(request.args, {
+		cache,
+		progress: (progress) =>
+			send({ type: 'progress', id, progress: { ...progress, memory: process.memoryUsage() } }),
+	})
+		.then(() => send({ type: 'done', id, memory: process.memoryUsage() }))
+		.catch((error: unknown) => {
+			cache.clear();
+			send({ type: 'error', id, error: error instanceof Error ? error.message : String(error) });
+		})
+		.finally(() => {
+			running = false;
+		});
+});
+process.on('disconnect', () => {
+	cache.clear();
+	process.exit(0);
+});
+send({ type: 'ready', version: 1 });
