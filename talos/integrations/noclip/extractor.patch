+		const duration = values?.get('accelerate_buff');
+		const goal = entry(device);
+		if (typeof duration !== 'number' || !Number.isFinite(duration) || duration <= 0 || !goal) {
+			outcomes.push({ id: device.id, mode: 'accelerate', reason: 'device-model-unresolved' });
+			continue;
+		}
+		boosts.push({ id: device.id, position: goal.position, interaction: goal.interaction,
+			duration, multiplier: 2.2 });
