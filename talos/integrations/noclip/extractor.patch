+import { UnityClass } from '@endfield-noclip/formats/unity/serialized-file';
+
+import type { Context } from '../context.ts';
+
+import type { AssetResolver, ObjectRef } from './assets/assets.ts';
+import { RENDER_PIPELINE_QUAD_PATH } from './assets/builtin-resources.ts';
+
+/**
+ * @param context the install's world index
+ * @param resolver asset resolver
+ * @returns the render pipeline's unit quad, or null if it cannot be resolved
+ */
+export const findParticleQuad = async (
+	context: Pick<Context, 'world'>,
+	resolver: AssetResolver,
+): Promise<ObjectRef | null> => {
+	const [hash] = await context.world.hashesOf(RENDER_PIPELINE_QUAD_PATH);
+	if (hash === undefined) {
+		return null;
+	}
+	try {
+		return await resolver.findUnique({ hash, path: RENDER_PIPELINE_QUAD_PATH }, UnityClass.Mesh);
+	} catch {
+		return null;
+	}
+};
diff --git a/packages/extractor/src/game/photo-effects.ts b/packages/extractor/src/game/photo-effects.ts
new file mode 100644
index 00000000..ab4afc84
--- /dev/null
+++ b/packages/extractor/src/game/photo-effects.ts
@@ -0,0 +1,175 @@
+/* oxlint-disable no-await-in-loop -- bounded prefab traversal and conversion */
+import { UnityClass } from '@endfield-noclip/formats/unity/serialized-file';
+import { arrayField, asPPtr, isObject, pptrField } from '@endfield-noclip/formats/unity/values';
+import { CurveMode, ParticleAlignment, ParticleRenderMode } from '@endfield-noclip/package-format/particles';
+import type { PhotoEffect } from '@endfield-noclip/package-format/photo-filters';
+
+import type { Context } from '../context.ts';
+import { convertTexture } from '../pack/convert/textures.ts';
+
+import { loadTexture } from './assets/asset-decode.ts';
+import type { ObjectRef } from './assets/assets.ts';
+import { RENDER_PIPELINE_QUAD_PATH } from './assets/builtin-resources.ts';
+import { loadMaterial } from './materials/material-load.ts';
+import { readPrefabRenderers } from './prefabs/prefab.ts';
+
+/**
+ * @param context the source install
+ * @param id effect prefab id from the snapshot table
+ * @returns supported additive billboard emitters and explicit unsupported parts
+ * @throws {Error} for missing assets or malformed prefab data
+ */
+export const loadPhotoEffects = async (
+	context: Context,
+	id: string,
+): Promise<{ effects: PhotoEffect[]; unsupported: string[] }> => {
+	const resolver = await context.resolver();
+	const path = `Assets/Beyond/DynamicAssets/Gameplay/Effects/Prefabs/${id}.prefab`;
+	const hashes = await context.world.hashesOf(path);
+	if (hashes.length !== 1) {
+		throw new Error(`${id}: expected one effect prefab hash`);
+	}
+	const root = await resolver.findUnique({ hash: hashes[0], path }, UnityClass.GameObject);
+	const [quadHash] = await context.world.hashesOf(RENDER_PIPELINE_QUAD_PATH);
+	if (quadHash === undefined) {
+		throw new Error(`${id}: missing particle quad`);
+	}
+	const quad = await resolver.findUnique(
+		{ hash: quadHash, path: RENDER_PIPELINE_QUAD_PATH },
+		UnityClass.Mesh,
+	);
+	const effects: PhotoEffect[] = [];
+	const unsupported: string[] = [];
+	for (const draw of await readPrefabRenderers(resolver, root, {
+		viewPose: null,
+		particleQuad: quad,
+		decalCube: null,
+		locked: false,
+		effectLod: 'camera',
+	})) {
+		const particles = draw.particles;
+		if (
+			particles === null ||
+			particles.renderMode !== ParticleRenderMode.Billboard ||
+			particles.alignment !== ParticleAlignment.View ||
+			particles.motion.kind !== 'free' ||
+			particles.motion.gravityModifier.mode !== CurveMode.Constant ||
+			particles.motion.gravityModifier.scalar !== 0 ||
+			particles.motion.velocity !== null ||
+			particles.motion.clamp !== null ||
+			particles.motion.forces !== null ||
+			particles.customData !== null ||
+			particles.ringBuffer !== null ||
+			particles.bursts.length !== 0 ||
+			particles.pivot.some((v) => v !== 0) ||
+			particles.startRotation.slice(0, 2).some((v) => v.mode !== CurveMode.Constant || v.scalar !== 0) ||
+			(particles.rotationOverLifetime !== null &&
+				particles.rotationOverLifetime
+					.slice(0, 2)
+					.some((v) => v.mode !== CurveMode.Constant || v.scalar !== 0)) ||
+			draw.materials.length !== 1 ||
+			draw.materials[0] === null
+		) {
+			unsupported.push(`${draw.name}: unsupported camera emitter`);
+			continue;
+		}
+		const material = await loadMaterial(resolver, draw.materials[0]);
+		const { record, shader, textures } = material;
+		const main = textures['_MainTex']?.ref;
+		if (
+			shader.name !== 'HGRP/Effect/VFXBaseV2' ||
+			record.keywords.length !== 0 ||
+			!main ||
+			record.floats['_BlendMode'] !== 1 ||
+			record.floats['_UseMainTexAsAlpha'] !== 0 ||
+			record.floats['_UseFresnel'] !== 0 ||
+			record.floats['_ExpIntensity'] !== 0 ||
+			Object.entries(textures).some(([key, slot]) => key !== '_MainTex' && slot.ref !== null)
+		) {
+			unsupported.push(`${draw.name}: unsupported camera material`);
+			continue;
+		}
+		const slot = record.textures['_MainTex'];
+		if (slot.scale.some((v) => v !== 1) || slot.offset.some((v) => v !== 0)) {
+			unsupported.push(`${draw.name}: particle texture transform`);
+			continue;
+		}
+		const texture = await loadTexture(resolver, main);
+		const converted = convertTexture(texture).entry;
+		if (
+			texture.kind !== '2d' ||
+			(converted.format !== 'bc7-rgba-unorm' && converted.format !== 'bc7-rgba-unorm-srgb')
+		) {
+			unsupported.push(`${draw.name}: unsupported particle texture`);
+			continue;
+		}
+		if (converted.sampler.mipBias !== 0) {
+			unsupported.push(`${draw.name}: particle mip bias`);
+			continue;
+		}
+		const tint = record.colors['_TintColor'] ?? [1, 1, 1, 1];
+		const intensity = record.floats['_TintColorIntensity'] ?? 1;
+		effects.push({
+			name: draw.name,
+			matrix: Array.from(draw.matrix),
+			particles,
+			tint: [
+				tint[0] * intensity,
+				tint[1] * intensity,
+				tint[2] * intensity,
+				tint[3] * (record.floats['_TintColorAlpha'] ?? 1),
+			],
+			ignorePostExposure: record.floats['_IgnorePostExposure'] !== 0,
+			texture: {
+				width: texture.width,
+				height: texture.height,
+				format: converted.format,
+				sampler: converted.sampler,
+				levels: texture.levels.map((level) => Buffer.from(level).toString('base64')),
+			},
+		});
+	}
+	// the shared closed-form particle evaluator deliberately ignores Unity's noise module.
+	const visit = async (go: ObjectRef, depth: number): Promise<void> => {
+		if (depth > 64) {
+			throw new Error('effect hierarchy deeper than 64');
+		}
+		const data = await resolver.read(go);
+		if (!data.m_IsActive) {
+			return;
+		}
+		for (const item of arrayField(data, 'm_Component')) {
+			if (!isObject(item)) {
+				continue;
+			}
+			const ref = await resolver.resolve(go, pptrField(item, 'component'));
+			if (!ref) {
+				continue;
+			}
+			const raw = await resolver.read(ref);
+			if (
+				ref.info.classId === UnityClass.ParticleSystem &&
+				isObject(raw.NoiseModule) &&
+				raw.NoiseModule.enabled
+			) {
+				unsupported.push('particle noise');
+			}
+			if (ref.info.classId === UnityClass.Transform) {
+				for (const pointer of arrayField(raw, 'm_Children')) {
+					const childTransform = await resolver.resolve(ref, asPPtr(pointer));
+					if (childTransform) {
+						const child = await resolver.resolve(
+							childTransform,
+							pptrField(await resolver.read(childTransform), 'm_GameObject'),
+						);
+						if (child) {
+							await visit(child, depth + 1);
+						}
+					}
+				}
+			}
+		}
+	};
+	await visit(root, 0);
+	return { effects, unsupported };
+};
diff --git a/packages/extractor/src/game/raft-transports.test.ts b/packages/extractor/src/game/raft-transports.test.ts
new file mode 100644
index 00000000..61ff979b
--- /dev/null
+++ b/packages/extractor/src/game/raft-transports.test.ts
@@ -0,0 +1,72 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+import type { LevelInteractive } from '@endfield-noclip/formats/endfield/level-interactives';
+import type { LevelSpline } from '@endfield-noclip/formats/endfield/level-splines';
+import type { MemoryPackValue } from '@endfield-noclip/formats/endfield/memory-pack';
+
+import { raftTransports } from './raft-transports.ts';
+
+const bits = (value: number) => {
+    const view = new DataView(new ArrayBuffer(4)); view.setFloat32(0, value, true); return BigInt(view.getUint32(0, true));
+};
+const parameter = (key: string, type: number, value: bigint) => ({ key, type, values: [{ bits: value, text: null }] });
+const rawParameter = (key: string, type: number, value: bigint) => ({ key, value: { type, valueArray: [{ valueBit64: String(value), valueString: null }] } });
+const row = (id: bigint, template: string, position: [number, number, number], componentProperties: LevelInteractive['componentProperties'] = new Map()): LevelInteractive => ({
+    id, template, position, rotation: [0, 0, 0], scale: [1, 1, 1], modelScale: 0, createState: 0,
+    properties: [], componentProperties, isLocked: false,
+});
+const raftTemplate: MemoryPackValue = { componentList: [
+    { $type: 'Beyond_Gameplay_InteractiveBambooRaftComponentDataForMemoryPack' },
+    { $type: 'Beyond_Gameplay_CurveMoveComponentDataForMemoryPack', propertyList: [
+        rawParameter('spline_id', 3, 8n), rawParameter('speed', 5, bits(2)),
+        rawParameter('tween', 3, 1n), rawParameter('distance', 5, bits(8)),
+    ] },
+] };
+const dockTemplate: MemoryPackValue = { componentList: [{
+    $type: 'Beyond_Gameplay_InteractiveBambooRaftDockComponentDataForMemoryPack',
+    propertyList: [rawParameter('node_index', 3, 0n)],
+}] };
+const spline: LevelSpline = { id: 8, position: [100, 20, 200], rotation: [0, 90, 0], closed: false,
+    knots: [[0, 0, 0], [100, 0, 0]].map(position => ({ position: position as [number, number, number],
+        tangentIn: [0, 0, 0], tangentOut: [0, 0, 0], rotation: [0, 0, 0, 1] })) };
+const placement = (placed: LevelInteractive, template: MemoryPackValue) => ({ row: placed, template, source: 'level.json' });
+const boat = placement(row(1n, 'int_bamboo_raft_v2', [100, 20, 200], new Map([[88, [parameter('speed', 5, bits(10))]]])), raftTemplate);
+const first = placement(row(2n, 'int_bamboo_raft_dock', [103, 21, 200]), dockTemplate);
+const last = placement(row(3n, 'int_bamboo_raft_dock', [103, 21, 100], new Map([[120, [parameter('node_index', 3, 1n)]]])), dockTemplate);
+
+describe('authored raft transport export', () => {
+    it('uses placement speed, world spline transform and distinct shore/ride positions', () => {
+        const { transports, unsupported } = raftTransports([boat, first, last], new Map([[8, spline]]), 'map02_lv007');
+        assert.deepEqual(unsupported, []);
+        assert.equal(transports.length, 1);
+        const raft = transports[0];
+        assert.equal(raft.movement.speed, 10);
+        assert.equal(raft.movement.rampDistance, 8);
+        assert.deepEqual(raft.docks.map(dock => dock.id), ['2', '3']);
+        assert.deepEqual(raft.docks[0].position, [103, 21, 200]);
+        assert.deepEqual(raft.docks[0].ridePosition, [100, 20, 200]);
+        assert.ok(Math.abs(raft.docks[1].ridePosition[0] - 100) < 1e-6);
+        assert.ok(Math.abs(raft.docks[1].ridePosition[2] - 100) < 1e-6);
+        assert.equal(raft.legs.length, 2);
+        assert.deepEqual(raft.legs[1].curves[0][0], raft.legs[0].curves[0][3]);
+        assert.deepEqual(raft.legs[1].curves[0][3], raft.legs[0].curves[0][0]);
+        assert.ok(raft.unpricedCosts.includes('wait'));
+    });
+
+    it('does not turn an ambiguous or distant dock into a usable transfer', () => {
+        const secondBoat = placement(row(4n, 'int_bamboo_raft_v2', [100, 20, 200]), raftTemplate);
+        const ambiguous = raftTransports([boat, secondBoat, first, last], new Map([[8, spline]]), 'map02_lv007');
+        assert.ok(ambiguous.transports.every(raft => raft.docks.length === 0 && raft.legs.length === 0));
+        assert.ok(ambiguous.unsupported.some(row => row.id === '2' && row.reason.includes('several')));
+        const distant = placement(row(5n, 'int_bamboo_raft_dock', [1000, 20, 200]), dockTemplate);
+        const result = raftTransports([boat, first, distant], new Map([[8, spline]]), 'map02_lv007');
+        assert.deepEqual(result.transports[0].legs, []);
+        assert.ok(result.unsupported.some(row => row.id === '5' && row.reason.includes('no nearby')));
+    });
+
+    it('retains an explicit unresolved record when a referenced spline is absent', () => {
+        const result = raftTransports([boat], new Map(), 'map02_lv007');
+        assert.deepEqual(result.transports, []);
+        assert.deepEqual(result.unsupported, [{ id: '1', template: 'int_bamboo_raft_v2', reason: 'raft spline 8 unavailable' }]);
+    });
+});
diff --git a/packages/extractor/src/game/raft-transports.ts b/packages/extractor/src/game/raft-transports.ts
new file mode 100644
index 00000000..493fbc23
--- /dev/null
+++ b/packages/extractor/src/game/raft-transports.ts
@@ -0,0 +1,143 @@
+/* oxlint-disable no-await-in-loop -- offline export reads each template and level once */
+import { readInteractiveTable } from '@endfield-noclip/formats/endfield/interactive-model';
+import { levelInteractiveFromValue, type InteractiveParam, type LevelInteractive } from '@endfield-noclip/formats/endfield/level-interactives';
+import { readLevelSplines, splineCurves, type BezierCurve, type LevelSpline } from '@endfield-noclip/formats/endfield/level-splines';
+import { isMemoryPackObject, type MemoryPackValue } from '@endfield-noclip/formats/endfield/memory-pack';
+
+import type { Context } from '../context.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+import { componentOf, componentParams } from './interactives/component-params.ts';
+
+type Vec3 = [number, number, number];
+type Placement = { row: LevelInteractive; template: MemoryPackValue; source: string };
+type Unsupported = { id: string; template: string; reason: string };
+const RAFT = '_InteractiveBambooRaftComponentDataForMemoryPack';
+const DOCK = '_InteractiveBambooRaftDockComponentDataForMemoryPack';
+const CURVE = { suffix: '_CurveMoveComponentDataForMemoryPack', diffKey: 'Comp_CurveMove', type: 88 };
+const DOCK_KEYS = { suffix: DOCK, diffKey: 'Comp_InteractiveBambooRaftDock', type: 120 };
+
+const integer = (params: Map<string, InteractiveParam>, key: string) => Number(BigInt.asIntN(32, params.get(key)?.values[0]?.bits ?? 0n));
+const float = (params: Map<string, InteractiveParam>, key: string) => {
+    const view = new DataView(new ArrayBuffer(4));
+    view.setUint32(0, Number(BigInt.asUintN(32, params.get(key)?.values[0]?.bits ?? 0n)), true);
+    return view.getFloat32(0, true);
+};
+const point = (value: readonly number[]): Vec3 => [value[0], value[1], value[2]];
+const distance = (a: readonly number[], b: readonly number[]) => Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);
+const reversed = (curve: BezierCurve): BezierCurve => [point(curve[3]), point(curve[2]), point(curve[1]), point(curve[0])];
+
+/** A dock placement is a shore interaction point, not the boat root or a proved
+ * walking connector. This guard rejects distant or ambiguous catalogue matches;
+ * it does not represent an activation radius or authorize boarding through air. */
+const DOCK_NODE_NEIGHBOURHOOD = 32;
+
+/** Export authored spline transfers without constructing water support. The
+ * independent shore and ride positions remain available to later access checks. */
+export const raftTransports = (placements: Placement[], splines: ReadonlyMap<number, LevelSpline>, level: string) => {
+    const unsupported: Unsupported[] = [];
+    const transports: {
+        id: string; kind: 'raft'; level: string; template: string; source: string; position: Vec3;
+        splineId: number; closed: boolean; curves: BezierCurve[]; nodes: Vec3[];
+        movement: { speed: number; tween: number; rampDistance: number | null; followsTangent: boolean; reverse: boolean; speedCurve: string | null };
+        docks: { id: string; nodeIndex: number; position: Vec3; ridePosition: Vec3; separation: number }[];
+        legs: { from: string; to: string; direction: 'forward' | 'reverse'; curves: BezierCurve[] }[];
+        snapshot: 'completed-game'; unpricedCosts: string[];
+    }[] = [];
+    const fail = (row: LevelInteractive, reason: string) => unsupported.push({ id: String(row.id), template: row.template, reason });
+    for (const { row, template, source } of placements) {
+        if (!componentOf(template, RAFT)) continue;
+        try {
+            const params = componentParams(template, row, CURVE);
+            if (!params) throw new Error('raft curve component unavailable');
+            const splineId = integer(params, 'spline_id');
+            const spline = splines.get(splineId);
+            if (!spline || spline.knots.length < 2) throw new Error(`raft spline ${splineId} unavailable`);
+            const curves = splineCurves(spline, spline.closed);
+            const nodes = curves.map(curve => point(curve[0]));
+            if (!spline.closed) nodes.push(point(curves.at(-1)![3]));
+            if (curves.flat(2).some(value => !Number.isFinite(value))) throw new Error('nonfinite raft spline');
+            const speed = float(params, 'speed');
+            if (!Number.isFinite(speed) || speed <= 0) throw new Error('raft speed must be finite and positive');
+            const tween = integer(params, 'tween');
+            const rampDistance = tween === 1 ? float(params, 'distance') : null;
+            if (rampDistance !== null && (!Number.isFinite(rampDistance) || rampDistance < 0)) throw new Error('invalid raft ramp distance');
+            transports.push({ id: String(row.id), kind: 'raft', level, template: row.template, source,
+                position: point(row.position), splineId, closed: spline.closed, curves, nodes,
+                movement: { speed, tween, rampDistance, followsTangent: integer(params, 'curve_move_direction') === 1,
+                    reverse: integer(params, 'curve_is_reverse') !== 0,
+                    speedCurve: integer(params, 'use_curve_control_speed') !== 0 ? params.get('speed_variation_curve_key')?.values[0]?.text ?? '' : null },
+                docks: [], legs: [], snapshot: 'completed-game', unpricedCosts: ['call', 'wait', 'board', 'alight'] });
+        } catch (error) {
+            fail(row, error instanceof Error ? error.message : String(error));
+        }
+    }
+    for (const { row, template } of placements) {
+        if (!componentOf(template, DOCK)) continue;
+        const params = componentParams(template, row, DOCK_KEYS);
+        if (!params) { fail(row, 'dock component unavailable'); continue; }
+        const nodeIndex = integer(params, 'node_index');
+        const matches = transports.filter(raft => nodeIndex >= 0 && nodeIndex < raft.nodes.length &&
+            distance(raft.nodes[nodeIndex], row.position) <= DOCK_NODE_NEIGHBOURHOOD);
+        if (matches.length !== 1) {
+            fail(row, matches.length ? 'dock matches several raft spline nodes' : 'dock has no nearby authored spline node');
+            continue;
+        }
+        const raft = matches[0], ridePosition = raft.nodes[nodeIndex];
+        if (raft.docks.some(dock => dock.nodeIndex === nodeIndex)) { fail(row, 'several docks name the same raft node'); continue; }
+        raft.docks.push({ id: String(row.id), nodeIndex, position: point(row.position), ridePosition,
+            separation: distance(ridePosition, row.position) });
+    }
+    for (const raft of transports) {
+        raft.docks.sort((a, b) => a.nodeIndex - b.nodeIndex);
+        for (const from of raft.docks) for (const to of raft.docks) {
+            if (from === to) continue;
+            const low = Math.min(from.nodeIndex, to.nodeIndex), high = Math.max(from.nodeIndex, to.nodeIndex);
+            const forward = from.nodeIndex < to.nodeIndex;
+            const curves = raft.curves.slice(low, high);
+            raft.legs.push({ from: from.id, to: to.id, direction: forward ? 'forward' : 'reverse',
+                curves: forward ? curves : curves.toReversed().map(reversed) });
+        }
+        if (raft.docks.length < 2) unsupported.push({ id: raft.id, template: raft.template, reason: 'raft has fewer than two unambiguous docks' });
+    }
+    return { transports, unsupported };
+};
+
+/** Read both template defaults and placement overrides from the installation. */
+export const collectRaftTransports = async (ctx: Context, scene: string) => {
+    const pool = await ctx.world.stringPool(), reader = await ctx.memoryPack(), paths = await ctx.world.pathLookup();
+    const read = async (path: string) => {
+        const file = await ctx.vfs.find(VfsGroup.JsonData, path);
+        if (!file) throw new Error(`missing raft input ${path}`);
+        return file.readVerified();
+    };
+    const table = readInteractiveTable(await read('Data/Json/Interactive/InteractiveTable.json'), id => pool.get(id));
+    const templates = new Map<string, MemoryPackValue>();
+    const transports: ReturnType<typeof raftTransports>['transports'] = [];
+    const unsupported: Unsupported[] = [];
+    for (const level of (await ctx.world.levelConfigs()).values()) {
+        if (level.mapId !== scene) continue;
+        const placements: Placement[] = [], splines = new Map<number, LevelSpline>(), seen = new Set<string>();
+        for (const hash of level.levelDataPathHashes ?? []) {
+            const source = paths(hash);
+            if (!source) throw new Error('missing raft level path');
+            const data = reader.decode(await read(source), 'Beyond_Gameplay_LevelDataForMemoryPack');
+            if (!isMemoryPackObject(data) || !Array.isArray(data.interactives)) throw new Error('invalid raft level data');
+            for (const spline of readLevelSplines(data)) splines.set(spline.id, spline);
+            for (const raw of data.interactives) {
+                if (!isMemoryPackObject(raw) || typeof raw.entityDataIdKey !== 'string' || !/raft/.test(raw.entityDataIdKey)) continue;
+                if (typeof raw.levelLogicId !== 'string' || !/^[1-9]\d*$/.test(raw.levelLogicId)) throw new Error('invalid raft identity');
+                const row = levelInteractiveFromValue(raw, BigInt(raw.levelLogicId));
+                if (seen.has(String(row.id))) continue;
+                seen.add(String(row.id));
+                const templateId = table.templates.get(row.template), templatePath = templateId === undefined ? undefined : table.templatePaths.get(templateId);
+                if (!templatePath) { unsupported.push({ id: String(row.id), template: row.template, reason: 'raft template unavailable' }); continue; }
+                let template = templates.get(templatePath);
+                if (!template) { template = reader.decode(await read(templatePath), 'Beyond_Gameplay_InteractiveTemplateDataForMemoryPack'); templates.set(templatePath, template); }
+                placements.push({ row, template, source });
+            }
+        }
+        const result = raftTransports(placements, splines, level.id);
+        transports.push(...result.transports); unsupported.push(...result.unsupported);
+    }
+    return { transports, unsupported };
+};
diff --git a/packages/extractor/src/game/round-exclusions.test.ts b/packages/extractor/src/game/round-exclusions.test.ts
