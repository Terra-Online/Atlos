+		candidates = groundPlanner!.project(goal, { maxVertical: 0.5, interaction: request.interaction });
+		if (!candidates.length && !request.interaction?.airborne && !followingTarget) {
+			await emit({ status: 'unavailable', reason: 'target-region-unmapped' });
+			return;
+		}
+	}
+	progress({ phase: 'jump-discovery', goalFaces: candidates.length });
+	const searchStart = performance.now();
+	const result = planJumpRoute(surfaces, world, [arrival], goal, {
+		...options,
+		boosts,
+		groundPlanner,
+		interaction: request.interaction,
+		runAirSpeed,
+		maxSlope,
+		maxDrop,
+		maxHorizontalDistance,
+		...limits,
+		maxShortcutCandidates: 512,
+		waypoints: request.waypoints,
+		onProgress: progress,
+		model,
+	});
+	timing.search = performance.now() - searchStart;
+	Object.assign(diagnostics, result.diagnostics);
+	let { route, connections } = result;
+	if (knownRoute.status === 'complete' && (route.status !== 'complete' || knownRoute.cost < route.cost)) {
+		route = knownRoute;
+		connections = knownConnections;
+	}
+	progress({ phase: 'route-search', connections: connections.length });
+	if (route.status === 'complete') {
+		await emit({ status: 'candidate', route, connections, groundedTarget: route.points.at(-1) });
+	} else {
+		const following = await followingFallback();
+		if (following) {
+			await emit({
+				status: 'candidate',
+				route: following.route,
+				connections: following.connections,
+				supportBoxes: following.supportBoxes,
+				groundedTarget: following.route.status === 'complete' ? following.route.points.at(-1) : undefined,
+			});
+		} else {
+			await emit({ status: 'unavailable', reason: route.status, connections });
+		}
+	}
+};
diff --git a/packages/extractor/src/commands/travel-points.ts b/packages/extractor/src/commands/travel-points.ts
new file mode 100644
index 00000000..9308bd7f
--- /dev/null
+++ b/packages/extractor/src/commands/travel-points.ts
@@ -0,0 +1,167 @@
+/* oxlint-disable no-await-in-loop -- decode and release each factory level in turn */
+import { writeFile } from 'node:fs/promises';
+import { parseArgs } from 'node:util';
+
+import { isObject } from '@endfield-noclip/formats/unity/values';
+
+import { withContext } from '../context.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+export const summary = 'export map teleport landing positions; availability remains a player-state input';
+export const usage = 'usage: endfield-extract travel-points -o <file> --config <config>';
+
+/** @param args output and install config @returns after exporting authored camp landing positions */
+export const run = async (args: string[]): Promise<void> => {
+	const { values } = parseArgs({
+		args,
+		options: { output: { type: 'string', short: 'o' }, config: { type: 'string' } },
+	});
+	if (!values.output) {
+		throw new Error(usage);
+	}
+	await withContext(values.config, async (ctx) => {
+		const file = await ctx.vfs.find(
+			VfsGroup.JsonData,
+			'Data/Json/GameplayConfig/MapTeleportValidationDataTable.json',
+		);
+		if (!file) {
+			throw new Error('missing map teleport data');
+		}
+		const reader = await ctx.memoryPack();
+		const data = reader.decode(
+			await ctx.vfs.readVerified(file),
+			'Beyond_Gameplay_TeleportValidationDataTableForMemoryPack',
+		);
+		if (!isObject(data) || !Array.isArray(data.teleportValidationDatas)) {
+			throw new Error('invalid teleport table');
+		}
+		const levels = await ctx.world.levelConfigs();
+		const points = [],
+			unmapped = [];
+		for (const entry of data.teleportValidationDatas) {
+			if (!Array.isArray(entry) || entry.length !== 2 || !isObject(entry[1])) {
+				throw new Error('invalid teleport entry');
+			}
+			const row = entry[1];
+			if (row.teleportReason !== 2 || typeof row.id !== 'string' || !row.id.startsWith('TpForMap_ent_')) {
+				continue;
+			}
+			const position: unknown = row.position;
+			if (
+				typeof row.sceneId !== 'string' ||
+				!Array.isArray(position) ||
+				position.length !== 3 ||
+				!position.every((v: unknown) => typeof v === 'number' && Number.isFinite(v))
+			) {
+				throw new Error('invalid teleport position');
+			}
+			const level = levels.get(row.sceneId);
+			if (!level) {
+				unmapped.push({ id: row.id, level: row.sceneId });
+				continue;
+			}
+			points.push({
+				id: row.id,
+				kind: 'teleport',
+				level: level.id,
+				scene: level.mapId,
+				position,
+				availability: 'unknown',
+			});
+		}
+		const paths = await ctx.world.pathLookup();
+		const baseIds = new Set<string>();
+		for (const level of levels.values()) {
+			if (!level.mapId || !['map01', 'map02'].includes(level.mapId)) {
+				continue;
+			}
+			for (const hash of level.levelDataPathHashes ?? []) {
+				const path = paths(hash);
+				if (!path) {
+					throw new Error('missing factory level path');
+				}
+				const levelFile = await ctx.vfs.find(VfsGroup.JsonData, path);
+				if (!levelFile) {
+					throw new Error(`missing ${path}`);
+				}
+				const levelData = reader.decode(
+					await ctx.vfs.readVerified(levelFile),
+					'Beyond_Gameplay_LevelDataForMemoryPack',
+				);
+				if (!isObject(levelData) || !Array.isArray(levelData.factoryRegions)) {
+					throw new Error('invalid factory regions');
+				}
+				for (const region of levelData.factoryRegions) {
+					if (!isObject(region) || !Array.isArray(region.areas)) {
+						throw new Error('invalid factory region');
+					}
+					for (const area of region.areas) {
+						if (!isObject(area) || typeof area.isMain !== 'boolean') {
+							continue;
+						}
+						const stageData: unknown = area.levelData;
+						if (
+							!Array.isArray(stageData) ||
+							typeof region.regionId !== 'string' ||
+							typeof area.index !== 'number' ||
+							!Number.isInteger(area.index)
+						) {
+							throw new Error('invalid base area');
+						}
+						const stages = stageData.filter(isObject).toSorted((a, b) => Number(a.level) - Number(b.level));
+						const stage = stages.at(-1);
+						if (
+							!stage ||
+							!Array.isArray(stage.levelBounds) ||
+							stage.levelBounds.length !== 1 ||
+							!isObject(stage.levelBounds[0])
+						) {
+							throw new Error('unsupported multi-bound base centre');
+						}
+						const bounds = stage.levelBounds[0];
+						const start: unknown = bounds.start,
+							size: unknown = bounds.size;
+						if (
+							!Array.isArray(start) ||
+							!Array.isArray(size) ||
+							start.length !== 3 ||
+							size.length !== 3 ||
+							![...start, ...size].every((v: unknown) => typeof v === 'number' && Number.isFinite(v)) ||
+							size.some((v: number) => v <= 0)
+						) {
+							throw new Error('invalid base bounds');
+						}
+						const id = `${region.regionId}:${String(area.index)}`;
+						if (baseIds.has(id)) {
+							throw new Error('duplicate base');
+						}
+						baseIds.add(id);
+						points.push({
+							id,
+							kind: 'base',
+							level: level.id,
+							scene: level.mapId,
+							position: start.map((v: number, i: number) => v + Number(size[i]) / 2),
+							availability: 'unknown',
+							approximate: true,
+							requiresGroundProjection: true,
+							groundRange: [Number(start[1]), Number(start[1]) + Number(size[1])],
+							areaLevel: Number(stage.level),
+						});
+					}
+				}
+			}
+		}
+		const build = await ctx.world.manifest();
+		await writeFile(
+			values.output!,
+			JSON.stringify({
+				version: 1,
+				source: { buildGuid: build.guid, contentHash: build.contentHash },
+				points,
+				unmapped,
+			}),
+		);
+		console.log(JSON.stringify({ points: points.length, bases: baseIds.size, unmapped: unmapped.length }));
+	});
+};
diff --git a/packages/extractor/src/commands/traversal-devices.ts b/packages/extractor/src/commands/traversal-devices.ts
new file mode 100644
index 00000000..1f108779
--- /dev/null
+++ b/packages/extractor/src/commands/traversal-devices.ts
@@ -0,0 +1,155 @@
+/* oxlint-disable no-await-in-loop -- decode and release level files, caching each small template once */
+import { writeFile } from 'node:fs/promises';
+import { parseArgs } from 'node:util';
+
+import { readInteractiveTable } from '@endfield-noclip/formats/endfield/interactive-model';
+import { isObject } from '@endfield-noclip/formats/unity/values';
+
+import { withContext } from '../context.ts';
+import { collectMovingSupports } from '../game/moving-supports.ts';
+import { ropePairs, traversalDevice } from '../game/traversal-devices.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+export const summary = 'export rope references, movement-device parameters and conveyor authoring';
+export const usage = 'usage: endfield-extract traversal-devices <scene> -o <file> --config <config>';
+
+/** @param args scene, output and install config @returns after exporting build-bound device inputs */
+export const run = async (args: string[]): Promise<void> => {
+	const { values, positionals } = parseArgs({
+		args,
+		allowPositionals: true,
+		options: { output: { type: 'string', short: 'o' }, config: { type: 'string' } },
+	});
+	if (positionals.length !== 1 || !values.output) {
+		throw new Error(usage);
+	}
+	const scene = positionals[0];
+	await withContext(values.config, async (ctx) => {
+		const read = async (path: string) => {
+			const file = await ctx.vfs.find(VfsGroup.JsonData, path);
+			if (!file) {
+				throw new Error(`missing ${path}`);
+			}
+			return ctx.vfs.readVerified(file);
+		};
+		const pool = await ctx.world.stringPool(),
+			reader = await ctx.memoryPack();
+		const table = readInteractiveTable(await read('Data/Json/Interactive/InteractiveTable.json'), (id) =>
+			pool.get(id),
+		);
+		const paths = await ctx.world.pathLookup();
+		const levels = [...(await ctx.world.levelConfigs()).values()].filter((level) => level.mapId === scene);
+		if (levels.length === 0) {
+			throw new Error(`unknown scene ${scene}`);
+		}
+		const devices = [],
+			templates = new Map<string, unknown>();
+		let files = 0,
+			autoSpawnedReferences = 0;
+		for (const level of levels) {
+			for (const hash of level.levelDataPathHashes ?? []) {
+				const path = paths(hash);
+				if (!path) {
+					throw new Error('missing level path');
+				}
+				const data = reader.decode(await read(path), 'Beyond_Gameplay_LevelDataForMemoryPack');
+				if (
+					!isObject(data) ||
+					!Array.isArray(data.interactives) ||
+					!Array.isArray(data.autoSpawnedInteractives)
+				) {
+					throw new Error('invalid level interactives');
+				}
+				files++;
+				autoSpawnedReferences += data.autoSpawnedInteractives.length;
+				const spawned = new Set<string>();
+				for (const id of data.autoSpawnedInteractives) {
+					if (typeof id !== 'string' || !/^[1-9]\d*$/.test(id)) {
+						throw new Error('invalid automatic spawn reference');
+					}
+					spawned.add(id);
+				}
+				for (const row of data.interactives) {
+					const device = traversalDevice(row, level.id);
+					if (!device) {
+						continue;
+					}
+					devices.push({ ...device, source: path, autoSpawned: spawned.has(device.id) });
+					if (!templates.has(device.template)) {
+						const templateId = table.templates.get(device.template);
+						const templatePath = templateId === undefined ? undefined : table.templatePaths.get(templateId);
+						if (!templatePath) {
+							throw new Error(`missing device template ${device.template}`);
+						}
+						const template = reader.decode(
+							await read(templatePath),
+							'Beyond_Gameplay_InteractiveTemplateDataForMemoryPack',
+						);
+						if (!isObject(template) || !Array.isArray(template.componentList)) {
+							throw new Error('invalid device template');
+						}
+						const components = [];
+						for (const component of template.componentList) {
+							if (isObject(component) && Array.isArray(component.propertyList)) {
+								components.push({ type: component.$type, properties: component.propertyList });
+							}
+						}
+						templates.set(device.template, {
+							source: templatePath,
+							config: template.configProperties,
+							saved: template.saveProperties,
+							temporary: template.tempProperties,
+							variants: template.templateVariant,
+							components,
+						});
+					}
+				}
+			}
+		}
+		const ropes = ropePairs(devices),
+			build = await ctx.world.manifest();
+		const conveyors = (await ctx.world.dynamicEntities(scene)).flatMap((entity) => {
+			const conveyor = entity.conveyor;
+			if (!conveyor) {
+				return [];
+			}
+			return [
+				{
+					id: entity.uid?.toString() ?? null,
+					grid: entity.grid,
+					...conveyor,
+					...(conveyor.kind === 'group' ? {} : { group: conveyor.group.toString() }),
+					resources: entity.resourceGroups,
+					gates: entity.gates,
+					motionValidation: 'unresolved',
+				},
+			];
+		});
+		const moving = await collectMovingSupports(ctx, scene);
+		await writeFile(
+			values.output!,
+			JSON.stringify({
+				version: 1,
+				scene,
+				source: { buildGuid: build.guid, contentHash: build.contentHash },
+				coverage: {
+					levels: levels.length,
+					files,
+					autoSpawnedReferences,
+					scope: 'authored-interactives',
+					conveyorRecords: conveyors.length,
+				},
+				devices,
+				conveyors,
+				movingSupports: moving.supports,
+				followingSupports: moving.following,
+				unsupportedMovingSupports: moving.unsupported,
+				templates: Object.fromEntries(templates),
+				ropes,
+			}),
+		);
+		console.log(
+			`${devices.length} devices, ${ropes.pairs.length} reciprocal rope pairs, ${ropes.unpaired.length} unpaired rope endpoints, ${conveyors.length} conveyor records, ${moving.supports.length} moving supports`,
+		);
+	});
+};
diff --git a/packages/extractor/src/commands/walk-routes.ts b/packages/extractor/src/commands/walk-routes.ts
new file mode 100644
index 00000000..57d5acf6
