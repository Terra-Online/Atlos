@@ -0,0 +1,310 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import type { GroundArrival, JumpRouteOptions, Surface, Vec3 } from '@opendfieldmap/ganglia';
+import { createCollisionWorld } from '@opendfieldmap/ganglia/collision';
+
+import { planFollowingRoute } from './following-route.ts';
+import type { FollowingSupport } from './following-supports.ts';
+
+const floor = (id: string, x0: number, x1: number, y: number, z0 = -6, z1 = 6): Surface => ({
+	id,
+	vertices: [
+		[x0, y, z0],
+		[x0, y, z1],
+		[x1, y, z1],
+		[x1, y, z0],
+	],
+});
+const geometry = (surfaces: Surface[]) => ({
+	positions: surfaces.flatMap((surface) => surface.vertices).flat(),
+	indices: surfaces.flatMap((_, i) => [i * 4, i * 4 + 1, i * 4 + 2, i * 4, i * 4 + 2, i * 4 + 3]),
+});
+const cuboid = (x: number, y: number, z: number): Vec3[] =>
+	Array.from({ length: 8 }, (_, bits): Vec3 => [
+		x + (bits & 1 ? 0.8 : -0.8),
+		y + (bits & 2 ? 1.2 : 0),
+		z + (bits & 4 ? 0.8 : -0.8),
+	]);
+const support = (): FollowingSupport => ({
+	id: 'box',
+	level: 'level',
+	model: 'fixture',
+	geometryKind: 'box',
+	initialState: 0,
+	assumption: 'placement-within-activity-range',
+	spawn: [0, 0, 0],
+	bodies: [cuboid(0, 0, 0)],
+	maxDistance: 65,
+});
+const build = {
+	profile: { radius: 0.2, height: 1.4 },
+	maxSlope: 45,
+	stepUp: 0.3,
+	stepDown: 0.5,
+	cellSize: 0.1,
+	cellHeight: 0.05,
+	bounds: { min: [-8, -6] as [number, number], max: [18, 6] as [number, number] },
+};
+const jump: JumpRouteOptions = {
+	profile: build.profile,
+	speed: 3,
+	maxVertical: 0.5,
+	walls: [],
+	locomotion: { speed: 3, sprintSpeed: 6, sprintAcceleration: 3 },
+	model: {
+		gravity: 10,
+		fallingGravity: 10,
+		maxJumpHeight: 1.5,
+		maxFallingSpeed: 15,
+		apexTime: 0,
+		maxHorizontalSpeed: 4,
+		airAcceleration: 60,
+		airDeceleration: 10,
+	},
+	runAirSpeed: 4,
+	maxSlope: 45,
+	maxDrop: 5,
+	maxHorizontalDistance: 6,
+	sampleSpacing: 0.5,
+	maxCandidates: 640,
+	maxLinks: 8,
+};
+const starts: GroundArrival[] = [{ id: 'player', state: 'available', position: [-4, 0, 0], cost: 0 }];
+const base = () => [floor('lower', -8, 18, 0), floor('upper', 10, 15, 2.5, -2, 2)];
+const solve = async ({
+	boxes = [support()],
