+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { terminalNavigationAssets } from './navigation-state.ts';
+const buckets = (n: number) => Object.fromEntries(Array.from({ length: 8 }, (_, i) => [`bucket${i}`, i ? 0 : n]));
+test('selects one authored terminal variant per chunk and rejects missing assets', () => {
+    const state = {
+        surfTileIDToSceneStateBucketsMask: [['1', buckets(31)]],
+        surfTileIDToSceneStateBucketsSet: [['1', [buckets(10), buckets(21)]]],
+        strongholdToSurfTileID: [],
+        poiToSurfTileID: [['site', [[0, []], [4, ['2']]]]],
+    };
+    const names = ['1_NavMeshChunkData.asset', '10_1_NavMeshChunkData.asset', '21_1_NavMeshChunkData.asset', '2_NavMeshChunkData.asset', '5497558138880_2_NavMeshChunkData.asset'];
+    assert.deepEqual(terminalNavigationAssets(names, state, buckets(842)), ['10_1_NavMeshChunkData.asset', '5497558138880_2_NavMeshChunkData.asset']);
+    assert.equal(terminalNavigationAssets(names, state, buckets(31))[0], '1_NavMeshChunkData.asset');
+    assert.throws(() => terminalNavigationAssets(names.slice(0, -1), state, buckets(842)), /Missing terminal/);
+});
diff --git a/packages/extractor/src/game/navigation-state.ts b/packages/extractor/src/game/navigation-state.ts
new file mode 100644
index 00000000..d648ef9a
--- /dev/null
+++ b/packages/extractor/src/game/navigation-state.ts
@@ -0,0 +1,67 @@
+type Pair = [unknown, unknown];
+const entries = (value: unknown): Pair[] => {
+    if (!Array.isArray(value) || value.some(row => !Array.isArray(row) || row.length !== 2))
+        throw new Error('Invalid navigation state dictionary');
+    return value as Pair[];
+};
+const record = (value: unknown): Record<string, unknown> => {
+    if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error('Invalid navigation state');
+    return value as Record<string, unknown>;
+};
+const bucket = (value: unknown): bigint[] => {
+    const row = record(value);
+    return Array.from({ length: 8 }, (_, i) => {
+        const v = row[`bucket${i}`];
+        if (!(typeof v === 'string' && /^\d+$/.test(v)) && !(typeof v === 'number' && Number.isSafeInteger(v) && v >= 0))
+            throw new Error('Invalid scene state bucket');
+        const n = BigInt(v);
+        if (n > 0xffffffffffffffffn) throw new Error('Scene state bucket overflow');
+        return n;
+    });
+};
+const terminalLevels = (value: unknown) => {
+    const result = new Map<string, number>();
+    for (const [, values] of entries(value)) {
+        const levels = entries(values).map(([level, chunks]) => {
+            const n = Number(level);
+            if (!Number.isInteger(n) || n < 0 || n > 254 || !Array.isArray(chunks)) throw new Error('Invalid navigation upgrade');
+            return { level: n, chunks };
+        }).sort((a, b) => b.level - a.level);
+        for (const id of levels[0]?.chunks ?? []) {
+            const key = String(id), level = levels[0].level;
+            if (result.has(key) && result.get(key) !== level) throw new Error('Conflicting navigation upgrades');
+            result.set(key, level);
+        }
+    }
+    return result;
+};
+
+/** Select one authored chunk variant for the terminal upgrade snapshot.
+ * Scene buckets are resolved from the caller's completed quest/map-variable snapshot.
+ * The native manager masks each chunk and accepts only an authored state combination.
+ */
+export function terminalNavigationAssets(available: string[], stateValue: unknown, snapshotValue: unknown, requested = available): string[] {
+    const state = record(stateValue), snapshot = bucket(snapshotValue);
+    const masks = new Map(entries(state.surfTileIDToSceneStateBucketsMask).map(([id, value]) => [String(id), bucket(value)]));
+    const sets = new Map(entries(state.surfTileIDToSceneStateBucketsSet).map(([id, value]) => {
+        if (!Array.isArray(value)) throw new Error('Invalid navigation state set');
+        return [String(id), value.map(bucket)] as const;
+    }));
+    const strongholds = terminalLevels(state.strongholdToSurfTileID), pois = terminalLevels(state.poiToSurfTileID);
+    const names = new Set(available), selected: string[] = [];
+    for (const name of requested) {
+        const match = /^(\d+)_NavMeshChunkData\.asset$/.exec(name);
+        if (!match) continue;
+        const id = match[1], mask = masks.get(id);
+        let scene = mask ? snapshot.map((value, i) => value & mask[i]) : Array<bigint>(8).fill(0n);
+        if (!sets.get(id)?.some(candidate => candidate.every((value, i) => value === scene[i]))) scene = Array<bigint>(8).fill(0n);
+        // These exports use the native legacy filename format, which holds 32 scene bits.
+        if (scene[0] > 0xffffffffn || scene.slice(1).some(value => value !== 0n)) throw new Error('Navigation state requires protocol filenames');
+        const prefix = scene[0] | (BigInt((strongholds.get(id) ?? -1) + 1) << 32n) | (BigInt((pois.get(id) ?? -1) + 1) << 40n);
+        const chosen = prefix === 0n ? name : `${prefix}_${name}`;
+        if (!names.has(chosen)) throw new Error(`Missing terminal navigation asset ${chosen}`);
+        selected.push(chosen);
+    }
+    if (!selected.length) throw new Error('No navigation chunks');
+    return selected;
+}
