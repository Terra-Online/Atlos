+++ b/packages/extractor/src/game/round-exclusions.test.ts
@@ -0,0 +1,46 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { createWallChecker } from "@opendfieldmap/ganglia/solver/host";
+import { type Wall } from "@opendfieldmap/ganglia";
+
+import { roundExclusions } from './round-exclusions.ts';
+
+test('restores round occupancy from retained envelopes without opening their interior', () => {
+	const wall: Wall & { id: string } = {
+		id: 'capsule-axis-envelope/1/2/3',
+		min: [-2, 0, -2],
+		max: [2, 4, 2],
+		state: 'unknown',
+	};
+	const coverage = {
+		approximations: [
+			{
+				kind: 'capsule-axis-envelope',
+				id: 1,
+				component: 2,
+				index: 3,
+				bounds: { min: [-2, 0, -2], max: [2, 4, 2] },
+				outerRadius: 2,
+				padding: 0.001,
+			},
+		],
+	};
+	const before = structuredClone({ wall, coverage });
+	const profile = { radius: 0.35, height: 1.66 };
+	const rounded = roundExclusions([wall], coverage);
+	const checker = createWallChecker(rounded, profile);
+	assert.equal(createWallChecker([wall], profile)([1.9, 0, 1.9], [1.9, 0, 1.9]), true);
+	assert.equal(checker([1.9, 0, 1.9], [1.9, 0, 1.9]), false);
+	assert.equal(checker([0, 0, 0], [0, 0, 0]), true);
+	assert.equal(checker([-3, 0, 0], [3, 0, 0]), true);
+	assert.deepEqual({ wall, coverage }, before);
+	assert.deepEqual(roundExclusions(rounded, coverage), rounded);
+	for (const absent of [undefined, {}, { approximations: [] }]) {
+		assert.deepEqual(roundExclusions([wall], absent), [wall]);
+	}
+	const missingCook = { ...wall, id: 'missing-cook-bounds/1/2/3' };
+	assert.deepEqual(roundExclusions([missingCook], coverage), [missingCook]);
+	coverage.approximations[0].outerRadius = NaN;
+	assert.throws(() => roundExclusions([wall], coverage), /invalid round exclusion metadata/);
+});
diff --git a/packages/extractor/src/game/round-exclusions.ts b/packages/extractor/src/game/round-exclusions.ts
new file mode 100644
index 00000000..547e2506
--- /dev/null
+++ b/packages/extractor/src/game/round-exclusions.ts
@@ -0,0 +1,62 @@
+import { isObject } from '@endfield-noclip/formats/unity/values';
+
+import type { Vec3, Wall } from '@opendfieldmap/ganglia';
+
+const vector = (value: unknown): value is Vec3 =>
+	Array.isArray(value) && value.length === 3 && value.every(Number.isFinite);
+
+/**
+ * @param walls exclusions from matching ground and request inputs
+ * @param coverage collision coverage from the same scene, selection and build
+ * @returns exclusions with known sphere envelopes restored, without mutating cached input data
+ * @throws for malformed envelope metadata matching an exclusion
+ */
+export const roundExclusions = (walls: Wall[], coverage: unknown): Wall[] => {
+	if (!isObject(coverage) || !Array.isArray(coverage.approximations)) {
+		return walls;
+	}
+	const envelopes = new Map<string, Record<string, unknown>>();
+	for (const entry of coverage.approximations) {
+		if (
+			isObject(entry) &&
+			(entry.kind === 'capsule-axis-envelope' || entry.kind === 'circumscribed-sphere') &&
+			typeof entry.id === 'number' &&
+			typeof entry.component === 'number' &&
+			typeof entry.index === 'number'
+		) {
+			const id = [entry.kind, entry.id, entry.component, entry.index].join('/');
+			if (envelopes.has(id)) {
+				throw new Error('duplicate round exclusion metadata');
+			}
+			envelopes.set(id, entry);
+		}
+	}
+	return walls.map((wall) => {
+		const envelope = 'id' in wall && typeof wall.id === 'string' ? envelopes.get(wall.id) : undefined;
+		if (!envelope || wall.sphere) {
+			return wall;
+		}
+		const { bounds, outerRadius, padding } = envelope;
+		if (
+			!isObject(bounds) ||
+			!vector(bounds.min) ||
+			!vector(bounds.max) ||
+			typeof outerRadius !== 'number' ||
+			!Number.isFinite(outerRadius) ||
+			outerRadius <= 0 ||
+			typeof padding !== 'number' ||
+			!Number.isFinite(padding) ||
+			padding < 0
+		) {
+			throw new Error('invalid round exclusion metadata');
+		}
+		const { min, max } = bounds;
+		if (min.some((value, axis) => value > max[axis])) {
+			throw new Error('invalid round exclusion metadata');
+		}
+		// The tessellation is centrally symmetric. Its enclosing sphere preserves the
+		// conservative collision shape without filling empty corners of its bounds.
+		const center: Vec3 = [(min[0] + max[0]) / 2, (min[1] + max[1]) / 2, (min[2] + max[2]) / 2];
+		return { ...wall, sphere: { center, radius: outerRadius + padding } };
+	});
+};
diff --git a/packages/extractor/src/game/route-hazards.test.ts b/packages/extractor/src/game/route-hazards.test.ts
