+		{ ...placement(), componentProperties: [[0, [field('radius', 7, ['0'])]]] },
+		'level',
+		base,
+		interactionRules(base, source),
+	);
+	assert.ok(wrongType.effective.unresolved.includes('typed-component-property-unresolved'));
+	assert.equal(wrongType.navigationGoal, null);
+	for (const changes of [
+		[field('shape', 3, ['1'])],
+		[field('player_direction_check', 1, ['1'])],
+		[field('check_angle', 5, [bits(270)])],
+	]) {
+		const changed = configuredTemplate(changes);
+		assert.equal(
+			interactionPoint(placement(), 'level', changed, interactionRules(changed, source)).navigationGoal,
+			null,
+		);
+	}
+	const direct = { ...offset, rotation: [20, 0, 0] as [number, number, number] };
+	assert.equal(interactionGoal(direct).goal, null);
+});
+
+test('an incompatible intermediate variant stays unresolved even if placement later supplies a valid value', () => {
+	const base = {
+		...template(),
+		id: 'base',
+		templateVariant: [
+			[
+				'item',
+				{
+					diffProperties: [],
+					componentDiffProperties: [['Comp_TriggerObserver', { value: [field('radius', 3, ['4'])] }]],
+				},
+			],
+		],
+	};
+	const row = { ...placement(), componentProperties: [[0, [field('radius', 5, [bits(6)])]]] };
+	const result = interactionPoint(row, 'level', base, interactionRules(base, source));
+	assert.equal(result.rules, null);
+	assert.equal(result.navigationGoal, null);
+	assert.ok(result.effective.unresolved.includes('typed-component-property-unresolved'));
+});
+
+test('a direction-free sphere retains rotated offset centers and nonuniform entity scale', () => {
+	const base = configuredTemplate([
+		field('interactive_direction_check', 1, ['0']),
+		field('center', 11, [bits(0), bits(1), bits(0)]),
+	]);
+	const row = { ...placement(), rotation: [90, 0, 0], scale: [2, 3, 4] };
+	const point = interactionPoint(row, 'level', base, interactionRules(base, source));
+	assert.ok(point.navigationGoal);
+	const position = point.navigationGoal.position;
+	assert.ok(Math.abs(position[0] - 1) < 1e-6);
+	assert.ok(Math.abs(position[1] - 1.6) < 1e-6);
+	assert.ok(Math.abs(position[2] - 6) < 1e-6);
+	assert.equal(point.navigationGoal.interaction.radius, 8.5);
+	assert.equal('facing' in point.navigationGoal.interaction, false);
+	assert.deepEqual(point.navigationGoal.source, source);
+});
+
+test('tilted direction gates remain unresolved even when their angular range is full', () => {
+	const changes = [
+		field('center', 11, [bits(0), bits(0), bits(0)]),
+		field('check_area_offset', 11, [bits(0), bits(0), bits(0)]),
+	];
+	const cone = configuredTemplate(changes);
+	const row = { ...placement(), rotation: [30, 50, 20] };
+	const unresolved = interactionPoint(row, 'level', cone, interactionRules(cone, source));
+	assert.equal(unresolved.navigationGoal, null);
+	assert.ok(unresolved.navigationUnresolved.includes('tilted-direction-gate-unresolved'));
+	const whole = configuredTemplate([...changes, field('check_angle', 5, [bits(360)])]);
+	const resolved = interactionPoint(row, 'level', whole, interactionRules(whole, source));
+	assert.equal(resolved.navigationGoal, null);
+	assert.ok(resolved.navigationUnresolved.includes('tilted-direction-gate-unresolved'));
+	const upright = interactionPoint(
+		{ ...row, rotation: [0, 50, 0] },
+		'level',
+		whole,
+		interactionRules(whole, source),
+	);
+	assert.ok(upright.navigationGoal);
+	assert.equal(upright.navigationGoal.interaction.radius, 2.5);
+	assert.equal(upright.navigationGoal.interaction.maxVertical, 3);
+	assert.equal('facing' in upright.navigationGoal.interaction, false);
+});
diff --git a/packages/extractor/src/game/interaction-rules.ts b/packages/extractor/src/game/interaction-rules.ts
new file mode 100644
index 00000000..2c6233f2
--- /dev/null
+++ b/packages/extractor/src/game/interaction-rules.ts
@@ -0,0 +1,524 @@
+import { trsMatrix, transformPoint, unityEulerQuaternion } from '@endfield-noclip/formats/unity/transform';
+import { isObject } from '@endfield-noclip/formats/unity/values';
+
+type Source = { buildGuid: string; contentHash: string; path: string };
+
+const integer = (value: unknown): bigint => {
+	if (typeof value === 'bigint') {
+		return value;
+	}
+	if (typeof value === 'number' && Number.isSafeInteger(value)) {
+		return BigInt(value);
+	}
+	if (typeof value === 'string' && /^-?\d+$/.test(value)) {
+		return BigInt(value);
+	}
+	throw new Error('invalid interaction parameter atom');
+};
+
+const float = (value: bigint) => {
+	const data = new DataView(new ArrayBuffer(4));
+	data.setUint32(0, Number(BigInt.asUintN(32, value)), true);
+	const result = data.getFloat32(0, true);
+	if (!Number.isFinite(result)) {
+		throw new Error('non-finite interaction parameter');
+	}
+	return result;
+};
+
+/**
+ * reads the authored base trigger independently of per-instance overrides and collision policy. offsets and
+ * angles remain in the interactive's local frame. trigger radius is retained as an authored collider
+ * parameter; it is not substituted for a player-foot collection distance.
+ *
+ * @param template decoded interactive template, from current MemoryPack or authored JSON
+ * @param source matching build identity and template path retained by the caller
+ * @returns base trigger and directional-check parameters, or null when the component is absent
+ * @throws for ambiguous components, missing fields, incompatible parameter types or malformed values
+ */
+export const interactionRules = (template: unknown, source: Source) => {
+	if (
+		![source.buildGuid, source.contentHash, source.path].every(
+			(value) => typeof value === 'string' && value.length,
+		)
+	) {
+		throw new Error('interaction source identity required');
+	}
+	if (!isObject(template) || !Array.isArray(template.componentList)) {
+		throw new Error('invalid interaction template');
+	}
+	const components = template.componentList.filter(
+		(component) =>
+			isObject(component) &&
+			(component.$type === 'Beyond_Gameplay_Core_TriggerObserverComponentDataForMemoryPack' ||
+				component.$type === 'Beyond.Gameplay.Core.TriggerObserverComponentData, Gameplay.Beyond'),
+	);
+	if (components.length === 0) {
+		return null;
+	}
+	if (components.length !== 1 || !isObject(components[0]) || !Array.isArray(components[0].propertyList)) {
+		throw new Error('ambiguous interaction trigger');
+	}
+	const properties = new Map<string, unknown>();
+	for (const property of components[0].propertyList) {
+		if (!isObject(property) || typeof property.key !== 'string' || properties.has(property.key)) {
+			throw new Error('invalid interaction trigger property');
+		}
+		properties.set(property.key, property.value);
+	}
+	const atoms = (key: string, numericType: number, namedType: string, count: number) => {
+		const value = properties.get(key);
+		if (
+			!isObject(value) ||
+			(value.type !== numericType && value.type !== namedType) ||
+			!Array.isArray(value.valueArray) ||
+			value.valueArray.length !== count
+		) {
+			throw new Error(`invalid interaction parameter ${key}`);
+		}
+		return value.valueArray.map((atom) => {
+			if (!isObject(atom)) {
+				throw new Error('invalid interaction parameter atom');
+			}
+			return integer(atom.valueBit64);
+		});
+	};
+
+	const scalar = (key: string) => float(atoms(key, 5, 'Float', 1)[0]);
+	const vector = (key: string): [number, number, number] => {
+		const values = atoms(key, 11, 'Vector3', 3).map(float);
+		return [values[0], values[1], values[2]];
+	};
+	const boolean = (key: string) => {
+		const value = atoms(key, 1, 'Bool', 1)[0];
+		if (value !== 0n && value !== 1n) {
