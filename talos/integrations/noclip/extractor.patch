@@ -0,0 +1,18 @@
+import { transformPoint, trsMatrix, unityEulerQuaternion } from '@endfield-noclip/formats/unity/transform';
+import type { Vec3 } from '@opendfieldmap/ganglia';
+
+/** LifterCore and MovingPlatform floor lists name world positions of the moving
+ * part, not offsets of the interactive pivot. Replace its saved translation once
+ * while retaining the placed body's orientation and scale. */
+export const floorSupportPoses = (
+    body: { bodies: Vec3[][]; movingRoot: Float32Array | null },
+    floors: Vec3[], rotation: Vec3, scale: Vec3,
+): Vec3[][][] => {
+    if (!body.movingRoot) throw new Error('platform moving subtree unresolved');
+    const origin = transformPoint(body.movingRoot, [0, 0, 0]);
+    return floors.map(floor => {
+        const matrix = trsMatrix(floor, unityEulerQuaternion(rotation), scale);
+        return body.bodies.map(vertices => vertices.map(vertex => transformPoint(matrix,
+            vertex.map((value, axis) => value - origin[axis]))));
+    });
+};
diff --git a/packages/extractor/src/game/ground-data.test.ts b/packages/extractor/src/game/ground-data.test.ts
