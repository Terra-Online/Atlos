@@ -0,0 +1,118 @@
+import type { LevelInteractive } from '@endfield-noclip/formats/endfield/level-interactives';
+import type { MemoryPackValue } from '@endfield-noclip/formats/endfield/memory-pack';
+import { transformPoint } from '@endfield-noclip/formats/unity/transform';
+
+import type { Vec3 } from '@opendfieldmap/ganglia';
+
+import { componentOf, componentParams } from './interactives/component-params.ts';
+import { atomFloat, entityProperties, entityProperty, entityState } from './interactives/template-data.ts';
+import type { readPrefabSupport } from './prefab-support.ts';
+import { supportEndpoints, sweepSupports, type SweptSupport } from './swept-supports.ts';
+
+type Control = NonNullable<SweptSupport['control']>;
+const LOGIC = {
+	suffix: '_InteractiveLogicControllerComponentDataForMemoryPack',
+	diffKey: 'Comp_InteractiveLogicController',
+	type: 29,
+};
+
+/**
+ * @param template decoded interactive template
+ * @param row placement with entity and component overrides
+ * @returns the forklift's authored local control, or null for another logic controller
+ * @throws when a forklift has missing, malformed or nonfinite control properties
+ */
+export const forkliftOf = (template: MemoryPackValue, row: LevelInteractive): Control | null => {
+	const params = componentParams(template, row, LOGIC);
+	const logic = params?.get('logic_type');
+	const declared = componentOf(template, LOGIC.suffix)?.logicType;
+	if (declared !== 24 && logic?.values[0]?.bits !== 24n) {
+		return null;
+	}
+	if (logic !== undefined && (logic.type !== 3 || logic.values.length !== 1)) {
+		throw new Error('invalid forklift logic control');
+	}
+	if (logic !== undefined && Number(BigInt.asIntN(32, logic.values[0].bits)) !== 24) {
+		return null;
+	}
+	const entity = entityProperties(template);
+	if (!entity) {
+		throw new Error('forklift entity properties unresolved');
+	}
+	const vector = (key: string): Vec3 => {
+		const values = entityProperty(entity, row, key);
+		if (!values || values.length !== 3) {
+			throw new Error(`invalid forklift ${key}`);
+		}
+		const point: Vec3 = [atomFloat(values[0].bits), atomFloat(values[1].bits), atomFloat(values[2].bits)];
+		if (!point.every(Number.isFinite)) {
+			throw new Error(`invalid forklift ${key}`);
+		}
+		return point;
+	};
+	const start = vector('start_pos'),
+		end = vector('end_pos');
+	const speedAtoms = entityProperty(entity, row, 'speed');
+	const speed = speedAtoms?.length === 1 ? atomFloat(speedAtoms[0].bits) : Number.NaN;
+	const state = entityProperty(entity, row, 'state');
+	const on = entityProperty(entity, row, 'is_on');
+	if (
+		!Number.isFinite(speed) ||
+		speed <= 0 ||
+		state?.length !== 1 ||
+		on?.length !== 1 ||
+		(on[0].bits !== 0n && on[0].bits !== 1n)
+	) {
+		throw new Error('invalid forklift speed or state control');
+	}
+	if (start.every((value, axis) => value === end[axis])) {
+		throw new Error('forklift has coincident control poses');
+	}
+	return {
+		kind: 'forklift',
+		logicType: 24,
+		start,
+		end,
+		speed,
+		initialState: entityState(entity, row),
+		initiallyOn: on[0].bits === 1n,
+		assumption: 'fully-enabled',
+	};
+};
+
+/**
+ * @param id stable source identity
+ * @param body decoded moving subtree in prefab space, with its authored rest matrix
+ * @param placement prefab/model-to-world matrix, including authored rotation and scale
+ * @param control validated local start/end control
+ * @returns phase-free supports, poses, endpoint boxes and rides at the authored world speed
+ * @throws when the lifted subtree or placement is unresolved
+ */
+export const forkliftSupports = (
+	id: string,
+	body: Awaited<ReturnType<typeof readPrefabSupport>>,
+	placement: Float32Array,
+	control: Control,
+) => {
+	const rest = body.translationRoot;
+	if (!rest || !body.movingPart || ![...rest, ...placement].every(Number.isFinite)) {
+		throw new Error('forklift lifted subtree or placement unresolved');
+	}
+	// setting the lifted transform's world position replaces its rest translation. its orientation,
+	// scale and descendant transforms remain in the decoded prefab-space vertices.
+	const poseBodies = [control.start, control.end].map((position) =>
+		body.bodies.map((vertices) =>
+			vertices.map((point) =>
+				transformPoint(
+					placement,
+					point.map((value, axis) => value - rest[12 + axis] + position[axis]),
+				),
+			),
+		),
+	);
+	return {
+		...sweepSupports(id, poseBodies, control.speed),
+		endpoints: supportEndpoints(poseBodies),
+		control,
+	};
+};
