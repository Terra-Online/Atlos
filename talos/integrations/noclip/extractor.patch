+			const [a, b, c] = face.map((vertexIndex) => vertices[vertexIndex]);
+			const ab = b.map((value, axis) => value - a[axis]),
+				ac = c.map((value, axis) => value - a[axis]);
+			const normal = [
+				ab[1] * ac[2] - ab[2] * ac[1],
+				ab[2] * ac[0] - ab[0] * ac[2],
+				ab[0] * ac[1] - ab[1] * ac[0],
