+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { trsMatrix } from '@endfield-noclip/formats/unity/transform';
+import { floorSupportPoses } from './floor-supports.ts';
+
+test('world floors replace the moving root translation without a second placement transform', () => {
+    const body = { movingRoot: trsMatrix([3, 0.5, 0], [0, 0, 0, 1], [1, 1, 1]),
+        bodies: [[[3, 0.5, 0], [4, 1.5, 0]] as [number, number, number][]] };
+    const floors: [number, number, number][] = [[34.15, 170.35, 1322.47], [34.15, 214.552, 1322.47]];
+    const poses = floorSupportPoses(body, floors, [0, 90, 0], [2, 3, 4]);
+    for (const [index, floor] of floors.entries()) {
+        assert.ok(poses[index][0][0].every((value, axis) => Math.abs(value - floor[axis]) < 1e-4));
+        const expected = [floor[0], floor[1] + 3, floor[2] - 2];
+        assert.ok(poses[index][0][1].every((value, axis) => Math.abs(value - expected[axis]) < 1e-4));
+    }
+    assert.throws(() => floorSupportPoses({ ...body, movingRoot: null }, floors, [0, 0, 0], [1, 1, 1]), /subtree/);
+});
