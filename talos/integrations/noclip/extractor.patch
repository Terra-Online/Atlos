diff --git a/packages/extractor/src/commands/air-walls.ts b/packages/extractor/src/commands/air-walls.ts
new file mode 100644
index 00000000..4261d6c2
--- /dev/null
+++ b/packages/extractor/src/commands/air-walls.ts
@@ -0,0 +1,192 @@
+/* oxlint-disable no-await-in-loop -- decode one level file at a time to bound memory */
+import { writeFile } from 'node:fs/promises';
+import { parseArgs } from 'node:util';
+
+import { isObject } from '@endfield-noclip/formats/unity/values';
+
+import { withContext } from '../context.ts';
+import { createWallResolver } from '../game/air-wall-state.ts';
+import { routeHazards } from '../game/route-hazards.ts';
+import { loadLevelScripts } from '../game/script-drivers.ts';
+import { createSteamHazardReader, scriptedSteamIds } from '../game/steam-hazards.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+const vector = (value: unknown): number[] => {
+	if (
+		!Array.isArray(value) ||
+		value.length !== 3 ||
+		!value.every((v: unknown) => typeof v === 'number' && Number.isFinite(v))
+	) {
+		throw new Error('invalid wall vector');
+	}
+	return value.map(Number);
+};
+
+export const summary =
+	'export conservative air-wall, reset-zone and steam exclusions from the current install';
+export const usage = 'usage: endfield-extract air-walls <scene> -o <file> --config <config>';
+
+/**
+ * @param args scene and output arguments @returns after exporting authored walls, reset zones and steam,
+ *   including conditional exclusions
+ */
+export const run = async (args: string[]): Promise<void> => {
+	const { values, positionals } = parseArgs({
+		args,
+		allowPositionals: true,
+		options: {
+			output: { type: 'string', short: 'o' },
+			config: { type: 'string' },
+		},
+	});
+	if (positionals.length !== 1 || !values.output) {
+		throw new Error(usage);
+	}
+	await withContext(values.config, async (ctx) => {
+		const reader = await ctx.memoryPack(),
+			paths = await ctx.world.pathLookup();
+		const build = await ctx.world.manifest();
+		const levels = [...(await ctx.world.levelConfigs()).values()].filter((c) => c.mapId === positionals[0]);
+		if (!levels.length) {
+			throw new Error('unknown scene');
+		}
+		const groups: unknown[] = [];
+		const hazards: unknown[] = [];
+		const readSteam = await createSteamHazardReader(ctx);
+		const steam: (Awaited<ReturnType<typeof readSteam>>[number] & { level: string; path: string })[] = [];
+		const briefs = new Map<string, unknown>();
+		for (const level of levels) {
+			for (const hash of level.levelDataPathHashes ?? []) {
+				const path = paths(hash);
+				if (!path) {
+					throw new Error('missing level path');
+				}
+				// oxlint-disable-next-line no-await-in-loop -- bound retained decoded level data
+				const file = await ctx.vfs.find(VfsGroup.JsonData, path);
+				if (!file) {
+					throw new Error(`missing ${path}`);
+				}
+				// oxlint-disable-next-line no-await-in-loop -- decode one level file at a time
+				const data = reader.decode(
+					await ctx.vfs.readVerified(file),
+					'Beyond_Gameplay_LevelDataForMemoryPack',
+				);
+				if (!isObject(data) || !Array.isArray(data.airWalls)) {
+					throw new Error('invalid level walls');
+				}
+				for (const entry of Array.isArray(data.levelScriptBriefDataDict)
+					? data.levelScriptBriefDataDict
+					: []) {
+					if (
+						Array.isArray(entry) &&
+						(typeof entry[0] === 'string' || typeof entry[0] === 'bigint' || typeof entry[0] === 'number')
+					) {
+						briefs.set(`${level.id}/${entry[0]}`, entry[1]);
+					}
+				}
+				for (const zone of routeHazards(data)) {
+					hazards.push({ ...zone, level: level.id, path });
+				}
+				for (const row of Array.isArray(data.interactives) ? data.interactives : []) {
+					for (const zone of await readSteam(row)) {
+						steam.push({ ...zone, level: level.id, path });
+					}
+				}
+				for (const group of data.airWalls) {
+					if (!isObject(group) || !Array.isArray(group.polyLineWalls)) {
+						throw new Error('invalid wall group');
+					}
+					for (const wall of group.polyLineWalls) {
+						if (
+							!isObject(wall) ||
+							!isObject(wall.bounds) ||
+							!Array.isArray(wall.bounds.m_center) ||
+							!Array.isArray(wall.bounds.m_size)
+						) {
+							throw new Error('missing wall bounds');
+						}
+						const center = vector(wall.bounds.m_center),
+							size = vector(wall.bounds.m_size);
+						if (size.some((v) => v < 0)) {
+							throw new Error('negative wall size');
+						}
+						groups.push({
+							level: level.id,
+							groupId: group.groupId,
+							scriptId: group.scriptId,
+							slotId: group.slotId,
+							defaultOn: group.defaultOn,
+							condition: group.checkData,
+							state: 'unknown',
+							min: center.map((v, i) => v - size[i] / 2),
+							max: center.map((v, i) => v + size[i] / 2),
+							points: wall.posList,
+							height: wall.heightRange,
+							usage: wall.usage,
+							navigationObstacle: wall.enableNavObstacle,
+							pushDistance: wall.pushDis,
+							padding: wall.usage === 4 && typeof wall.pushDis === 'number' ? Math.max(0, wall.pushDis) : 0,
+						});
+					}
+				}
+			}
+		}
+		const targets = new Set<string>();
+		for (const wall of groups) {
+			if (
+				!isObject(wall) ||
+				(typeof wall.groupId !== 'string' &&
+					typeof wall.groupId !== 'number' &&
+					typeof wall.groupId !== 'bigint')
+			) {
+				throw new Error('invalid wall group identity');
+			}
+			if (String(wall.groupId) !== '0') {
+				targets.add(String(wall.groupId));
+			}
+		}
+		const steamIds = new Set(steam.map((zone) => zone.id));
+		const scripts = await loadLevelScripts(ctx, positionals[0], new Set([...targets, ...steamIds]));
+		const controlledSteam = scriptedSteamIds(scripts.scripts, steamIds, [...briefs.values()]);
+		for (const zone of steam) {
+			const unresolved = controlledSteam.has(zone.id) || scripts.undecoded > 0 || zone.state === 'unknown';
+			hazards.push({
+				...zone,
+				state: unresolved ? 'unknown' : 'active',
+				activation: unresolved ? 'lifecycle-unresolved' : 'continuous-while-loaded',
+				controlEvidence: {
+					scriptReferenced: controlledSteam.has(zone.id),
+					undecodedScripts: scripts.undecoded,
+				},
+			});
+		}
+		const resolveCompleted = createWallResolver({ ...scripts, briefs });
+		const controlled = groups.map((wall) => {
+			if (!isObject(wall)) {
+				throw new Error('invalid exported wall');
+			}
+			return { ...wall, completed: resolveCompleted(wall) };
+		});
+		await writeFile(
+			values.output!,
+			JSON.stringify(
+				{
+					version: 2,
+					scene: positionals[0],
+					source: { buildGuid: build.guid, contentHash: build.contentHash },
+					walls: controlled,
+					hazards,
+				},
+				(_key, value: unknown) => (typeof value === 'bigint' ? value.toString() : value),
+			),
+		);
+		console.log(
+			JSON.stringify({
+				scene: positionals[0],
+				walls: groups.length,
+				hazards: hazards.length,
+				steam: steam.length,
+			}),
+		);
+	});
+};
