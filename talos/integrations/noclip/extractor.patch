+++ b/packages/extractor/src/commands/filters.ts
@@ -0,0 +1,238 @@
+/* oxlint-disable no-await-in-loop -- keep bundle residency bounded while visiting the small library */
+import { mkdir, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { parseArgs } from 'node:util';
+
+import { readEnvironmentPhase } from '@endfield-noclip/formats/hg/environment-phase';
+import { isSparkBean, parseSparkTable } from '@endfield-noclip/formats/hg/spark-buffer';
+import { toPlainObject } from '@endfield-noclip/formats/unity/plain-object';
+import { UnityClass } from '@endfield-noclip/formats/unity/serialized-file';
+import { arrayField, asPPtr, isObject, pptrField, stringField } from '@endfield-noclip/formats/unity/values';
+import type { ColorGradingConfig } from '@endfield-noclip/package-format/environment';
+import type { PhotoFilter, PhotoFilters } from '@endfield-noclip/package-format/photo-filters';
+
+import { withContext } from '../context.ts';
+import { loadTexture } from '../game/assets/asset-decode.ts';
+import type { ObjectRef } from '../game/assets/assets.ts';
+import { loadPhotoEffects } from '../game/photo-effects.ts';
+import { readPrefabEnvironmentVolumes } from '../game/prefabs/prefab-environment.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+export const summary = 'export the install’s photo filters and LUTs: filters [-o out/photo-filters.json]';
+
+/** command usage, available without opening the install */
+export const usage = 'usage: filters [-o out/photo-filters.json]';
+
+/**
+ * @param args CLI arguments, including the local config and output path
+ * @returns after writing a library; missing or unsupported assets fail explicitly
+ */
+export const run = async (args: string[]): Promise<void> => {
+	const { values } = parseArgs({
+		args,
+		options: {
+			config: { type: 'string' },
+			output: { type: 'string', short: 'o', default: 'out/photo-filters.json' },
+		},
+	});
+	await withContext(values.config, async (context) => {
+		const table = async (name: string) => {
+			const file = await context.vfs.find(VfsGroup.Table, `Data/TableCfg/${name}.bytes`);
+			if (file === undefined) {
+				throw new Error(`missing ${name}`);
+			}
+			return parseSparkTable(await context.vfs.readVerified(file)).entries;
+		};
+		const text = new Map(await table('I18nTextTable_EN'));
+		const resolver = await context.resolver();
+		const filters: PhotoFilter[] = [];
+		const rows = (await table('SnapshotFilterTable'))
+			.map(([, row]) => {
+				if (!isSparkBean(row)) {
+					throw new Error('invalid snapshot filter row');
+				}
+				return row;
+			})
+			// oxlint-disable-next-line unicorn/no-array-sort -- sorts the newly mapped rows
+			.sort((a, b) => Number(a.sortId) - Number(b.sortId));
+		for (const row of rows) {
+			const field = (key: string): string => {
+				const value = row[key];
+				if (typeof value !== 'string') {
+					throw new Error(`invalid snapshot filter ${key}`);
+				}
+				return value;
+			};
+			const id = field('id');
+			const path = `Assets/Beyond/DynamicAssets/Gameplay/Snapshot/Filter/Volume/${field('filterPath')}.prefab`;
+			const hashes = await context.world.hashesOf(path);
+			if (hashes.length !== 1) {
+				throw new Error(`${id}: expected one prefab path hash`);
+			}
+			const root = await resolver.findUnique({ hash: hashes[0], path }, UnityClass.GameObject);
+			const textId = isSparkBean(row.name) ? row.name.id : null;
+			const name = typeof textId === 'bigint' ? text.get(textId) : undefined;
+			const filter: PhotoFilter = {
+				id,
+				name: typeof name === 'string' ? name : id,
+				unsupported: [],
+				grading: null,
+				vignette: null,
+				bloom: null,
+				lut: null,
+			};
+			if (field('filterEffectPath') !== '') {
+				const result = await loadPhotoEffects(context, field('filterEffectPath'));
+				filter.effects = result.effects;
+				filter.unsupported.push(...result.unsupported);
+			}
+			const volumes = await readPrefabEnvironmentVolumes(resolver, root, {
+				position: [0, 0, 0],
+				rotation: [0, 0, 0, 1],
+				scale: [1, 1, 1],
+			});
+			for (const volume of volumes) {
+				if (volume.phase === null) {
+					continue;
+				}
+				const phase = readEnvironmentPhase(volume.phase.info.type.nodes, await resolver.read(volume.phase));
+				for (const [key, section] of Object.entries(phase.sections)) {
+					if (section.active && key !== 'colorGradingConfig') {
+						filter.unsupported.push(key);
+					}
+				}
+				const section = phase.sections.colorGradingConfig;
+				if (!section.active) {
+					continue;
+				}
+				// the converter preserves the TypeTree's config layout; pointers remain outside the JSON value.
+				// oxlint-disable-next-line typescript/no-unsafe-type-assertion -- readEnvironmentPhase preserves the config's TypeTree layout
+				filter.grading = section.value as unknown as ColorGradingConfig;
+				if (filter.grading.colorCurvesEnabled) {
+					filter.unsupported.push('colour curves');
+				}
+				if (filter.grading.colorLookupEnabled) {
+					const pointer = section.textures.find((t) => t.path.join('.') === 'colorLookupTexture');
+					const ref = pointer && (await resolver.resolve(volume.phase, pointer.pptr));
+					if (!ref) {
+						throw new Error(`${id}: missing LUT`);
+					}
+					const texture = await loadTexture(resolver, ref);
+					if (
+						texture.kind !== '2d' ||
+						texture.width !== texture.height ** 2 ||
+						texture.height < 4 ||
+						texture.height % 4 !== 0 ||
+						texture.srgb ||
+						texture.vkFormat !== 145
+					) {
+						throw new Error(`${id}: unsupported LUT shape or format`);
+					}
+					filter.lut = {
+						size: texture.height,
+						format: 'bc7-rgba-unorm',
+						data: Buffer.from(texture.levels[0]).toString('base64'),
+						contribution: filter.grading.colorLookupContribution,
+					};
+				}
+			}
+			// SRP volumes may override only selected parameters; preserve each overrideState.
+			const visit = async (go: ObjectRef, depth: number): Promise<void> => {
+				if (depth > 64) {
+					throw new Error(`${id}: filter hierarchy deeper than 64`);
+				}
+				const data = await resolver.read(go);
+				if (!data.m_IsActive) {
+					return;
+				}
+				for (const item of arrayField(data, 'm_Component')) {
+					if (!isObject(item)) {
+						continue;
+					}
+					const ref = await resolver.resolve(go, pptrField(item, 'component'));
+					if (ref === null) {
+						continue;
+					}
+					const component = await resolver.read(ref);
+					if (ref.info.classId === UnityClass.Transform) {
+						for (const pointer of arrayField(component, 'm_Children')) {
+							const transform = await resolver.resolve(ref, asPPtr(pointer));
+							if (transform !== null) {
+								const child = await resolver.resolve(
+									transform,
+									pptrField(await resolver.read(transform), 'm_GameObject'),
+								);
+								if (child !== null) {
+									await visit(child, depth + 1);
+								}
+							}
+						}
+					} else if (component.m_Enabled && component.sharedProfile) {
+						const profile = await resolver.resolve(ref, pptrField(component, 'sharedProfile'));
+						if (profile === null) {
+							continue;
+						}
+						for (const pointer of arrayField(await resolver.read(profile), 'components')) {
+							const target = await resolver.resolve(profile, asPPtr(pointer));
+							if (target === null) {
+								continue;
+							}
+							const raw = await resolver.read(target);
+							if (!raw.active) {
+								continue;
+							}
+							const componentName = stringField(raw, 'm_Name');
+							if (componentName !== 'Vignette' && componentName !== 'Bloom') {
+								filter.unsupported.push(componentName);
+								continue;
+							}
+							const { value } = toPlainObject(target.info.type.nodes, raw, {
+								keepPPtr: () => false,
+								dropField: (key) => key.startsWith('m_') || key === 'active',
+							});
+							const overrides = Object.fromEntries(
+								Object.entries(value).filter(([key]) => isObject(raw[key]) && raw[key].overrideState),
+							);
+							if (componentName === 'Vignette') {
+								filter.vignette = overrides;
+							} else {
+								const supported = new Set([
+									'resolutionHighQuality',
+									'thresholdHighQuality',
+									'intensityHighQuality',
+									'scatterHighQuality',
+									'tint',
+									'blendMode',
+								]);
+								filter.bloom = Object.fromEntries(
+									Object.entries(overrides).filter(([key]) => supported.has(key)),
+								);
+								for (const key of [
+									'bloomUpsampleAdditive',
+									'characterBloomControl',
+									'anamorphic',
+									'dirtIntensity',
+								]) {
+									if (overrides[key]) {
+										filter.unsupported.push(`bloom ${key}`);
+									}
+								}
+							}
+						}
+					}
+				}
+			};
+			await visit(root, 0);
+			filter.unsupported = [...new Set(filter.unsupported)];
+			filters.push(filter);
+			console.error(
+				`${filter.id}: ${filter.name}${filter.unsupported.length ? ` (partial: ${filter.unsupported.join(', ')})` : ''}`,
+			);
+		}
+		const library: PhotoFilters = { format: 'endfield-noclip.photo-filters', version: 4, filters };
+		const output = resolve(values.output);
+		await mkdir(dirname(output), { recursive: true });
+		await writeFile(output, JSON.stringify(library));
+		console.error(`wrote ${filters.length} photo filters to ${output}`);
+	});
+};
diff --git a/packages/extractor/src/commands/interaction-points.ts b/packages/extractor/src/commands/interaction-points.ts
new file mode 100644
index 00000000..a48f42d8
--- /dev/null
+++ b/packages/extractor/src/commands/interaction-points.ts
@@ -0,0 +1,138 @@
+/* oxlint-disable no-await-in-loop -- decode one level at a time and cache small template metadata */
+import { writeFile } from 'node:fs/promises';
+import { parseArgs } from 'node:util';
+
+import { readInteractiveTable } from '@endfield-noclip/formats/endfield/interactive-model';
+import { isObject } from '@endfield-noclip/formats/unity/values';
+
+import { withContext } from '../context.ts';
+import { interactionPoint, interactionRules } from '../game/interaction-rules.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+export const summary = 'export build-bound placed interaction triggers and unresolved override scopes';
+export const usage = 'usage: endfield-extract interaction-points <scene> -o <file> --config <config>';
+
+/** @param args scene, output and local install config @returns after exporting placed interaction rules */
+export const run = async (args: string[]): Promise<void> => {
+	const { values, positionals } = parseArgs({
+		args,
+		allowPositionals: true,
+		options: { output: { type: 'string', short: 'o' }, config: { type: 'string' } },
+	});
+	if (positionals.length !== 1 || !values.output) {
+		throw new Error(usage);
+	}
+	const scene = positionals[0];
+	await withContext(values.config, async (ctx) => {
+		const read = async (path: string) => {
+			const file = await ctx.vfs.find(VfsGroup.JsonData, path);
+			if (!file) {
+				throw new Error(`missing ${path}`);
+			}
+			return ctx.vfs.readVerified(file);
+		};
+		const build = await ctx.world.manifest();
+		const source = { buildGuid: build.guid, contentHash: build.contentHash };
+		const pool = await ctx.world.stringPool(),
+			reader = await ctx.memoryPack();
+		const table = readInteractiveTable(await read('Data/Json/Interactive/InteractiveTable.json'), (id) =>
+			pool.get(id),
+		);
+		const lookup = await ctx.world.pathLookup();
+		const levels = [...(await ctx.world.levelConfigs()).values()].filter((level) => level.mapId === scene);
+		if (!levels.length) {
+			throw new Error(`unknown scene ${scene}`);
+		}
+		type Template = { value: unknown; rules: ReturnType<typeof interactionRules>; error: string | null };
+		const templates = new Map<string, Template>(),
+			points = [],
+			errors = [];
+		let files = 0;
+		for (const level of levels) {
+			for (const hash of level.levelDataPathHashes ?? []) {
+				const path = lookup(hash);
+				if (!path) {
+					throw new Error('missing level data path');
+				}
+				const data = reader.decode(await read(path), 'Beyond_Gameplay_LevelDataForMemoryPack');
+				if (!isObject(data) || !Array.isArray(data.interactives)) {
+					throw new Error('invalid level interactives');
+				}
+				files++;
+				for (const row of data.interactives) {
+					if (!isObject(row) || typeof row.entityDataIdKey !== 'string') {
+						throw new Error('invalid interactive identity');
+					}
+					const templateId = table.templates.get(row.entityDataIdKey);
+					const templatePath = templateId === undefined ? undefined : table.templatePaths.get(templateId);
+					let template: Template = { value: null, rules: null, error: 'missing template reference' };
+					if (templatePath) {
+						const cached = templates.get(templatePath);
+						if (cached) {
+							template = cached;
+						} else {
+							try {
+								const value = reader.decode(
+									await read(templatePath),
+									'Beyond_Gameplay_InteractiveTemplateDataForMemoryPack',
+								);
+								template = {
+									value,
+									rules: interactionRules(value, { ...source, path: templatePath }),
+									error: null,
+								};
+							} catch (error) {
+								template = { value: null, rules: null, error: String(error) };
+							}
+							templates.set(templatePath, template);
+						}
+					}
+					if (template.error) {
+						errors.push({
+							id: row.levelLogicId,
+							level: level.id,
+							template: row.entityDataIdKey,
+							path: templatePath ?? null,
+							error: template.error,
+						});
+					}
+					points.push({
+						...interactionPoint(row, level.id, template.value, template.rules),
+						source: path,
+						templatePath: templatePath ?? null,
+					});
+				}
+			}
+		}
+		const counts = {
+			levels: levels.length,
+			files,
+			templates: templates.size,
+			points: points.length,
+			withRules: points.filter((point) => point.rules).length,
+			baseRuleCompatible: points.filter((point) => point.effective.status === 'base-rule-compatible').length,
+			pointsWithTriggerOverrides: points.filter((point) =>
+				Object.values(point.overrides.triggerCandidates).some((items) => items.length > 0),
+			).length,
+			overridesApplied: points.filter((point) => point.effective.status === 'overrides-applied').length,
+			unresolvedRules: points.filter((point) => point.effective.status === 'unresolved').length,
+			navigationGoals: points.filter((point) => point.navigationGoal).length,
+			errors: errors.length,
+		};
+		await writeFile(
+			values.output!,
+			JSON.stringify(
+				{
+					version: 1,
+					scene,
+					source,
+					coverage: { scope: 'authored-interactives', runtimeState: 'unresolved', ...counts },
+					points,
+					errors,
+				},
+				(_, value) => (typeof value === 'bigint' ? String(value) : value),
+			),
+		);
+		console.log(counts);
+	});
+};
diff --git a/packages/extractor/src/commands/movement-settings.ts b/packages/extractor/src/commands/movement-settings.ts
new file mode 100644
index 00000000..e7774c92
--- /dev/null
+++ b/packages/extractor/src/commands/movement-settings.ts
@@ -0,0 +1,133 @@
+/* oxlint-disable no-await-in-loop -- keep only one decoded asset at a time */
+import { writeFile } from 'node:fs/promises';
+import { parseArgs } from 'node:util';
+
+import { parseSparkBean } from '@endfield-noclip/formats/hg/spark-buffer';
+import { numberField } from '@endfield-noclip/formats/unity/values';
+
+import { withContext } from '../context.ts';
+import { characterMovement, commonCapsule } from '../game/character-movement.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+export const summary = 'export build-bound player movement settings separately from AI navigation settings';
+export const usage = 'usage: endfield-extract movement-settings -o <file> --config <config>';
+
+const positive = (value: unknown, name: string): number => {
+	if (typeof value !== 'number' || !Number.isFinite(value) || value <= 0) {
+		throw new Error(`invalid movement setting ${name}`);
+	}
+	return value;
+};
+
+/**
+ * @param args output and local installation arguments
+ * @returns after exporting movement assets and their variants without treating them as verified motion links
+ * @throws if a required settings asset is missing or cannot be decoded
+ */
+export const run = async (args: string[]): Promise<void> => {
+	const { values, positionals } = parseArgs({
+		args,
+		allowPositionals: true,
+		options: { output: { type: 'string', short: 'o' }, config: { type: 'string' } },
+	});
+	if (positionals.length || !values.output) {
+		throw new Error(usage);
+	}
+	await withContext(values.config, async (ctx) => {
+		const paths = await ctx.world.pathHash(),
+			resolver = await ctx.resolver();
+		const prefix = 'Assets/Beyond/DynamicAssets/GameData/';
+		const movement = 'GameplayConfig/MovementSetting/';
+		const required = new Set([
+			`${prefix}${movement}MovementSetting_Default.asset`,
+			`${prefix}GameplayConfig/WorldSetting.asset`,
+			`${prefix}NavMesh/DefaultNavMeshBuildData.asset`,
+		]);
+		const assets = [];
+		const characters = [];
+		for (const [hash, path] of paths.entries()) {
+			const player = path.startsWith(`${prefix}${movement}`) && path.endsWith('.asset');
+			const character = path.startsWith(`${prefix}CharacterData/data_chr_`) && path.endsWith('.asset');
+			if (!player && !character && !required.has(path)) {
+				continue;
+			}
+			const settings = await resolver.read(await resolver.findUnique({ hash, path }, 114));
+			if (character) {
+				characters.push({ path, ...characterMovement(settings) });
+				continue;
+			}
+			assets.push({
+				purpose: player ? 'player' : path.includes('/NavMesh/') ? 'ai-navigation' : 'world',
+				path,
+				settings,
+			});
+			required.delete(path);
+		}
+		if (required.size) {
+			throw new Error(`missing movement settings: ${[...required].join(', ')}`);
+		}
+		assets.sort((a, b) => a.path.localeCompare(b.path));
+		characters.sort((a, b) => a.id.localeCompare(b.id));
+		const settings = assets.find((asset) => asset.path.endsWith('/MovementSetting_Default.asset'))!.settings;
+		const constantsFile = await ctx.vfs.find(VfsGroup.Table, 'Data/TableCfg/GlobalConst.bytes');
+		if (!constantsFile) {
+			throw new Error('missing movement resource constants');
+		}
+		const constants = parseSparkBean(await ctx.vfs.readVerified(constantsFile));
+		if (constants.name !== 'GlobalConst') {
+			throw new Error('unexpected movement resource constants');
+		}
+
+		const energyCost = positive(constants.value.dashCostEnergyValue, 'dashCostEnergyValue');
+		const capacity = positive(constants.value.maxDashEnergyLimit, 'maxDashEnergyLimit') / energyCost;
+		const delay = numberField(settings, '_dashBlockRecoverTime');
+		if (capacity < 1 || !Number.isFinite(delay) || delay < 0) {
+			throw new Error('invalid sprint resource bounds');
+		}
+		// sprint activation shares the action resource. holding the gait does not repeatedly pay entry cost.
+		// normalize capacity by one activation and initialize at the requested maximum, without regional buffs.
+		const sustainedSprint = {
+			speed: positive(numberField(settings, '_runSpeed'), '_runSpeed'),
+			sprintSpeed: positive(numberField(settings, '_sprintSpeed'), '_sprintSpeed'),
+			sprintAcceleration: positive(numberField(settings, '_sprintAcceleration'), '_sprintAcceleration'),
+			// held sprint intent survives ordinary air transitions without a fresh input activation.
+			sprintThrough: ['jump', 'drop'],
+			stamina: {
+				capacity,
+				initial: capacity,
+				activationCost: 1,
+				sprintDrain: 0,
+				recoveryRate: 1 / positive(numberField(settings, '_dashCd'), '_dashCd'),
+				recoveryDelay: delay,
+				reserve: 0,
+				recoveryDuringSprint: true,
+				recoveryDuringNonWalk: true,
+			},
+		};
+		const build = await ctx.world.manifest();
+		await writeFile(
+			values.output!,
+			JSON.stringify(
+				{
+					version: 1,
+					source: { buildGuid: build.guid, contentHash: build.contentHash },
+					// authored inputs do not establish the applied capsule, active modifiers or collision-free trajectories.
+					motionValidation: 'unresolved',
+					assets,
+					characters,
+					defaultProfile: commonCapsule(characters),
+					sustainedSprint,
+				},
+				(_key, value: unknown) => (typeof value === 'bigint' ? value.toString() : value),
+			),
+		);
+		console.log(
+			JSON.stringify({
+				assets: assets.length,
+				characters: characters.length,
+				sustainedSprint,
+				motionValidation: 'unresolved',
+			}),
+		);
+	});
+};
diff --git a/packages/extractor/src/commands/navmesh.ts b/packages/extractor/src/commands/navmesh.ts
new file mode 100644
index 00000000..c9766701
--- /dev/null
+++ b/packages/extractor/src/commands/navmesh.ts
@@ -0,0 +1,85 @@
+/* oxlint-disable no-await-in-loop -- release each asset before loading the next */
+import { writeFile } from 'node:fs/promises';
+import { parseArgs } from 'node:util';
+
+import { readNavTile } from '@endfield-noclip/formats/unity/navmesh';
+import {
+	arrayField,
+	bytesField,
+	isObject,
+	objectField,
+	vector3Field,
+} from '@endfield-noclip/formats/unity/values';
+
+import { withContext } from '../context.ts';
+
+export const summary = 'export source-bound navigation tile topology without inventing player connectivity';
+export const usage = 'usage: endfield-extract navmesh <scene> -o <file> [--limit n] --config <config>';
+
+/**
+ * @param args scene and output arguments @returns after decoding selected navigation assets; partial exports
+ *   are explicitly marked
+ */
+export const run = async (args: string[]): Promise<void> => {
+	const { values, positionals } = parseArgs({
+		args,
+		allowPositionals: true,
+		options: {
+			output: { type: 'string', short: 'o' },
+			config: { type: 'string' },
+			limit: { type: 'string' },
+		},
+	});
+	if (positionals.length !== 1 || !values.output) {
+		throw new Error(usage);
+	}
+	const limit = values.limit === undefined ? Infinity : Number(values.limit);
+	if (!(limit > 0) || (limit !== Infinity && !Number.isInteger(limit))) {
+		throw new Error('invalid limit');
+	}
+	await withContext(values.config, async (ctx) => {
+		const resolver = await ctx.resolver(),
+			build = await ctx.world.manifest();
+		const prefix = `Assets/Beyond/DynamicAssets/Scenes/PC/${positionals[0]}/NavMeshChunks/`;
+		const assets = [...(await ctx.world.pathHash()).entries()].filter(
+			([, path]) => path.startsWith(prefix) && path.endsWith('_NavMeshChunkData.asset'),
+		);
+		if (!assets.length) {
+			throw new Error('no navigation assets');
+		}
+		const rows = [];
+		for (const [hash, path] of assets.slice(0, limit)) {
+			const data = await resolver.read(await resolver.findUnique({ hash, path }, 238));
+			const tiles = arrayField(data, 'm_NavMeshTiles').map((tile) => {
+				if (!isObject(tile)) {
+					throw new Error('invalid navmesh tile');
+				}
+				return readNavTile(bytesField(tile, 'm_MeshData'));
+			});
+			rows.push({
+				asset: path.slice(prefix.length),
+				position: vector3Field(data, 'm_Position'),
+				rotation: objectField(data, 'm_Rotation'),
+				settings: objectField(data, 'm_NavMeshBuildSettings'),
+				tiles,
+			});
+		}
+		await writeFile(
+			values.output!,
+			JSON.stringify({
+				version: 1,
+				scene: positionals[0],
+				source: { buildGuid: build.guid, contentHash: build.contentHash },
+				partial: rows.length !== assets.length,
+				assets: rows,
+			}),
+		);
+		console.log(
+			JSON.stringify({
+				assets: rows.length,
+				totalAssets: assets.length,
+				polygons: rows.reduce((n, row) => n + row.tiles.reduce((m, tile) => m + tile.polygons.length, 0), 0),
+			}),
+		);
+	});
+};
diff --git a/packages/extractor/src/commands/oem-check.ts b/packages/extractor/src/commands/oem-check.ts
new file mode 100644
index 00000000..145469f0
--- /dev/null
+++ b/packages/extractor/src/commands/oem-check.ts
@@ -0,0 +1,191 @@
+import { readFile, stat } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+
+import { cameraValues, NO_TRIGGER_MEMORY } from '@endfield-noclip/package-format/camera';
+import {
+	conditionResults,
+	groupsShown,
+	conditionVisible,
+	resolveSceneValues,
+} from '@endfield-noclip/package-format/conditions';
+import { isNavigation, matchesNavigation } from '@endfield-noclip/package-format/navigation';
+import {
+	companionStates,
+	pointPicks,
+	pointValues,
+	isCatalog,
+	isCompanion,
+} from '@endfield-noclip/package-format/oem';
+import type { StatesInfo } from '@endfield-noclip/package-format/states';
+import { completedProgressionPicksByIndex } from '@endfield-noclip/package-format/story';
+import { areasShownIn, zonesAt, zonesAround } from '@endfield-noclip/package-format/stream-areas';
+
+import { pointViewKey } from '../../../viewer/src/scene/point-view-cache.ts';
+
+import { readCore } from './oem.ts';
+
+export const summary = 'validate every archive, point and authored preset: oem-check <release-directory>';
+
+/** command usage, available without opening the install */
+export const usage = 'usage: oem-check <release-directory>';
+
+export const run = async (args: string[]): Promise<void> => {
+	if (args.length !== 1) {
+		throw new Error(summary);
+	}
+	const root = resolve(args[0]);
+	const value: unknown = JSON.parse(await readFile(join(root, 'index.json'), 'utf8'));
+	if (!isCatalog(value)) {
+		throw new Error('invalid OEM catalog');
+	}
+	const catalog = value;
+	const cores = new Map<string, Awaited<ReturnType<typeof readCore>>>();
+	let archives = 0,
+		bytes = 0,
+		points = 0,
+		presets = 0,
+		unknown = 0,
+		views = 0,
+		fallbackViews = 0;
+	for (const [scene, entry] of Object.entries(catalog.packages)) {
+		// oxlint-disable-next-line no-await-in-loop -- bound memory while opening scene cores
+		const core = await readCore(join(root, entry.path));
+		if (
+			core.scene.id !== scene ||
+			core.generation !== entry.generation ||
+			core.version !== entry.version ||
+			core.source.buildGuid !== catalog.source.buildGuid ||
+			core.source.contentHash !== catalog.source.contentHash
+		) {
+			throw new Error(`package mismatch: ${scene}`);
+		}
+		cores.set(scene, core);
+		for (const archive of core.archives) {
+			// oxlint-disable-next-line no-await-in-loop -- metadata-only verification, no archive bodies read
+			const size = (await stat(join(root, entry.path, archive.name))).size;
+			if (archive.role !== 'core' && archive.size !== size) {
+				throw new Error(`archive size mismatch: ${scene}/${archive.name}`);
+			}
+			archives++;
+			bytes += size;
+		}
+	}
+	if (catalog.navigation) {
+		const data: unknown = JSON.parse(await readFile(join(root, catalog.navigation), 'utf8'));
+		if (
+			!isNavigation(data) ||
+			!matchesNavigation(data, catalog) ||
+			data.routes.some((r) => !cores.get(r.scene)?.levels.some((l) => l.id === r.level))
+		) {
+			throw new Error('navigation release/source/level mismatch');
+		}
+	}
+	const seen = new Set<string>();
+	for (const [subregion, path] of Object.entries(catalog.files)) {
+		// oxlint-disable-next-line no-await-in-loop -- release each partition before loading the next
+		const partition: unknown = JSON.parse(await readFile(join(root, path), 'utf8'));
+		if (!isCompanion(partition) || partition.release !== catalog.release) {
+			throw new Error(`invalid companion: ${path}`);
+		}
+		const states = new Map<string, StatesInfo>();
+		for (const point of partition.points) {
+			if (seen.has(point.id) || point.subregion !== subregion || catalog.pointIndex[point.id] !== subregion) {
+				throw new Error(`point index mismatch: ${point.id}`);
+			}
+			seen.add(point.id);
+			points++;
+			unknown += Number(point.unknown.length > 0);
+			const base = cores.get(point.scene)?.states;
+			if (!base || !cores.get(point.scene)?.levels.some((l) => l.id === point.level && l.instances > 0)) {
+				throw new Error(`missing level: ${point.id}`);
+			}
+			let merged = states.get(point.scene);
+			if (!merged) {
+				merged = companionStates(base, partition);
+				states.set(point.scene, merged);
+			}
+			if (catalog.framing) {
+				if (!point.view) {
+					throw new Error(`missing baked view: ${point.id}`);
+				}
+				const completed = completedProgressionPicksByIndex(merged.controls);
+				let visibleAreas: ReadonlySet<number> | null = null;
+				const areas = merged.streamAreas;
+				if (areas) {
+					let zones = zonesAt(areas, point.position);
+					if (zones.size === 0) {
+						zones = zonesAround(areas, point.position);
+					}
+					visibleAreas = areasShownIn(areas, zones);
+				}
+				const picks = new Map([
+					...cameraValues(merged.controls, point.position, visibleAreas, NO_TRIGGER_MEMORY).values,
+					...completed,
+				]);
+				const shown = groupsShown(merged, conditionResults(merged, resolveSceneValues(merged, picks)));
+				// oxlint-disable-next-line no-await-in-loop -- validate each point against the exact selected profile
+				const key = await pointViewKey(
+					cores.get(point.scene)!.generation,
+					point.level,
+					point.position,
+					shown,
+				);
+				if (
+					point.view.key !== key ||
+					Math.hypot(point.view.position[0] - point.position[0], point.view.position[2] - point.position[2]) <
+						9.999
+				) {
+					throw new Error(`invalid baked view binding or distance: ${point.id}`);
+				}
+				for (const interaction of point.view.interactions ?? []) {
+					const control = merged.controls.find((entry) => entry.id === interaction.control);
+					if (
+						!control ||
+						control.source.kind !== 'user' ||
+						resolveSceneValues(merged, picks)[merged.controls.indexOf(control)] !== interaction.before ||
+						!control.values.some((option) => option.value === interaction.after) ||
+						!point.view.clear
+					) {
+						throw new Error(`invalid obstruction preview: ${point.id}`);
+					}
+				}
+				views++;
+				fallbackViews += Number(!point.view.clear);
+			}
+			for (const preset of point.presets) {
+				presets++;
+				if (
+					point.condition &&
+					conditionVisible(
+						point.condition,
+						pointValues(
+							merged.controls,
+							resolveSceneValues(merged, pointPicks(merged.controls, preset.picks)),
+						),
+					) !== preset.satisfies
+				) {
+					throw new Error(`invalid preset: ${point.id}/${preset.id}`);
+				}
+			}
+		}
+	}
+	if (catalog.framing && catalog.framing.points !== views) {
+		throw new Error('baked view coverage mismatch');
+	}
+	if (seen.size !== Object.keys(catalog.pointIndex).length) {
+		throw new Error('catalog contains points absent from its partitions');
+	}
+	console.log(
+		JSON.stringify({
+			release: catalog.release,
+			scenes: cores.size,
+			archives,
+			bytes,
+			points,
+			presets,
+			unknown,
+			views,
+			fallbackViews,
+		}),
+	);
+};
diff --git a/packages/extractor/src/commands/oem-navigation.ts b/packages/extractor/src/commands/oem-navigation.ts
new file mode 100644
index 00000000..86219bf7
--- /dev/null
+++ b/packages/extractor/src/commands/oem-navigation.ts
@@ -0,0 +1,187 @@
+import { createHash } from 'node:crypto';
+import { mkdir, readFile, writeFile, link } from 'node:fs/promises';
+import { dirname, join, resolve } from 'node:path';
+import { parseArgs } from 'node:util';
+
+import { isNavigation, type Navigation, type Volume } from '@endfield-noclip/package-format/navigation';
+import { isCatalog, isCompanion, type Companion } from '@endfield-noclip/package-format/oem';
+
+import { withContext } from '../context.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+import { readCore } from './oem.ts';
+
+/* oxlint-disable no-await-in-loop -- bound file handles and preserve deterministic source order */
+const vector = (p: { x: number; y: number; z: number }): [number, number, number] => [p.x, p.y, p.z];
+
+export const summary =
+	'add source-authored navigation to a baked OEM release: oem-navigation <release> -o <releases> --config <config>';
+
+/** command usage, available without opening the install */
+export const usage = 'usage: oem-navigation <release> -o <releases> --config <config>';
+
+/** @param args command arguments @returns after writing a new immutable release without copying model bytes */
+export const run = async (args: string[]): Promise<void> => {
+	const { values, positionals } = parseArgs({
+		args,
+		allowPositionals: true,
+		options: { output: { type: 'string', short: 'o' }, config: { type: 'string' } },
+	});
+	if (positionals.length !== 1 || !values.output) {
+		throw new Error(summary);
+	}
+	const root = resolve(positionals[0]),
+		output = resolve(values.output);
+	const catalog: unknown = JSON.parse(await readFile(join(root, 'index.json'), 'utf8'));
+	if (!isCatalog(catalog)) {
+		throw new Error('invalid OEM catalog');
+	}
+	await withContext(values.config, async (ctx) => {
+		const build = await ctx.world.manifest();
+		if (build.guid !== catalog.source.buildGuid || build.contentHash !== catalog.source.contentHash) {
+			throw new Error('navigation game build differs from release');
+		}
+		const file = await ctx.vfs.find(VfsGroup.JsonData, 'Data/Json/GameplayConfig/MapRegionTable.json');
+		if (!file) {
+			throw new Error('missing MapRegionTable');
+		}
+		// Only normalized geometry is exported. The final validator rejects unsupported source fields/shapes.
+		// The local game table is normalized below and isNavigation validates every emitted number and shape.
+		// oxlint-disable-next-line typescript/no-unsafe-type-assertion -- source table, strict output validation before writing
+		const table = JSON.parse(new TextDecoder().decode(await ctx.vfs.readVerified(file))) as Record<
+			string,
+			{
+				levelId: string;
+				mapRegionType: number;
+				tierIndex: number;
+				priority: number;
+				shapeList: {
+					shapeType: number;
+					position: { x: number; y: number; z: number };
+					rotation: { x: number; y: number; z: number };
+					size: { x: number; y: number; z: number };
+					radius: number;
+					polyLinePoints: { x: number; y: number }[];
+				}[];
+			}[]
+		>;
+		const rows = Object.values(table).flat();
+		const levels = await ctx.world.levelConfigs();
+		const navigation: Navigation = {
+			version: 1,
+			release: '',
+			source: catalog.source,
+			generations: {},
+			routes: [],
+		};
+		const cores = new Map<string, Awaited<ReturnType<typeof readCore>>>();
+		for (const [scene, pack] of Object.entries(catalog.packages)) {
+			const core = await readCore(join(root, pack.path));
+			if (
+				core.generation !== pack.generation ||
+				core.source.buildGuid !== build.guid ||
+				core.source.contentHash !== build.contentHash
+			) {
+				throw new Error(`package mismatch ${scene}`);
+			}
+			cores.set(scene, core);
+			navigation.generations[scene] = core.generation;
+		}
+		const partitions = new Map<string, Companion>();
+		for (const [id, path] of Object.entries(catalog.files)) {
+			const payload: unknown = JSON.parse(await readFile(join(root, path), 'utf8'));
+			if (!isCompanion(payload) || payload.release !== catalog.release) {
+				throw new Error(`invalid companion ${id}`);
+			}
+			partitions.set(id, payload);
+			const keys = new Set<string>();
+			for (const point of payload.points) {
+				const key = `${point.scene}/${point.level}`;
+				if (keys.has(key)) {
+					continue;
+				}
+				keys.add(key);
+				const level = cores.get(point.scene)?.levels.find((l) => l.id === point.level);
+				if (!level) {
+					throw new Error(`missing route level ${point.level}`);
+				}
+				navigation.routes.push({
+					scene: point.scene,
+					level: point.level,
+					region: point.region,
+					subregion: id,
+					seamless: levels.get(point.level)?.isSeamless ?? false,
+					bounds: level.contentBounds,
+					volumes: rows
+						.filter((r) => r.levelId === point.level && r.mapRegionType === 3)
+						.map((r) => ({
+							tier: r.tierIndex,
+							priority: r.priority,
+							shapes: r.shapeList.map((s): Volume => {
+								if (![1, 2, 3].includes(s.shapeType)) {
+									throw new Error('unsupported map volume');
+								}
+								return {
+									kind: s.shapeType === 1 ? 'box' : s.shapeType === 2 ? 'sphere' : 'polygon',
+									position: vector(s.position),
+									rotation: vector(s.rotation),
+									size: vector(s.size),
+									radius: s.radius,
+									points: s.polyLinePoints.map((p) => [p.x, p.y]),
+								};
+							}),
+						})),
+				});
+			}
+		}
+		for (const route of navigation.routes) {
+			if (route.seamless || route.volumes.length) {
+				continue;
+			}
+			// Decorative content bounds can span kilometres. Without a tier volume, only the verified
+			// gameplay-point footprint is evidence for entering this independent scene.
+			const points = partitions
+				.get(route.subregion)!
+				.points.filter((p) => p.scene === route.scene && p.level === route.level);
+			const min = (axis: number): number => Math.min(...points.map((p) => p.position[axis])) - 10;
+			const max = (axis: number): number => Math.max(...points.map((p) => p.position[axis])) + 10;
+			route.bounds = { min: [min(0), min(1), min(2)], max: [max(0), max(1), max(2)] };
+		}
+		if (!isNavigation(navigation)) {
+			throw new Error('invalid navigation geometry');
+		}
+		const release = createHash('sha256')
+			.update(JSON.stringify({ base: catalog.release, navigation }))
+			.digest('hex')
+			.slice(0, 16);
+		navigation.release = release;
+		const destination = join(output, release);
+		await mkdir(destination, { recursive: false });
+		for (const [scene, core] of cores) {
+			for (const archive of core.archives) {
+				const target = join(destination, catalog.packages[scene].path, archive.name);
+				await mkdir(dirname(target), { recursive: true });
+				await link(join(root, catalog.packages[scene].path, archive.name), target);
+			}
+		}
+		for (const [id, payload] of partitions) {
+			payload.release = release;
+			const target = join(destination, catalog.files[id]);
+			await mkdir(dirname(target), { recursive: true });
+			await writeFile(target, JSON.stringify(payload));
+		}
+		await writeFile(join(destination, 'navigation.json'), JSON.stringify(navigation));
+		await writeFile(
+			join(destination, 'index.json'),
+			JSON.stringify({ ...catalog, release, navigation: 'navigation.json' }),
+		);
+		console.log(
+			JSON.stringify({
+				release,
+				routes: navigation.routes.length,
+				volumes: navigation.routes.reduce((n, r) => n + r.volumes.length, 0),
+				bytes: JSON.stringify(navigation).length,
+			}),
+		);
+	});
+};
diff --git a/packages/extractor/src/commands/oem-views.ts b/packages/extractor/src/commands/oem-views.ts
new file mode 100644
index 00000000..b3405d0c
--- /dev/null
+++ b/packages/extractor/src/commands/oem-views.ts
@@ -0,0 +1,426 @@
+import { createHash } from 'node:crypto';
+import { open, readFile, mkdir, writeFile, rename, link } from 'node:fs/promises';
+import { dirname, join, resolve } from 'node:path';
+import { parseArgs } from 'node:util';
+
+import { cameraValues, NO_TRIGGER_MEMORY } from '@endfield-noclip/package-format/camera';
+import {
+	conditionResults,
+	groupsShown,
+	resolveSceneValues,
+} from '@endfield-noclip/package-format/conditions';
+import { isNavigation, matchesNavigation } from '@endfield-noclip/package-format/navigation';
+import {
+	companionStates,
+	isCatalog,
+	isCompanion,
+	isPointView,
+	type Companion,
+	type Point,
+} from '@endfield-noclip/package-format/oem';
+import { completedProgressionPicksByIndex } from '@endfield-noclip/package-format/story';
+import { areasShownIn, zonesAt, zonesAround } from '@endfield-noclip/package-format/stream-areas';
+import { isTerrainHole, TERRAIN_PAGE_SAMPLES, terrainHeight } from '@endfield-noclip/package-format/terrain';
+import { tileAt, tileId } from '@endfield-noclip/package-format/tiles';
+
+import { decodeData } from '../../../viewer/src/package/decode-data.ts';
+import { SharedBytes, type DecodeJob, type DecodePool } from '../../../viewer/src/package/decode-pool.ts';
+import type { Decoded } from '../../../viewer/src/package/decode-protocol.ts';
+import type { PackageSource } from '../../../viewer/src/package/package-source.ts';
+import { openViewerPackage } from '../../../viewer/src/package/viewer-package.ts';
+import { pointPreview } from '../../../viewer/src/scene/point-preview.ts';
+import { pointViewKey } from '../../../viewer/src/scene/point-view-cache.ts';
+import { buildTileTree } from '../../../viewer/src/scene/tile-tree.ts';
+import { arrivalFraming } from '../game/arrival-view.ts';
+
+/* oxlint-disable no-await-in-loop -- process in scene order to bound memory and checkpoint deterministic output */
+export const summary =
+	'bake every completed-profile point view into a new immutable release: oem-views <release> -o <releases> --cache <work-directory>';
+
+/** command usage, available without opening the install */
+export const usage =
+	'usage: oem-views <release> -o <releases> --cache <work-directory> [--scenes map01,map02] [--subregions WL_1,WL_2] [--points <id>,<id>] [--rebuild] [--arrival-routes routes.json]';
+
+export const run = async (args: string[]): Promise<void> => {
+	const { values, positionals } = parseArgs({
+		args,
+		allowPositionals: true,
+		options: {
+			output: { type: 'string', short: 'o' },
+			cache: { type: 'string' },
+			scenes: { type: 'string' },
+			subregions: { type: 'string' },
+			points: { type: 'string' },
+			rebuild: { type: 'boolean', default: false },
+			'arrival-routes': { type: 'string' },
+		},
+	});
+	if (positionals.length !== 1 || !values.output || !values.cache) {
+		throw new Error(summary);
+	}
+	const root = resolve(positionals[0]),
+		output = resolve(values.output),
+		cache = resolve(values.cache);
+	const raw: unknown = JSON.parse(await readFile(join(root, 'index.json'), 'utf8'));
+	if (!isCatalog(raw)) {
+		throw new Error('invalid source OEM release');
+	}
+	const catalog = raw;
+	const arrivals = new Map<string, [number, number, number][]>();
+	let routeBinding = 'none';
+	if (values['arrival-routes']) {
+		const text = await readFile(resolve(values['arrival-routes']), 'utf8');
+		const data: unknown = JSON.parse(text);
+		if (
+			!data ||
+			typeof data !== 'object' ||
+			!('release' in data) ||
+			data.release !== catalog.release ||
+			!('routes' in data) ||
+			!Array.isArray(data.routes)
+		) {
+			throw new Error('arrival routes must bind the exact input release');
+		}
+		for (const row of data.routes) {
+			if (
+				!row ||
+				typeof row !== 'object' ||
+				typeof row.id !== 'string' ||
+				row.status !== 'complete' ||
+				!Array.isArray(row.points) ||
+				row.points.length < 1 ||
+				row.points.some(
+					(p: unknown) =>
+						!Array.isArray(p) ||
+						p.length !== 3 ||
+						!p.every((v: unknown) => typeof v === 'number' && Number.isFinite(v)),
+				) ||
+				arrivals.has(row.id)
+			) {
+				throw new Error('invalid or duplicate arrival route');
+			}
+			arrivals.set(row.id, row.points);
+		}
+		routeBinding = createHash('sha256').update('arrival-view-v2:').update(text).digest('hex');
+	}
+	const points = values.points ? new Set(values.points.split(',')) : null;
+	const scenes = values.scenes ? new Set(values.scenes.split(',')) : null;
+	const subregions = values.subregions ? new Set(values.subregions.split(',')) : null;
+	if (subregions && [...subregions].some((id) => !Object.hasOwn(catalog.files, id))) {
+		throw new Error('unknown framing partition');
+	}
+	if (scenes && [...scenes].some((scene) => !Object.hasOwn(catalog.packages, scene))) {
+		throw new Error('unknown framing scene');
+	}
+	await mkdir(cache, { recursive: true });
+	const partitions = new Map<string, Companion>();
+	for (const [id, path] of Object.entries(catalog.files)) {
+		const value: unknown = JSON.parse(await readFile(join(root, path), 'utf8'));
+		if (!isCompanion(value) || value.release !== catalog.release) {
+			throw new Error(`invalid companion ${id}`);
+		}
+		partitions.set(id, value);
+	}
+	for (const id of arrivals.keys()) {
+		if (![...partitions.values()].some((p) => p.points.some((point) => point.id === id))) {
+			throw new Error(`unknown arrival target ${id}`);
+		}
+	}
+	if (
+		points &&
+		[...points].some((id) => ![...partitions.values()].some((p) => p.points.some((point) => point.id === id)))
+	) {
+		throw new Error('unknown framing point');
+	}
+	const decoder: Pick<DecodePool, 'run'> = {
+		async run<J extends DecodeJob>(job: J): Promise<Extract<Decoded, { kind: J['kind'] }>> {
+			const data = job.bytes.data;
+			const { response } = await decodeData({ ...job, id: 0, buffer: 0, last: true }, data);
+			if (response.kind === 'error' || response.kind !== job.kind) {
+				throw new Error('offline decoder kind mismatch');
+			}
+			// The discriminant matches J; TypeScript cannot narrow a generic conditional return type.
+			// oxlint-disable-next-line typescript/no-unsafe-type-assertion -- discriminant checked against the generic job above
+			return response as Extract<Decoded, { kind: J['kind'] }>;
+		},
+	};
+	let count = 0,
+		fallback = 0;
+	const started = performance.now();
+	for (const [scene, entry] of Object.entries(catalog.packages)) {
+		if (scenes && !scenes.has(scene)) {
+			continue;
+		}
+		const handles = new Map<string, ReturnType<typeof open>>();
+		const handle = (path: string) => {
+			let pending = handles.get(path);
+			if (!pending) {
+				pending = open(join(root, entry.path, path), 'r');
+				handles.set(path, pending);
+			}
+			return pending;
+		};
+		const source: PackageSource = {
+			label: scene,
+			async readFile(path) {
+				return Uint8Array.from(await readFile(join(root, entry.path, path)));
+			},
+			async readRange(path, range, signal) {
+				signal?.throwIfAborted();
+				const file = await handle(path);
+				if ((await file.stat()).size !== range.fileSize) {
+					throw new Error(`archive size mismatch ${scene}/${path}`);
+				}
+				const bytes = new Uint8Array(range.length);
+				let offset = 0;
+				while (offset < bytes.length) {
+					const { bytesRead } = await file.read(bytes, offset, bytes.length - offset, range.offset + offset);
+					if (bytesRead === 0) {
+						throw new Error(`short archive read ${path}`);
+					}
+					offset += bytesRead;
+				}
+				return bytes;
+			},
+		};
+		try {
+			const pkg = await openViewerPackage(source, () => {});
+			if (
+				pkg.manifest.generation !== entry.generation ||
+				pkg.manifest.version !== entry.version ||
+				pkg.manifest.source.buildGuid !== catalog.source.buildGuid ||
+				pkg.manifest.source.contentHash !== catalog.source.contentHash
+			) {
+				throw new Error(`source mismatch ${scene}`);
+			}
+			const tree = buildTileTree(pkg.manifest, pkg.tree),
+				heights = new Map<number, Uint16Array>();
+			const terrain = pkg.manifest.terrain;
+			const heightAt = (x: number, z: number): number | null => {
+				if (!terrain) {
+					return null;
+				}
+				for (let level = tree.terrainLeafLevel; level >= tree.terrainRootLevel; level--) {
+					const node = tree.byId.get(tileId(tileAt(pkg.manifest.tree, level, x, z))),
+						blob = node?.terrain?.blob;
+					const samples = blob === undefined ? undefined : heights.get(blob);
+					if (!node || !samples) {
+						continue;
+					}
+					const side = TERRAIN_PAGE_SAMPLES,
+						spacing = node.size / (side - 1),
+						fx = Math.min(side - 1, Math.max(0, (x - node.minX) / spacing)),
+						fz = Math.min(side - 1, Math.max(0, (z - node.minZ) / spacing));
+					const sample = samples[Math.round(fz) * side + Math.round(fx)];
+					return isTerrainHole(sample) ? null : terrainHeight(terrain, sample);
+				}
+				return null;
+			};
+			const prepareTerrain = async (point: Point) => {
+				if (!terrain) {
+					return;
+				}
+				for (let level = tree.terrainRootLevel; level <= tree.terrainLeafLevel; level++) {
+					const min = tileAt(pkg.manifest.tree, level, point.position[0] - 16, point.position[2] - 16),
+						max = tileAt(pkg.manifest.tree, level, point.position[0] + 16, point.position[2] + 16);
+					for (let x = min.x; x <= max.x; x++) {
+						for (let z = min.z; z <= max.z; z++) {
+							const blob = tree.byId.get(tileId({ level, x, z }))?.terrain?.blob;
+							if (blob === undefined || heights.has(blob)) {
+								continue;
+							}
+							const record = pkg.blobs[blob];
+							let data: ArrayBuffer;
+							if (record.archive === 0) {
+								data = await pkg.readCoreBlob(blob);
+							} else {
+								const range = pkg.blobRange(blob);
+								data = (
+									await source.readRange(range.path, {
+										offset: range.start,
+										length: range.length,
+										fileSize: range.archiveSize,
+									})
+								).buffer;
+							}
+							const decoded = await decoder.run(
+								{
+									kind: 'heights',
+									bytes: new SharedBytes(data, 1),
+									offset: 0,
+									length: data.byteLength,
+									codec: record.codec,
+									rawLength: record.rawLength,
+								},
+								new AbortController().signal,
+							);
+							heights.set(blob, decoded.samples);
+						}
+					}
+				}
+			};
+			for (const [subregion, partition] of partitions) {
+				if (subregions && !subregions.has(subregion)) {
+					continue;
+				}
+				const rows = partition.points
+					.filter((p) => p.scene === scene && (!points || points.has(p.id)))
+					.toSorted(
+						(a, b) =>
+							Math.floor(a.position[0] / 64) - Math.floor(b.position[0] / 64) ||
+							Math.floor(a.position[2] / 64) - Math.floor(b.position[2] / 64),
+					);
+				if (rows.length === 0) {
+					continue;
+				}
+				const states = companionStates(pkg.manifest.states, partition);
+				const completed = completedProgressionPicksByIndex(states.controls);
+				const checkpoint = join(
+					cache,
+					`${scene}-${subregion}${routeBinding === 'none' ? '' : '-' + routeBinding}.json`,
+				);
+				let saved: Record<string, NonNullable<Point['view']>> = {};
+				try {
+					const value: unknown = JSON.parse(await readFile(checkpoint, 'utf8'));
+					if (
+						!value ||
+						typeof value !== 'object' ||
+						Array.isArray(value) ||
+						!Object.values(value).every(isPointView)
+					) {
+						throw new Error('invalid view checkpoint');
+					}
+					saved = Object.fromEntries(
+						Object.entries(value).filter((item): item is [string, NonNullable<Point['view']>] =>
+							isPointView(item[1]),
+						),
+					);
+				} catch (error) {
+					if (!(error instanceof Error && 'code' in error && error.code === 'ENOENT')) {
+						throw error;
+					}
+				}
+				const flush = async () => {
+					await writeFile(checkpoint + '.tmp', JSON.stringify(saved));
+					await rename(checkpoint + '.tmp', checkpoint);
+				};
+				for (const point of rows) {
+					const areas = states.streamAreas;
+					let visibleAreas: ReadonlySet<number> | null = null;
+					if (areas) {
+						let zones = zonesAt(areas, point.position);
+						if (zones.size === 0) {
+							zones = zonesAround(areas, point.position);
+						}
+						visibleAreas = areasShownIn(areas, zones);
+					}
+					const level = pkg.manifest.levels.find((l) => l.id === point.level);
+					if (!level) {
+						throw new Error(`missing point level ${point.id}`);
+					}
+					const picks = new Map([
+						...cameraValues(states.controls, point.position, visibleAreas, NO_TRIGGER_MEMORY).values,
+						...completed,
+					]);
+					const shown = groupsShown(states, conditionResults(states, resolveSceneValues(states, picks)));
+					const key = await pointViewKey(pkg.manifest.generation, point.level, point.position, shown);
+					let view = saved[point.id];
+					if (values.rebuild || !view || view.key !== key) {
+						await prepareTerrain(point);
+						const arrival = arrivals.get(point.id);
+						if (arrival && Math.hypot(...arrival.at(-1)!.map((v, axis) => v - point.position[axis])) > 1) {
+							throw new Error(`arrival route misses target ${point.id}`);
+						}
+						const framing = arrival ? arrivalFraming(arrival) : undefined;
+						const pose = await pointPreview(
+							pkg,
+							decoder,
+							point.position,
+							states,
+							pkg.manifest.levels.indexOf(level),
+							picks,
+							heightAt,
+							new AbortController().signal,
+							framing,
+						);
+						view = { key, ...pose };
+						saved[point.id] = view;
+					}
+					point.view = view;
+					count++;
+					fallback += Number(!view.clear);
+					if (count % 100 === 0) {
+						await flush();
+						console.log(
+							`${scene}: ${count} points, ${fallback} fallbacks, ${Math.round((performance.now() - started) / 1000)} s`,
+						);
+					}
+					// Keep only height pages needed around the next target; instances/geometry have their own bounded cache.
+					if (heights.size > 512) {
+						heights.clear();
+					}
+				}
+				await flush();
+			}
+		} finally {
+			for (const file of handles.values()) {
+				await (await file).close();
+			}
+		}
+	}
+	if (scenes || subregions || points) {
+		console.log(
+			JSON.stringify({
+				scenes: scenes ? [...scenes] : null,
+				subregions: subregions ? [...subregions] : null,
+				points: count,
+				fallback,
+				seconds: Math.round((performance.now() - started) / 1000),
+				checkpointOnly: true,
+			}),
+		);
+		return;
+	}
+	const release = createHash('sha256')
+		.update(JSON.stringify({ base: catalog.release, framing: 3, partitions: [...partitions] }))
+		.digest('hex')
+		.slice(0, 16);
+	const destination = join(output, release);
+	await mkdir(destination, { recursive: false });
+	for (const entry of Object.values(catalog.packages)) {
+		const dir = join(root, entry.path);
+		// Only immutable release archives are linked; later pack operations replace different paths atomically.
+		const core = await import('./oem.ts').then((m) => m.readCore(dir));
+		for (const archive of core.archives) {
+			const target = join(destination, entry.path, archive.name);
+			await mkdir(dirname(target), { recursive: true });
+			await link(join(dir, archive.name), target);
+		}
+	}
+	for (const [id, partition] of partitions) {
+		partition.release = release;
+		const target = join(destination, catalog.files[id]);
+		await mkdir(dirname(target), { recursive: true });
+		await writeFile(target, JSON.stringify(partition));
+	}
+	if (catalog.navigation) {
+		const navigation: unknown = JSON.parse(await readFile(join(root, catalog.navigation), 'utf8'));
+		if (!isNavigation(navigation) || !matchesNavigation(navigation, catalog)) {
+			throw new Error('invalid navigation companion');
+		}
+		await writeFile(join(destination, catalog.navigation), JSON.stringify({ ...navigation, release }));
+	}
+	await writeFile(
+		join(destination, 'index.json'),
+		JSON.stringify({ ...catalog, release, framing: { version: 7, profile: 'completed', points: count } }),
+	);
+	console.log(
+		JSON.stringify({
+			release,
+			points: count,
+			fallback,
+			seconds: Math.round((performance.now() - started) / 1000),
+			destination,
+		}),
+	);
+};
diff --git a/packages/extractor/src/commands/oem.ts b/packages/extractor/src/commands/oem.ts
new file mode 100644
index 00000000..a51178ce
--- /dev/null
+++ b/packages/extractor/src/commands/oem.ts
@@ -0,0 +1,431 @@
+import { createHash } from 'node:crypto';
+import { constants } from 'node:fs';
+import { cp, mkdir, readFile, writeFile } from 'node:fs/promises';
+import { join, resolve } from 'node:path';
+import { parseArgs } from 'node:util';
+import { zstdDecompressSync } from 'node:zlib';
+
+import type { MemoryPackValue } from '@endfield-noclip/formats/endfield/memory-pack';
+import {
+	PACKAGE_FORMAT,
+	PACKAGE_VERSION,
+	type PackageManifest,
+} from '@endfield-noclip/package-format/manifest';
+import {
+	companionStates,
+	type Catalog,
+	type Companion,
+	type CompanionControl,
+	type Point,
+} from '@endfield-noclip/package-format/oem';
+import type { Vec3 } from '@endfield-noclip/package-format/values';
+
+import { fromUint8Array, openArchive } from '@mary-ext/czar';
+
+import { withContext } from '../context.ts';
+import { pointPresets } from '../game/oem-presets.ts';
+import { GameState, type GameCondition } from '../game/state/game-state.ts';
+import { labelStory, mainStoryOrder } from '../game/state/story.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+/* oxlint-disable no-await-in-loop -- one stateful decoder and bounded archive copies; never decode concurrently */
+
+export const summary =
+	'export an immutable OEM companion release: oem --atlos <talos> --packages <dir> -o <dir>';
+
+/** command usage, available without opening the install */
+export const usage = 'usage: oem --atlos <talos> --packages <dir> -o <releases>';
+
+type Node = { [key: string]: MemoryPackValue };
+const node = (v: MemoryPackValue | undefined): Node => {
+	if (v === null || typeof v !== 'object' || Array.isArray(v)) {
+		throw new Error('expected a game data object');
+	}
+	return v;
+};
+const list = (v: MemoryPackValue | undefined): MemoryPackValue[] => (Array.isArray(v) ? v : []);
+const text = (v: MemoryPackValue | undefined): string => {
+	if (typeof v !== 'string' && typeof v !== 'number') {
+		throw new Error('expected an identifier');
+	}
+	return String(v);
+};
+const vec = (v: MemoryPackValue | undefined): Vec3 => {
+	if (
+		Array.isArray(v) &&
+		v.length === 3 &&
+		typeof v[0] === 'number' &&
+		typeof v[1] === 'number' &&
+		typeof v[2] === 'number' &&
+		v.every(Number.isFinite)
+	) {
+		return [v[0], v[1], v[2]];
+	}
+	const p = node(v);
+	if (typeof p.x !== 'number' || typeof p.y !== 'number' || typeof p.z !== 'number') {
+		throw new Error('invalid position');
+	}
+	return [p.x, p.y, p.z];
+};
+
+const condition = (value: MemoryPackValue | undefined): GameCondition | null => {
+	if (value == null) {
+		return null;
+	}
+	const v = node(value),
+		type = text(v.$type);
+	if (type.includes('CombinedConditionRuntime')) {
+		const children = list(v.subConditions).map(condition);
+		if (children.some((c) => c === null) || ![0, 1].includes(Number(v.conditionOperator))) {
+			throw new Error('unsupported combined prerequisite');
+		}
+		return {
+			kind: Number(v.conditionOperator) === 0 ? 'all' : 'any',
+			reverse: Boolean(v.reverse),
+			conditions: children.filter((c) => c !== null),
+		};
+	}
+	const kind = type.includes('SimpleConditionCheckQuestState')
+		? 'quest'
+		: type.includes('SimpleConditionCheckMissionState')
+			? 'mission'
+			: null;
+	if (kind === null) {
+		throw new Error(`unsupported prerequisite ${type}`);
+	}
+	const id = v[kind === 'quest' ? 'questId' : 'missionId'],
+		compare = v.compareOperator,
+		target = v.compareTarget;
+	if (
+		typeof id !== 'string' ||
+		typeof compare !== 'number' ||
+		![0, 1, 2, 3, 4, 5].includes(compare) ||
+		typeof target !== 'number'
+	) {
+		throw new Error('invalid quest prerequisite');
+	}
+	// oxlint-disable-next-line typescript/no-unsafe-type-assertion -- enum domain checked above
+	return { kind, id, compare: compare as 0 | 1 | 2 | 3 | 4 | 5, target };
+};
+
+/**
+ * reads a core without importing the browser viewer or changing its archive format.
+ *
+ * @param path package directory
+ * @returns the current package's manifest
+ * @throws {Error} for a foreign or incompatible package
+ */
+export const readCore = async (path: string): Promise<PackageManifest> => {
+	const archive = await openArchive(fromUint8Array(await readFile(join(path, 'core.czar'))));
+	const entry = archive.get('manifest.json.zst');
+	if (!entry) {
+		throw new Error(`missing manifest in ${path}`);
+	}
+	const value: unknown = JSON.parse(zstdDecompressSync(await entry.bytes()).toString());
+	if (
+		!value ||
+		typeof value !== 'object' ||
+		!('format' in value) ||
+		value.format !== PACKAGE_FORMAT ||
+		!('version' in value) ||
+		value.version !== PACKAGE_VERSION
+	) {
+		throw new Error(`incompatible package ${path}`);
+	}
+	// oxlint-disable-next-line typescript/no-unsafe-type-assertion -- same versioned contract as the viewer's core reader
+	return value as PackageManifest;
+};
+
+export const run = async (args: string[]): Promise<void> => {
+	const { values } = parseArgs({
+		args,
+		options: {
+			config: { type: 'string' },
+			atlos: { type: 'string' },
+			packages: { type: 'string' },
+			output: { type: 'string', short: 'o' },
+		},
+	});
+	if (!values.atlos || !values.packages || !values.output) {
+		throw new Error(summary);
+	}
+	const atlos = resolve(values.atlos),
+		packages = resolve(values.packages),
+		output = resolve(values.output);
+	const sceneIds = [
+		'map01',
+		'map02',
+		'indie_dg005',
+		'indie_dg007',
+		'indie_dg016',
+		'base01_lv001',
+		'dung01_wrdg001',
+	];
+	const cores = new Map<string, PackageManifest>();
+	for (const scene of sceneIds) {
+		cores.set(scene, await readCore(join(packages, scene)));
+	}
+	await withContext(values.config, async (ctx) => {
+		const bundle = await ctx.world.manifest();
+		const source = { buildGuid: bundle.guid, contentHash: bundle.contentHash };
+		for (const [scene, core] of cores) {
+			if (
+				core.scene.id !== scene ||
+				JSON.stringify(core.source) !== JSON.stringify(source) ||
+				core.subset !== null
+			) {
+				throw new Error(`package/source mismatch or partial package: ${scene}`);
+			}
+		}
+		const group = await ctx.vfs.group(VfsGroup.JsonData),
+			reader = await ctx.memoryPack();
+		const read = async (path: string): Promise<Uint8Array> => {
+			const f = await ctx.vfs.find(VfsGroup.JsonData, path);
+			if (!f) {
+				throw new Error(`missing ${path}`);
+			}
+			return ctx.vfs.readVerified(f);
+		};
+		const placements = new Map<string, { row: Node; level: string; path: string; kind: string }>();
+		const locks = new Map<string, Node[]>();
+		const levels = await ctx.world.levelConfigs();
+		const sceneFor = (level: string): string =>
+			levels.get(level)?.defaultState.exportedSceneConfigPath?.split('/')[0] ?? '';
+		for (const path of group.files.keys()) {
+			const match = /^Data\/Json\/LevelData\/([^/]+)\//.exec(path);
+			if (!match || !sceneIds.includes(sceneFor(match[1]))) {
+				continue;
+			}
+			const data = node(reader.decode(await read(path), 'Beyond_Gameplay_LevelDataForMemoryPack'));
+			for (const kind of ['interactives', 'enemies', 'npcs']) {
+				for (const entry of list(data[kind])) {
+					const row = node(entry),
+						id = text(row.levelLogicId);
+					const previous = placements.get(id);
+					if (previous && previous.level !== match[1]) {
+						throw new Error(`ambiguous entity ${id}`);
+					}
+					placements.set(id, { row, level: match[1], path, kind });
+				}
+			}
+			for (const entry of list(data.interactiveLockData)) {
+				const lock = node(entry);
+				locks.set(text(lock.logicIdGlobal), list(lock.locks).map(node));
+			}
+		}
+		const registryPath = 'Data/Json/GameplayConfig/WorldEntityRegistry.json';
+		const registry: Node = node(JSON.parse(new TextDecoder().decode(await read(registryPath))));
+		const proxies = node(registry.npcProxyBriefInfos);
+		const proxyTable = node(
+			JSON.parse(new TextDecoder().decode(await read('Data/Json/GameplayConfig/NpcProxyTable.json'))),
+		);
+		const proxyLevels = node(proxyTable.dataTable);
+		const game = new GameState();
+		const regionConfig: unknown = JSON.parse(await readFile(join(atlos, 'src/data/map/region.json'), 'utf8'));
+		if (!regionConfig || typeof regionConfig !== 'object' || Array.isArray(regionConfig)) {
+			throw new Error('invalid OEM region configuration');
+		}
+		const subregions = new Map<string, string>();
+		for (const [region, config] of Object.entries(regionConfig)) {
+			if (
+				!config ||
+				typeof config !== 'object' ||
+				!('subregions' in config) ||
+				!Array.isArray(config.subregions)
+			) {
+				throw new Error(`invalid subregions for ${region}`);
+			}
+			for (const subregion of config.subregions) {
+				if (typeof subregion !== 'string' || !/^[A-Z]+_\d+$/.test(subregion) || subregions.has(subregion)) {
+					throw new Error(`invalid or duplicate OEM subregion: ${String(subregion)}`);
+				}
+				subregions.set(subregion, region);
+			}
+		}
+		const partitions = new Map<string, Point[]>();
+		for (const [subregion, region] of [...subregions].toSorted(([a], [b]) => a.localeCompare(b))) {
+			const file = `${subregion}.json`;
+			const rows: unknown = JSON.parse(await readFile(join(atlos, 'src/data/marker/data', file), 'utf8'));
+			if (!Array.isArray(rows)) {
+				throw new Error(`invalid marker partition ${file}`);
+			}
+			const points: Point[] = [];
+			for (const raw of rows) {
+				if (!Array.isArray(raw) || raw.length < 6 || !Number.isFinite(raw[4])) {
+					throw new Error(`invalid marker tuple in ${file}`);
+				}
+				const id = String(raw[0]),
+					placed = placements.get(id),
+					proxy = proxies[id];
+				if (!placed && !proxy) {
+					throw new Error(`unresolved point ${id}`);
+				}
+				const proxyConfig = proxy ? node(proxyLevels[text(node(proxy).proxyId)]) : undefined;
+				const level = placed?.level ?? text(proxyConfig?.levelId ?? '');
+				const scene = sceneFor(level),
+					core = cores.get(scene);
+				if (!core || !core.levels.some((l) => l.id === level && l.instances > 0)) {
+					throw new Error(`no packed level for ${id}: ${scene}/${level}`);
+				}
+				const unknown: string[] = [],
+					row = placed?.row ?? node(proxy);
+				let gate: GameCondition | null = null;
+				try {
+					gate = condition(row.progressLockCondition);
+				} catch (error) {
+					unknown.push(error instanceof Error ? error.message : String(error));
+				}
+				const prerequisite = gate ? { alternatives: game.requirements(gate) } : null;
+				if (!placed) {
+					unknown.push('npc-activation');
+				}
+				if (placed && row.createState !== 0) {
+					unknown.push('script-spawn');
+				}
+				const lockKinds = new Map([
+					[1, 'ScriptLock'],
+					[2, 'MiniGame'],
+					[4, 'Quest'],
+					[5, 'Sludge'],
+				]);
+				const pointLocks = (locks.get(id) ?? []).map((lock) => ({
+					kind: lockKinds.get(Number(lock.unlockType)) ?? `Unknown:${text(lock.unlockType)}`,
+					quests: typeof lock.questId === 'string' && lock.questId ? [lock.questId] : [],
+					games: list(lock.miniGameIds).map(String),
+				}));
+				if (pointLocks.length) {
+					unknown.push('interaction-runtime');
+				}
+				points.push({
+					id,
+					scene,
+					level,
+					region,
+					subregion,
+					tier: Number(raw[4]),
+					position: vec(row.position),
+					condition: prerequisite,
+					locks: pointLocks,
+					drivers:
+						core.states.controls.find((c) => c.kind === 'script' && c.id === `script:${id}`)?.drivers ?? [],
+					unknown,
+					presets: [],
+					source: {
+						path: placed?.path ?? registryPath,
+						kind: placed?.kind ?? 'npc-proxy',
+						createState: typeof row.createState === 'number' ? row.createState : null,
+					},
+				});
+			}
+			partitions.set(subregion, points);
+		}
+		const drafts = game.controls(),
+			missions = await labelStory(ctx.world, drafts);
+		const extra: CompanionControl[] = drafts.map((control) => {
+			if (control.source.kind !== 'user') {
+				throw new Error(`companion control ${control.id} is not user-set`);
+			}
+			return { ...control, source: control.source };
+		});
+		const labels: Companion['labels'] = {};
+		for (const [locale, language] of Object.entries({
+			'en-US': 'EN',
+			'zh-CN': 'CN',
+			'zh-TW': 'TC',
+			'ja-JP': 'JP',
+			'ko-KR': 'KR',
+			'ru-RU': 'RU',
+			'es-ES': 'MX',
+			'pt-BR': 'BR',
+			'de-DE': 'DE',
+			'fr-FR': 'FR',
+			'vi-VN': 'VN',
+			'th-TH': 'TH',
+			'id-ID': 'ID',
+			'it-IT': 'IT',
+		})) {
+			const controls = extra.map((c) => ({ ...c })),
+				names = await labelStory(ctx.world, controls, language);
+			labels[locale] = Object.fromEntries(
+				controls.map((c) => {
+					const story = c.story;
+					const mission = names.find((m) => m.id === story?.mission)?.name;
+					return [c.id, c.story?.role === 'quest' && mission ? `${mission}: ${c.name}` : c.name];
+				}),
+			);
+		}
+		const payloads = new Map<string, Companion>();
+		const presets = new Map<string, Point['presets']>();
+		for (const [subregion, points] of partitions) {
+			for (const p of points) {
+				const states = companionStates(cores.get(p.scene)!.states, { controls: extra, missions });
+				states.mainStory = mainStoryOrder(states.missions).map((id) =>
+					states.missions.findIndex((mission) => mission.id === id),
+				);
+				const key = `${p.scene}:${JSON.stringify(p.condition)}`;
+				let choices = presets.get(key);
+				if (!choices) {
+					choices = pointPresets(states, p.condition);
+					presets.set(key, choices);
+				}
+				p.presets = choices;
+				if (!p.presets.some((preset) => preset.satisfies)) {
+					p.unknown.push('no-consistent-story-preset');
+				}
+			}
+			payloads.set(subregion, { version: 1, release: '', controls: extra, missions, labels, points });
+		}
+		const release = createHash('sha256')
+			.update(
+				JSON.stringify({
+					source,
+					generations: [...cores.values()].map((c) => c.generation),
+					payloads: [...payloads],
+				}),
+			)
+			.digest('hex')
+			.slice(0, 16);
+		const destination = join(output, release);
+		await mkdir(join(destination, 'points'), { recursive: true });
+		const catalog: Catalog = {
+			format: 'oem-noclip',
+			version: 1,
+			release,
+			source,
+			packages: {},
+			files: {},
+			pointIndex: {},
+		};
+		for (const [scene, core] of cores) {
+			catalog.packages[scene] = {
+				path: `packages/${scene}/`,
+				generation: core.generation,
+				version: core.version,
+			};
+			for (const archive of core.archives) {
+				const target = join(destination, 'packages', scene, archive.name);
+				await mkdir(resolve(target, '..'), { recursive: true });
+				await cp(join(packages, scene, archive.name), target, {
+					force: false,
+					errorOnExist: true,
+					mode: constants.COPYFILE_FICLONE,
+				});
+			}
+		}
+		for (const [id, payload] of payloads) {
+			payload.release = release;
+			catalog.files[id] = `points/${id}.json`;
+			for (const point of payload.points) {
+				if (catalog.pointIndex[point.id]) {
+					throw new Error(`duplicate point ${point.id}`);
+				}
+				catalog.pointIndex[point.id] = id;
+			}
+			await writeFile(join(destination, catalog.files[id]), JSON.stringify(payload));
+		}
+		await writeFile(join(destination, 'index.json'), JSON.stringify(catalog));
+		console.log(
+			`OEM release ${release}: ${Object.keys(catalog.pointIndex).length} points, ${cores.size} scenes, ${destination}`,
+		);
+	});
+};
diff --git a/packages/extractor/src/commands/player-ground.test.ts b/packages/extractor/src/commands/player-ground.test.ts
new file mode 100644
index 00000000..56af04e6
--- /dev/null
+++ b/packages/extractor/src/commands/player-ground.test.ts
@@ -0,0 +1,31 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { run } from './player-ground.ts';
+
+const args = (bounds: string, cellSize = '0.15') => [
+	'map01',
+	`--bounds=${bounds}`,
+	'--scene-state',
+	'0',
+	'--area',
+	'0',
+	'--movement-settings',
+	'unused.json',
+	'--collision-output',
+	'unused-collision.json',
+	'-o',
+	'unused-ground.json',
+	'--cell-size',
+	cellSize,
+];
+
+test('rejects unbounded source-cell loops before reading installation inputs', async () => {
+	await assert.rejects(run(args('1e24,0,2e24,10')), /collision cell budget/);
+	await assert.rejects(run(args('0,0,100000,100000')), /collision cell budget/);
+});
+
+test('rejects invalid voxel resolution and excessive tile work before extraction', async () => {
+	await assert.rejects(run(args('0,0,10,10', '0')), /resolution or tile budget/);
+	await assert.rejects(run(args('0,0,100,100', '0.0001')), /resolution or tile budget/);
+});
diff --git a/packages/extractor/src/commands/player-ground.ts b/packages/extractor/src/commands/player-ground.ts
new file mode 100644
index 00000000..22332a0a
--- /dev/null
+++ b/packages/extractor/src/commands/player-ground.ts
@@ -0,0 +1,257 @@
+import { createHash } from 'node:crypto';
+/* oxlint-disable no-await-in-loop -- retain one selected collision export at a time */
+import { mkdir, readFile, rename, writeFile } from 'node:fs/promises';
+import { resolve } from 'node:path';
+import { parseArgs, isDeepStrictEqual } from 'node:util';
+
+import { isObject, numberField, objectField, stringField } from '@endfield-noclip/formats/unity/values';
+
+import { buildGroundTiles } from '@opendfieldmap/ganglia/build';
+
+import { parseInteger } from '../cli-args.ts';
+import { withContext } from '../context.ts';
+import {
+	collisionGeometry,
+	walkableCollisionIndices,
+	type CollisionInputs,
+} from '../game/collision-ground.ts';
+import { collectCollisionInputs } from '../game/collision-inputs.ts';
+import { groundGeneratorIdentity, groundTileCache } from '../game/ground-tile-cache.ts';
+
+export const summary =
+	'build bounded player ground tiles from selected collision sources, including factory floors';
+export const usage =
+	'usage: endfield-extract player-ground <scene> --bounds <minX,minZ,maxX,maxZ> --scene-state <n> --area <n> --movement-settings <file> -o <ground-file> --collision-output <geometry-file> [--cell-size <m>] [--tile-cells <n>] [--tiles <x,z;x,z>] [--tile-cache <directory>] --config <config>; player-ground --identity';
+
+/**
+ * @param args source selection, build-bound movement parameters and explicit world bounds
+ * @returns after writing physical ground and collision evidence independently of AI navigation coverage
+ * @throws on unsupported source geometry, missing selected payloads, mismatched builds or failed tile builds
+ */
+export const run = async (args: string[]): Promise<void> => {
+	const { values, positionals } = parseArgs({
+		args,
+		allowPositionals: true,
+		options: {
+			bounds: { type: 'string' },
+			'scene-state': { type: 'string' },
+			area: { type: 'string' },
+			'movement-settings': { type: 'string' },
+			output: { type: 'string', short: 'o' },
+			'collision-output': { type: 'string' },
+			'cell-size': { type: 'string', default: '0.15' },
+			'tile-cells': { type: 'string', default: '256' },
+			tiles: { type: 'string' },
+			config: { type: 'string' },
+			'input-cache': { type: 'string' },
+			'tile-cache': { type: 'string' },
+			identity: { type: 'boolean' },
+		},
+	});
+	if (values.identity) {
+		console.log(JSON.stringify({ generator: await groundGeneratorIdentity() }));
+		return;
+	}
+	if (
+		positionals.length !== 1 ||
+		!values.bounds ||
+		values['scene-state'] === undefined ||
+		values.area === undefined ||
+		!values['movement-settings'] ||
+		!values.output ||
+		!values['collision-output'] ||
+		values.output === values['collision-output']
+	) {
+		throw new Error(usage);
+	}
+	const bounds = values.bounds.split(',').map(Number);
+	if (
+		bounds.length !== 4 ||
+		!bounds.every(Number.isFinite) ||
+		bounds[0] >= bounds[2] ||
+		bounds[1] >= bounds[3]
+	) {
+		throw new Error('invalid player ground bounds');
+	}
+	const minCell = [Math.floor(bounds[0] / 128) - 1, Math.floor(bounds[1] / 128) - 1];
+	const maxCell = [Math.floor(bounds[2] / 128) + 1, Math.floor(bounds[3] / 128) + 1];
+	const cellCount = (maxCell[0] - minCell[0] + 1) * (maxCell[1] - minCell[1] + 1);
+	if (![...minCell, ...maxCell, cellCount].every(Number.isSafeInteger) || cellCount > 512) {
+		throw new Error('player ground region exceeds the collision cell budget');
+	}
+	const cellSize = Number(values['cell-size']);
+	const tileCells = parseInteger(values['tile-cells'], '--tile-cells');
+	const tiles = values.tiles?.split(';').map((value) => {
+		if (!/^-?\d+,-?\d+$/.test(value)) {
+			throw new Error('invalid physical tile selection');
+		}
+		const [x, z] = value.split(',').map(Number);
+		return { x, z };
+	});
+	const tileSpan = cellSize * tileCells;
+	const tileRange = [
+		Math.floor(bounds[0] / tileSpan),
+		Math.floor(bounds[1] / tileSpan),
+		Math.ceil(bounds[2] / tileSpan),
+		Math.ceil(bounds[3] / tileSpan),
+	];
+	const tileCount = tiles?.length ?? (tileRange[2] - tileRange[0]) * (tileRange[3] - tileRange[1]);
+	if (
+		!Number.isFinite(cellSize) ||
+		cellSize <= 0 ||
+		tileCells < 1 ||
+		![...tileRange, tileCount].every(Number.isSafeInteger) ||
+		tileCount > 512
+	) {
+		throw new Error('player ground resolution or tile budget is invalid');
+	}
+	const movement: unknown = JSON.parse(await readFile(values['movement-settings'], 'utf8'));
+	if (
+		!isObject(movement) ||
+		!isObject(movement.source) ||
+		!isObject(movement.defaultProfile) ||
+		!Array.isArray(movement.assets)
+	) {
+		throw new Error('invalid movement export');
+	}
+	const asset = movement.assets.find(
+		(a) => isObject(a) && typeof a.path === 'string' && a.path.endsWith('/MovementSetting_Default.asset'),
+	);
+	if (!isObject(asset) || !isObject(asset.settings)) {
+		throw new Error('missing default movement settings');
+	}
+	const settings = asset.settings;
+	const source = {
+		buildGuid: stringField(movement.source, 'buildGuid'),
+		contentHash: stringField(movement.source, 'contentHash'),
+	};
+	const profile = {
+		radius: numberField(movement.defaultProfile, 'radius'),
+		height: numberField(movement.defaultProfile, 'height'),
+	};
+	const selection = {
+		sceneState: parseInteger(values['scene-state'], '--scene-state'),
+		area: parseInteger(values.area, '--area'),
+		layerMask: numberField(objectField(settings, '_collidableLayers'), 'm_Bits'),
+		solidsOnly: true,
+	};
+	const scene = positionals[0];
+	await withContext(values.config, async (ctx) => {
+		const manifest = await ctx.world.manifest();
+		if (source.buildGuid !== manifest.guid || source.contentHash !== manifest.contentHash) {
+			throw new Error('collision and movement sources must share a build');
+		}
+		const cells: ({ x: number; z: number } | 'global')[] = ['global'];
+		// Adjacent cells may own geometry intersecting the region despite an outside actor origin.
+		for (let x = minCell[0]; x <= maxCell[0]; x++) {
+			for (let z = minCell[1]; z <= maxCell[1]; z++) {
+				cells.push({ x, z });
+			}
+		}
+		const cacheKey = createHash('sha256')
+			.update(JSON.stringify({ source, scene, selection, format: 2 }))
+			.digest('hex');
+		const cacheDirectory = values['input-cache'] ? resolve(values['input-cache'], cacheKey) : null;
+		if (cacheDirectory) {
+			await mkdir(cacheDirectory, { recursive: true });
+		}
+		const inputs: CollisionInputs[] = [],
+			absent = [];
+		for (const cell of cells) {
+			if (!(await ctx.world.cellChunkFiles(scene, cell, selection)).length) {
+				absent.push(cell);
+				continue;
+			}
+			const cacheFile = cacheDirectory
+				? resolve(cacheDirectory, cell === 'global' ? 'global.json' : `${cell.x}_${cell.z}.json`)
+				: null;
+			let input: CollisionInputs | null = null;
+			if (cacheFile) {
+				try {
+					const cached: CollisionInputs = JSON.parse(await readFile(cacheFile, 'utf8'));
+					if (
+						cached.version === 1 &&
+						cached.scene === scene &&
+						cached.source.buildGuid === source.buildGuid &&
+						cached.source.contentHash === source.contentHash &&
+						isDeepStrictEqual(cached.selection, selection) &&
+						isDeepStrictEqual(cached.cell, cell)
+					) {
+						input = cached;
+					}
+				} catch {
+					/* Missing or incomplete cache entries are rebuilt from verified source payloads. */
+				}
+			}
+			if (!input) {
+				input = await collectCollisionInputs(ctx, scene, cell, selection);
+				if (cacheFile) {
+					const temporary = `${cacheFile}.${process.pid}.tmp`;
+					await writeFile(temporary, JSON.stringify(input));
+					await rename(temporary, cacheFile);
+				}
+			}
+			inputs.push(input);
+			console.log(JSON.stringify({ phase: 'collision-inputs', cell, actors: input.actors.length }));
+		}
+		const geometry = collisionGeometry(inputs, {
+			walkableLayers: numberField(objectField(settings, '_walkableLayers'), 'm_Bits'),
+		});
+		const buildIndices = walkableCollisionIndices(geometry);
+		const options = {
+			profile,
+			maxSlope: numberField(settings, '_slopeLimit'),
+			stepUp: numberField(settings, '_stepOffset'),
+			stepDown: numberField(settings, '_stepDownOffset'),
+			cellSize,
+			cellHeight: 0.05,
+			tileCells,
+			bounds: {
+				min: [bounds[0], bounds[1]] as [number, number],
+				max: [bounds[2], bounds[3]] as [number, number],
+			},
+			...(tiles ? { tiles } : {}),
+		};
+		await writeFile(values['collision-output']!, JSON.stringify({ ...geometry, options, absent }));
+		const ground = await buildGroundTiles(
+			{ positions: geometry.positions, indices: buildIndices },
+			{
+				...options,
+				cache: values['tile-cache']
+					? await groundTileCache(resolve(values['tile-cache']), source)
+					: undefined,
+				onTile: (progress) => console.log(JSON.stringify({ phase: 'ground-tile', ...progress })),
+			},
+		);
+		await writeFile(
+			values.output!,
+			JSON.stringify({
+				version: 1,
+				source: geometry.source,
+				scene,
+				selection,
+				coverage: geometry.coverage,
+				absent,
+				build: options,
+				tiles: ground.tiles,
+				surfaces: ground.surfaces,
+				options: {
+					speed: numberField(settings, '_runSpeed'),
+					maxVertical: 0.5,
+					profile,
+					walls: geometry.exclusions,
+					portals: ground.portals,
+					locomotion: movement.sustainedSprint,
+				},
+			}),
+		);
+		console.log(
+			JSON.stringify({
+				phase: 'ground',
+				tiles: ground.tiles.length,
+				surfaces: ground.surfaces.length,
+				portals: ground.portals.length,
+			}),
+		);
+	});
+};
diff --git a/packages/extractor/src/commands/player-route.test.ts b/packages/extractor/src/commands/player-route.test.ts
new file mode 100644
index 00000000..cae27cc2
--- /dev/null
+++ b/packages/extractor/src/commands/player-route.test.ts
@@ -0,0 +1,681 @@
+import assert from 'node:assert/strict';
+import { fork } from 'node:child_process';
+import { once } from 'node:events';
+import { mkdtemp, readFile, rm, writeFile } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { test } from 'node:test';
+
+import type { Wall } from '@opendfieldmap/ganglia';
+
+import type { FollowingSupport } from '../game/following-supports.ts';
+import { sweepSupports, type SweptSupport } from '../game/swept-supports.ts';
+import { createRouteCache } from '../route-cache.ts';
+
+import { run } from './player-route.ts';
+
+const source = { buildGuid: 'build', contentHash: 'content' };
+const profile = { radius: 0.25, height: 1 };
+const selection = { sceneState: 0, area: 0 };
+const locomotion = { speed: 1, sprintSpeed: 2, sprintAcceleration: 1 };
+const fixture = (bounds?: { min: number[]; max: number[] }) => ({
+	ground: {
+		...(bounds ? { build: { bounds } } : {}),
+		version: 1,
+		scene: 'scene',
+		source,
+		selection,
+		coverage: { complete: false },
+		surfaces: [
+			{
+				id: 'floor',
+				vertices: [
+					[0, 0, 0],
+					[10, 0, 0],
+					[10, 0, 10],
+					[0, 0, 10],
+				],
+			},
+		],
+		options: { speed: 1, maxVertical: 0.5, walls: [] as Wall[], profile },
+	},
+	collision: {
+		scene: 'scene',
+		source,
+		selection,
+		coverage: { complete: false },
+		options: { profile },
+		positions: [0, 0, 0, 10, 0, 0, 10, 0, 10, 0, 0, 10],
+		indices: [0, 2, 1, 0, 3, 2],
+	},
+	movement: {
+		version: 1,
+		source,
+		defaultProfile: profile,
+		sustainedSprint: locomotion,
+		assets: [
+			{
+				path: 'MovementSetting/MovementSetting_Default.asset',
+				settings: {
+					_gravity: 10,
+					_stepDownOffset: 0.6,
+					_fallingGravity: 10,
+					_maxJumpHeight: 1,
+					_maxFallingSpeed: 10,
+					_apexTime: 0,
+					_inAirMaxHorizontalSpeedSprint: 2,
+					_startHorizontalSpeedSprint: 2,
+					_inAirMaxInitHorizontalSpeed: 12.5,
+					_inAirDecelerationWithInputSprint: 5,
+					_inAirMaxHorizontalSpeedRun: 1,
+					_inAirAcceleration: 60,
+					_inAirDecelerationNoInputSprint: 10,
+					_slopeLimit: 45,
+				},
+			},
+		],
+	},
+	request: {
+		scene: 'scene',
+		source,
+		arrival: { id: 'player', state: 'available', cost: 0, position: [1, 0, 1] },
+		target: [9, 0, 9],
+		walls: [],
+	},
+});
+
+const execute = async (
+	data: ReturnType<typeof fixture>,
+	extra: Record<string, unknown> = {},
+	stage: 'all' | 'walking' | 'devices' = 'all',
+	devices?: {
+		version: number;
+		scene: string;
+		source: typeof source;
+		devices: [];
+		templates: {};
+		movingSupports: SweptSupport[];
+		followingSupports?: FollowingSupport[];
+	},
+) => {
+	const directory = await mkdtemp(join(tmpdir(), 'player-route-'));
+	try {
+		const files = ['ground', 'collision', 'movement', 'request'] as const;
+		for (const file of files) {
+			await writeFile(
+				join(directory, file + '.json'),
+				JSON.stringify(file === 'request' ? { ...data.request, ...extra } : data[file]),
+			);
+		}
+		const output = join(directory, 'result.json');
+		if (devices) {
+			await writeFile(join(directory, 'devices.json'), JSON.stringify(devices));
+		}
+		await run([
+			'--ground',
+			join(directory, 'ground.json'),
+			'--collision',
+			join(directory, 'collision.json'),
+			'--movement-settings',
+			join(directory, 'movement.json'),
+			'--request',
+			join(directory, 'request.json'),
+			'-o',
+			output,
+			...(stage === 'all' ? [] : [stage === 'walking' ? '--ground-only' : '--devices-only']),
+			...(devices ? ['--devices', join(directory, 'devices.json')] : []),
+		]);
+		return JSON.parse(await readFile(output, 'utf8'));
+	} finally {
+		await rm(directory, { recursive: true, force: true });
+	}
+};
+
+test('plans arbitrary ground endpoints through the CLI and retains source/coverage/resource timing', async () => {
+	const result = await execute(fixture());
+	assert.equal(result.status, 'candidate');
+	assert.equal(result.motionValidation, 'model-based');
+	assert.deepEqual(result.source, source);
+	assert.deepEqual(result.route.points[0], [1, 0, 1]);
+	assert.deepEqual(result.route.points.at(-1), [9, 0, 9]);
+	assert.ok(result.route.cost < Math.hypot(8, 8));
+	assert.deepEqual(result.connections, []);
+	assert.equal(result.supportBoxes, undefined);
+	assert.equal(result.diagnostics.timingMs.annotationPreparation, undefined);
+	assert.equal(result.coverage.ground.complete, false);
+});
+
+test('a target supported only by an imported moving platform reaches device preparation', async () => {
+	const data = fixture({ min: [0, 0], max: [10, 10] });
+	Object.assign(data.ground.build!, { cellSize: 0.1, cellHeight: 0.05 });
+	Object.assign(data.movement.assets[0].settings, { _stepOffset: 0.4 });
+	data.request.target = [5, 5, 5];
+	const cap = (y: number): [number, number, number][] => [
+		[4, y, 4],
+		[4, y, 6],
+		[6, y, 6],
+		[6, y, 4],
+	];
+	const support: SweptSupport = {
+		id: 'lift',
+		family: 'platform',
+		model: 'fixture',
+		level: 'level',
+		assumption: 'phase-free-swept-support',
+		...sweepSupports('lift', [[cap(0)], [cap(5)]], 2),
+	};
+	const result = await execute(data, {}, 'devices', {
+		version: 1,
+		scene: 'scene',
+		source,
+		devices: [],
+		templates: {},
+		movingSupports: [support],
+	});
+	assert.equal(result.status, 'candidate');
+	assert.equal(result.route.status, 'complete');
+	assert.ok(
+		result.connections.some((connection: { id: string }) => connection.id.startsWith('moving-ride/')),
+	);
+	assert.ok(result.diagnostics.movingSupports.addedSurfaces > 0);
+	assert.deepEqual(
+		result.supportBoxes.map((box: { role: string; max: number[] }) => [box.role, box.max[1]]),
+		[
+			['board', 0],
+			['use', 5],
+		],
+	);
+	assert.equal(result.route.supportBoxes, undefined);
+	assert.ok(result.diagnostics.timingMs.annotationPreparation >= 0);
+	assert.ok(result.diagnostics.timingMs.annotations >= 0);
+});
+
+test('the foreground walking stage finishes before airborne collision indexing', async () => {
+	const result = await execute(fixture(), {}, 'walking');
+	assert.equal(result.status, 'candidate');
+	assert.equal(result.optimizing, false);
+	assert.ok(result.route.segments.every((segment: { mode: string }) => segment.mode === 'walk'));
+	assert.equal(result.diagnostics.collisionScope, undefined);
+});
+
+test('refines failed round-envelope connectivity while retaining completed ground search ordering', async () => {
+	const data = fixture();
+	const id = 'capsule-axis-envelope/1/2/3';
+	const wall: Wall & { id: string } = {
+		id,
+		min: [-1, 1, -1],
+		max: [3, 5, 3],
+		state: 'unknown',
+	};
+	data.ground.options.walls.push(wall);
+	Object.assign(data.collision.coverage, {
+		approximations: [
+			{
+				kind: 'capsule-axis-envelope',
+				id: 1,
+				component: 2,
+				index: 3,
+				bounds: { min: [-1, 1, -1], max: [3, 5, 3] },
+				outerRadius: 2,
+				padding: 0.001,
+			},
+		],
+	});
+	const recovered = await execute(
+		data,
+		{
+			arrival: { ...data.request.arrival, position: [1.9, 0, 1.9] },
+		},
+		'walking',
+	);
+	assert.equal(recovered.status, 'candidate');
+	assert.deepEqual(recovered.diagnostics.roundOccupancy, { refined: true, groundStatus: 'complete' });
+	assert.equal((await execute(data, {}, 'walking')).status, 'unavailable');
+	const clear = await execute(
+		data,
+		{
+			arrival: { ...data.request.arrival, position: [7, 0, 1] },
+		},
+		'walking',
+	);
+	assert.equal(clear.status, 'candidate');
+	assert.equal(clear.diagnostics.roundOccupancy, undefined);
+});
+
+test('known-action queries finish without jump discovery when no device inputs are supplied', async () => {
+	const result = await execute(fixture(), {}, 'devices');
+	assert.equal(result.status, 'candidate');
+	assert.equal(result.optimizing, false);
+	assert.equal(result.diagnostics.collisionScope, undefined);
+	assert.equal(result.diagnostics.searches, undefined);
+});
+
+test('plans to the supplied interaction region instead of snapping an outside marker onto another floor', async () => {
+	const result = await execute(fixture(), { target: [13, 0, 5], interaction: { radius: 4 } });
+	assert.equal(result.status, 'candidate');
+	const end = result.route.points.at(-1);
+	assert.ok(Math.hypot(end[0] - 13, end[1], end[2] - 5) <= 4);
+	assert.ok(end[0] <= 10);
+	const below = await execute(fixture(), { target: [9, 2, 9] });
+	assert.equal(below.status, 'candidate');
+	assert.equal(below.groundedTarget[1], 0);
+});
+
+test('rejects mismatched source and capsule inputs and keeps unavailable arrival state explicit', async () => {
+	const wrongSource = fixture();
+	wrongSource.collision.source = { ...source, contentHash: 'other' };
+	await assert.rejects(execute(wrongSource), /share a scene and build/);
+	const wrongProfile = fixture();
+	wrongProfile.collision.options.profile = { ...profile, radius: 0.3 };
+	await assert.rejects(execute(wrongProfile), /share body profile/);
+	const unavailable = await execute(fixture(), {
+		arrival: { id: 'locked', state: 'unknown', cost: 0, position: [1, 0, 1] },
+	});
+	assert.equal(unavailable.status, 'unavailable');
+	assert.equal(unavailable.reason, 'arrival-unavailable');
+});
+
+test('model-discovered jumps exceeding running air speed retain their sprint-entry requirement', async () => {
+	const data = fixture();
+	data.ground.surfaces = [
+		{
+			id: 'left',
+			vertices: [
+				[0, 0, 0],
+				[2, 0, 0],
+				[2, 0, 2],
+				[0, 0, 2],
+			],
+		},
+		{
+			id: 'right',
+			vertices: [
+				[3, 0, 0],
+				[6, 0, 0],
+				[6, 0, 2],
+				[3, 0, 2],
+			],
+		},
+	];
+	data.collision.positions = [0, 0, 0, 2, 0, 0, 2, 0, 2, 0, 0, 2, 3, 0, 0, 6, 0, 0, 6, 0, 2, 3, 0, 2];
+	data.collision.indices = [0, 2, 1, 0, 3, 2, 4, 6, 5, 4, 7, 6];
+	data.request.target = [5, 0, 1];
+	data.movement.assets[0].settings = {
+		...data.movement.assets[0].settings,
+		_inAirMaxHorizontalSpeedSprint: 4,
+	};
+	const result = await execute(data);
+	assert.equal(result.status, 'candidate');
+	assert.ok(result.connections.length > 0);
+	assert.ok(
+		result.connections.some((connection: { requiredGait?: string }) => connection.requiredGait === 'sprint'),
+	);
