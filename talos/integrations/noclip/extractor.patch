@@ -0,0 +1,126 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { conditionVisible, resolveSceneValues } from '@endfield-noclip/package-format/conditions';
+import { pointPicks, pointValues } from '@endfield-noclip/package-format/oem';
+import type { SceneControl, StatesInfo } from '@endfield-noclip/package-format/states';
+
+import { pointPresets } from './oem-presets.ts';
+
+const quest = (id: string, step: number | null): SceneControl & { kind: 'quest' } => ({
+	kind: 'quest',
+	id: `quest:${id}`,
+	name: id,
+	story: step === null ? null : { role: 'quest', mission: 0, step },
+	category: 0,
+	source: { kind: 'user' },
+	drivers: [],
+	place: null,
+	assumption: 'story finished',
+	levels: [],
+	default: 3,
+	values: [0, 2, 3, 4, 5].map((value) => ({ value, label: String(value) })),
+});
+const states = (controls: SceneControl[]): StatesInfo => ({
+	controls,
+	conditionalSets: [],
+	groups: [],
+	streamAreas: null,
+	categories: [{ id: 'story', title: 'Story', note: null }],
+	mainStory: [0],
+	missions: [{ id: 'e1m1', name: 'mission', category: 'main', chapter: null, episode: null, levelId: null }],
+});
+
+test('keeps completed defaults when they already satisfy a point', () => {
+	const presets = pointPresets(states([quest('a', 1)]), {
+		alternatives: [[{ control: 'quest:a', mask: 8 }]],
+	});
+	assert.deepEqual(presets[0].picks, {});
+	assert.equal(presets[0].satisfies, true);
+});
+
+test('applies an AND alternative without flattening it into independent choices', () => {
+	const s = states([quest('a', 1), quest('b', 2)]);
+	const condition = {
+		alternatives: [
+			[
+				{ control: 'quest:a', mask: 8 },
+				{ control: 'quest:b', mask: 4 },
+			],
+		],
+	};
+	const presets = pointPresets(s, condition).filter((p) => p.satisfies);
+	assert.ok(presets.length);
+	for (const p of presets) {
+		assert.equal(
+			conditionVisible(
+				condition,
+				pointValues(s.controls, resolveSceneValues(s, pointPicks(s.controls, p.picks))),
+			),
+			true,
+		);
+	}
+	assert.equal(presets[0].picks['quest:a'], undefined);
+	assert.equal(presets[0].picks['quest:b'], 2);
+});
+
+test('rejects an impossible reversed quest ordering', () => {
+	const s = states([quest('a', 1), quest('b', 2)]);
+	const p = pointPresets(s, {
+		alternatives: [
+			[
+				{ control: 'quest:a', mask: 1 },
+				{ control: 'quest:b', mask: 8 },
+			],
+		],
+	});
+	assert.equal(
+		p.some((entry) => entry.satisfies),
+		false,
+	);
+});
+
+test('uses the packed main story order for prerequisites spanning missions', () => {
+	const s = states([
+		{ ...quest('early_q#1', 1), story: { role: 'quest', mission: 0, step: 1 } },
+		{ ...quest('late_q#1', 1), story: { role: 'quest', mission: 1, step: 1 } },
+	]);
+	s.mainStory = [0, 1];
+	s.missions = ['early', 'late'].map((id) => ({ ...s.missions[0], id, name: id }));
+	assert.equal(
+		pointPresets(s, {
+			alternatives: [
+				[
+					{ control: 'quest:early_q#1', mask: 8 },
+					{ control: 'quest:late_q#1', mask: 4 },
+				],
+			],
+		}).some((p) => p.satisfies),
+		true,
+	);
+	assert.equal(
+		pointPresets(s, {
+			alternatives: [
+				[
+					{ control: 'quest:early_q#1', mask: 1 },
+					{ control: 'quest:late_q#1', mask: 8 },
+				],
+			],
+		}).some((p) => p.satisfies),
+		false,
+	);
+});
+
+test('preserves OR alternatives and refuses to invent an unplaceable quest state', () => {
+	const s = states([quest('a', 1), quest('unknown', null)]);
+	assert.equal(
+		pointPresets(s, { alternatives: [[{ control: 'quest:unknown', mask: 4 }]] }).some((p) => p.satisfies),
+		false,
+	);
+	assert.equal(
+		pointPresets(s, {
+			alternatives: [[{ control: 'quest:unknown', mask: 4 }], [{ control: 'quest:a', mask: 4 }]],
+		}).some((p) => p.satisfies),
+		true,
+	);
+});
diff --git a/packages/extractor/src/game/oem-presets.ts b/packages/extractor/src/game/oem-presets.ts
new file mode 100644
index 00000000..ae7824ab
--- /dev/null
+++ b/packages/extractor/src/game/oem-presets.ts
@@ -0,0 +1,97 @@
+import { conditionVisible, resolveSceneValues } from '@endfield-noclip/package-format/conditions';
+import {
+	pointPicks,
+	pointValues,
+	type PointCondition,
+	type Preset,
+} from '@endfield-noclip/package-format/oem';
+import type { StatesInfo } from '@endfield-noclip/package-format/states';
+import { storyPointPicks, storyPoints } from '@endfield-noclip/package-format/story';
+
+/**
+ * finds story-consistent candidates using the viewer's existing story-point semantics. unknown, unplaceable
+ * quests are never assigned independently to manufacture a passing preset.
+ *
+ * @param states scene controls including point-only quests
+ * @param condition known point prerequisites, or null without recorded prerequisites
+ * @returns defaults and satisfying story points ordered by number of changed control values
+ */
+export const pointPresets = (states: StatesInfo, condition: PointCondition | null): Preset[] => {
+	const defaults = pointValues(states.controls, resolveSceneValues(states, new Map()));
+	const satisfied = (picks: Record<string, number>): boolean =>
+		condition === null ||
+		conditionVisible(
+			condition,
+			pointValues(states.controls, resolveSceneValues(states, pointPicks(states.controls, picks))),
+		);
+	const result: Preset[] = [{ id: 'default', label: 'Viewer defaults', picks: {}, satisfies: satisfied({}) }];
+	if (condition === null) {
+		return result;
+	}
+	const required = new Set(condition.alternatives.flatMap((alt) => alt.map((r) => r.control)));
+	const missions = [
+		...new Set(
+			states.controls
+				.filter((c) => required.has(c.id))
+				.flatMap((c) => {
+					const story = c.story;
+					return story === null ? [] : [story.mission];
+				}),
+		),
+	];
+	const main = states.mainStory;
+	const groups = missions
+		.map((id) => (main.includes(id) ? main : [id]))
+		.filter((ids, i, all) => all.findIndex((other) => other.join() === ids.join()) === i);
+	let candidates: { picks: Record<string, number>; labels: string[] }[] = [{ picks: {}, labels: [] }];
+	for (const ids of groups) {
+		const choices = storyPoints(states.controls, ids).map(({ point, mission, quests }) => ({
+			picks: Object.fromEntries(
+				[...storyPointPicks(states.controls, ids, point)].map(([index, v]) => [
+					states.controls[index].id,
+					v ?? defaults[states.controls[index].id],
+				]),
+			),
+			label:
+				point === null
+					? 'Story finished'
+					: `${mission === null ? '' : (states.missions[mission]?.name ?? mission)}: ${quests.map((q) => q.name).join(', ') || 'mission start'} (${mission}:${point.step})`,
+		}));
+		const next = candidates.flatMap((base) =>
+			choices.map((choice) => ({
+				picks: Object.assign({}, base.picks, choice.picks),
+				labels: [...base.labels, choice.label],
+			})),
+		);
+		// A huge cross-product is evidence that no safe automatic preset was established.
+		if (next.length > 4096) {
+			return result;
+		}
+		candidates = next;
+	}
+	const seen = new Set<string>();
+	const valid = candidates
+		.filter(({ picks }) => satisfied(picks))
+		.map(({ picks, labels }) => ({
+			picks: Object.fromEntries(Object.entries(picks).filter(([id, v]) => v !== defaults[id])),
+			labels,
+		}))
+		.filter(({ picks }) => {
+			const key = JSON.stringify(picks);
+			if (seen.has(key) || Object.keys(picks).length === 0) {
+				return false;
+			}
+			seen.add(key);
+			return true;
+		})
+		.toSorted((a, b) => Object.keys(a.picks).length - Object.keys(b.picks).length);
+	for (const [index, { picks, labels }] of valid.slice(0, 8).entries()) {
+		result.push({
+			id: `story-${index + 1}`,
+			label: labels.join('; '),
+			picks,
+			satisfies: true,
+		});
+	}
+	return result;
+};
