index 00000000..505a6a54
--- /dev/null
+++ b/packages/extractor/src/game/seesaw-supports.ts
@@ -0,0 +1,152 @@
+import {
+	inverseTransformPoint,
+	multiplyMatrices,
+	transformPoint,
+} from '@endfield-noclip/formats/unity/transform';
+
+import type { Surface, Vec3 } from '@opendfieldmap/ganglia';
+
+import { supportBounds, type PoseBounds, type PoseSpan } from './swept-supports.ts';
+
+type Segment = { low: number; high: number; slope: number; offset: number; pose: number };
+
+/**
+ * @param id stable source identity
+ * @param bodies moving solid collider vertices in prefab space
+ * @param pivot rotating board's local-to-prefab matrix
+ * @param placement prefab-to-world matrix
+ * @param maxRotation authored tilt limit in degrees about the board's local x axis
+ * @returns the piecewise upper envelope and its actual sampled source poses, without invented angular ride
+ *   timing
+ * @throws when the tilt, body vertices or support bounds are invalid
+ */
+export const seesawSupports = (
+	id: string,
+	bodies: Vec3[][],
+	pivot: Float32Array,
+	placement: Float32Array,
+	maxRotation: number,
+): { surfaces: Surface[]; transfers: []; poses: PoseBounds[]; surfacePoses: PoseSpan[][] } => {
+	if (!Number.isFinite(maxRotation) || maxRotation <= 0 || maxRotation >= 90 || !bodies.length) {
+		throw new Error('invalid seesaw tilt');
+	}
+	const matrix = multiplyMatrices(placement, pivot);
+	const surfaces: Surface[] = [];
+	for (const body of bodies) {
+		if (body.length !== 8 || body.some((p) => p.length !== 3 || !p.every(Number.isFinite))) {
+			throw new Error('seesaw support requires a decoded box collider');
+		}
+	}
+	const localBodies = bodies.map((body) => body.map((p) => inverseTransformPoint(pivot, p)));
+	const poses: PoseBounds[] = [];
+	const surfacePoses: PoseSpan[][] = [];
+	const poseIndices = new Map<number, number>();
+	const poseAt = (angle: number) => {
+		const previous = poseIndices.get(angle);
+		if (previous !== undefined) {
+			return previous;
+		}
+		const c = Math.cos(angle),
+			s = Math.sin(angle);
+		const pose = localBodies.map((body) =>
+			body.map(([x, y, z]) => transformPoint(matrix, [x, y * c - z * s, y * s + z * c])),
+		);
+		const index = poses.length;
+		poses.push(supportBounds(pose));
+		poseIndices.set(angle, index);
+		return index;
+	};
+	for (const [body, vertices] of localBodies.entries()) {
+		const low = [0, 1, 2].map((axis) => Math.min(...vertices.map((p) => p[axis])));
+		const high = [0, 1, 2].map((axis) => Math.max(...vertices.map((p) => p[axis])));
+		if (low.some((v, axis) => v >= high[axis])) {
+			throw new Error('degenerate seesaw support');
+		}
+		// geometric error is bounded by the same 5 cm subdivision tolerance as moving curves.
+		const radius = Math.max(...vertices.map((p) => Math.hypot(p[1], p[2])));
+		const angle = (maxRotation * Math.PI) / 180;
+		const count = Math.max(1, Math.ceil((2 * angle) / (2 * Math.acos(Math.max(-1, 1 - 0.05 / radius)))));
+		const angles = [...Array.from({ length: count + 1 }, (_, i) => -angle + (2 * angle * i) / count), 0];
+		const segments: Segment[] = [];
+		for (const tilt of angles) {
+			const c = Math.cos(tilt),
+				s = Math.sin(tilt);
+			const pose = poseAt(tilt);
+			const corners = [
+				[low[1], low[2]],
+				[low[1], high[2]],
+				[high[1], high[2]],
+				[high[1], low[2]],
+			].map(([y, z]) => [y * c - z * s, y * s + z * c]);
+			for (let i = 0; i < corners.length; i++) {
+				const a = corners[i],
+					b = corners[(i + 1) % corners.length];
+				if (Math.abs(b[1] - a[1]) < 1e-9) {
+					continue;
+				}
+				const slope = (b[0] - a[0]) / (b[1] - a[1]);
+				segments.push({
+					low: Math.min(a[1], b[1]),
+					high: Math.max(a[1], b[1]),
+					slope,
+					offset: a[0] - a[1] * slope,
+					pose,
+				});
+			}
+		}
+		const breaks = segments.flatMap((segment) => [segment.low, segment.high]);
+		for (let i = 0; i < segments.length; i++) {
+			for (let j = 0; j < i; j++) {
+				const a = segments[i],
+					b = segments[j];
+				if (Math.abs(a.slope - b.slope) < 1e-9) {
+					continue;
+				}
+				const z = (b.offset - a.offset) / (a.slope - b.slope);
+				if (z > Math.max(a.low, b.low) && z < Math.min(a.high, b.high)) {
+					breaks.push(z);
+				}
+			}
+		}
+		breaks.sort((a, b) => a - b);
+		const cuts = breaks.filter((v, i) => !i || v - breaks[i - 1] > 1e-9);
+		const pieces: { low: number; high: number; segment: Segment }[] = [];
+		for (let i = 1; i < cuts.length; i++) {
+			const middle = (cuts[i - 1] + cuts[i]) / 2;
+			let winner: Segment | null = null;
+			for (const segment of segments) {
+				if (
+					middle >= segment.low &&
+					middle <= segment.high &&
+					(!winner || segment.slope * middle + segment.offset > winner.slope * middle + winner.offset)
+				) {
+					winner = segment;
+				}
+			}
+			if (!winner) {
+				continue;
+			}
+			const previous = pieces.at(-1);
+			if (previous?.segment === winner) {
+				previous.high = cuts[i];
+			} else {
+				pieces.push({ low: cuts[i - 1], high: cuts[i], segment: winner });
+			}
+		}
+		for (const piece of pieces) {
+			const height = (z: number) => piece.segment.slope * z + piece.segment.offset;
+			const points: Vec3[] = [
+				[low[0], height(piece.low), piece.low],
+				[low[0], height(piece.high), piece.high],
+				[high[0], height(piece.high), piece.high],
+				[high[0], height(piece.low), piece.low],
+			];
+			surfaces.push({
+				id: 'moving/' + id + '/seesaw/' + surfaces.length,
+				vertices: points.map((p) => transformPoint(matrix, p)),
+			});
+			surfacePoses.push([{ body, fromPose: piece.segment.pose, toPose: piece.segment.pose }]);
+		}
+	}
+	return { surfaces, transfers: [], poses, surfacePoses };
+};
