+import { readCollisionMesh } from '@endfield-noclip/formats/unity/collision-mesh';
+import { readConvexMesh } from '@endfield-noclip/formats/unity/convex-mesh';
+import { UnityClass } from '@endfield-noclip/formats/unity/serialized-file';
+import { booleanField, bytesField } from '@endfield-noclip/formats/unity/values';
+
+import { withContext } from '../../../context.ts';
+import { locateObject } from '../../../game/assets/assets.ts';
+import { jsonReplacer, save } from '../../helpers.ts';
+
+import type { InspectSubArgs } from './parser.ts';
+import { resolveObjectArg } from './shared.ts';
+
+/** @param args collision mesh selector and optional JSON output */
+export const runInspectCollision = async (args: InspectSubArgs<'collision'>): Promise<void> => {
+	await withContext(args.config, async (context) => {
+		const resolver = await context.resolver();
+		const ref = await resolveObjectArg(context, resolver, args.target, UnityClass.Mesh, {
+			pathId: args.pathId,
+			nameFilter: args.name,
+		});
+		const data = await resolver.read(ref);
+		const convex = booleanField(data, 'm_CollisionMeshConvex');
+		const mesh = convex
+			? readConvexMesh(bytesField(data, 'm_BakedConvexCollisionMesh'))
+			: readCollisionMesh(bytesField(data, 'm_BakedTriangleCollisionMesh'));
+		console.log(
+			JSON.stringify({
+				vertices: mesh.vertices.length,
+				convex,
+				triangles: mesh.triangles.length,
+				bounds: mesh.bounds,
+			}),
+		);
+		if (args.output !== undefined) {
+			const build = await context.world.manifest();
+			await save(
+				args.output,
+				new TextEncoder().encode(
+					JSON.stringify(
+						{
+							version: 1,
+							source: { buildGuid: build.guid, contentHash: build.contentHash, object: locateObject(ref) },
+							coordinates: 'local-unity',
+							convex,
+							mesh,
+						},
+						jsonReplacer,
+					),
+				),
+			);
+		}
+	});
+};
