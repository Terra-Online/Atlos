diff --git a/packages/extractor/src/game/steam-hazards.test.ts b/packages/extractor/src/game/steam-hazards.test.ts
new file mode 100644
index 00000000..b0f81837
--- /dev/null
+++ b/packages/extractor/src/game/steam-hazards.test.ts
@@ -0,0 +1,117 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { levelInteractiveFromValue } from '@endfield-noclip/formats/endfield/level-interactives';
+import type { MemoryPackValue } from '@endfield-noclip/formats/endfield/memory-pack';
+
+import { toScript } from './script-drivers.ts';
+import { scriptedSteamIds, steamHazards } from './steam-hazards.ts';
+
+const bits = (value: number) => {
+	const view = new DataView(new ArrayBuffer(4));
+	view.setFloat32(0, value, true);
+	return String(view.getUint32(0, true));
+};
+const param = (key: string, type: number, values: number[]): MemoryPackValue => ({
+	key,
+	value: {
+		type,
+		valueArray: values.map((value) => ({
+			valueBit64: type === 1 ? String(value) : bits(value),
+			valueString: null,
+		})),
+	},
+});
+const template: MemoryPackValue = {
+	componentList: [
+		{
+			$type: 'Beyond_Gameplay_Core_InteractiveSteamBlockerComponentDataForMemoryPack',
+			propertyList: [
+				param('position_list', 12, [0, 0, 0]),
+				param('max_length', 5, [4]),
+				param('height', 5, [0.5]),
+				param('size_y', 5, [2]),
+				param('variable_3', 1, [0]),
+			],
+		},
+	],
+};
+const placement = (rotation: number[], overrides: MemoryPackValue[]) =>
+	levelInteractiveFromValue(
+		{
+			entityDataIdKey: 'steam',
+			createState: 0,
+			levelLogicId: '12',
+			position: [10, 2, 20],
+			rotation,
+			scale: [1, 1, 1],
+			properties: [],
+			componentProperties: [[91, overrides]],
+		},
+		12n,
+	);
+const near = (actual: number[], expected: number[]) =>
+	assert.ok(
+		actual.every((value, i) => Math.abs(value - expected[i]) < 1e-5),
+		JSON.stringify({ actual, expected }),
+	);
+
+test('rotates individual maximum nozzle envelopes and respects component-scoped dimensions', () => {
+	const zones = steamHazards(
+		template,
+		placement([0, 90, 0], [param('position_list', 12, [0, -1, 0, 0, 1, 0]), param('max_length', 5, [3])]),
+		'active',
+	);
+	assert.equal(zones.length, 2);
+	near(zones[0].min, [10, 0.75, 19.975]);
+	near(zones[0].max, [13, 1.25, 20.025]);
+	near(zones[1].min, [10, 2.75, 19.975]);
+	assert.equal(zones[0].polygon?.length, 4);
+	assert.equal(zones[0].state, 'active');
+	assert.equal(zones[0].occlusion, 'unclipped');
+});
+
+test('alternate height and pitched jets retain conservative bounds without a misleading upright prism', () => {
+	const [zone] = steamHazards(template, placement([90, 0, 0], [param('variable_3', 1, [1])]), 'unknown');
+	near(zone.min, [9.975, -2, 19]);
+	near(zone.max, [10.025, 2, 21]);
+	assert.equal(zone.polygon, undefined);
+	assert.equal(zone.state, 'unknown');
+	assert.equal(zone.activation, 'lifecycle-unresolved');
+	assert.equal(steamHazards({ componentList: [] }, placement([0, 0, 0], []), 'active').length, 0);
+	assert.throws(
+		() => steamHazards(template, placement([0, 0, 0], [param('position_list', 12, [0, 1])]), 'active'),
+		/positions/,
+	);
+	assert.throws(
+		() => steamHazards(template, placement([0, 0, 0], [param('max_length', 5, [-1])]), 'active'),
+		/dimensions/,
+	);
+});
+
+test('lifecycle scan retains node and getter references without interpreting parameter flags as switches', () => {
+	const script = toScript('1', 'level', {
+		actionMap: {
+			dataMap: {
+				headerList: [],
+				actionList: [{ ID: 0, target: { constValue: { logicId: '12', useSlotId: false }, paramSource: 0 } }],
+				getterList: [{ ID: 1, target: { constValue: { logicId: '13', useSlotId: false }, paramSource: 0 } }],
+			},
+		},
+	});
+	assert.ok(script);
+	assert.deepEqual(scriptedSteamIds([script], new Set(['12', '13', '14']), []), new Set(['12', '13']));
+	assert.deepEqual(
+		scriptedSteamIds([], new Set(['12', '13']), [{ scriptId: '12', refWorldEntityIdList: ['13'] }]),
+		new Set(['13']),
+	);
+	const [zone] = steamHazards(
+		template,
+		placement(
+			[0, 0, 0],
+			[param('variable_0', 1, [0]), param('variable_1', 1, [0]), param('variable_2', 1, [0])],
+		),
+		'active',
+	);
+	assert.equal(zone.state, 'active');
+});
diff --git a/packages/extractor/src/game/steam-hazards.ts b/packages/extractor/src/game/steam-hazards.ts
new file mode 100644
index 00000000..c0aa21d9
--- /dev/null
+++ b/packages/extractor/src/game/steam-hazards.ts
@@ -0,0 +1,226 @@
+import { FormatError } from '@endfield-noclip/formats/binary/binary-reader';
+import { readInteractiveTable } from '@endfield-noclip/formats/endfield/interactive-model';
+import {
+	levelInteractiveFromValue,
+	type InteractiveParam,
+	type LevelInteractive,
+} from '@endfield-noclip/formats/endfield/level-interactives';
+import type { MemoryPackValue } from '@endfield-noclip/formats/endfield/memory-pack';
+import { transformPoint, trsMatrix, unityEulerQuaternion } from '@endfield-noclip/formats/unity/transform';
+
+import type { Context } from '../context.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+import { componentParams } from './interactives/component-params.ts';
+import type { Script } from './script-drivers.ts';
+
+type Vec3 = [number, number, number];
+type State = 'active' | 'unknown';
+const STEAM = {
+	suffix: '_InteractiveSteamBlockerComponentDataForMemoryPack',
+	diffKey: 'Comp_SteamBlocker',
+	type: 91,
+};
+const isRecord = (value: unknown): value is { [key: string]: MemoryPackValue } =>
+	value !== null && typeof value === 'object' && !Array.isArray(value);
+const floats = (value: InteractiveParam | undefined, type: number): number[] => {
+	if (!value || value.type !== type) {
+		throw new FormatError('invalid steam parameter type');
+	}
+	return value.values.map(({ bits }) => {
+		const view = new DataView(new ArrayBuffer(4));
+		view.setUint32(0, Number(BigInt.asUintN(32, bits)), true);
+		const result = view.getFloat32(0, true);
+		if (!Number.isFinite(result)) {
+			throw new FormatError('nonfinite steam parameter');
+		}
+		return result;
+	});
+};
+const scalar = (value: InteractiveParam | undefined) => {
+	const values = floats(value, 5);
+	if (values.length !== 1 || values[0] < 0) {
+		throw new FormatError('invalid steam dimensions');
+	}
+	return values[0];
+};
+const bool = (value: InteractiveParam | undefined) => {
+	if (!value || value.type !== 1 || value.values.length !== 1 || ![0n, 1n].includes(value.values[0].bits)) {
+		throw new FormatError('invalid steam boolean');
+	}
+	return value.values[0].bits === 1n;
+};
+
+/**
+ * @param template decoded interactive template, including variants
+ * @param row matching placed interactive
+ * @param state whether its continuously emitting component has unresolved lifecycle controls
+ * @returns one maximum jet envelope per nozzle, or an empty list without a steam component
+ * @throws for malformed supported component parameters or placement transforms
+ */
+export const steamHazards = (template: MemoryPackValue, row: LevelInteractive, state: State) => {
+	const params = componentParams(template, row, STEAM);
+	if (!params) {
+		return [];
+	}
+	if (![row.position, row.rotation, row.scale].every((v) => v.length === 3 && v.every(Number.isFinite))) {
+		throw new FormatError('invalid steam placement');
+	}
+	const positions = floats(params.get('position_list'), 12);
+	if (positions.length % 3) {
+		throw new FormatError('invalid steam nozzle positions');
+	}
+	const length = scalar(params.get('max_length'));
+	const height = scalar(params.get(bool(params.get('variable_3')) ? 'size_y' : 'height'));
+	// the component's collision width is independent of its visual effect and nozzle spacing.
+	const width = 0.05;
+	const matrix = trsMatrix(row.position, unityEulerQuaternion(row.rotation), row.scale);
+	const upright = [row.rotation[0], row.rotation[2]].every((angle) => angle % 360 === 0);
+	return Array.from({ length: positions.length / 3 }, (_, nozzle) => {
+		const origin: Vec3 = [positions[nozzle * 3], positions[nozzle * 3 + 1], positions[nozzle * 3 + 2]];
+		const corners = Array.from({ length: 8 }, (_, bits) =>
+			transformPoint(matrix, [
+				origin[0] + (bits & 1 ? width / 2 : -width / 2),
+				origin[1] + (bits & 2 ? height / 2 : -height / 2),
+				origin[2] + (bits & 4 ? length : 0),
+			]),
+		);
+		const min = [0, 1, 2].map((axis) => Math.min(...corners.map((p) => p[axis])));
+		const max = [0, 1, 2].map((axis) => Math.max(...corners.map((p) => p[axis])));
+		const polygon = upright ? [0, 1, 5, 4].map((index) => [corners[index][0], corners[index][2]]) : undefined;
+		return {
+			kind: 'steam' as const,
+			id: row.id.toString(),
+			nozzle,
+			state,
+			min,
+			max,
+			polygon,
+			envelope: 'maximum-jet' as const,
+			occlusion: 'unclipped' as const,
+			activation: state === 'active' ? 'continuous-while-loaded' : 'lifecycle-unresolved',
+		};
+	});
+};
+
+/**
+ * @param context open install readers
+ * @returns a cached template reader for steam placements, retaining lifecycle evidence separately from
+ *   geometry
+ */
+export const createSteamHazardReader = async (context: Pick<Context, 'vfs' | 'world' | 'memoryPack'>) => {
+	const pool = await context.world.stringPool(),
+		reader = await context.memoryPack();
+	const read = async (path: string) => {
+		const file = await context.vfs.find(VfsGroup.JsonData, path);
+		if (!file) {
+			throw new FormatError('missing steam template input');
+		}
+		return context.vfs.readVerified(file);
+	};
+	const table = readInteractiveTable(await read('Data/Json/Interactive/InteractiveTable.json'), (id) =>
+		pool.get(id),
+	);
+	const templates = new Map<string, Promise<MemoryPackValue>>();
+	return async (raw: unknown) => {
+		if (!isRecord(raw) || typeof raw.entityDataIdKey !== 'string') {
+			throw new FormatError('invalid interactive hazard placement');
+		}
+		const scoped =
+			Array.isArray(raw.componentProperties) &&
+			raw.componentProperties.some((pair) => Array.isArray(pair) && pair[0] === STEAM.type);
+		if (!raw.entityDataIdKey.includes('steam') && !scoped) {
+			return [];
+		}
+		const id = table.templates.get(raw.entityDataIdKey);
+		const path = id === undefined ? undefined : table.templatePaths.get(id);
+		if (!path) {
+			throw new FormatError('missing steam interactive template');
+		}
+		const template = templates.getOrInsertComputed(path, async () =>
+			reader.decode(await read(path), 'Beyond_Gameplay_InteractiveTemplateDataForMemoryPack'),
+		);
+		if (typeof raw.levelLogicId !== 'string' || !/^[1-9]\d*$/.test(raw.levelLogicId)) {
+			throw new FormatError('invalid steam entity id');
+		}
+		const row = levelInteractiveFromValue(raw, BigInt(raw.levelLogicId));
+		const controlled =
+			row.createState !== 0 ||
+			raw.belongLevelScriptId !== '0' ||
+			raw.dependencyGroupId !== '0' ||
+			[raw.properties, raw.globalProperties, raw.mapProperties].some(
+				(list) => Array.isArray(list) && list.length > 0,
+			);
+		const lifecycle = {
+			createState: row.createState,
+			owner: raw.belongLevelScriptId,
+			group: raw.dependencyGroupId,
+			progressLockCondition: raw.progressLockCondition,
+			properties: raw.properties,
+			globalProperties: raw.globalProperties,
+			mapProperties: raw.mapProperties,
+		};
+		return steamHazards(await template, row, controlled ? 'unknown' : 'active').map((zone) =>
+			Object.assign(zone, { lifecycle }),
+		);
+	};
+};
+
+/**
+ * @param scripts decoded scripts that may name exported steam entities
+ * @param ids decimal steam entity ids
+ * @param briefs level-script parameter bindings, which can name entities through indirect inputs
+ * @returns ids named by entity pointers, entity parameters or script risk/reference lists; these retain
+ *   unknown lifecycle rather than proving the jet inactive
+ */
+export const scriptedSteamIds = (scripts: Script[], ids: ReadonlySet<string>, briefs: unknown[]) => {
+	const result = new Set<string>();
+	const add = (value: unknown) => {
+		if ((typeof value === 'string' || typeof value === 'number') && ids.has(String(value))) {
+			result.add(String(value));
+		}
+	};
+	const visit = (value: MemoryPackValue) => {
+		if (Array.isArray(value)) {
+			for (const item of value) {
+				visit(item);
+			}
+		} else if (isRecord(value)) {
+			if (value.useSlotId === false) {
+				add(value.logicId);
+			}
+			for (const item of Object.values(value)) {
+				visit(item);
+			}
+		}
+	};
+	for (const script of scripts) {
+		for (const node of [...script.nodes.values(), ...script.getters.values()]) {
+			visit(node);
+		}
+	}
+	for (const brief of briefs) {
+		if (isRecord(brief)) {
+			// script ids share the numeric namespace of placed entity ids. only entity-typed bindings count.
+			for (const key of ['interactiveActiveRiskEntityIdList', 'refWorldEntityIdList']) {
+				for (const id of Array.isArray(brief[key]) ? brief[key] : []) {
+					add(id);
+				}
+			}
+			for (const property of Array.isArray(brief.properties) ? brief.properties : []) {
+				if (
+					isRecord(property) &&
+					isRecord(property.value) &&
+					[13, 14].includes(Number(property.value.type))
+				) {
+					for (const atom of Array.isArray(property.value.valueArray) ? property.value.valueArray : []) {
+						if (isRecord(atom)) {
+							add(atom.valueBit64);
+						}
+					}
+				}
+			}
+		}
+	}
+	return result;
+};
diff --git a/packages/extractor/src/game/support-endpoints.test.ts b/packages/extractor/src/game/support-endpoints.test.ts
new file mode 100644
index 00000000..ffda62b4
--- /dev/null
+++ b/packages/extractor/src/game/support-endpoints.test.ts
@@ -0,0 +1,54 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import { transformPoint, trsMatrix, unityEulerQuaternion } from '@endfield-noclip/formats/unity/transform';
+
+import type { Vec3 } from '@opendfieldmap/ganglia';
+
+import { supportEndpoints } from './swept-supports.ts';
+
+const box: Vec3[] = Array.from({ length: 8 }, (_, bits) => [
+	bits & 1 ? 2 : -2,
+	bits & 2 ? 0.8 : 0.2,
+	bits & 4 ? 7 : -7,
+]);
+
+test('endpoint boxes cover all collider bodies after placement and retain the path ends', () => {
+	const start = trsMatrix([10, 20, 30], unityEulerQuaternion([0, 90, 0]), [1, 2, 1]);
+	const end = trsMatrix([15, 40, 35], unityEulerQuaternion([0, 90, 0]), [1, 2, 1]);
+	const other: Vec3[] = [
+		[-9, 21, 50],
+		[-8, 22, 51],
+	];
+	const poses: Vec3[][][] = [
+		[box.map((p) => transformPoint(start, p)), other],
+		[[[100, 200, 300]]],
+		[box.map((p) => transformPoint(end, p))],
+	];
+	const before = structuredClone(poses);
+	const result = supportEndpoints(poses);
+	assert.ok(result.initial.min.every((value, axis) => Math.abs(value - [-9, 20.4, 28][axis]) < 1e-6));
+	assert.ok(result.initial.max.every((value, axis) => Math.abs(value - [17, 22, 51][axis]) < 1e-6));
+	assert.ok(result.terminal.min.every((value, axis) => Math.abs(value - [8, 40.4, 33][axis]) < 1e-6));
+	assert.ok(result.terminal.max.every((value, axis) => Math.abs(value - [22, 41.6, 37][axis]) < 1e-6));
+	assert.deepEqual(poses, before);
+});
+
+test('tilted endpoint bounds enclose the actual box and allow closed paths with coincident ends', () => {
+	const tilted = trsMatrix([0, 2, 0], unityEulerQuaternion([25, 0, 0]), [1, 1, 1]);
+	const end = box.map((p) => transformPoint(tilted, p));
+	const result = supportEndpoints([[box], [end]]);
+	assert.ok(result.terminal.max[1] > 5.6);
+	assert.ok(result.terminal.min[1] < -0.7);
+	for (const p of end) {
+		for (let axis = 0; axis < 3; axis++) {
+			assert.ok(p[axis] >= result.terminal.min[axis] && p[axis] <= result.terminal.max[axis]);
+		}
+	}
+	const closed = supportEndpoints([[box], [end], [box]]);
+	assert.deepEqual(closed.initial, closed.terminal);
+	assert.notEqual(closed.initial.min, closed.terminal.min);
+	assert.throws(() => supportEndpoints([]), /missing/);
+	assert.throws(() => supportEndpoints([[[]]]), /missing/);
+	assert.throws(() => supportEndpoints([[[[0, Number.NaN, 0]]]]), /invalid/);
+});
diff --git a/packages/extractor/src/game/swept-supports.test.ts b/packages/extractor/src/game/swept-supports.test.ts
new file mode 100644
index 00000000..7696e1cf
--- /dev/null
+++ b/packages/extractor/src/game/swept-supports.test.ts
@@ -0,0 +1,83 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import type { Vec3 } from '@opendfieldmap/ganglia';
+
+import { supportEndpoints, sweepSupports } from './swept-supports.ts';
+
+const box = (x: number, y: number, z: number): Vec3[] =>
+	Array.from({ length: 8 }, (_, bits) => [
+		x + (bits & 1 ? 1 : -1),
+		y + (bits & 2 ? 1 : -1),
+		z + (bits & 4 ? 1 : -1),
+	]);
+
+test('coincident sweep faces retain every source body and pose interval', () => {
+	const first = box(0, 0, 0),
+		second = box(6, 0, 0);
+	const bodies = [
+		[first, first],
+		[second, second],
+		[first, first],
+	];
+	const before = structuredClone(bodies);
+	const result = sweepSupports('closed', bodies, 2);
+	assert.equal(result.surfaces.length, 3);
+	assert.equal(result.surfacePoses.length, result.surfaces.length);
+	assert.deepEqual(result.surfacePoses, [
+		[
+			{ body: 0, fromPose: 0, toPose: 0 },
+			{ body: 0, fromPose: 2, toPose: 2 },
+			{ body: 1, fromPose: 0, toPose: 0 },
+			{ body: 1, fromPose: 2, toPose: 2 },
+		],
+		[
+			{ body: 0, fromPose: 1, toPose: 1 },
+			{ body: 1, fromPose: 1, toPose: 1 },
+		],
+		[
+			{ body: 0, fromPose: 0, toPose: 1 },
+			{ body: 0, fromPose: 1, toPose: 2 },
+			{ body: 1, fromPose: 0, toPose: 1 },
+			{ body: 1, fromPose: 1, toPose: 2 },
+		],
+	]);
+	assert.deepEqual(result.transfers, [
+		{ from: [0, 1, 0], to: [6, 1, 0], speed: 2, body: 0, fromPose: 0, toPose: 1 },
+		{ from: [6, 1, 0], to: [0, 1, 0], speed: 2, body: 0, fromPose: 1, toPose: 2 },
+		{ from: [0, 1, 0], to: [6, 1, 0], speed: 2, body: 1, fromPose: 0, toPose: 1 },
+		{ from: [6, 1, 0], to: [0, 1, 0], speed: 2, body: 1, fromPose: 1, toPose: 2 },
+	]);
+	assert.deepEqual(result.poses, [
+		{ min: [-1, -1, -1], max: [1, 1, 1] },
+		{ min: [5, -1, -1], max: [7, 1, 1] },
+		{ min: [-1, -1, -1], max: [1, 1, 1] },
+	]);
+	assert.deepEqual(supportEndpoints(bodies), { initial: result.poses[0], terminal: result.poses[2] });
+	assert.deepEqual(bodies, before);
+});
+
+test('pose boxes enclose the whole support while face and ride references identify individual bodies', () => {
+	const result = sweepSupports(
+		'two-bodies',
+		[
+			[box(0, 0, 0), box(4, 2, 0)],
+			[box(0, 8, 0), box(4, 10, 0)],
+		],
+		null,
+	);
+	assert.deepEqual(result.poses, [
+		{ min: [-1, -1, -1], max: [5, 3, 1] },
+		{ min: [-1, 7, -1], max: [5, 11, 1] },
+	]);
+	assert.deepEqual(result.surfacePoses, [
+		[{ body: 0, fromPose: 0, toPose: 0 }],
+		[{ body: 0, fromPose: 1, toPose: 1 }],
+		[{ body: 1, fromPose: 0, toPose: 0 }],
+		[{ body: 1, fromPose: 1, toPose: 1 }],
+	]);
+	assert.deepEqual(result.transfers, [
+		{ from: [0, 1, 0], to: [0, 9, 0], speed: null, body: 0, fromPose: 0, toPose: 1 },
+		{ from: [4, 3, 0], to: [4, 11, 0], speed: null, body: 1, fromPose: 0, toPose: 1 },
+	]);
+});
diff --git a/packages/extractor/src/game/swept-supports.ts b/packages/extractor/src/game/swept-supports.ts
new file mode 100644
index 00000000..a897f412
--- /dev/null
+++ b/packages/extractor/src/game/swept-supports.ts
@@ -0,0 +1,197 @@
+import type { Surface, Vec3 } from '@opendfieldmap/ganglia';
+
+/** world-axis-aligned bounds enclosing all collider bodies at one sampled pose */
+export interface PoseBounds {
+	min: Vec3;
+	max: Vec3;
+}
+
+/** source pose interval of one body contributing a support face or transfer */
+export interface PoseSpan {
+	fromPose: number;
+	toPose: number;
+	body: number;
+}
+
+/** query-independent phase-free support, scoped to one moving body's authored path */
+export interface SweptSupport {
+	id: string;
+	family: 'platform' | 'conveyor' | 'seesaw' | 'water-floater' | 'forklift';
+	level: string;
+	model: string;
+	/** local authored control, retained alongside the fully-enabled planning assumption */
+	control?: {
+		kind: 'forklift';
+		logicType: 24;
+		start: Vec3;
+		end: Vec3;
+		speed: number;
+		initialState: number;
+		initiallyOn: boolean;
+		assumption: 'fully-enabled';
+	};
+	/** world-axis-aligned endpoint boxes for illustration; separate from navigation support */
+	endpoints?: {
+		initial: PoseBounds;
+		terminal: PoseBounds;
+	};
+	/** sampled whole-support boxes; translation spans permit interpolation, seesaw states remain discrete */
+	poses?: PoseBounds[];
+	surfaces: Surface[];
+	/** parallel to surfaces, retaining every pose interval contributing a deduplicated face */
+	surfacePoses?: PoseSpan[][];
+	/** rides connect supported poses without making other times into solid obstacles */
+	transfers: {
+		from: Vec3;
+		to: Vec3;
+		speed: number | null;
+		fromPose?: number;
+		toPose?: number;
+		body?: number;
+	}[];
+	assumption: 'phase-free-swept-support';
+}
+
+/**
+ * @param bodies solid collider vertices in one world-space pose
+ * @returns a copied box enclosing every body
+ * @throws for missing geometry or nonfinite vertices
+ */
+export const supportBounds = (bodies: readonly Vec3[][] | undefined): PoseBounds => {
+	if (!bodies?.length || bodies.some((body) => !body.length)) {
+		throw new Error('missing moving support endpoint geometry');
+	}
+	const min: Vec3 = [Infinity, Infinity, Infinity];
+	const max: Vec3 = [-Infinity, -Infinity, -Infinity];
+	for (const body of bodies) {
+		for (const point of body) {
+			if (point.length !== 3 || !point.every(Number.isFinite)) {
+				throw new Error('invalid moving support endpoint vertex');
+			}
+			for (let axis = 0; axis < 3; axis++) {
+				min[axis] = Math.min(min[axis], point[axis]);
+				max[axis] = Math.max(max[axis], point[axis]);
+			}
+		}
+	}
+	return { min, max };
+};
+
+/**
+ * @param poses solid collider vertices in world space, grouped by body at each authored pose
+ * @returns copied world bounds at the first and last poses, including closed paths with coincident ends
+ * @throws for missing endpoint geometry or nonfinite endpoint vertices
+ */
+export const supportEndpoints = (
+	poses: readonly (readonly Vec3[][])[],
+): NonNullable<SweptSupport['endpoints']> => ({
+	initial: supportBounds(poses[0]),
+	terminal: supportBounds(poses.at(-1)),
+});
+
+const cross = (a: Vec3, b: Vec3, c: Vec3) => (b[0] - a[0]) * (c[2] - a[2]) - (b[2] - a[2]) * (c[0] - a[0]);
+
+const half = (list: Vec3[]) => {
+	const chain: Vec3[] = [];
+	for (const p of list) {
+		while (chain.length > 1 && cross(chain.at(-2)!, chain.at(-1)!, p) <= 0) {
+			chain.pop();
+		}
+		chain.push(p);
+	}
+	return chain.slice(0, -1);
+};
+
+const center = (vertices: Vec3[]): Vec3 => {
+	const sum: Vec3 = [0, 0, 0];
+	for (const point of vertices) {
+		sum[0] += point[0];
+		sum[1] += point[1];
+		sum[2] += point[2];
+	}
+	return [sum[0] / vertices.length, sum[1] / vertices.length, sum[2] / vertices.length];
+};
+
+// each segment gets its own hull, so an L-shaped route never fills the inside of the bend.
+const roof = (points: readonly Vec3[]): Vec3[] => {
+	const height = Math.max(...points.map((p) => p[1]));
+	const sorted = points
+		.map((p) => [p[0], height, p[2]] as Vec3)
+		.toSorted((a, b) => a[0] - b[0] || a[2] - b[2]);
+	const unique = sorted.filter((p, i) => !i || p[0] !== sorted[i - 1][0] || p[2] !== sorted[i - 1][2]);
+
+	return [...half(unique), ...half(unique.toReversed())].toReversed();
+};
+
+/**
+ * @param id stable source identity
+ * @param bodies solid collider vertices at each sampled fixed-orientation translation pose, with identical
+ *   body ordering
+ * @param speed positive ride speed in metres per second, or null when timing is unresolved
+ * @returns sweep roofs, endpoint caps and transfers with their source pose spans, without phase expansion
+ * @throws for nonfinite geometry, unequal pose body counts or invalid speed
+ */
+export const sweepSupports = (id: string, bodies: Vec3[][][], speed: number | null) => {
+	if (
+		!bodies.length ||
+		bodies.some(
+			(pose) =>
+				pose.length !== bodies[0].length ||
+				pose.some((body) => body.length < 3 || body.some((p) => p.length !== 3 || !p.every(Number.isFinite))),
+		) ||
+		(speed !== null && (!Number.isFinite(speed) || speed <= 0))
+	) {
+		throw new Error('invalid moving support poses');
+	}
+	const surfaces: Surface[] = [];
+	const surfacePoses: PoseSpan[][] = [];
+	const transfers: SweptSupport['transfers'] = [];
+	const poses = bodies[0].length ? bodies.map(supportBounds) : [];
+	const seen = new Map<string, number>();
+	const add = (vertices: Vec3[], span: PoseSpan) => {
+		const key = JSON.stringify(vertices);
+		if (vertices.length < 3) {
+			return;
+		}
+		const index = seen.get(key);
+		if (index !== undefined) {
+			const previous = surfacePoses[index];
+			if (
+				!previous.some(
+					(entry) =>
+						entry.fromPose === span.fromPose && entry.toPose === span.toPose && entry.body === span.body,
+				)
+			) {
+				previous.push(span);
+			}
+			return;
+		}
+		seen.set(key, surfaces.length);
+		surfaces.push({ id: `moving/${id}/${surfaces.length}`, vertices });
+		surfacePoses.push([span]);
+	};
+
+	for (let body = 0; body < bodies[0].length; body++) {
+		add(roof(bodies[0][body]), { body, fromPose: 0, toPose: 0 });
+		for (let pose = 1; pose < bodies.length; pose++) {
+			const a = roof(bodies[pose - 1][body]),
+				b = roof(bodies[pose][body]);
+			const from = center(a),
+				to = center(b);
+			add(a, { body, fromPose: pose - 1, toPose: pose - 1 });
+			add(b, { body, fromPose: pose, toPose: pose });
+			if (Math.hypot(...from.map((value, axis) => value - to[axis])) > 1e-9) {
+				transfers.push({ from, to, speed, body, fromPose: pose - 1, toPose: pose });
+			}
+			// a purely vertical trip has caps and a ride, without a fictitious shaft wall.
+			if (Math.hypot(from[0] - to[0], from[2] - to[2]) > 1e-9) {
+				add(roof([...bodies[pose - 1][body], ...bodies[pose][body]]), {
+					body,
+					fromPose: pose - 1,
+					toPose: pose,
+				});
+			}
+		}
+	}
+	return { surfaces, surfacePoses, poses, transfers };
+};
