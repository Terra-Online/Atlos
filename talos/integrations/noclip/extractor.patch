+						path: placed?.path ?? registryPath,
+						kind: placed?.kind ?? 'npc-proxy',
+						createState: typeof row.createState === 'number' ? row.createState : null,
+					},
+				});
+			}
+			partitions.set(subregion, points);
+		}
+		const drafts = game.controls(),
+			missions = await labelStory(ctx.world, drafts);
+		const extra: CompanionControl[] = drafts.map((control) => {
+			if (control.source.kind !== 'user') {
+				throw new Error(`companion control ${control.id} is not user-set`);
+			}
+			return { ...control, source: control.source };
+		});
+		const labels: Companion['labels'] = {};
+		for (const [locale, language] of Object.entries({
+			'en-US': 'EN',
+			'zh-CN': 'CN',
+			'zh-TW': 'TC',
+			'ja-JP': 'JP',
+			'ko-KR': 'KR',
+			'ru-RU': 'RU',
+			'es-ES': 'MX',
+			'pt-BR': 'BR',
+			'de-DE': 'DE',
+			'fr-FR': 'FR',
+			'vi-VN': 'VN',
+			'th-TH': 'TH',
+			'id-ID': 'ID',
+			'it-IT': 'IT',
+		})) {
+			const controls = extra.map((c) => ({ ...c })),
+				names = await labelStory(ctx.world, controls, language);
+			labels[locale] = Object.fromEntries(
+				controls.map((c) => {
+					const story = c.story;
+					const mission = names.find((m) => m.id === story?.mission)?.name;
+					return [c.id, c.story?.role === 'quest' && mission ? `${mission}: ${c.name}` : c.name];
+				}),
+			);
+		}
+		const payloads = new Map<string, Companion>();
+		const presets = new Map<string, Point['presets']>();
+		for (const [subregion, points] of partitions) {
+			for (const p of points) {
+				const states = companionStates(cores.get(p.scene)!.states, { controls: extra, missions });
+				states.mainStory = mainStoryOrder(states.missions).map((id) =>
+					states.missions.findIndex((mission) => mission.id === id),
+				);
+				const key = `${p.scene}:${JSON.stringify(p.condition)}`;
+				let choices = presets.get(key);
+				if (!choices) {
+					choices = pointPresets(states, p.condition);
+					presets.set(key, choices);
+				}
+				p.presets = choices;
+				if (!p.presets.some((preset) => preset.satisfies)) {
+					p.unknown.push('no-consistent-story-preset');
+				}
+			}
+			payloads.set(subregion, { version: 1, release: '', controls: extra, missions, labels, points });
+		}
+		const release = createHash('sha256')
+			.update(
+				JSON.stringify({
+					source,
+					generations: [...cores.values()].map((c) => c.generation),
+					payloads: [...payloads],
+				}),
+			)
+			.digest('hex')
+			.slice(0, 16);
+		const destination = join(output, release);
+		await mkdir(join(destination, 'points'), { recursive: true });
+		const catalog: Catalog = {
+			format: 'oem-noclip',
+			version: 1,
+			release,
+			source,
+			packages: {},
+			files: {},
+			pointIndex: {},
+		};
+		for (const [scene, core] of cores) {
+			catalog.packages[scene] = {
+				path: `packages/${scene}/`,
+				generation: core.generation,
+				version: core.version,
+			};
+			for (const archive of core.archives) {
+				const target = join(destination, 'packages', scene, archive.name);
+				await mkdir(resolve(target, '..'), { recursive: true });
+				await cp(join(packages, scene, archive.name), target, {
+					force: false,
+					errorOnExist: true,
+					mode: constants.COPYFILE_FICLONE,
+				});
+			}
+		}
+		for (const [id, payload] of payloads) {
+			payload.release = release;
+			catalog.files[id] = `points/${id}.json`;
+			for (const point of payload.points) {
+				if (catalog.pointIndex[point.id]) {
+					throw new Error(`duplicate point ${point.id}`);
+				}
+				catalog.pointIndex[point.id] = id;
+			}
+			await writeFile(join(destination, catalog.files[id]), JSON.stringify(payload));
+		}
+		await writeFile(join(destination, 'index.json'), JSON.stringify(catalog));
+		console.log(
+			`OEM release ${release}: ${Object.keys(catalog.pointIndex).length} points, ${cores.size} scenes, ${destination}`,
+		);
+	});
+};
diff --git a/packages/extractor/src/commands/player-ground.test.ts b/packages/extractor/src/commands/player-ground.test.ts
new file mode 100644
index 00000000..09da9359
--- /dev/null
+++ b/packages/extractor/src/commands/player-ground.test.ts
@@ -0,0 +1,59 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { deserialize } from 'node:v8';
+
+import { encodeCollision, run } from './player-ground.ts';
+
+const args = (bounds: string, cellSize = '0.15') => [
+	'map01',
+	`--bounds=${bounds}`,
+	'--scene-state',
+	'0',
+	'--area',
+	'0',
+	'--movement-settings',
+	'unused.json',
+	'--collision-output',
+	'unused-collision.json',
+	'-o',
+	'unused-ground.json',
+	'--cell-size',
+	cellSize,
+];
+
+test('rejects unbounded source-cell loops before reading installation inputs', async () => {
+	await assert.rejects(run(args('1e24,0,2e24,10')), /collision cell budget/);
+	await assert.rejects(run(args('0,0,100000,100000')), /collision cell budget/);
+});
+
+test('rejects invalid voxel resolution and excessive tile work before extraction', async () => {
+	await assert.rejects(run(args('0,0,10,10', '0')), /resolution or tile budget/);
+	await assert.rejects(run(args('0,0,100,100', '0.0001')), /resolution or tile budget/);
+	await assert.rejects(run([...args('0,0,10,10'), '--collision-format=unsupported']), /invalid collision format/);
+});
+
+test('local v8 collision snapshots retain float64 coordinates, uint32 indices and exporter metadata', () => {
+	const value = {
+		positions: [-0, Math.PI, 1 + Number.EPSILON, 2 ** 40 + 0.125, -(2 ** 40) - 0.5, Number.MIN_VALUE, 1, 2, 3],
+		indices: [2, 0, 1],
+		scene: 'scene', source: { buildGuid: 'build', contentHash: 'content' },
+		selection: { sceneState: 0, area: 0, solidsOnly: true },
+		coverage: { complete: false }, records: [{ first: 0, count: 1, walkable: false }],
+		exclusions: [], options: { profile: { radius: 0.25, height: 1 }, bounds: { min: [0, 0], max: [10, 10] } },
+		exportRevision: 2, generator: 'generator', absent: [{ x: 1, z: 2 }],
+	};
+	assert.equal(encodeCollision(value), JSON.stringify(value));
+	const encoded = encodeCollision(value, 'v8');
+	assert.ok(Buffer.isBuffer(encoded));
+	const decoded = deserialize(encoded);
+	assert.ok(decoded.positions instanceof Float64Array);
+	assert.ok(decoded.indices instanceof Uint32Array);
+	assert.deepEqual(Array.from(decoded.positions), value.positions);
+	assert.deepEqual(Array.from(decoded.indices), value.indices);
+	assert.deepEqual({ ...decoded, positions: value.positions, indices: value.indices }, value);
+	assert.throws(() => encodeCollision({ ...value, indices: [2 ** 32, 0, 1] }, 'v8'), /invalid collision/);
+	assert.throws(() => encodeCollision({ ...value, indices: [0.5, 0, 1] }, 'v8'), /invalid collision/);
+	const invalid = { ...value, positions: [...value.positions] };
+	Object.assign(invalid.positions, { 0: false });
+	assert.throws(() => encodeCollision(invalid, 'v8'), /invalid collision/);
+});
diff --git a/packages/extractor/src/commands/travel-points.ts b/packages/extractor/src/commands/travel-points.ts
new file mode 100644
index 00000000..3adba4be
--- /dev/null
+++ b/packages/extractor/src/commands/travel-points.ts
@@ -0,0 +1,167 @@
+/* oxlint-disable no-await-in-loop -- decode and release each factory level in turn */
+import { writeFile } from 'node:fs/promises';
+import { parseArgs } from 'node:util';
+
+import { isObject } from '@endfield-noclip/formats/unity/values';
+
+import { withContext } from '../context.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+export const summary = 'export map teleport landing positions; availability remains a player-state input';
+export const usage = 'usage: endfield-extract travel-points -o <file> --config <config>';
+
+/** @param args output and install config @returns after exporting authored camp landing positions */
+export const run = async (args: string[]): Promise<void> => {
+	const { values } = parseArgs({
+		args,
+		options: { output: { type: 'string', short: 'o' }, config: { type: 'string' } },
+	});
+	if (!values.output) {
+		throw new Error(usage);
+	}
+	await withContext(values.config, async (ctx) => {
+		const file = await ctx.vfs.find(
+			VfsGroup.JsonData,
+			'Data/Json/GameplayConfig/MapTeleportValidationDataTable.json',
+		);
+		if (!file) {
+			throw new Error('missing map teleport data');
+		}
+		const reader = await ctx.memoryPack();
+		const data = reader.decode(
+			await file.readVerified(),
+			'Beyond_Gameplay_TeleportValidationDataTableForMemoryPack',
+		);
+		if (!isObject(data) || !Array.isArray(data.teleportValidationDatas)) {
+			throw new Error('invalid teleport table');
+		}
+		const levels = await ctx.world.levelConfigs();
+		const points = [],
+			unmapped = [];
+		for (const entry of data.teleportValidationDatas) {
+			if (!Array.isArray(entry) || entry.length !== 2 || !isObject(entry[1])) {
+				throw new Error('invalid teleport entry');
+			}
+			const row = entry[1];
+			if (row.teleportReason !== 2 || typeof row.id !== 'string' || !row.id.startsWith('TpForMap_ent_')) {
+				continue;
+			}
+			const position: unknown = row.position;
+			if (
+				typeof row.sceneId !== 'string' ||
+				!Array.isArray(position) ||
+				position.length !== 3 ||
+				!position.every((v: unknown) => typeof v === 'number' && Number.isFinite(v))
+			) {
+				throw new Error('invalid teleport position');
+			}
+			const level = levels.get(row.sceneId);
+			if (!level) {
+				unmapped.push({ id: row.id, level: row.sceneId });
+				continue;
+			}
+			points.push({
+				id: row.id,
+				kind: 'teleport',
+				level: level.id,
+				scene: level.mapId,
+				position,
+				availability: 'unknown',
+			});
+		}
+		const paths = await ctx.world.pathLookup();
+		const baseIds = new Set<string>();
+		for (const level of levels.values()) {
+			if (!level.mapId || !['map01', 'map02'].includes(level.mapId)) {
+				continue;
+			}
+			for (const hash of level.levelDataPathHashes ?? []) {
+				const path = paths(hash);
+				if (!path) {
+					throw new Error('missing factory level path');
+				}
+				const levelFile = await ctx.vfs.find(VfsGroup.JsonData, path);
+				if (!levelFile) {
+					throw new Error(`missing ${path}`);
+				}
+				const levelData = reader.decode(
+					await levelFile.readVerified(),
+					'Beyond_Gameplay_LevelDataForMemoryPack',
+				);
+				if (!isObject(levelData) || !Array.isArray(levelData.factoryRegions)) {
+					throw new Error('invalid factory regions');
+				}
+				for (const region of levelData.factoryRegions) {
+					if (!isObject(region) || !Array.isArray(region.areas)) {
+						throw new Error('invalid factory region');
+					}
+					for (const area of region.areas) {
+						if (!isObject(area) || typeof area.isMain !== 'boolean') {
+							continue;
+						}
+						const stageData: unknown = area.levelData;
+						if (
+							!Array.isArray(stageData) ||
+							typeof region.regionId !== 'string' ||
+							typeof area.index !== 'number' ||
+							!Number.isInteger(area.index)
+						) {
+							throw new Error('invalid base area');
+						}
+						const stages = stageData.filter(isObject).toSorted((a, b) => Number(a.level) - Number(b.level));
+						const stage = stages.at(-1);
+						if (
+							!stage ||
+							!Array.isArray(stage.levelBounds) ||
+							stage.levelBounds.length !== 1 ||
+							!isObject(stage.levelBounds[0])
+						) {
+							throw new Error('unsupported multi-bound base centre');
+						}
+						const bounds = stage.levelBounds[0];
+						const start: unknown = bounds.start,
+							size: unknown = bounds.size;
+						if (
+							!Array.isArray(start) ||
+							!Array.isArray(size) ||
+							start.length !== 3 ||
+							size.length !== 3 ||
+							![...start, ...size].every((v: unknown) => typeof v === 'number' && Number.isFinite(v)) ||
+							size.some((v: number) => v <= 0)
+						) {
+							throw new Error('invalid base bounds');
+						}
+						const id = `${region.regionId}:${String(area.index)}`;
+						if (baseIds.has(id)) {
+							throw new Error('duplicate base');
+						}
+						baseIds.add(id);
+						points.push({
+							id,
+							kind: 'base',
+							level: level.id,
+							scene: level.mapId,
+							position: start.map((v: number, i: number) => v + Number(size[i]) / 2),
+							availability: 'unknown',
+							// Region centres are teleport anchors in the completed-world model.
+							requiresGroundProjection: true,
+							groundRange: [Number(start[1]), Number(start[1]) + Number(size[1])],
+							areaLevel: Number(stage.level),
+						});
+					}
+				}
+			}
+		}
+		const build = await ctx.world.manifest();
+		await writeFile(
+			values.output!,
+			JSON.stringify({
+				version: 1,
+				source: { buildGuid: build.guid, contentHash: build.contentHash },
+				points,
+				unmapped,
+			}),
+		);
+		console.log(JSON.stringify({ points: points.length, bases: baseIds.size, unmapped: unmapped.length }));
+	});
+};
diff --git a/packages/extractor/src/commands/walk-routes.ts b/packages/extractor/src/commands/walk-routes.ts
new file mode 100644
index 00000000..bfb5d554
--- /dev/null
+++ b/packages/extractor/src/commands/walk-routes.ts
@@ -0,0 +1,78 @@
+import { createHash } from 'node:crypto';
+import { readFile, writeFile } from 'node:fs/promises';
+import { parseArgs } from 'node:util';
+
+import { createGroundPlanner } from "@opendfieldmap/ganglia/solver/host";
+
+import { groundData } from '../game/ground-data.ts';
+
+export const summary = 'plan selected ground routes and export source-bound inputs for Atlos';
+export const usage =
+	'usage: endfield-extract walk-routes --navigation <file> --walls <file> --request <file> -o <routes> --data <ground-data> [--travel-points <file>] [--movement-settings <file>]';
+
+/**
+ * @param args matching navigation/wall exports and explicit state/profile/arrival request
+ * @returns after writing routes for oem-views and ground data for Atlos
+ */
+export const run = async (args: string[]): Promise<void> => {
+	const { values } = parseArgs({
+		args,
+		options: {
+			navigation: { type: 'string' },
+			walls: { type: 'string' },
+			request: { type: 'string' },
+			output: { type: 'string', short: 'o' },
+			data: { type: 'string' },
+			'travel-points': { type: 'string' },
+			'movement-settings': { type: 'string' },
+		},
+	});
+	if (
+		!values.navigation ||
+		!values.walls ||
+		!values.request ||
+		!values.output ||
+		!values.data ||
+		values.output === values.data
+	) {
+		throw new Error(usage);
+	}
+	const input = await Promise.all(
+		[values.navigation, values.walls, values.request].map((path) => readFile(path, 'utf8')),
+	);
+	const travel: unknown = values['travel-points']
+		? JSON.parse(await readFile(values['travel-points'], 'utf8'))
+		: undefined;
+	const movement: unknown = values['movement-settings']
+		? JSON.parse(await readFile(values['movement-settings'], 'utf8'))
+		: undefined;
+	const data = groundData(JSON.parse(input[0]), JSON.parse(input[1]), JSON.parse(input[2]), {
+		travel,
+		movement,
+	});
+	const binding = createHash('sha256').update(JSON.stringify(data)).digest('hex');
+	const planner = createGroundPlanner(data.surfaces, data.options);
+	const routes = data.targets.map((target) => ({
+		id: target.id,
+		...planner.plan(data.arrivals, target.position),
+	}));
+	await writeFile(values.data, JSON.stringify({ version: 1, binding, ...data }));
+	await writeFile(
+		values.output,
+		JSON.stringify({
+			release: data.release,
+			binding,
+			routes: routes.filter((route) => route.status === 'complete'),
+			unresolved: routes.filter((route) => route.status !== 'complete'),
+		}),
+	);
+	console.log(
+		JSON.stringify({
+			binding,
+			surfaces: data.surfaces.length,
+			profile: data.options.profile,
+			routes: routes.length,
+			complete: routes.filter((route) => route.status === 'complete').length,
+		}),
+	);
+};
diff --git a/packages/extractor/src/game/air-wall-state.test.ts b/packages/extractor/src/game/air-wall-state.test.ts
new file mode 100644
index 00000000..5638aba9
--- /dev/null
+++ b/packages/extractor/src/game/air-wall-state.test.ts
@@ -0,0 +1,426 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import {
+	completedWallState,
+	enabledWallState,
+	completedScriptWallState,
+	terminalScriptStage,
+	createWallResolver,
+} from './air-wall-state.ts';
+import type { Script } from './script-drivers.ts';
+
+const reason = (detailState: number, isSame = true) => ({
+	id: 'mission',
+	isQuest: false,
+	detailState,
+	isSame,
+});
+const wall = (riseReason = [reason(2)], downReason = [reason(2, false)]) => ({
+	scriptId: '0',
+	defaultOn: false,
+	condition: { checkType: 1, missionData: { isRiseAny: false, isDownAny: false, riseReason, downReason } },
+});
+
+test('completed progression resolves mission gates using client equality and rise/down priority', () => {
+	assert.equal(completedWallState(wall()), 'inactive');
+	assert.equal(completedWallState(wall([reason(3)])), 'active');
+	assert.equal(completedWallState(wall([reason(3)], [reason(3)])), 'active');
+	const neither = wall([reason(2)], [reason(3, false)]);
+	assert.equal(completedWallState(neither), 'inactive');
+	assert.equal(completedWallState({ ...neither, defaultOn: true }), 'active');
+	const combined = wall([reason(2), reason(3)], [reason(3)]);
+	assert.equal(completedWallState(combined), 'inactive');
+	combined.condition.missionData.isRiseAny = true;
+	assert.equal(completedWallState(combined), 'active');
+	assert.equal(completedWallState(wall([], [reason(3)])), 'inactive');
+	assert.equal(completedWallState({ ...wall([], [reason(3)]), defaultOn: true }), 'inactive');
+	assert.equal(completedWallState(wall([], [])), 'inactive');
+	assert.equal(completedWallState({ ...wall([], []), defaultOn: true }), 'active');
+	const emptyAny = wall([], [reason(3)]);
+	emptyAny.condition.missionData.isRiseAny = true;
+	assert.equal(completedWallState(emptyAny), 'inactive');
+});
+
+test('level-script defaults require a control scan including group-id writers', () => {
+	const data = { ...wall(), level: 'level', groupId: '42', condition: { checkType: 0, missionData: null } };
+	assert.equal(completedWallState(data), 'unknown');
+	const resolve = createWallResolver({ scripts: [], ownLevels: new Set(['level']), undecoded: 0 });
+	assert.equal(completedWallState({ ...data, completed: resolve(data) }), 'inactive');
+	assert.equal(resolve({ ...data, defaultOn: true }).state, 'active');
+	assert.equal(resolve({ ...data, scriptId: '42' }).state, 'unknown');
+	const active = { ID: 0, $type: 'ScriptEvent_OnScriptActive', nextID: 1 };
+	const enter = { ID: 2, $type: 'ScriptEvent_OnLeaderEnterTriggerVolume', nextID: 3 };
+	const pointer = { paramSource: 0, constValue: { useSlotId: false, logicId: '42' } };
+	const script: Script = {
+		id: 'controller',
+		level: 'level',
+		data: {},
+		headers: [active, enter],
+		getters: new Map(),
+		nodes: new Map<number, Script['data']>([
+			[0, active],
+			[2, enter],
+			[
+				1,
+				{ ID: 1, $type: 'AirWallEnable', airWallPtr: pointer, enable: { paramSource: 0, constValue: false } },
+			],
+			[
+				3,
+				{ ID: 3, $type: 'AirWallEnable', airWallPtr: pointer, enable: { paramSource: 0, constValue: true } },
+			],
+		]),
+	};
+	const controlled = createWallResolver({ scripts: [script], ownLevels: new Set(['level']), undecoded: 0 })(
+		data,
+	);
+	assert.equal(controlled.state, 'unknown');
+	assert.equal(controlled.controllers[0].script, 'controller');
+	assert.equal(completedWallState({ ...data, completed: controlled }), 'unknown');
+	script.nodes.set(3, {
+		ID: 3,
+		$type: 'AirWallEnable',
+		airWallPtr: pointer,
+		enable: { paramSource: 0, constValue: false },
+	});
+	assert.equal(
+		createWallResolver({ scripts: [script], ownLevels: new Set(['level']), undecoded: 0 })(data).state,
+		'inactive',
+	);
+	assert.equal(
+		createWallResolver({ scripts: [script], ownLevels: new Set(['level']), undecoded: 1 })(data).state,
+		'unknown',
+	);
+	assert.equal(
+		createWallResolver({ scripts: [script], ownLevels: new Set(), undecoded: 0 })({
+			...data,
+			defaultOn: true,
+		}).state,
+		'unknown',
+	);
+	const changed = {
+		...active,
+		$type: 'ScriptEvent_OnScriptStageChanged',
+		filterMode: true,
+		newStageFilter: { paramSource: 0, constValue: 2 },
+	};
+	script.headers = [changed];
+	script.nodes.set(0, changed);
+	assert.equal(
+		completedScriptWallState(script, { logicId: '42' }, { stage: null, initialState: 'unknown' }),
+		'unknown',
+	);
+	const dynamicFilter = { ...changed, newStageFilter: { paramSource: 300, path: 'stage' } };
+	script.headers = [dynamicFilter];
+	script.nodes.set(0, dynamicFilter);
+	assert.equal(
+		completedScriptWallState(script, { logicId: '42' }, { stage: 2, initialState: 'active' }),
+		'unknown',
+	);
+	script.nodes.set(1, {
+		ID: 1,
+		$type: 'AirWallEnable',
+		airWallPtr: { paramSource: 300, path: 'target' },
+		enable: { paramSource: 0, constValue: true },
+	});
+	const unresolved = createWallResolver({ scripts: [script], ownLevels: new Set(['level']), undecoded: 0 })(
+		data,
+	);
