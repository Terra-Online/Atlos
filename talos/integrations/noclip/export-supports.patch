@@ -0,0 +1,169 @@
+import type { LevelInteractive } from '@endfield-noclip/formats/endfield/level-interactives';
+import type { MemoryPackValue } from '@endfield-noclip/formats/endfield/memory-pack';
+import type { Vec3 } from '@opendfieldmap/ganglia';
+import { componentParams } from './interactives/component-params.ts';
+import { atomFloat } from './interactives/template-data.ts';
+import type { LevelWaterVolume } from './water/water-volumes.ts';
+import type { Script } from './script-drivers.ts';
+import type { ScriptWaterLevel } from './water/water-volume-scripts.ts';
+import { isMemoryPackObject } from '@endfield-noclip/formats/endfield/memory-pack';
+
+const CURVE = {
+	suffix: '_WaterProgressDriveCurveMovementComponentDataForMemoryPack',
+	diffKey: 'Comp_WaterProgressDriveCurveMovement',
+	type: 125,
+};
+const PROGRESS = {
+	suffix: '_WaterProgressComponentDataForMemoryPack',
+	diffKey: 'Comp_WaterProgress',
+	type: 87,
+};
+const FLOATER = {
+	suffix: '_BelongToWaterVolumeComponentDataForMemoryPack',
+	diffKey: 'Comp_BelongToWaterVolume',
+	type: 39,
+};
+const scalar = (value: ReturnType<typeof componentParams>, key: string) => {
+	const p = value?.get(key);
+	if (!p || ![5, 6].includes(p.type) || p.values.length !== 1) return null;
+	const n = atomFloat(p.values[0].bits);
+	return Number.isFinite(n) ? n : null;
+};
+
+/** WaterProgress is an interactive control, independent of WaterVolume IDs.
+ * Its curve supplies a support domain; ratios are not constant travel speeds. */
+export const waterCurveOf = (template: MemoryPackValue, row: LevelInteractive) => {
+	const curve = componentParams(template, row, CURVE);
+	if (!curve) return null;
+	const spline = curve.get('spline_id'),
+		rotation = curve.get('is_update_rotation_on_spline');
+	if (spline?.type !== 3 || spline.values.length !== 1 || spline.values[0].bits <= 0n)
+		throw new Error('water-progress spline unavailable');
+	if (rotation?.type !== 1 || rotation.values.length !== 1 || rotation.values[0].bits !== 0n)
+		throw new Error('water-progress tangent rotation unresolved');
+	const mode = curve.get('curve_move_type');
+	if (mode?.type !== 3 || mode.values.length !== 1 || mode.values[0].bits !== 1n)
+		throw new Error('water-progress curve mode unsupported');
+	const progress = componentParams(template, row, PROGRESS);
+	const increaseRatio = scalar(progress, 'water_progress_increase_ratio');
+	const decreaseRatio = scalar(progress, 'water_progress_decrease_ratio');
+	if (increaseRatio === null || decreaseRatio === null || increaseRatio < 0 || decreaseRatio < 0)
+		throw new Error('water-progress rates unresolved');
+	return {
+		splineId: Number(spline.values[0].bits),
+		control: {
+			kind: 'water-progress' as const,
+			id: String(row.id),
+			increaseRatio,
+			decreaseRatio,
+			assumption: 'phase-free-swept-support' as const,
+		},
+	};
+};
+
+/** A zero source reference is unbound, rather than an invitation to select a
+ * nearby pool. Shared volume IDs retain a common water-level binding. */
+export const waterFloaterOf = (template: MemoryPackValue, row: LevelInteractive) => {
+	const p = componentParams(template, row, FLOATER);
+	if (!p) return null;
+	const volume = p.get('water_volume');
+	if (volume?.type !== 56 || volume.values.length !== 1 || volume.values[0].bits < 0n)
+		throw new Error('floater water-volume reference unresolved');
+	const surfaceOffset = p.has('surface_offset') ? scalar(p, 'surface_offset') : 0;
+	if (surfaceOffset === null) throw new Error('floater surface offset unresolved');
+	return {
+		volume: volume.values[0].bits === 0n ? null : String(volume.values[0].bits),
+		surfaceOffset,
+	};
+};
+
+/** Settled floating roots use the source surface_offset, not their authored
+ * height above the initial water. Animation lag does not establish a ride speed. */
+export const waterFloaterPositions = (
+	volume: Pick<LevelWaterVolume, 'pivot' | 'heightMax' | 'fraction'>,
+	row: LevelInteractive,
+	surfaceOffset: number,
+	fills: readonly number[] = [0, 1],
+): Vec3[] => {
+	if (
+		![volume.pivot[1], volume.heightMax, volume.fraction, surfaceOffset].every(Number.isFinite) ||
+		volume.heightMax < 0 ||
+		volume.fraction < 0 ||
+		volume.fraction > 1 ||
+		!fills.length ||
+		fills.some((fill) => !Number.isFinite(fill) || fill < 0 || fill > 1)
+	)
+		throw new Error('invalid water-level range');
+	if (fills.length === 1 && fills[0] === volume.fraction) return [[...row.position]];
+	const settled: Vec3[] = fills.map((fill) => [
+		row.position[0],
+		volume.pivot[1] + volume.heightMax * fill + surfaceOffset,
+		row.position[2],
+	]);
+	// The authored initial pose is distinct from the settled response after a
+	// water-level change. Preserve it without carrying its offset to other fills.
+	return [
+		[...row.position],
+		...settled.filter((p) => Math.hypot(...p.map((v, i) => v - row.position[i])) > 1e-6),
+	];
+};
+
+/** Finite pools retain the full-capacity abstraction. Infinite water follows
+ * its authored initial fill and script targets. Floater lag is a separate motion. */
+export const waterLevelDomain = (
+	volume: Pick<LevelWaterVolume, 'id' | 'infinite' | 'fraction' | 'amountMax'>,
+	levels: readonly ScriptWaterLevel[],
+) => {
+	const targets = levels.filter((level) => level.volume === volume.id);
+	const fills = [
+		volume.fraction,
+		...targets.map((level) =>
+			level.kind === 'fraction' ? level.value : level.value / volume.amountMax,
+		),
+	];
+	if (fills.some((fill) => !Number.isFinite(fill) || fill < 0 || fill > 1))
+		throw new Error('invalid scripted water level');
+	if (!volume.infinite) fills.push(0, 1);
+	return {
+		fills: [...new Set(fills)].sort((a, b) => a - b),
+		continuous: !volume.infinite || targets.some((level) => level.smooth),
+	};
+};
+
+/** Retain source synchronization between platforms without mixing the progress
+ * namespace with actual water bodies, even when their numeric IDs are equal. */
+export const waterProgressGroups = (scripts: readonly Pick<Script, 'data'>[]) => {
+	const groups = new Map<string, { id: string; decreaseRatio: number }>();
+	const visit = (value: MemoryPackValue) => {
+		if (Array.isArray(value)) {
+			for (const entry of value) visit(entry);
+			return;
+		}
+		if (!isMemoryPackObject(value)) return;
+		if (value.$type === 'Beyond_Gameplay_WaterProgressSyncDataForMemoryPack') {
+			if (
+				typeof value.id !== 'string' ||
+				typeof value.decreaseRatio !== 'number' ||
+				!Number.isFinite(value.decreaseRatio) ||
+				value.decreaseRatio < 0 ||
+				!Array.isArray(value.entityPtrList)
+			)
+				throw new Error('water-progress synchronization unresolved');
+			for (const entity of value.entityPtrList) {
+				if (
+					!isMemoryPackObject(entity) ||
+					entity.useSlotId !== false ||
+					typeof entity.logicId !== 'string'
+				)
+					throw new Error('water-progress synchronization reference unresolved');
+				const old = groups.get(entity.logicId);
+				if (old && (old.id !== value.id || old.decreaseRatio !== value.decreaseRatio))
+					throw new Error('ambiguous water-progress synchronization');
+				groups.set(entity.logicId, { id: value.id, decreaseRatio: value.decreaseRatio });
+			}
+		}
+		for (const entry of Object.values(value)) visit(entry);
+	};
+	for (const script of scripts) visit(script.data);
+	return groups;
+};
