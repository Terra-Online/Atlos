+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { levelInteractiveFromValue } from '@endfield-noclip/formats/endfield/level-interactives';
+import type { MemoryPackValue } from '@endfield-noclip/formats/endfield/memory-pack';
+import type { LevelWaterVolume } from './water/water-volumes.ts';
+import {
+	waterCurveOf,
+	waterFloaterOf,
+	waterFloaterPositions,
+	waterProgressGroups,
+	waterLevelDomain,
+} from './water-supports.ts';
+
+const bits = (value: number) => {
+	const b = new DataView(new ArrayBuffer(4));
+	b.setFloat32(0, value);
+	return String(b.getUint32(0));
+};
+const param = (key: string, type: number, value: string): MemoryPackValue => ({
+	key,
+	value: { type, valueArray: [{ valueBit64: value, valueString: null }] },
+});
+const component = (name: string, propertyList: MemoryPackValue[]) => ({
+	$type: `Beyond_Gameplay_Core_${name}ComponentDataForMemoryPack`,
+	propertyList,
+});
+const row = () =>
+	levelInteractiveFromValue(
+		{
+			entityDataIdKey: 'variant',
+			createState: 0,
+			levelLogicId: '1',
+			position: [10, 25.5, 30],
+			rotation: [0, 0, 0],
+			scale: [1, 1, 1],
+			isLocked: false,
+			properties: [],
+			componentProperties: [],
+			modelScale: 0,
+		},
+		1n,
+	);
+
+test('water-driven curves resolve their own component scopes and reject unsupported rotation', () => {
+	const template = {
+		componentList: [
+			component('WaterProgressDriveCurveMovement', [
+				param('spline_id', 3, '0'),
+				param('curve_move_type', 3, '1'),
+				param('is_update_rotation_on_spline', 1, '0'),
+			]),
+			component('WaterProgress', [
+				param('water_progress_increase_ratio', 5, bits(0)),
+				param('water_progress_decrease_ratio', 5, bits(0)),
+			]),
+		],
+		templateVariant: [],
+	};
+	const placed = row();
+	placed.componentProperties.set(125, [
+		{ key: 'spline_id', type: 3, values: [{ bits: 9n, text: null }] },
+	]);
+	placed.componentProperties.set(87, [
+		{
+			key: 'water_progress_increase_ratio',
+			type: 5,
+			values: [{ bits: BigInt(bits(15)), text: null }],
+		},
+	]);
+	const result = waterCurveOf(template, placed)!;
+	assert.equal(result.splineId, 9);
+	assert.equal(result.control.increaseRatio, 15);
+	assert.equal(result.control.kind, 'water-progress');
+	placed.componentProperties
+		.get(125)!
+		.push({ key: 'is_update_rotation_on_spline', type: 1, values: [{ bits: 1n, text: null }] });
+	assert.throws(() => waterCurveOf(template, placed), /rotation/);
+});
+
+test('an omitted floater offset defaults to zero while a malformed offset is rejected', () => {
+	const template = (offset: ReturnType<typeof param>[] = []) => ({
+		componentList: [
+			component('BelongToWaterVolume', [param('water_volume', 56, '123'), ...offset]),
+		],
+	});
+	assert.deepEqual(waterFloaterOf(template(), row()), { volume: '123', surfaceOffset: 0 });
+	assert.throws(
+		() => waterFloaterOf(template([param('surface_offset', 3, '1')]), row()),
+		/floater surface offset unresolved/,
+	);
+});
+
+test('floaters follow a shared water surface offset rather than retaining their authored height', () => {
+	const template = {
+		componentList: [
+			component('BelongToWaterVolume', [
+				param('water_volume', 56, '123'),
+				param('surface_offset', 5, bits(0.25)),
+			]),
+		],
+	};
+	const first = row(),
+		second = { ...row(), position: [20, 999, 40] as [number, number, number] };
+	const a = waterFloaterOf(template, first)!,
+		b = waterFloaterOf(template, second)!;
+	assert.equal(a.volume, b.volume);
+	const volume: Pick<LevelWaterVolume, 'pivot' | 'heightMax' | 'fraction'> = {
+		pivot: [0, 20, 0],
+		heightMax: 10,
+		fraction: 0.5,
+	};
+	const positions = waterFloaterPositions(volume, first, a.surfaceOffset);
+	const other = waterFloaterPositions(volume, second, b.surfaceOffset);
+	assert.deepEqual(positions, [
+		[10, 25.5, 30],
+		[10, 20.25, 30],
+		[10, 30.25, 30],
+	]);
+	assert.deepEqual(other[0], second.position);
+	assert.deepEqual(
+		other.slice(1).map((p) => p[1]),
+		positions.slice(1).map((p) => p[1]),
+	);
+	assert.deepEqual(waterFloaterPositions(volume, first, a.surfaceOffset, [0.5]), [first.position]);
+	first.componentProperties.set(39, [
+		{ key: 'water_volume', type: 56, values: [{ bits: 0n, text: null }] },
+	]);
+	assert.equal(waterFloaterOf(template, first)!.volume, null);
+	assert.throws(() => waterFloaterPositions({ ...volume, fraction: 2 }, first, 0), /range/);
+});
+
+test('water synchronization shares progress identity without conflating it with a water body', () => {
+	const sync = (id: string) => ({
+		$type: 'Beyond_Gameplay_WaterProgressSyncDataForMemoryPack',
+		id,
+		decreaseRatio: 30,
+		entityPtrList: [
+			{ logicId: '1', useSlotId: false },
+			{ logicId: '2', useSlotId: false },
+		],
+	});
+	const groups = waterProgressGroups([{ data: { modules: [sync('123')] } }]);
+	assert.equal(groups.get('1')!.id, '123');
+	assert.deepEqual(groups.get('1'), groups.get('2'));
+	assert.throws(
+		() => waterProgressGroups([{ data: { modules: [sync('123'), sync('456')] } }]),
+		/ambiguous/,
+	);
+});
+
+test('infinite water retains source states and distinguishes snap changes from continuous motion', () => {
+	const volume = { id: '123', infinite: true, fraction: 1, amountMax: 100 };
+	const action = {
+		volume: '123',
+		script: 'source',
+		node: 1,
+		kind: 'fraction' as const,
+		value: 0.2,
+		smooth: false,
+		speed: null,
+	};
+	assert.deepEqual(waterLevelDomain(volume, []), { fills: [1], continuous: false });
+	assert.deepEqual(waterLevelDomain(volume, [action]), { fills: [0.2, 1], continuous: false });
+	assert.deepEqual(waterLevelDomain(volume, [{ ...action, smooth: true }]), {
+		fills: [0.2, 1],
+		continuous: true,
+	});
+	assert.deepEqual(waterLevelDomain({ ...volume, infinite: false }, [action]).fills, [0, 0.2, 1]);
+	assert.deepEqual(waterLevelDomain(volume, [{ ...action, volume: 'other' }]).fills, [1]);
+});
