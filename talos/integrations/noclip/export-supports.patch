+test('box-game lifts use their own component override scope at the same authored world floors', () => {
+	const box = { ...template, componentList: [{
+		...template.componentList[0], $type: 'Beyond_Gameplay_Core_LifterForBoxGameCoreComponentDataForMemoryPack',
+	}] };
+	const placed = row(1, [1n, 2n]);
+	placed.componentProperties.set(155, placed.componentProperties.get(154)!);
+	placed.componentProperties.delete(154);
+	const start = lifterStart(box, entityProperties(box)!, placed);
