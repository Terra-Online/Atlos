+import { parseArgs } from 'node:util';
+import {
+	preparePhysicalRoute,
+	physicalResources,
+} from '../game/physical-input.ts';
+import { physicalWork } from '@opendfieldmap/ganglia/solver/host';
+import { readFile } from 'node:fs/promises';
+import { routeWriter } from '../write-route.ts';
+import type { RouteCache } from '../route-cache.ts';
+export const summary = 'solve a physical player route';
+export const usage =
+	'usage: endfield-extract player-route --ground <file> --collision <file> --movement-settings <file> --request <file> -o <result>';
+export const run = async (
+	args: string[],
+	context?: {
+		cache: RouteCache;
+		progress: (value: Record<string, unknown>) => void;
+	},
+): Promise<void> => {
+	const { values } = parseArgs({
+		args,
+		options: {
+			ground: { type: 'string' },
+			collision: { type: 'string' },
+			'movement-settings': { type: 'string' },
+			request: { type: 'string' },
+			output: { type: 'string', short: 'o' },
+			devices: { type: 'string' },
+			'ground-only': { type: 'boolean' },
+			'devices-only': { type: 'boolean' },
+		},
+	});
+	let resources: ReturnType<typeof physicalResources>;
+	try {
+		resources = physicalResources({
+			...values,
+			movement: values['movement-settings'],
+			devices: values['ground-only'] ? undefined : values.devices,
+		});
+	} catch {
+		throw new Error(usage);
+	}
+	if (!values.request || !values.output) throw new Error(usage);
+	const write = routeWriter(values.output, [
+		resources.ground,
+		resources.collision,
+		resources.movement,
+		values.request,
+		...(resources.devices ? [resources.devices] : []),
+	]);
+	const progress =
+		context?.progress ??
+		((value: object) => console.log(JSON.stringify(value)));
+	const prepared = await preparePhysicalRoute(
+		resources,
+		JSON.parse(await readFile(values.request, 'utf8')),
+		context ? { cache: context.cache, progress } : undefined,
+	);
+	await prepared.solve({
+		work: physicalWork(
+			values['ground-only'] ? 0 : values['devices-only'] ? 1 : 2,
+		),
+		onProgress: progress,
+		onResult: write,
+	});
+};
