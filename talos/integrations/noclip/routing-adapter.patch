+++ b/packages/extractor/src/write-route.ts
@@ -0,0 +1,15 @@
+import { writeFile, rename, rm } from 'node:fs/promises';
+import { resolve } from 'node:path';
+export function routeWriter(output: string, inputs: readonly string[]) {
+	if (inputs.some((path) => resolve(path) === resolve(output)))
+		throw new Error('route output must not overwrite an input');
+	return async (value: unknown) => {
+		const temporary = `${output}.${process.pid}.tmp`;
+		try {
+			await writeFile(temporary, JSON.stringify(value));
+			await rename(temporary, output);
+		} finally {
+			await rm(temporary, { force: true });
+		}
+	};
+}
