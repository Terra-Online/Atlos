+++ b/packages/extractor/src/game/physical-input.ts
@@ -0,0 +1,377 @@
+import { readFile } from 'node:fs/promises';
+import { isDeepStrictEqual } from 'node:util';
+import { isObject, numberField } from '@endfield-noclip/formats/unity/values';
+import {
+	retimeGroundRoute,
+	type GroundArrival,
+	type GroundOptions,
+	type InteractionGoal,
+	type LocomotionOptions,
+	type Surface,
+	type Vec3,
+	type Wall,
+} from '@opendfieldmap/ganglia';
+import type {
+	BuildOptions,
+	CollisionGeometry,
+} from '@opendfieldmap/ganglia/build';
+import {
+	type PhysicalInput,
+	type PhysicalConfig,
+} from '@opendfieldmap/ganglia/solver';
+import {
+	createPhysicalPreparation,
+	validateWaypoints,
+	type PhysicalWork,
+} from '@opendfieldmap/ganglia/solver/host';
+import {
+	walkableCollisionIndices,
+	type CollisionRecord,
+} from './collision-ground.ts';
+import { normalizeDevices, deviceConnections } from './traversal-links.ts';
+import { roundExclusions } from './round-exclusions.ts';
+import type { RouteCache } from '../route-cache.ts';
+type Source = { buildGuid: string; contentHash: string };
+type Profile = { radius: number; height: number };
+type Ground = {
+	version: number;
+	scene: string;
+	source: Source;
+	selection: unknown;
+	coverage: unknown;
+	surfaces: Surface[];
+	options: GroundOptions;
+	build?: Partial<BuildOptions & { tileCells: number }>;
+};
+type Collision = CollisionGeometry & {
+	records?: CollisionRecord[];
+	scene: string;
+	source: Source;
+	selection: unknown;
+	coverage: unknown;
+	options: { profile: Profile };
+};
+const physicalGeometries = new WeakMap<Collision, CollisionGeometry>();
+type Movement = {
+	version: number;
+	source: Source;
+	defaultProfile: Profile;
+	sustainedSprint: LocomotionOptions;
+	assets: { path: string; settings: unknown }[];
+};
+type Request = {
+	scene: string;
+	source: Source;
+	arrival: GroundArrival & { groundRange?: [number, number] };
+	target: Vec3;
+	interaction?: InteractionGoal;
+	walls: Wall[];
+	waypoints?: Vec3[];
+	config?: import('@opendfieldmap/ganglia/solver').RouteQuery['config'];
+};
+
+const vector = (point: unknown): point is Vec3 =>
+	Array.isArray(point) && point.length === 3 && point.every(Number.isFinite);
+const sameSource = (a: Source, b: Source) =>
+	a &&
+	b &&
+	typeof a.buildGuid === 'string' &&
+	a.buildGuid.length > 0 &&
+	typeof a.contentHash === 'string' &&
+	a.contentHash.length > 0 &&
+	a.buildGuid === b.buildGuid &&
+	a.contentHash === b.contentHash;
+const sameProfile = (a: Profile, b: Profile) =>
+	a && b && a.radius === b.radius && a.height === b.height;
+export interface PhysicalResources {
+	ground: string;
+	collision: string;
+	movement: string;
+	devices?: string;
+}
+export const physicalResources = (value: unknown): PhysicalResources => {
+	if (!isObject(value)) throw new Error('Invalid physical scene resources');
+	const { ground, collision, movement, devices } = value;
+	if (
+		typeof ground !== 'string' ||
+		!ground ||
+		typeof collision !== 'string' ||
+		!collision ||
+		typeof movement !== 'string' ||
+		!movement
+	)
+		throw new Error('Missing physical scene resources');
+	if (devices !== undefined && typeof devices !== 'string')
+		throw new Error('Invalid device resource');
+	return { ground, collision, movement, devices };
+};
+export type PhysicalReport = {
+	version: number;
+	scene: string;
+	source: Source;
+	motionValidation: string;
+	coverage: { ground: unknown; collision: unknown };
+	diagnostics: unknown;
+	status: string;
+	route?: Extract<
+		import('@opendfieldmap/ganglia').Route,
+		{ status: 'complete' }
+	>;
+	reason?: string;
+	connections: import('@opendfieldmap/ganglia').GroundConnection[];
+	groundedTarget?: Vec3;
+	supportBoxes?: import('@opendfieldmap/ganglia/solver').RouteResult['supportBoxes'];
+	optimizing: boolean;
+};
+export const preparePhysicalRoute = async (
+	values: PhysicalResources,
+	value: unknown,
+	context?: {
+		cache: RouteCache;
+		progress?: (value: { phase: string }) => void;
+	},
+) => {
+	if (!value || typeof value !== 'object')
+		throw new Error('invalid physical route request');
+	const request = value as Request;
+	validateWaypoints(request.waypoints);
+	const progress = context?.progress ?? (() => {});
+	progress({ phase: 'read-inputs' });
+	const generation = context
+		? await context.cache.begin({
+				ground: values.ground,
+				collision: values.collision,
+				movement: values.movement,
+			})
+		: '';
+	const reads: [Promise<Ground>, Promise<Collision>, Promise<Movement>] = [
+		context
+			? context.cache.read<Ground>('ground', values.ground)
+			: readFile(values.ground, 'utf8').then(JSON.parse),
+		context
+			? context.cache.read<Collision>('collision', values.collision)
+			: readFile(values.collision, 'utf8').then(JSON.parse),
+		context
+			? context.cache.read<Movement>('movement', values.movement)
+			: readFile(values.movement, 'utf8').then(JSON.parse),
+	];
+	const deviceRead: Promise<Parameters<typeof deviceConnections>[0] | null> =
+		values.devices
+			? context
+				? context.cache.read('devices', values.devices)
+				: readFile(values.devices, 'utf8').then(JSON.parse)
+			: Promise.resolve(null);
+	const [ground, collision, movement, deviceInput] = await Promise.all([
+		...reads,
+		deviceRead,
+	]).catch(async (error: unknown) => {
+		// Drain parallel input reads before the worker clears its cache for the next request.
+		await Promise.allSettled([...reads, deviceRead]);
+		throw error;
+	});
+	if (
+		!ground ||
+		!collision ||
+		!movement ||
+		!request ||
+		ground.version !== 1 ||
+		movement.version !== 1 ||
+		!request.scene ||
+		request.scene !== ground.scene ||
+		request.scene !== collision.scene ||
+		!sameSource(request.source, ground.source) ||
+		!sameSource(request.source, collision.source) ||
+		!sameSource(request.source, movement.source)
+	) {
+		throw new Error('physical route inputs must share a scene and build');
+	}
+	const profile = ground.options?.profile;
+	if (
+		!profile ||
+		![profile.radius, profile.height].every(
+			(value) => Number.isFinite(value) && value > 0,
+		) ||
+		profile.height < 2 * profile.radius ||
+		!sameProfile(profile, collision.options?.profile) ||
+		!sameProfile(profile, movement.defaultProfile) ||
+		!isDeepStrictEqual(ground.selection, collision.selection)
+	) {
+		throw new Error(
+			'physical route inputs must share body profile and collision selection',
+		);
+	}
+	if (
+		!Array.isArray(ground.surfaces) ||
+		!Array.isArray(movement.assets) ||
+		!Array.isArray(request.walls) ||
+		!Array.isArray(ground.options.walls) ||
+		!Array.isArray(collision.positions) ||
+		collision.positions.length < 9 ||
+		collision.positions.length % 3 !== 0 ||
+		!Array.isArray(collision.indices) ||
+		collision.indices.length < 3 ||
+		collision.indices.length % 3 !== 0 ||
+		!request.arrival ||
+		!vector(request.arrival.position) ||
+		!vector(request.target) ||
+		!Number.isFinite(ground.options.maxVertical) ||
+		ground.options.maxVertical < 0 ||
+		!movement.sustainedSprint
+	) {
+		throw new Error('invalid physical route request');
+	}
+	retimeGroundRoute({ status: 'unmapped' }, movement.sustainedSprint);
+	const defaults = movement.assets.find((asset) =>
+		asset.path.endsWith('/MovementSetting_Default.asset'),
+	);
+	if (!defaults || !isObject(defaults.settings)) {
+		throw new Error('missing default movement settings');
+	}
+	const settings = defaults.settings;
+	const config: PhysicalConfig = {
+		get model() {
+			return {
+				gravity: numberField(settings, '_gravity'),
+				fallingGravity: numberField(settings, '_fallingGravity'),
+				maxJumpHeight: numberField(settings, '_maxJumpHeight'),
+				maxFallingSpeed: numberField(settings, '_maxFallingSpeed'),
+				apexTime: numberField(settings, '_apexTime'),
+				maxHorizontalSpeed: numberField(
+					settings,
+					'_inAirMaxHorizontalSpeedSprint',
+				),
+				startHorizontalSpeed: Math.min(
+					numberField(settings, '_startHorizontalSpeedSprint'),
+					numberField(settings, '_inAirMaxInitHorizontalSpeed'),
+				),
+				airOverspeedDeceleration: numberField(
+					settings,
+					'_inAirDecelerationWithInputSprint',
+				),
+				airAcceleration: numberField(settings, '_inAirAcceleration'),
+				airDeceleration: numberField(
+					settings,
+					'_inAirDecelerationNoInputSprint',
+				),
+			};
+		},
+		get maxSlope() {
+			return numberField(settings, '_slopeLimit');
+		},
+		get runAirSpeed() {
+			return numberField(settings, '_inAirMaxHorizontalSpeedRun');
+		},
+		get stepUp() {
+			return numberField(settings, '_stepOffset');
+		},
+		stepDown: numberField(settings, '_stepDownOffset'),
+	};
+	const physicalDevices = deviceInput
+		? {
+				...normalizeDevices(
+					deviceInput,
+					{ scene: ground.scene, source: ground.source },
+					profile.radius,
+				),
+				movingSupports: deviceInput.movingSupports,
+				followingSupports: deviceInput.followingSupports,
+			}
+		: null;
+
+	const input: PhysicalInput = {
+		ground: {
+			...ground,
+			options: {
+				...ground.options,
+				profile,
+				walls: [...ground.options.walls, ...request.walls],
+			},
+		},
+		collision: {
+			...collision,
+			get indices() {
+				let geometry = physicalGeometries.get(collision);
+				if (!geometry) {
+					geometry = {
+						positions: collision.positions,
+						indices: walkableCollisionIndices(collision),
+					};
+					physicalGeometries.set(collision, geometry);
+				}
+				return geometry.indices;
+			},
+		},
+		get roundedWalls() {
+			return roundExclusions(
+				[...ground.options.walls, ...request.walls],
+				collision.coverage,
+			);
+		},
+		config,
+		locomotion: movement.sustainedSprint,
+		devices: physicalDevices,
+	};
+	const preparation = context?.cache.preparation ?? createPhysicalPreparation();
+	return {
+		async solve(
+			options: {
+				work?: PhysicalWork;
+				signal?: AbortSignal;
+				onProgress?: (progress: {
+					phase: string;
+					completed?: number;
+					total?: number;
+				}) => void;
+				onResult?: (report: PhysicalReport) => void | Promise<void>;
+			} = {},
+		) {
+			let final: PhysicalReport | undefined;
+			const report = (
+				result: import('@opendfieldmap/ganglia/solver').RouteResult,
+				optimizing: boolean,
+				diagnostics: unknown,
+			) => ({
+				version: 1,
+				scene: request.scene,
+				source: request.source,
+				motionValidation: 'model-based',
+				coverage: { ground: ground.coverage, collision: collision.coverage },
+				diagnostics,
+				status:
+					result.route.status === 'complete' ? 'candidate' : 'unavailable',
+				...(result.route.status === 'complete' ? { route: result.route } : {}),
+				reason: result.reason,
+				connections: result.connections,
+				groundedTarget: result.groundedTarget,
+				supportBoxes: result.supportBoxes,
+				optimizing,
+			});
+			try {
+				await preparation.solve(
+					input,
+					{
+						starts: [request.arrival],
+						goal: request.target,
+						interaction: request.interaction,
+						waypoints: request.waypoints,
+						config: request.config,
+					},
+					{
+						binding: JSON.stringify([generation, request.walls]),
+						work: options.work,
+						signal: options.signal,
+						onProgress: options.onProgress,
+						async onResult(result, optimizing, diagnostics) {
+							final = report(result, optimizing, diagnostics);
+							await options.onResult?.(final);
+						},
+					},
+				);
+				if (!final) throw new Error('Physical solver produced no result');
+				return final;
+			} finally {
+				if (!context) preparation.clear();
+			}
+		},
+	};
+};
