@@ -0,0 +1,307 @@
+import {
+	trsMatrix,
+	transformPoint,
+	unityEulerQuaternion,
+} from '@endfield-noclip/formats/unity/transform';
+import type { TypeTreeObject } from '@endfield-noclip/formats/unity/type-tree';
+import { isObject, numberField } from '@endfield-noclip/formats/unity/values';
+
+import {
+	createDeviceConnections,
+	type DeviceFacts,
+} from '@opendfieldmap/ganglia/solver';
+import type { Surface, Vec3, Wall } from '@opendfieldmap/ganglia';
+import type { CollisionWorld } from '@opendfieldmap/ganglia/collision';
+
+import type { FollowingSupport } from './following-supports.ts';
+import { interactionPoint, interactionRules } from './interaction-rules.ts';
+import type { SweptSupport } from './swept-supports.ts';
+import { ropePairs, type traversalDevice } from './traversal-devices.ts';
+
+type Device = NonNullable<ReturnType<typeof traversalDevice>>;
+type Source = { buildGuid: string; contentHash: string };
+type Input = {
+	version: number;
+	scene: string;
+	source: Source;
+	devices: Device[];
+	templates: Record<string, unknown>;
+	movingSupports?: SweptSupport[];
+	followingSupports?: FollowingSupport[];
+};
+type Options = {
+	scene: string;
+	source: Source;
+	surfaces: Surface[];
+	world: CollisionWorld;
+	settings: TypeTreeObject;
+	profile: { radius: number; height: number };
+	walls: Wall[];
+};
+const float = (b: bigint) => {
+	const data = new DataView(new ArrayBuffer(4));
+	data.setUint32(0, Number(BigInt.asUintN(32, b)), true);
+	return data.getFloat32(0, true);
+};
+
+// this reader handles only direct scalar/vector device values. expressions retain unknown state.
+const parameter = (value: unknown): unknown => {
+	if (!isObject(value) || !Array.isArray(value.valueArray)) {
+		return undefined;
+	}
+	const bits: bigint[] = [];
+	for (const atom of value.valueArray) {
+		if (
+			!isObject(atom) ||
+			typeof atom.valueBit64 !== 'string' ||
+			!/^-?\d+$/.test(atom.valueBit64)
+		) {
+			return undefined;
+		}
+		bits.push(BigInt(atom.valueBit64));
+	}
+	if (
+		value.type === 1 &&
+		bits.length === 1 &&
+		(bits[0] === 0n || bits[0] === 1n)
+	) {
+		return bits[0] === 1n;
+	}
+	if (value.type === 3 && bits.length === 1) {
+		return Number(bits[0]);
+	}
+	if ((value.type === 5 || value.type === 6) && bits.length === 1) {
+		return float(bits[0]);
+	}
+	if (value.type === 11 && bits.length === 3) {
+		return bits.map(float);
+	}
+	return undefined;
+};
+const properties = (list: unknown) =>
+	new Map(
+		(Array.isArray(list) ? list : []).flatMap((p) =>
+			isObject(p) && typeof p.key === 'string'
+				? [[p.key, parameter(p.value)] as const]
+				: [],
+		),
+	);
+const forcedState = (key: string) =>
+	key === 'state' || key === 'is_locked' || key === 'has_power';
+const effective = (device: Device, raw: unknown, component: string) => {
+	if (!isObject(raw) || !Array.isArray(raw.components)) {
+		return null;
+	}
+	const selected = raw.components.find(
+		(c) =>
+			isObject(c) && typeof c.type === 'string' && c.type.includes(component),
+	);
+	if (!isObject(selected)) {
+		return null;
+	}
+	const values = properties(selected.properties);
+	for (const list of [raw.config, raw.saved]) {
+		for (const [key, value] of properties(list)) {
+			values.set(key, value);
+		}
+	}
+	const variants = Array.isArray(raw.variants) ? raw.variants : [];
+	const entry = variants.find(
+		(v) => Array.isArray(v) && v[0] === device.template,
+	);
+	const variant = Array.isArray(entry) && isObject(entry[1]) ? entry[1] : null;
+	if (variant) {
+		for (const [key, value] of properties(variant.diffProperties)) {
+			values.set(key, value);
+		}
+		for (const diff of Array.isArray(variant.componentDiffProperties)
+			? variant.componentDiffProperties
+			: []) {
+			if (
+				Array.isArray(diff) &&
+				typeof diff[0] === 'string' &&
+				diff[0].includes(component.replace('ComponentData', '')) &&
+				isObject(diff[1])
+			) {
+				for (const [key, value] of properties(diff[1].value)) {
+					values.set(key, value);
+				}
+			}
+		}
+	}
+	for (const [key, value] of properties(device.placement.properties)) {
+		values.set(key, value);
+	}
+	// component-scoped/runtime overrides need an explicit resolver before replacing direct fields.
+	for (const override of device.placement.componentProperties) {
+		// the versioned interactive schema uses key 169 for the jump-machine component.
+		if (
+			Array.isArray(override) &&
+			override[0] === 169 &&
+			component === 'JumpMachineComponentData'
+		) {
+			for (const [key, value] of properties(override[1])) {
+				if (forcedState(key)) {
+					continue;
+				}
+				if (properties(device.placement.properties).has(key)) {
+					return null;
+				}
+				values.set(key, value);
+			}
+			continue;
+		}
+		if (
+			Array.isArray(override) &&
+			[...properties(override[1])].some(
+				([key, value]) =>
+					!forcedState(key) &&
+					values.has(key) &&
+					JSON.stringify(values.get(key)) !== JSON.stringify(value),
+			)
+		) {
+			return null;
+		}
+	}
+	if (
+		[
+			...properties(device.placement.mapProperties),
+			...properties(device.placement.globalProperties),
+		].some(([key]) => !forcedState(key))
+	) {
+		return null;
+	}
+	return values;
+};
+
+const offset = (d: Device, p: Vec3): Vec3 => {
+	const v = transformPoint(
+		trsMatrix(d.position, unityEulerQuaternion(d.rotation), [1, 1, 1]),
+		p,
+	);
+	return [v[0], v[1], v[2]];
+};
+
+export const normalizeDevices = (
+	input: Input,
+	options: Pick<Options, 'scene' | 'source'>,
+	radius = 0.3,
+): DeviceFacts => {
+	if (
+		input.version !== 1 ||
+		input.scene !== options.scene ||
+		input.source.buildGuid !== options.source.buildGuid ||
+		input.source.contentHash !== options.source.contentHash ||
+		!Array.isArray(input.devices) ||
+		!isObject(input.templates)
+	)
+		throw new Error('device inputs must share scene and build');
+	const entry = (device: Device) => {
+		const raw = input.templates[device.template];
+		if (
+			!isObject(raw) ||
+			!Array.isArray(raw.components) ||
+			typeof raw.source !== 'string'
+		) {
+			return null;
+		}
+		const template = {
+			componentList: raw.components
+				.filter(isObject)
+				.map((c) => ({ $type: c.type, propertyList: c.properties })),
+			templateVariant: raw.variants,
+		};
+		const rules = interactionRules(template, {
+			...input.source,
+			path: raw.source,
+		});
+		return interactionPoint(
+			{
+				...device.placement,
+				entityDataIdKey: device.template,
+				levelLogicId: device.id,
+				position: device.position,
+				rotation: device.rotation,
+				scale: device.scale,
+			},
+			device.level,
+			template,
+			rules,
+		).navigationGoal;
+	};
+	const devices = input.devices.map((d) => {
+		const component =
+			d.kind === 'accelerate'
+				? 'TriggerObserverComponentData'
+				: d.kind === 'launch'
+					? 'JumpMachineComponentData'
+					: 'InteractiveVerticalRopeComponentData';
+		const p = effective(d, input.templates[d.template], component);
+		const goal = entry(d);
+		return {
+			id: d.id,
+			kind: d.kind,
+			position: d.position,
+			goal,
+			seeds: [offset(d, [0, 0, -1]), offset(d, [0, 0, 1])],
+			rotation: d.rotation,
+			unitScale: d.scale.every((v) => v === 1),
+			resolved: !!p,
+			speed:
+				Number(p?.get('move_speed')) > 0
+					? Number(p?.get('move_speed'))
+					: Number(p?.get('speed')),
+			overhead: Number(p?.get('duration')),
+			duration: p?.get('accelerate_buff'),
+			fixedLaunch:
+				!!p &&
+				p.get('free_jump') === false &&
+				typeof p.get('use_electric') === 'boolean' &&
+				p.get('unlock_height_limit') === false,
+			aim: p?.get('target_position'),
+			height: Number(p?.get('height')),
+			aimClearance: 3,
+			boostMultiplier: 2.2,
+			nearbyOffsets: (radius: number) => [
+				offset(d, [0, 0, -radius]),
+				offset(d, [0, 0, radius]),
+				...[radius * 2, 1].flatMap((r) =>
+					Array.from({ length: 8 }, (_, i) =>
+						offset(d, [
+							Math.cos((i * Math.PI) / 4) * r,
+							0,
+							Math.sin((i * Math.PI) / 4) * r,
+						]),
+					),
+				),
+			],
+		};
+	});
+	// Fixed launch pads retain the game controller's 3 m aim clearance;
+	// accelerate_buff supplies duration and the authored +1.2 scalar gives 2.2x speed.
+	// World-space seeds avoid making the solver interpret game transforms.
+	return {
+		devices: devices.map(({ nearbyOffsets, seeds, rotation, ...d }) => ({
+			...d,
+			seeds: nearbyOffsets(radius),
+		})),
+		ropes: ropePairs(input.devices).pairs,
+	};
+};
+export const deviceConnections = (input: Input, options: Options) =>
+	createDeviceConnections(
+		normalizeDevices(input, options, options.profile.radius),
+		{
+			surfaces: options.surfaces,
+			world: options.world,
+			profile: options.profile,
+			walls: options.walls,
+			model: {
+				gravity: numberField(options.settings, '_gravity'),
+				fallingGravity: numberField(options.settings, '_fallingGravity'),
+				maxFallingSpeed: numberField(options.settings, '_maxFallingSpeed'),
+				apexTime: numberField(options.settings, '_apexTime'),
+			},
+			maxSlope: numberField(options.settings, '_slopeLimit'),
+		},
+	);
