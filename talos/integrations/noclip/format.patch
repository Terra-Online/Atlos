 });
+
+const buildConveyors = (): Uint8Array => {
+	const w = new Writer();
+	const root = w.reserve(4),
+		rootFields = w.table(5, [3]);
+	w.link(root, rootFields.get(3)! - 4);
+	const grids = w.reserve(12);
+	w.view.setUint32(grids, 2, true);
+	w.link(rootFields.get(3)!, grids);
+	const grid = w.table(42, [0, 5, 33, 38, 39, 40]);
+	w.link(grids + 4, grid.get(0)! - 4);
+	w.view.setUint32(grid.get(0)!, GRID, true);
+	const types = [
+		DynamicData.ConveyorBeltComp,
+		DynamicData.ConveyorBeltBoxComp,
+		DynamicData.ConveyorBeltBoxComp,
+		DynamicData.ConveyorBeltGroupComp,
+	];
+	w.link(
+		grid.get(5)!,
+		w.structs(
+			16,
+			types.map((type, i) => ref(type, i === 2 ? 1 : 0).slice(0, 4)),
+		),
+	);
+	w.link(
+		grid.get(33)!,
+		w.structs(
+			84,
+			types.map((_, i) => [10 + i, 0].concat(ref(1, i, 1))),
+		),
+	);
+	const groupId = 0x100000005n;
+	const belts = w.structs(16, [[]]);
+	w.view.setBigUint64(belts + 4, groupId, true);
+	w.view.setUint8(belts + 12, 1);
+	w.link(grid.get(38)!, belts);
+	const boxes = w.structs(16, [[], []]);
+	for (let i = 0; i < 2; i++) {
+		const at = boxes + 4 + i * 16;
+		w.view.setBigUint64(at, groupId, true);
+		w.view.setInt32(at + 8, i === 0 ? -7 : 123456, true);
+		w.view.setFloat32(at + 12, i === 0 ? -0.25 : 1.5, true);
+	}
+	w.link(grid.get(39)!, boxes);
+	const group = w.structs(40, [[]]);
+	w.view.setFloat32(group + 4, -1.5, true);
+	w.view.setFloat32(group + 8, 12, true);
+	w.view.setInt32(group + 12, 28, true);
+	w.view.setInt32(group + 16, 3, true);
+	ref(DynamicData.ConveyorPath, 1, 1).forEach((word, i) => w.view.setInt32(group + 20 + i * 4, word, true));
+	w.view.setUint32(group + 28, GRID + 1, true);
+	w.link(grid.get(40)!, group);
+	const pathGrid = w.table(42, [0, 41]);
+	w.link(grids + 8, pathGrid.get(0)! - 4);
+	w.view.setUint32(pathGrid.get(0)!, GRID + 1, true);
+	const paths = w.structs(84, [[], []]);
+	const at = paths + 4 + 84;
+	w.view.setUint32(at, 1, true);
+	for (let offset = 4; offset <= 80; offset += 4) {
+		if (offset !== 72) {
+			w.view.setFloat32(at + offset, offset / 4, true);
+		}
+	}
+	w.view.setUint8(at + 72, 1);
+	w.link(pathGrid.get(41)!, paths);
+	return w.finish();
+};
+
+test('preserves conveyor identity, signed speed, box offsets and cross-grid path rows', () => {
+	const conveyors = readDynamicEntities(buildConveyors()).map((entity) => entity.conveyor);
+	assert.deepEqual(conveyors.slice(0, 3), [
+		{ kind: 'belt', group: 0x100000005n, entry: true, exit: false },
+		{ kind: 'box', group: 0x100000005n, fixedProgress: -7, lateralOffset: -0.25 },
+		{ kind: 'box', group: 0x100000005n, fixedProgress: 123456, lateralOffset: 1.5 },
+	]);
+	assert.deepEqual(conveyors[3], {
+		kind: 'group',
+		speed: -1.5,
+		length: 12,
+		level: 28,
+		spline: 3,
+		paths: [
+			{
+				type: 1,
+				start: [1, 2, 3],
+				end: [4, 5, 6],
+				width: 7,
+				length: 8,
+				radius: 9,
+				center: [10, 11, 12],
+				startAngle: 13,
+				endAngle: 14,
+				rotation: [15, 16, 17],
+				clockwise: true,
+				startProgress: 19,
+				endProgress: 20,
+			},
+		],
+	});
+	assert.ok(readDynamicEntities(build()).every((entity) => entity.conveyor === undefined));
+});
+
+test('rejects malformed conveyor references, flags and non-finite geometry', () => {
+	for (const [slot, offset, value, expected] of [
+		[38, 8, 2, /conveyor boolean/],
+		[40, 20, DynamicData.Model, /conveyor path reference/],
+		[40, 32, -1, /conveyor path reference/],
+		[40, 28, 2, /ConveyorPath.*outside/],
+	] as const) {
+		const bytes = buildConveyors(),
+			fb = new FlatBuffer(bytes);
+		const grid = fb.tableAt(fb.vector(fb.root(), 3).start, 0),
+			rows = fb.vector(grid, slot);
+		const view = new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength);
+		view.setInt32(rows.start + offset, value, true);
+		assert.throws(() => readDynamicEntities(bytes), expected);
+	}
+	const bytes = buildConveyors(),
+		fb = new FlatBuffer(bytes);
+	const grid = fb.tableAt(fb.vector(fb.root(), 3).start, 1),
+		paths = fb.vector(grid, 41);
+	new DataView(bytes.buffer, bytes.byteOffset, bytes.byteLength).setFloat32(paths.start + 84 + 4, NaN, true);
+	assert.throws(() => readDynamicEntities(bytes), /non-finite conveyor/);
+});
