+	) &&
+	Array.isArray(value.missions) &&
+	value.missions.every((m) => object(m) && typeof m.id === 'string') &&
+	object(value.labels) &&
+	Object.values(value.labels).every(dictionary) &&
+	Array.isArray(value.points) &&
+	value.points.every(validPoint);
