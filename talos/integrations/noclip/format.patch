+export const completedProgressionPicks = (controls: readonly SceneControl[]): Record<string, number> => {
+	const progression = new Set([
+		'controlNexus',
+		'cabin',
+		'cabinLevel',
+		'settlement',
+		'poi',
+		'factoryRegion',
+		'facility',
+		'doodadGroups',
+	]);
+	const picks: Record<string, number> = {};
+	for (const control of controls) {
+		if (control.source.kind !== 'user') {
+			continue;
+		}
+		let value: number | undefined;
+		if (control.story !== null || control.kind === 'quest' || control.kind === 'mission') {
+			value = COMPLETED;
+		} else if (progression.has(control.kind)) {
+			value = control.values.at(-1)?.value;
+		}
+		if (value !== undefined && value !== control.default && control.values.some((v) => v.value === value)) {
+			picks[control.id] = value;
+		}
+	}
+	return picks;
+};
+
+/** Completed progression indexed for the scene's numeric state evaluator. */
+export const completedProgressionPicksByIndex = (controls: readonly SceneControl[]): Map<number, number> => {
+	const byId = completedProgressionPicks(controls);
+	return new Map(
+		controls.flatMap((control, index) => {
+			const value = byId[control.id];
+			return value === undefined ? [] : [[index, value] as const];
+		}),
+	);
+};
