+		!Number.isInteger(value.tier) ||
+		!Array.isArray(value.position) ||
+		value.position.length !== 3 ||
+		!value.position.every((v) => typeof v === 'number' && Number.isFinite(v)) ||
+		!strings(value.unknown) ||
