+	level: string;
+	region: string;
+	subregion: string;
+	tier: number;
+	position: Vec3;
+	condition: PointCondition | null;
+	locks: { kind: string; quests: string[]; games: string[] }[];
+	drivers: ControlDriver[];
+	unknown: string[];
