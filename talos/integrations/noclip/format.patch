+import assert from 'node:assert/strict';
+import { it } from 'node:test';
+
+import { companionStates, pointPicks, type CompanionControl, isCompanion, isPointView } from './oem.ts';
+import type { StatesInfo } from './states.ts';
+
+it('appends companion controls while retaining package references and rejects unknown picked IDs', () => {
+	const mission = {
+		id: 'base',
+		name: 'Original',
+		category: 'main' as const,
+		chapter: null,
+		episode: null,
+		levelId: null,
+	};
+	const extra: CompanionControl = {
+		id: 'quest:extra',
+		kind: 'quest',
+		name: 'Extra',
+		category: 'story',
+		levelTags: [],
+		source: { kind: 'user' },
+		story: { role: 'quest', mission: 'extra', step: 1 },
+		values: [{ value: 3, label: 'Done' }],
+		default: 3,
+		assumption: '',
+		drivers: [],
+		place: null,
+	};
+	const base: StatesInfo = {
+		categories: [{ id: 'story', title: 'Story', note: null }],
+		controls: [
+			{ ...extra, id: 'quest:base', category: 0, levels: [0], story: { role: 'quest', mission: 0, step: 1 } },
+		],
+		missions: [mission],
+		mainStory: [0],
+		conditionalSets: [{ alternatives: [[{ control: 0, mask: 8 }]] }],
+		groups: [{ level: 0, condition: 0 }],
+		streamAreas: null,
+	};
+	const merged = companionStates(base, {
+		controls: [extra],
+		missions: [
+			{ ...mission, name: 'Replacement' },
+			{ ...mission, id: 'extra' },
+		],
+	});
+	assert.equal(merged.controls[0], base.controls[0]);
+	assert.equal(merged.conditionalSets, base.conditionalSets);
+	assert.deepEqual(merged.controls[1].story, { role: 'quest', mission: 1, step: 1 });
+	assert.equal(merged.controls[1].category, 0);
+	assert.equal(merged.missions[0].name, 'Original');
+	assert.deepEqual(pointPicks(merged.controls, { 'quest:extra': 3 }), new Map([[1, 3]]));
+	assert.throws(() => pointPicks(merged.controls, { missing: 3 }), /unknown companion control/);
+});
+
+it('accepts versioned clear and fallback views but rejects malformed camera values or old bindings', () => {
+	const view = {
+		key: 'noclip-point-view-v3:' + 'a'.repeat(64),
+		position: [1, 2, 3],
+		yaw: 0,
+		pitch: -0.3,
+		clear: true,
+	};
+	assert.equal(isPointView(view), true);
+	assert.equal(isPointView({ ...view, key: 'noclip-point-view-v4:' + 'a'.repeat(64) }), true);
+	assert.equal(isPointView({ ...view, clear: false }), true);
+	for (const value of [
+		{ ...view, position: [1, 2] },
+		{ ...view, position: [1, 2, NaN] },
+		{ ...view, pitch: 3 },
+		{ ...view, key: 'noclip-point-view-v1:' + 'a'.repeat(64) },
+		{ ...view, clear: undefined },
+	]) {
+		assert.equal(isPointView(value), false);
+	}
+});
+
+it('validates obstruction replay metadata without accepting arbitrary state values', () => {
+	const view = {
+		key: 'noclip-point-view-v5:' + 'b'.repeat(64),
+		position: [0, 3, -10],
+		yaw: 0,
+		pitch: 0,
+		clear: true,
+	};
+	const interaction = { control: 'door:1', label: 'Door', before: 0, after: 1 };
+	assert.equal(isPointView({ ...view, interactions: [interaction] }), true);
+	for (const invalid of [
+		{ ...interaction, after: 32 },
+		{ ...interaction, before: -1 },
+		{ ...interaction, after: 0 },
+		{ ...interaction, label: null },
+	]) {
+		assert.equal(isPointView({ ...view, interactions: [invalid] }), false);
+	}
+});
+
+it('accepts companion story controls with user sources and rejects derived or camera controls', () => {
+	const control = {
+		id: 'quest:test',
+		kind: 'quest',
+		name: 'Test',
+		category: 'story',
+		levelTags: [],
+		story: null,
+		default: 0,
+		assumption: '',
+		drivers: [],
+		place: null,
+		source: { kind: 'user' },
+		values: [{ value: 0, label: 'Not started' }],
+	};
+	const companion = {
+		version: 1,
+		release: 'test',
+		controls: [control],
+		missions: [],
+		labels: {},
+		points: [],
+	};
+	assert.equal(isCompanion(companion), true);
+	for (const field of ['category', 'levelTags', 'story', 'default', 'assumption', 'drivers', 'place']) {
+		assert.equal(isCompanion({ ...companion, controls: [{ ...control, [field]: undefined }] }), false);
+	}
+	for (const source of [
+		undefined,
+		{ kind: 'derived', condition: 0 },
+		{ kind: 'camera', test: { kind: 'area', area: 1 } },
+	]) {
+		assert.equal(isCompanion({ ...companion, controls: [{ ...control, source }] }), false);
+	}
+});
diff --git a/packages/package-format/src/oem.ts b/packages/package-format/src/oem.ts
new file mode 100644
index 00000000..19fa7e18
--- /dev/null
+++ b/packages/package-format/src/oem.ts
@@ -0,0 +1,312 @@
+import type { PackageManifest } from './manifest.ts';
+import type { ControlDriver, MissionInfo, SceneControl, StatesInfo } from './states.ts';
+import type { Vec3 } from './values.ts';
+
+/** version of the static companion data and cross-window message contract */
+export const OEM_VERSION = 1;
+
+/** Stable IDs keep companion data independent of package table ordering. */
+export interface PointCondition {
+	alternatives: { control: string; mask: number }[][];
+}
+export interface CompanionControl extends Omit<SceneControl, 'category' | 'story' | 'levels' | 'source'> {
+	category: string;
+	levelTags: number[];
+	source: { kind: 'user' };
+	story: { role: 'quest' | 'mission'; mission: string; step: number | null } | null;
+}
+
+/** Append companion-only story controls without changing any package index. */
+export const companionStates = (
+	base: StatesInfo,
+	companion: Pick<Companion, 'controls' | 'missions'>,
+): StatesInfo => {
+	const missions = [...base.missions];
+	for (const mission of companion.missions) {
+		if (!missions.some((entry) => entry.id === mission.id)) {
+			missions.push(mission);
+		}
+	}
+	const categories = [...base.categories];
+	const controls = [...base.controls];
+	for (const extra of companion.controls) {
+		if (controls.some((control) => control.id === extra.id)) {
+			continue;
+		}
+		let category = categories.findIndex((entry) => entry.id === extra.category);
+		if (category < 0) {
+			category = categories.length;
+			categories.push({
+				id: extra.category,
+				title: extra.category === 'story' ? 'Quests and missions' : extra.category,
+				note: null,
+			});
+		}
+		const { levelTags: _tags, story, ...rest } = extra;
+		const mission = story === null ? -1 : missions.findIndex((entry) => entry.id === story.mission);
+		if (story !== null && mission < 0) {
