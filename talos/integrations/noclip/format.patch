+		return false;
+	}
+	return (
+		Array.isArray(value.presets) &&
+		value.presets.length > 0 &&
+		value.presets.every(
+			(p) =>
+				object(p) &&
+				typeof p.id === 'string' &&
+				typeof p.label === 'string' &&
+				typeof p.satisfies === 'boolean' &&
