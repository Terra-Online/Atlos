+import { circularRotations } from './circular-rotations.ts';
+const path=bindingKey('Rotor');
+const clip=():PoseClip=>({animator:null,transforms:new Map(),active:new Map(),materials:new Map(),renderers:new Map(),
+    motion:{duration:8,sampleRate:60,loops:true,paths:[path],sample:t=>new Map([[path,[{kind:'rotation',value:[0,0,Math.sin(Math.PI*t/8),Math.cos(Math.PI*t/8)]}]]])}});
