@@ -0,0 +1,105 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import type { LevelInteractive } from '@endfield-noclip/formats/endfield/level-interactives';
+import type { MemoryPackValue } from '@endfield-noclip/formats/endfield/memory-pack';
+
+import type { Vec3 } from '@opendfieldmap/ganglia';
+
+import { collisionBox } from './collision-ground.ts';
+import { transformPoint, trsMatrix, unityEulerQuaternion } from '@endfield-noclip/formats/unity/transform';
+import { followingSupport, isFollowingBox } from './following-supports.ts';
+
+const bits = (v: number) => {
+	const data = new DataView(new ArrayBuffer(4));
+	data.setFloat32(0, v);
+	return String(data.getUint32(0));
+};
+const param = (key: string, values: number[], type = 5) => ({
+	key,
+	value: {
+		type,
+		valueArray: values.map((v) => ({ valueBit64: type === 3 ? String(v) : bits(v), valueString: null })),
+	},
+});
+const template = (): MemoryPackValue => ({
+	componentList: [
+		{
+			$type: '_InteractiveLogicControllerComponentDataForMemoryPack',
+			propertyList: [param('logic_type', [12], 3)],
+		},
+	],
+	configProperties: [param('box_max_distance', [65]), param('end_pos', [100, 2, 300], 11)],
+	saveProperties: [param('state', [0], 3)],
+});
+const row = {
+	template: 'box',
+	position: [10, 0, 20],
+	properties: [],
+	componentProperties: new Map(),
+} as unknown as LevelInteractive;
+const bodies: Vec3[][] = [
+	collisionBox([1, 1, 1]).vertices.map((p): Vec3 => [p[0]+10,p[1]+1,p[2]+20]),
+];
+
+test('sources retain the authored activity range and actual solid without a transport state space', () => {
+	const data = followingSupport('x', 'level', 'model', template(), row, bodies, 'box');
+	assert.equal(isFollowingBox(template(), row), true);
+	assert.deepEqual(data.spawn, row.position);
+	assert.equal(data.maxDistance, 65);
+	assert.deepEqual(data.bodies[0], [0,1,3,2,4,5,7,6].map(i=>bodies[0][i]));
+	assert.equal(data.assumption, 'placement-within-activity-range');
+	assert.equal('surfaces' in data, false);
+	assert.equal('activation' in data, false);
+	assert.equal('movement' in data, false);
+});
+
+test('saved state restores the activity centre once without granting a separate free endpoint', () => {
+	const saved = template() as Record<string, MemoryPackValue>;
+	saved.saveProperties = [param('state', [1], 3)];
+	const data = followingSupport('x', 'level', 'model', saved, row, bodies, 'box');
+	assert.deepEqual(data.spawn, [100, 2, 300]);
+	assert.deepEqual(data.bodies[0][0], [99, 2, 299]);
+	assert.deepEqual(bodies[0][0], [9, 0, 19]);
+});
+
+test('invalid activity ranges and solids do not grant placements', () => {
+	const invalid = template() as Record<string, MemoryPackValue>;
+	invalid.configProperties = [param('box_max_distance', [-1])];
+	assert.throws(() => followingSupport('x', 'level', 'model', invalid, row, bodies, 'box'), /activity range/);
+	assert.throws(() => followingSupport('x', 'level', 'model', template(), row, [], 'box'), /solid geometry/);
+});
+
+test('controller declaration is a fallback, while effective placement properties take precedence', () => {
+	const source = template() as Record<string, MemoryPackValue>;
+	source.componentList = [
+		{ $type: '_InteractiveLogicControllerComponentDataForMemoryPack', logicType: 12, propertyList: [] },
+	];
+	assert.equal(isFollowingBox(source, row), true);
+	const changed = {
+		...row,
+		componentProperties: new Map([
+			[29, [{ key: 'logic_type', type: 3, values: [{ bits: 24n, text: null }] }]],
+		]),
+	} as LevelInteractive;
+	assert.equal(isFollowingBox(source, changed), false);
+});
+
+
+test('rotated mirrored multiple BoxColliders preserve coordinates with bit-indexed edge axes', () => {
+    const source = [1, -1].map(sign => collisionBox([1,2,3]).vertices.map(p =>
+        transformPoint(trsMatrix([10,2,20],unityEulerQuaternion([0,37,0]),[sign,1,1]),p)));
+    const before=structuredClone(source);
+    const result=followingSupport('x','level','model',template(),row,source,'box');
+    assert.deepEqual(source,before);
+    for(let i=0;i<source.length;i++) {
+        const b=result.bodies[i];
+        assert.deepEqual([...b].map(p=>JSON.stringify(p)).sort(),[...source[i]].map(p=>JSON.stringify(p)).sort());
+        for(let bits=0;bits<8;bits++) for(let axis=0;axis<3;axis++) {
+            const expected=b[0][axis]+[1,2,4].reduce((sum,mask)=>sum+(bits&mask?b[mask][axis]-b[0][axis]:0),0);
+            assert.ok(Math.abs(b[bits][axis]-expected)<1e-5);
+        }
+    }
+    const convex=followingSupport('x','level','model',template(),row,source,'convex');
+    assert.equal(convex.geometryKind,'convex');assert.deepEqual(convex.bodies,source);
+});
diff --git a/packages/extractor/src/game/following-supports.ts b/packages/extractor/src/game/following-supports.ts
new file mode 100644
index 00000000..dc4931a4
--- /dev/null
+++ b/packages/extractor/src/game/following-supports.ts
@@ -0,0 +1,107 @@
+import type { LevelInteractive } from '@endfield-noclip/formats/endfield/level-interactives';
+import type { MemoryPackValue } from '@endfield-noclip/formats/endfield/memory-pack';
+
+import type { Vec3 } from '@opendfieldmap/ganglia';
+
+import { componentOf, componentParams } from './interactives/component-params.ts';
+import { atomFloat, entityProperties, entityProperty, entityState } from './interactives/template-data.ts';
+
+/** One movable support with an authored activity range, independent of its transport choreography. */
+export interface FollowingSupport {
+	id: string;
+	level: string;
+	model: string;
+	spawn: Vec3;
+	bodies: Vec3[][];
+	geometryKind: 'box' | 'convex';
+	/** Three-dimensional distance from the restored spawn, not an arbitrary endpoint. */
+	maxDistance: number;
+	initialState: number;
+	assumption: 'placement-within-activity-range';
+}
+
+/**
+ * @param template decoded template with placement and variant overrides
+ * @param row placed interactive
+ * @returns whether the effective controller belongs to the following-box family
+ */
+export const isFollowingBox = (template: MemoryPackValue, row: LevelInteractive): boolean => {
+	const suffix = '_InteractiveLogicControllerComponentDataForMemoryPack';
+	const logic = componentParams(template, row, {
+		suffix,
+		diffKey: 'Comp_InteractiveLogicController',
+		type: 29,
+	})?.get('logic_type');
+	return logic === undefined
+		? componentOf(template, suffix)?.logicType === 12
+		: logic.type === 3 && logic.values.length === 1 && logic.values[0].bits === 12n;
+};
+
+/**
+ * @param id source identity
+ * @param level owning level
+ * @param model source model
+ * @param template decoded effective interactive template
+ * @param row placed box
+ * @param bodies solid collider vertices at the authored placement in world space; boxes retain collisionBox face-ring order
+ * @param geometryKind decoded solid provenance
+ * @returns an activity-range source; the solver must still validate each stationary placement
+ * @throws on invalid collision geometry, saved state or activity range
+ */
+export const followingSupport = (
+	id: string,
+	level: string,
+	model: string,
+	template: MemoryPackValue,
+	row: LevelInteractive,
+	bodies: Vec3[][],
+	geometryKind: FollowingSupport['geometryKind'],
+): FollowingSupport => {
+	const entity = entityProperties(template);
+	if (!entity || !isFollowingBox(template, row)) {
+		throw new Error('following box controller unresolved');
+	}
+	const distance = entityProperty(entity, row, 'box_max_distance');
+	const maxDistance = distance?.length === 1 ? atomFloat(distance[0].bits) : NaN;
+	if (!Number.isFinite(maxDistance) || maxDistance <= 0) {
+		throw new Error('invalid following box activity range');
+	}
+	const initialState = entityState(entity, row);
+	if (initialState !== 0 && initialState !== 1) {
+		throw new Error('following box saved state unresolved');
+	}
+	let spawn: Vec3 = [...row.position];
+	if (initialState === 1) {
+		const values = entityProperty(entity, row, 'end_pos');
+		if (!values || values.length !== 3) {
+			throw new Error('following box restored position unresolved');
+		}
+		spawn = [atomFloat(values[0].bits), atomFloat(values[1].bits), atomFloat(values[2].bits)];
+	}
+	if (
+		!spawn.every(Number.isFinite) ||
+		!bodies.length ||
+		bodies.some((body) => body.length < 8 || (geometryKind === 'box' && body.length !== 8) || body.some((p) => p.length !== 3 || !p.every(Number.isFinite)))
+	) {
+		throw new Error('following box solid geometry unresolved');
+	}
+	return {
+		id,
+		level,
+		model,
+		spawn,
+		geometryKind,
+		bodies: bodies.map((body) =>
+			// Only the following-box boundary needs bit-indexed corners. Preserve the
+			// indexed mesh/ring order used by static and rotating collider exporters.
+			(geometryKind === 'box' ? [0, 1, 3, 2, 4, 5, 7, 6].map(i => body[i]) : body).map((p): Vec3 => [
+				p[0] + (spawn[0] - row.position[0]),
+				p[1] + (spawn[1] - row.position[1]),
+				p[2] + (spawn[2] - row.position[2]),
+			]),
+		),
+		maxDistance,
+		initialState,
+		assumption: 'placement-within-activity-range',
+	};
+};
