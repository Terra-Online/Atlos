+/* oxlint-disable no-await-in-loop -- offline export follows authored placement order */
+import {
+	levelInteractiveFromValue,
+	type LevelInteractive,
+} from '@endfield-noclip/formats/endfield/level-interactives';
+import { isMemoryPackObject } from '@endfield-noclip/formats/endfield/memory-pack';
+import { UnityClass } from '@endfield-noclip/formats/unity/serialized-file';
+import { transformPoint, trsMatrix, unityEulerQuaternion } from '@endfield-noclip/formats/unity/transform';
+
+import type { SweptSupport } from '@opendfieldmap/ganglia/solver';
+import { circularSupport } from '@opendfieldmap/ganglia/solver/host';
+
+import type { Context } from '../context.ts';
+import { VfsGroup } from '../hg/vfs.ts';
+
+import { loadDynamicStructures, type StructureModel } from './dynamic/dynamic-structures.ts';
+import { loadInteractiveFacilities } from './interactives/interactive-facilities.ts';
+import { readPrefabSupport } from './prefab-support.ts';
+import type { PrefabPose } from './prefabs/prefab.ts';
+import { GameState, type MapVariables } from './state/game-state.ts';
+import { loadMapVariables, loadSceneStates, defaultSceneStates } from './state/scene-conditions.ts';
+import type { DraftControl, Visibility } from './state/scene-control.ts';
+import { loadProgressions, progressionId } from './state/scenery-variants.ts';
+
+type Row = { row: LevelInteractive; level: string; source: string; owners: string[] };
+type Motion = {
+	animator: string | null;
+	duration: number;
+	sampleRate: number;
+	loops: boolean;
+	paths: readonly number[];
+	frames: { time: number; transforms: [number, unknown][] }[];
+};
+type Support = {
+	id: string;
+	level: string;
+	template: string;
+	source: string;
+	model: string;
+	pose: string;
+	positions: number[];
+	indices: number[];
+	parts: {
+		model: { pathHash: string; position: number[]; rotation: number[]; scale: number[] };
+		path: string;
+		pose: string;
+		source: string;
+		motion: Motion[];
+	}[];
+	motion: 'fixed-terminal-pose' | 'animated-terminal-pose';
+};
+type ObjectRecord = {
+	id: string;
+	level: string;
+	template: string;
+	source: string;
+	owners: string[];
+	category: string;
+	status: string;
+	reason?: string;
+	representedBy?: string;
+};
+
+type Receipt = Pick<Support, 'id' | 'template' | 'level'> & {
+	parts: Pick<Support['parts'][number], 'path' | 'model'>[];
+};
+type Placement = Pick<LevelInteractive, 'template' | 'position' | 'rotation' | 'scale' | 'modelScale'>;
+
+/**
+ * Recognize already imported, uniquely placed source geometry for a stale logical owner reference. This adds
+ * an inventory alias, never a guessed model.
+ */
+export const representedSupport = (
+	placed: { row: Placement; level: string },
+	supports: readonly Receipt[],
+	placements: ReadonlyMap<string, { row: Placement }>,
+): string | null => {
+	const { row, level } = placed;
+	const rotation = unityEulerQuaternion(row.rotation);
+	// Templates share a source catalog across levels; only the represented
+	// physical instance, rather than its template witness, must share the level.
+	const witnesses = supports
+		.filter((s) => s.template === row.template)
+		.flatMap((s) => {
+			const placed = placements.get(s.id)?.row;
+			if (!placed || placed.modelScale > 0 !== row.modelScale > 0) return [];
+			const q = unityEulerQuaternion(placed.rotation);
+			return s.parts
+				.filter(
+					(p) =>
+						p.model.position.every((v, i) => Math.abs(v - placed.position[i]) <= 1e-3) &&
+						1 - Math.abs(unityEulerQuaternion(p.model.rotation).reduce((sum, v, i) => sum + v * q[i], 0)) <
+							1e-10,
+				)
+				.map((p) => ({
+					path: p.path,
+					scale: p.model.scale.map(
+						(v, i) =>
+							((v * row.scale[i]) / placed.scale[i]) *
+							(row.modelScale > 0 ? row.modelScale / placed.modelScale : 1),
+					),
+				}));
+		});
+	const matches = supports.filter(
+		(s) =>
+			s.level === level &&
+			s.parts.some((p) => {
+				if (
+					![...p.model.position, ...p.model.rotation, ...p.model.scale, ...row.position].every(
+						Number.isFinite,
+					)
+				)
+					return false;
+				if (
+					!witnesses.some(
+						(w) =>
+							w.path === p.path &&
+							w.scale.every((v, i) => Number.isFinite(v) && Math.abs(v - p.model.scale[i]) <= 1e-4),
+					) ||
+					p.model.position.some((v, i) => Math.abs(v - row.position[i]) > 1e-3)
+				)
+					return false;
+				const q = unityEulerQuaternion(p.model.rotation);
+				return 1 - Math.abs(q.reduce((sum, v, i) => sum + v * rotation[i], 0)) < 1e-10;
+			}),
+	);
+	return matches.length === 1 ? matches[0].id : null;
+};
+
+/**
+ * Names select an audit scope; they never create support geometry. Controllers and destroyed obstructions
+ * remain in the object inventory as removed records.
+ */
+export const supportObjectKind = (name: string): 'support' | 'removed' | 'controller' | null => {
+	if (/door|unrealwall|destruct|breakfloor|breakable|shards|electric_fence/i.test(name)) return 'removed';
+	if (/button|switch|terminal|monitor|controller|bamboo_raft_dock/i.test(name)) return 'controller';
+	return /bridge|jump_mushroom|rainbow_mushroom|waterwheel|platform|movingplat|gantry|crane|lifter|floater|floating_raft|move_bamboo|unstable|seesaw|dynamicbox|box_for_box_game|trap_floor|barrier|invisible_collider/i.test(
+		name,
+	)
+		? 'support'
+		: null;
+};
+
+/**
+ * A StructureModel already includes ModelTable and placement scales. Apply it exactly once, preserving the
+ * indexed solid shape rather than inventing a top.
+ */
+export const supportGeometry = (
+	body: Pick<Awaited<ReturnType<typeof readPrefabSupport>>, 'bodies' | 'bodyTriangles'>,
+	model: StructureModel['model'],
+) => {
+	const matrix = trsMatrix(model.position, unityEulerQuaternion(model.rotation), model.scale);
+	const mirrored = model.scale[0] * model.scale[1] * model.scale[2] < 0;
+	const positions: number[] = [],
+		indices: number[] = [];
+	for (const [i, vertices] of body.bodies.entries()) {
+		const triangles = body.bodyTriangles[i];
+		if (!triangles) throw new Error('solid collider has no triangle indices');
+		const first = positions.length / 3;
+		for (const vertex of vertices) {
+			const point = transformPoint(matrix, vertex);
+			if (!point.every(Number.isFinite)) throw new Error('nonfinite support placement');
+			positions.push(...point);
+		}
+		for (const triangle of triangles) {
+			if (
+				triangle.length !== 3 ||
+				triangle.some((index) => !Number.isInteger(index) || index < 0 || index >= vertices.length)
+			)
+				throw new Error('invalid solid triangle index');
+			const [a, b, c] = triangle.map((index) => index + first);
+			indices.push(a, mirrored ? c : b, mirrored ? b : c);
+		}
+	}
+	return { positions, indices };
+};
+
+/**
+ * ClipMotion.sample is an executable reader, so serialize its authored-rate Transform samples and binding IDs
+ * explicitly instead of losing it in JSON.
+ */
+export const supportMotion = (pose: PrefabPose | null): Motion[] =>
+	(pose?.clips ?? []).flatMap((clip) => {
+		const motion = clip.motion;
+		if (!motion) return [];
+		const { duration, sampleRate, loops, paths } = motion;
+		if (![duration, sampleRate].every(Number.isFinite) || duration < 0 || sampleRate <= 0)
+			throw new Error('invalid support animation timing');
+		const count = Math.max(1, Math.ceil(duration * sampleRate));
+		const frames = Array.from({ length: count + 1 }, (_, index) => {
+			const time = Math.min(index / sampleRate, duration);
+			return { time, transforms: [...motion.sample(time)] };
+		});
+		return [{ animator: clip.animator, duration, sampleRate, loops, paths, frames }];
+	});
+
+// Keep unresolved control references separate from a proven terminal exclusion.
+const visibility = (
+	condition: Visibility,
+	values: Record<string, number>,
+): 'visible' | 'hidden' | 'unresolved' => {
+	let unresolved = false;
+	for (const requirements of condition.alternatives) {
+		let unknown = false,
+			excluded = false;
+		for (const { control, mask } of requirements) {
+			const value = values[control];
+			if (value === undefined) unknown = true;
+			else if (((mask >>> value) & 1) === 0) {
+				excluded = true;
+				break;
+			}
+		}
+		if (!excluded && !unknown) return 'visible';
+		if (!excluded && unknown) unresolved = true;
+	}
+	return unresolved ? 'unresolved' : 'hidden';
+};
+
+/** `InteractiveComponentType.PaintingScroll` in LevelData. */
+const PAINTING_SCROLL = 254;
+
+/** LevelData's PaintingScroll component owns the map variables its painting restores. */
+export const paintingVariables = (rows: Iterable<LevelInteractive>, config: MapVariables | null) => {
+	if (!config) return undefined;
+	const keys = new Set<number>();
+	for (const row of rows) {
+		const related = row.componentProperties
+			.get(PAINTING_SCROLL)
+			?.find((param) => param.key === 'related_map_var_list');
+		if (related?.type !== 8) continue;
+		for (const { text } of related.values) {
+			if (text && Object.hasOwn(config.ids, text)) keys.add(config.ids[text]);
+		}
+	}
+	return keys.size ? { mapId: config.mapId, keys } : undefined;
+};
+
+/**
+ * Import passable completed-state scenery from the same placements and poses as the viewer. Geometry with
+ * ongoing motion is tagged and retains its motion data; exporting one pose does not establish
+ * time-independent traversal feasibility.
+ */
+export const collectStaticSupports = async (ctx: Context, scene: string, knownIds: ReadonlySet<string>) => {
+	const objects: ObjectRecord[] = [],
+		unsupported: { id: string; template: string; reason: string }[] = [];
+	const supports = new Map<string, Support>();
+	const circular = new Map<string, SweptSupport>();
+	const rows = new Map<string, Row>(),
+		byOwner = new Map<string, Row[]>();
+	const paths = await ctx.world.pathLookup(),
+		reader = await ctx.memoryPack();
+	const levels = [...(await ctx.world.levelConfigs()).values()].filter((level) => level.mapId === scene);
+	for (const level of levels)
+		for (const hash of level.levelDataPathHashes ?? []) {
+			const source = paths(hash);
+			const file = source && (await ctx.vfs.find(VfsGroup.JsonData, source));
+			if (!file) throw new Error('missing static-support level data');
+			const data = reader.decode(await file.readVerified(), 'Beyond_Gameplay_LevelDataForMemoryPack');
+			if (!isMemoryPackObject(data) || !Array.isArray(data.interactives))
+				throw new Error('invalid static-support level data');
+			for (const raw of data.interactives) {
+				if (!isMemoryPackObject(raw) || typeof raw.levelLogicId !== 'string') continue;
+				const row = levelInteractiveFromValue(raw, BigInt(raw.levelLogicId)),
+					id = String(row.id);
+				if (rows.has(id)) continue;
+				const owners = [...row.componentProperties.values()].flatMap((params) =>
+					params
+						.filter((param) => param.key === 'dynamic_entity_id')
+						.flatMap((param) =>
+							param.values.filter((atom) => atom.bits > 0n).map((atom) => String(atom.bits)),
+						),
+				);
+				const placed: Row = { row, level: level.id, source: source!, owners };
+				rows.set(id, placed);
+				for (const owner of owners) byOwner.set(owner, [...(byOwner.get(owner) ?? []), placed]);
+			}
+		}
+	const records = new Map<string, ObjectRecord>();
+	const record = (placed: Row) => {
+		const id = String(placed.row.id);
+		let item = records.get(id);
+		if (!item) {
+			const category = supportObjectKind(placed.row.template) ?? 'dynamic-support';
+			item = {
+				id,
+				level: placed.level,
+				template: placed.row.template,
+				source: placed.source,
+				owners: placed.owners,
+				category,
+				status: knownIds.has(id)
+					? 'known'
+					: category === 'removed' || category === 'controller'
+						? 'excluded'
+						: 'pending',
+			};
+			records.set(id, item);
+			objects.push(item);
+		}
+		return item;
+	};
+	for (const placed of rows.values()) if (supportObjectKind(placed.row.template)) record(placed);
+	const states = await loadSceneStates(ctx.world, scene);
+	const progressions = await loadProgressions(ctx.world, scene);
+	const variables = await loadMapVariables(ctx.world, scene);
+	const game = new GameState({ variables });
+	game.note(states.flatMap((state) => (state.condition ? [state.condition] : [])));
+	const partition = await ctx.world.partition(scene);
+	const levelsByTag = new Map((partition?.levels ?? []).map((level) => [level.tag, level.id]));
+	const painting = paintingVariables(
+		[...rows.values()].map(({ row }) => row),
+		variables,
+	);
+	const dynamic = await loadDynamicStructures(ctx, scene, partition, game, { painting });
+	const values: Record<string, number> = {
+		...game.defaults(),
+		...Object.fromEntries(dynamic.controls.map((control) => [control.id, control.default])),
+		...Object.fromEntries(
+			progressions.map((progression) => [
+				progressionId(progression.kind, progression.key),
+				progression.defaultLevel,
+			]),
+		),
+	};
+	const enabledStates = defaultSceneStates(states, game);
+	const restored = Object.fromEntries(
+		dynamic.models.flatMap((model) =>
