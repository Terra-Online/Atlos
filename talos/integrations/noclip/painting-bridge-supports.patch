+		const rotating = new Set(body.circular.flatMap((r) => r.bodies));
+		if (wheel && !body.circular.length) throw new Error('waterwheel has no source-bound circular collider');
+		const generated: SweptSupport[] = [];
+		for (const [ri, rotor] of body.circular.entries()) {
