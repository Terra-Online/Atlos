+import type { LevelInteractive } from '@endfield-noclip/formats/endfield/level-interactives';
+
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+
+import type { PrefabPose } from './prefabs/prefab.ts';
+import { supportGeometry, supportMotion, supportObjectKind, representedSupport, paintingVariables } from './static-supports.ts';
+
+test('support audit keeps persistent barriers and excludes only explicit removed/control families', () => {
+    assert.equal(supportObjectKind('int_bridge_wuling_18m'), 'support');
+    assert.equal(supportObjectKind('int_waterwheel'), 'support');
+    assert.equal(supportObjectKind('dyn_gantry_bigPlatform'), 'support');
+    assert.equal(supportObjectKind('int_invisible_collider'), 'support');
+    assert.equal(supportObjectKind('persistent_barrier_postmodel'), 'support');
+    assert.equal(supportObjectKind('int_door_common_v2'), 'removed');
+    assert.equal(supportObjectKind('int_destructible_physics_miasma_rock'), 'removed');
+    assert.equal(supportObjectKind('int_lifter_button'), 'controller');
+    assert.equal(supportObjectKind('int_doodad_grass'), null);
+});
+
+test('uses the actual dynamic transform once and preserves solid indices under reflection', () => {
+    const body: Parameters<typeof supportGeometry>[0] = { bodies: [[[1, 0, 0], [0, 1, 0], [0, 0, 1]]], bodyTriangles: [[[0, 1, 2]]] };
+    const model = { pathHash: 1n, position: [10, 20, 30] as [number, number, number], rotation: [0, 90, 0] as [number, number, number], scale: [2, 3, 4] as [number, number, number] };
+    const result = supportGeometry(body, model);
+    const expected = [10, 20, 28, 10, 23, 30, 14, 20, 30];
+    assert.ok(result.positions.every((value, i) => Math.abs(value - expected[i]) < 1e-5));
+    assert.deepEqual(result.indices, [0, 1, 2]);
+    assert.deepEqual(supportGeometry(body, { ...model, scale: [-2, 3, 4] }).indices, [0, 2, 1]);
+    assert.throws(() => supportGeometry({ ...body, bodyTriangles: [[[0, 1, 3]]] }, model), /invalid solid triangle index/);
+});
+
+test('looping transform animation survives JSON as authored-rate samples', () => {
+    const pose: PrefabPose = { key: 'wheel:state=1', active: new Map(), clips: [{ animator: 'WheelRoot',
+        transforms: new Map(), active: new Map(), materials: new Map(), renderers: new Map(),
+        motion: { duration: 1, sampleRate: 2, loops: true, paths: [17], materials: null, sample: time =>
+            new Map([[17, [{ kind: 'position', value: [time, 0, 0] }]]]) },
+    }] };
+    const motion = JSON.parse(JSON.stringify(supportMotion(pose)));
+    assert.equal(motion[0].loops, true);
+    assert.equal(motion[0].animator, 'WheelRoot');
+    assert.deepEqual(motion[0].paths, [17]);
+    assert.deepEqual(motion[0].frames.map((frame: { time: number }) => frame.time), [0, 0.5, 1]);
+    assert.deepEqual(motion[0].frames[2].transforms, [[17, [{ kind: 'position', value: [1, 0, 0] }]]]);
+});
+test('stale owners are represented only by unique matching source geometry, never by nearby scenery', () => {
+    const row={template:'bridge-variant',position:[10,20,30] as [number,number,number],rotation:[0,90,0] as [number,number,number],scale:[1,1,1] as [number,number,number],modelScale:0};
+    const part=(position:number[])=>({path:'source-model',model:{pathHash:'1',position,rotation:[0,90,0],scale:[1,1,1]}});
+    const witness={id:'known-variant',template:row.template,level:'level',parts:[part([100,20,30])]};
+    const actual={id:'actual-owner',template:'dynamic-source',level:'level',parts:[part([10.0004,20,30])]};
+    const placements=new Map([[witness.id,{row:{...row,position:[100,20,30] as [number,number,number]}}]]);
+    const placed={row,level:'level'};
+    assert.equal(representedSupport(placed,[witness,actual],placements),actual.id);
+    assert.equal(representedSupport(placed,[{...witness,level:'other-level'},actual],placements),actual.id);
