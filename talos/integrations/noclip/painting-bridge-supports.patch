+		}
+	}
+	if (objects.some((item) => item.status === 'pending' && !claimed.has(item.id))) {
+		const facilities = await loadInteractiveFacilities(ctx, {
+			scene,
+			level: null,
+			partition,
+			scripted: new Set(),
+			erosionCores: dynamic.erosionCores,
+			interactiveStates: new Map(),
+			openTraversal: true,
+		});
+		const controls: DraftControl[] = [
+			...facilities.progressions,
+			...facilities.created,
+			...facilities.activities,
+			...facilities.proximityControls,
+			...facilities.bridges,
+			...facilities.doors.map((door) => door.control),
+			...facilities.scriptControls.values(),
+		];
+		for (const control of controls)
+			values[control.id] =
+				control.kind === 'bridge' ||
+				control.kind === 'created' ||
+				control.kind === 'door' ||
+				control.kind === 'activation'
+					? 1
+					: control.default;
+		for (const model of facilities.models) {
+			const item = model.logicId ? records.get(model.logicId) : undefined;
+			if (!item || item.category !== 'support' || knownIds.has(item.id) || claimed.has(item.id)) continue;
+			const shown = visibility(model.visibility, values);
+			if (shown !== 'visible') {
+				if (shown === 'unresolved')
+					failed(item, new Error(`unresolved interactive visibility: ${JSON.stringify(model.visibility)}`));
+				continue;
+			}
+			try {
+				await add(item, model);
+			} catch (error) {
+				failed(item, error);
+			}
+		}
+		for (const missing of facilities.standIns) {
+			// loadInteractiveFacilities creates stand-in sources as `${path}#${row.id}`.
+			const id = /#([1-9]\d*)$/.exec(missing.source)?.[1],
+				item = id ? records.get(id) : undefined;
+			if (item?.status === 'pending') failed(item, new Error(missing.reason));
+		}
+	}
+	const dynamicOwners = new Set(
+		(await ctx.world.dynamicEntities(scene)).flatMap((entity) =>
+			entity.uid === null ? [] : [String(entity.uid)],
+		),
+	);
+	const imported = [...supports.values()].filter((support) => {
+		const status = records.get(support.id)?.status;
+		return status === 'exported' || status === 'animated';
+	});
+	for (const item of objects) {
+		if (item.status === 'pending') {
+			const absentOwners = item.owners.filter((owner) => !dynamicOwners.has(owner));
+			if (item.owners.length && absentOwners.length === item.owners.length) {
+				const placed = rows.get(item.id);
+				const represented = placed && representedSupport(placed, imported, rows);
+				if (represented) {
+					item.status = 'represented';
+					item.representedBy = represented;
+					item.reason = 'logical owner reference absent; matching source geometry is already imported';
+					continue;
+				}
+			}
+			item.status = 'unresolved';
+			item.reason =
+				item.owners.length && absentOwners.length === item.owners.length
+					? `referenced dynamic owner is absent from scene resources: ${absentOwners.join(', ')}`
+					: 'no terminal physical model was resolved';
+		}
+		if (item.status === 'unresolved') {
