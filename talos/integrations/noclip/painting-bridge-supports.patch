+		);
+	}
+	for (const area of dynamic.areas) values[`area:${area}`] = 1;
+	const resolver = await ctx.resolver();
+	const bodies = new Map<string, Promise<Awaited<ReturnType<typeof readPrefabSupport>>>>();
+	const add = async (item: ObjectRecord, model: StructureModel) => {
+		if (knownIds.has(item.id)) return;
+		const path = paths(model.model.pathHash)?.toLowerCase();
+		if (!path) throw new Error('static-support prefab path unavailable');
+		const pose = model.pose?.key ?? 'authored-rest';
+		const wheel = /^int_(?:big_)?waterwheel$/.test(item.template);
+		const key = `${path}:${pose}:${wheel}`;
+		if (!bodies.has(key))
+			bodies.set(
+				key,
+				(async () => {
+					const ref = await resolver.findUnique({ hash: model.model.pathHash, path }, UnityClass.GameObject);
+					return readPrefabSupport(resolver, ref, { wholePrefab: true, pose: model.pose, circular: wheel });
+				})(),
