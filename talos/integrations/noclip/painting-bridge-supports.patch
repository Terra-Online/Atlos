index 00000000..96d5aced
--- /dev/null
+++ b/packages/extractor/src/game/ground-tile-cache.ts
@@ -0,0 +1,132 @@
+import { createHash, randomUUID } from 'node:crypto';
+import { mkdir, readFile, rename, rm, writeFile } from 'node:fs/promises';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+import { isObject } from '@endfield-noclip/formats/unity/values';
+
+import type { Surface } from '@opendfieldmap/ganglia';
+import { groundBuildIdentity, type BuildOptions, type CollisionGeometry, type TileCache } from '@opendfieldmap/ganglia/build';
+
+type Source = { buildGuid: string; contentHash: string };
+const validSurface = (value: unknown): value is Surface =>
+	isObject(value) &&
+	typeof value.id === 'string' &&
+	Array.isArray(value.vertices) &&
+	value.vertices.length >= 3 &&
+	value.vertices.every(
+		(point: unknown) => Array.isArray(point) && point.length === 3 && point.every(Number.isFinite),
+	);
+
+/** @returns the installed geometry generator identity, independent of runtime route code */
+export const groundGeneratorIdentity = async (
+	readSource: (file: string) => Promise<Uint8Array> = readFile,
+): Promise<string> => {
+	const files = [
+		// Physical exports also depend on decoding, selecting and placing source
+		// geometry. SDK-only hashing could otherwise retain old bridge/floor/terrain
+		// results after those importers changed. Route/search code is excluded.
+		...[
+			'../commands/player-ground.ts',
+			'./collision-inputs.ts',
+			'./collision-ground.ts',
+			'./dynamic/ink-road-collision.ts',
+			'./dynamic/dynamic-structures.ts',
+			'./dynamic/dynamic-grids.ts',
+			'./state/game-state.ts',
+			'./state/scene-conditions.ts',
+			'./prefab-support.ts',
+            './circular-rotations.ts',
+			'./static-supports.ts',
+			'./dynamic/dynamic-structures.ts',
+			'./interactives/view-state-poses.ts',
+			'./moving-supports.ts',
+            './water-supports.ts',
+            './water/water-volumes.ts',
+            './water/water-volume-scripts.ts',
+            './interactives/lifters.ts',
+            './interactives/component-params.ts',
+            './following-supports.ts',
+			'./floor-supports.ts',
+			'./prefabs/pose-paths.ts',
+			'./assets/asset-decode.ts',
+		].map((file) => fileURLToPath(new URL(file, import.meta.url))),
+		...[
+			'endfield/collision-heightfield',
+			'endfield/ecs-collider',
+			'endfield/streaming-chunk-data',
+			'endfield/init-chunk-data',
+			'endfield/dynamic-scene',
+			'unity/collision-mesh',
+			'unity/convex-mesh',
+			'unity/mesh',
+			'unity/transform',
+			'hg/terrain',
+			'binary/binary-reader',
+		].map((file) => fileURLToPath(import.meta.resolve(`@endfield-noclip/formats/${file}`))),
+	];
+	const generator = createHash('sha256').update(await groundBuildIdentity()).update('\0');
+	for (const bytes of await Promise.all(files.map((file) => readSource(file)))) {
+		generator.update(bytes).update('\0');
+	}
+	return generator.digest('hex');
+};
+
+/**
+ * @param directory local content-addressed tile storage
+ * @param source immutable collision build binding
+ * @returns a disk cache keyed by exact padded geometry and physical build settings
+ * @throws if the installed generator identity cannot be read
+ */
+export const groundTileCache = async (directory: string, source: Source): Promise<TileCache> => {
+	const identity = await groundGeneratorIdentity();
+	const keyFor = (geometry: CollisionGeometry, options: BuildOptions) => {
+		const hash = createHash('sha256')
+			.update(JSON.stringify({ version: 1, source, generator: identity, options }))
+			.update(JSON.stringify([geometry.positions.length, geometry.indices.length]));
+		const positions = Float64Array.from(geometry.positions),
+			indices = Uint32Array.from(geometry.indices);
+		hash.update(Buffer.from(positions.buffer));
+		hash.update(Buffer.from(indices.buffer));
+		return hash.digest('hex');
+	};
+	const pathFor = (key: string) => resolve(directory, key.slice(0, 2), `${key}.json`);
+	return {
+		async load(geometry, options) {
+			const key = keyFor(geometry, options);
+			try {
+				const record: unknown = JSON.parse(await readFile(pathFor(key), 'utf8'));
+				if (!isObject(record) || record.key !== key || !Array.isArray(record.surfaces)) {
+					return null;
+				}
+				const ids = new Set<string>();
+				const surfaces: Surface[] = [];
+				for (const value of record.surfaces) {
+					const surface: unknown = value;
+					if (!validSurface(surface) || ids.has(surface.id)) {
+						return null;
+					}
+					ids.add(surface.id);
+					surfaces.push(surface);
+				}
+				return surfaces;
+			} catch {
+				return null;
+			}
+		},
+		async save(geometry, options, surfaces) {
+			const key = keyFor(geometry, options),
+				path = pathFor(key),
+				temporary = `${path}.${randomUUID()}.tmp`;
+			try {
+				await mkdir(dirname(path), { recursive: true });
+				await writeFile(temporary, JSON.stringify({ key, surfaces }));
+				await rename(temporary, path);
+			} catch (error) {
+				console.warn('unable to retain physical tile cache', error);
+			} finally {
+				await rm(temporary, { force: true }).catch(() => {});
+			}
+		},
+	};
+};
