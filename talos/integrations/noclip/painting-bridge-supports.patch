+    assert.equal(representedSupport(placed,[witness,{...actual,parts:[{...part([10,20,30]),path:'different-model'}]}],placements),null);
+    assert.equal(representedSupport(placed,[witness,{...actual,level:'another-level'}],placements),null);
+});
