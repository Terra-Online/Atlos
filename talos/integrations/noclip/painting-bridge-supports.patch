+			{
+				bodies: body.bodies.filter((_, i) => !rotating.has(i)),
+				bodyTriangles: body.bodyTriangles.filter((_, i) => !rotating.has(i)),
+			},
+			model.model,
+		);
+		if (!geometry.indices.length && !generated.length) throw new Error('prefab has no solid triangles');
+		const motion = supportMotion(model.pose);
+		let support = supports.get(item.id);
+		if (!support) {
+			support = {
+				id: item.id,
+				level: item.level,
+				template: item.template,
+				source: item.source,
+				model: path,
+				pose,
+				positions: [],
+				indices: [],
+				parts: [],
+				motion: 'fixed-terminal-pose',
+			};
+			supports.set(item.id, support);
+		}
+		const first = support.positions.length / 3;
+		for (const coordinate of geometry.positions) support.positions.push(coordinate);
+		for (const index of geometry.indices) support.indices.push(index + first);
+		support.parts.push({
+			model: {
+				pathHash: String(model.model.pathHash),
+				position: model.model.position,
+				rotation: model.model.rotation,
+				scale: model.model.scale,
+			},
+			path,
+			pose,
+			source: model.source,
+			motion,
+		});
+		for (const ring of generated) circular.set(ring.id, ring);
+		if (motion.length) support.motion = 'animated-terminal-pose';
+		if (item.status !== 'unresolved')
