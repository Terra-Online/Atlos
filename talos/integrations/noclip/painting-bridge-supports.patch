+				: model.owner
+					? (byOwner.get(model.owner) ?? (rows.has(model.owner) ? [rows.get(model.owner)!] : []))
+					: [];
+		const placed = matches.find((row) => supportObjectKind(row.row.template) === 'support');
+		// A controller may address a separate physical dynamic model. Classify
+		// that model by its own prefab rather than removing its whole owner.
+		if (!placed && !model.painting && supportObjectKind(path) !== 'support') continue;
+		const item = placed
+			? record(placed)
+			: {
+					id: model.owner ?? model.logicId ?? `dynamic/${model.source}`,
+					level: levelsByTag.get(model.levelTag) ?? String(model.levelTag),
+					template: path,
+					source: model.source,
+					owners: model.owner ? [model.owner] : [],
+					category: 'dynamic-support',
+					status: 'pending',
