+		if (knownIds.has(target.id) || target.status === 'excluded') continue;
+		// Even an excluded terminal variant establishes dynamic ownership. A
+		// fallback at the logical interactive pivot would reintroduce a model
+		// that its actual completed-state dynamic owner has hidden.
+		claimed.add(target.id);
+		const shown = visibility(model.visibility, values);
