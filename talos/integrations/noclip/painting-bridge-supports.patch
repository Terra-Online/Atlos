+			for (const id of circular.keys())
+				if (id === item.id || id.startsWith(item.id + '/rotor/')) circular.delete(id);
+			unsupported.push({
+				id: item.id,
+				template: item.template,
+				reason: item.reason ?? 'unresolved physical model',
+			});
+		}
+	}
+	return { supports: [...supports.values()], circularSupports: [...circular.values()], objects, unsupported };
+};
