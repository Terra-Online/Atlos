diff --git a/packages/viewer/src/package/resource-metadata.test.ts b/packages/viewer/src/package/resource-metadata.test.ts
new file mode 100644
--- /dev/null
+++ b/packages/viewer/src/package/resource-metadata.test.ts
@@ -0,0 +1,34 @@
+import assert from 'node:assert/strict';
+import { it } from 'node:test';
+
+import { httpSource, type ByteRange } from './package-source.ts';
+
+it('routes multipart reads through the host transport with all semantic bytes', async () => {
+	const previous = Object.getOwnPropertyDescriptor(globalThis, 'location');
+	Object.defineProperty(globalThis, 'location', { configurable: true, value: { href: 'https://example.test/' } });
+	try {
+		const calls: { header: string | null; range: ByteRange | undefined }[] = [];
+		const source = httpSource('https://example.test/packages/', async (_url, init, range) => {
+			calls.push({ header: new Headers(init.headers).get('range'), range });
+			return new Response(
+				'--parts\r\nContent-Range: bytes 0-1/8\r\n\r\nab\r\n' +
+				'--parts\r\nContent-Range: bytes 6-7/8\r\n\r\ngh\r\n--parts--\r\n',
+				{ status: 206, headers: { 'content-type': 'multipart/byteranges; boundary=parts' } },
+			);
+		});
+		const parts = await source.readRanges('shard.czar', [
+			{ offset: 0, length: 2, fileSize: 8, content: [{ kind: 'geometry', bytes: 2 }] },
+			{ offset: 6, length: 2, fileSize: 8, content: [{ kind: 'texture', bytes: 2 }] },
+		]);
+		assert.deepEqual(parts.map(bytes => new TextDecoder().decode(bytes)), ['ab', 'gh']);
+		assert.equal(calls.length, 1);
+		assert.equal(calls[0].header, 'bytes=0-1,6-7');
+		assert.deepEqual(calls[0].range?.content, [
+			{ kind: 'geometry', bytes: 2 },
+			{ kind: 'texture', bytes: 2 },
+		]);
+	} finally {
+		if (previous) Object.defineProperty(globalThis, 'location', previous);
+		else Reflect.deleteProperty(globalThis, 'location');
+	}
+});
