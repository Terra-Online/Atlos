+it('keeps injected transport metadata for multipart reads and their single-range fallback', async () => {
+	const previous = Object.getOwnPropertyDescriptor(globalThis, 'location');
+	Object.defineProperty(globalThis, 'location', {
+		configurable: true,
+		value: { href: 'https://viewer.test/' },
+	});
+	try {
+		for (const multipart of [true, false]) {
+			const calls: { range: string | null; content: unknown }[] = [];
+			const source = httpSource('https://data.test/map02/', async (url, init, metadata) => {
+				assert.equal(url.href, 'https://data.test/map02/shard.czar');
+				const range = new Headers(init.headers).get('range');
+				calls.push({ range, content: metadata?.content });
+				if (range === 'bytes=0-1,4-5') {
+					if (!multipart) {
+						return new Response('abcdef');
+					}
+					return new Response(
+						'--b\r\nContent-Range: bytes 0-1/6\r\n\r\nab\r\n--b\r\nContent-Range: bytes 4-5/6\r\n\r\nef\r\n--b--\r\n',
+						{
+							status: 206,
+							headers: { 'content-type': 'multipart/byteranges; boundary=b' },
+						},
+					);
+				}
+				return new Response(range === 'bytes=0-1' ? 'ab' : 'ef', {
+					status: 206,
+					headers: { 'content-range': range === 'bytes=0-1' ? 'bytes 0-1/6' : 'bytes 4-5/6' },
+				});
+			});
+			const parts = await source.readRanges('shard.czar', [
+				{ offset: 0, length: 2, fileSize: 6, content: [{ kind: 'geometry', bytes: 2 }] },
+				{ offset: 4, length: 2, fileSize: 6, content: [{ kind: 'texture', bytes: 2 }] },
+			]);
+			assert.deepEqual(
+				parts.map((bytes) => new TextDecoder().decode(bytes)),
+				['ab', 'ef'],
+			);
+			assert.deepEqual(calls[0].content, [
+				{ kind: 'geometry', bytes: 2 },
+				{ kind: 'texture', bytes: 2 },
+			]);
+			assert.equal(calls.length, multipart ? 1 : 3);
+			if (!multipart) {
+				assert.deepEqual(
+					calls.slice(1).map((call) => call.content),
+					[[{ kind: 'geometry', bytes: 2 }], [{ kind: 'texture', bytes: 2 }]],
+				);
+			}
+		}
+	} finally {
+		if (previous) {
+			Object.defineProperty(globalThis, 'location', previous);
+		} else {
+			Reflect.deleteProperty(globalThis, 'location');
+		}
+	}
+});
