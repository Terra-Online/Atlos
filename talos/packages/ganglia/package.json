{
  "name": "@opendfieldmap/ganglia",
  "version": "0.1.0-alpha.88",
  "private": true,
  "description": "Conservative ground-route planning for Open Endfield Map",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "src",
    "LICENSE",
    "LICENSE-AGPL-3.0"
  ],
  "type": "module",
  "imports": {
    "#@/*": "./*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build.ts",
    "./collision": "./src/collision.ts",
    "./solver": "./src/solver/index.ts",
    "./solver/host": "./src/solver/host.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src bench test scripts prototype",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test": "node --test test/*.test.ts",
    "prepack": "pnpm check",
    "benchmark:full": "node --max-old-space-size=${GANGLIA_BENCHMARK_HEAP_MB:-6144} bench/cli.ts",
    "prototype:rust:build": "node prototype/rust-kernel/build.ts",
    "prototype:rust:test": "node --test prototype/rust-kernel/parity.test.ts",
    "prototype:rust:benchmark": "node prototype/rust-kernel/benchmark.ts",
    "benchmark:markdown": "node bench/report.ts"
  },
  "dependencies": {
    "@recast-navigation/core": "0.44.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.12"
  },
  "packageManager": "pnpm@10.5.0"
}
